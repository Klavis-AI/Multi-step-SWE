<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.madgag</groupId>
    <artifactId>mini-git-server-parent</artifactId>
    <version>0.5-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mini-git-server - Parent</name>
    <description>
        mini-git-server - a pure-Java WAR capable of hosting git repos and exposing them with git+ssh.
        Basically a copy of Gerrit (http://code.google.com/p/gerrit/) - with all the review-related
        functionality stripped away and the dependency on a database removed (making it entirely filesystem based).
        I use it for integration-testing my git client.
    </description>
    <url>https://github.com/rtyley/mini-git-server</url>

    <properties>
        <jgitVersion>7.8.0.202609011348-r</jgitVersion>
        <sshdVersion>2.19.0</sshdVersion>
        <!-- Spring Boot supplies the framework, the embedded servlet
             container and the dependency versions that used to be pinned
             one artifact at a time below. -->
        <springBootVersion>4.1.1</springBootVersion>

        <!-- The language and class-file level for every module. `release` and
             not `source`/`target`: on a JDK newer than the one being targeted,
             source/target compiles against the *running* JDK's API and only
             fails at run time on the older one. 21 and not 17 because the work
             queues are virtual threads, which are a 21 API and a 21 runtime;
             17 was where Spring Framework 6 and Spring Boot 3 set the floor,
             and this is the first thing the server needs that is above it. -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Keep parameter names in the class files. The platform binds
             configuration and resolves constructor arguments by name, and a
             build that drops the names leaves it guessing from position. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>mini-git-server-util-cli</module>
        <module>mini-git-server-util-ssl</module>
        <module>mini-git-server-httpd</module>
        <module>mini-git-server-server</module>
        <module>mini-git-server-sshd</module>
        <module>mini-git-server-app</module>
    </modules>

    <licenses>
        <license>
            <name>Apache License, 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.html</url>
        </license>
    </licenses>
    <scm>
        <connection>scm:git:git@github.com:rtyley/mini-git-server.git</connection>
        <developerConnection>scm:git:git@github.com:rtyley/mini-git-server.git</developerConnection>
        <url>git@github.com:rtyley/mini-git-server.git</url>
    </scm>
    <developers>
        <developer>
            <id>roberto</id>
            <name>Roberto Tyley</name>
            <timezone>0</timezone>
            <url>https://github.com/rtyley</url>
        </developer>
    </developers>
    <build>
        <pluginManagement>
            <plugins>
                <!-- Only the plugins this reactor actually binds. The 2011 pom
                     also managed shade, antrun, dependency, build-helper and
                     antlr3; nothing declared any of them, and the antlr3 usage
                     in mini-git-server-server had no .g grammar to read. They
                     are gone rather than re-versioned. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${springBootVersion}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- release comes from maven.compiler.release above; there is
                     deliberately no <source>/<target> here. The whole warning
                     set is on and every warning is an error: a warning nobody
                     has to look at is a warning nobody looks at. -->
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- The nullness vocabulary, in every module. Compile scope and no
             version: the platform manages it like everything else, and these
             are the same annotations the framework's own signatures carry, so
             a tool that reads this project's nullness and a tool that reads
             the framework's are reading one vocabulary rather than two. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- The only import there is. It manages JUnit as well now, so
                 the separate junit-bom import this reactor used to declare
                 ahead of it is gone: the platform names one JUnit version for
                 the whole build and nothing here has to agree with it by
                 hand. Everything else the framework and the embedded container need (spring-*,
                 tomcat-embed-*, and the servlet API that comes with it) is
                 managed from here rather than pinned by hand.

                 slf4j comes from here too, in place of the 1.6.1 this pom
                 used to pin. sshd 2.19 reads org.slf4j.event.Level in a
                 static initialiser and 1.6.1 has no such class; while this
                 was a war the servlet container's own slf4j was visible to
                 the webapp and hid the gap, so the mismatch only surfaces
                 once the jar is what runs. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${springBootVersion}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-core</artifactId>
                <version>${sshdVersion}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-common</artifactId>
                <version>${sshdVersion}</version>
            </dependency>



            <dependency>
                <groupId>args4j</groupId>
                <artifactId>args4j</artifactId>
                <version>2.37</version>
            </dependency>








            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgitVersion}</version>
            </dependency>

            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit.http.server</artifactId>
                <version>${jgitVersion}</version>
            </dependency>


        </dependencies>
    </dependencyManagement>

</project>
