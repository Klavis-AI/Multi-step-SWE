# Verifier image for step 06 (06-logging).
#
# GENERATED by bin/mk-verifier-dockerfile.sh 06-logging 17 bootjar -- edit the
# generator, not this file.
#
# Harbor builds this with steps/06-logging/tests/ as the whole Docker build
# context, so nothing above it can be reached and every shared file is a copy
# put there by bin/sync-scorer.sh.
#
# Exactly one JDK: 17. The agent image carries three and defaults to the
# oldest, so a candidate that targets the wrong release finds out from javac.
# The verifier carries one so that "it compiled" and "it compiled for this
# rung" cannot come apart.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC

# The same package set as the agent image, deliberately. git, openssh-client
# and curl are the clients the behaviour suite was recorded through, and an
# expectation recorded with one git and replayed with another is not an
# expectation. Installing the identical list is the cheapest way to keep the
# two resolutions from diverging; bin/check-clients.sh compares the binaries.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      bsdextrautils \
      ca-certificates \
      coreutils \
      curl \
      diffutils \
      file \
      findutils \
      gawk \
      git \
      gnupg \
      jq \
      less \
      make \
      netcat-openbsd \
      openssh-client \
      patch \
      procps \
      python3 \
      ripgrep \
      tar \
      unzip \
      util-linux \
      xz-utils \
      zip \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL -o /tmp/jdk.tar.gz 'https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.20.1%2B1/OpenJDK17U-jdk_x64_linux_hotspot_17.0.20.1_1.tar.gz'; \
    echo '3808d1d15e3ec6bd5b84057fb5d84c33d8a1536a258146bcea2e603fc726e08e  /tmp/jdk.tar.gz' | sha256sum -c -; \
    mkdir -p /usr/lib/jvm/temurin-17; \
    tar -xzf /tmp/jdk.tar.gz -C /usr/lib/jvm/temurin-17 --strip-components=1; \
    rm -f /tmp/jdk.tar.gz; \
    /usr/lib/jvm/temurin-17/bin/java -version

ENV JAVA_HOME=/usr/lib/jvm/temurin-17 \
    PATH=/usr/lib/jvm/temurin-17/bin:/opt/maven/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

RUN set -eux; \
    curl -fsSL -o /tmp/maven.tar.gz \
      'https://archive.apache.org/dist/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz'; \
    echo '831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6  /tmp/maven.tar.gz' \
      | sha512sum -c -; \
    mkdir -p /opt/maven; \
    tar -xzf /tmp/maven.tar.gz -C /opt/maven --strip-components=1; \
    rm -f /tmp/maven.tar.gz; \
    mvn -v

# No servlet container here: from this rung on the build produces a single
# executable jar and is started with `java -jar`, which is the platform's own
# way to run it. Shipping jetty-runner anyway would let a candidate that kept
# the war shape score.

# ---------------------------------------------------------------------------
# The migrated-ness scanners, compiled here so that a scan is never a javac
# invocation inside a scored run. ASM reads the artifact's bytecode;
# JavaParser reads the repository's source. Both jars are pinned by sha256,
# because a gate whose library changed under it is a gate that measured
# something else.
# ---------------------------------------------------------------------------
RUN set -eux; \
    mkdir -p /opt/gatejars /opt/gates; \
    get() { curl -fsSL -o "/opt/gatejars/$1" "$2"; echo "$3  /opt/gatejars/$1" | sha256sum -c -; }; \
    get asm-9.9.jar \
      'https://repo1.maven.org/maven2/org/ow2/asm/asm/9.9/asm-9.9.jar' \
      '03d99a74ad1ee5c71334ef67437f4ef4fe3488caa7c96d8645abc73c8e2017d4'; \
    get asm-tree-9.9.jar \
      'https://repo1.maven.org/maven2/org/ow2/asm/asm-tree/9.9/asm-tree-9.9.jar' \
      '42178f3775c9c63f9e5e1446747d29b4eca4d91bd6e75e5c43cfa372a47d38c6'; \
    get javaparser-core-3.27.0.jar \
      'https://repo1.maven.org/maven2/com/github/javaparser/javaparser-core/3.27.0/javaparser-core-3.27.0.jar' \
      '11b0deeaeb29f2496e1704c8c6f7593f14901f7253a671b81bdaa531bead779f'

COPY gates/java /opt/gatesrc
RUN set -eux; \
    javac -nowarn -cp /opt/gatejars/asm-9.9.jar:/opt/gatejars/asm-tree-9.9.jar \
      -d /opt/gates /opt/gatesrc/ArtifactScan.java; \
    javac -nowarn -cp /opt/gatejars/javaparser-core-3.27.0.jar \
      -d /opt/gates /opt/gatesrc/AstScan.java; \
    test -s /opt/gates/ArtifactScan.class; \
    test -s /opt/gates/AstScan.class; \
    rm -rf /opt/gatesrc

# ---------------------------------------------------------------------------
# Warm Maven cache for this rung's target stack, fetched from warm/pom.xml --
# the reference solution's poms with no source. Owned by the unprivileged user
# that the candidate's build runs as, so the build can add to it without a
# chown of the whole tree at score time.
#
# Warming is best-effort and the assertion after it is not: a silent miss here
# would show up much later as a build that spent its budget downloading.
# ---------------------------------------------------------------------------
RUN install -d -o 65534 -g 65534 /opt/m2 /opt/warmhome
COPY warm /warm
RUN set -eux; \
    chown -R 65534:65534 /warm; \
    setpriv --reuid 65534 --regid 65534 --clear-groups \
      env HOME=/opt/warmhome JAVA_HOME="$JAVA_HOME" PATH="$PATH" \
          MAVEN_OPTS=-Xmx2g \
      mvn -B -ntp -f /warm/pom.xml -Dmaven.repo.local=/opt/m2 \
          -fn dependency:go-offline \
          org.apache.maven.plugins:maven-dependency-plugin:3.7.0:help \
          > /tmp/warm.log 2>&1 || true; \
    tail -5 /tmp/warm.log; \
    jars=$(find /opt/m2 -name '*.jar' ! -name '*-sources.jar' | wc -l); \
    echo "warm cache jars=$jars"; \
    test "$jars" -ge 120; \
    # scan.sh names this plugin by full coordinates rather than by the
    # `dependency:` prefix, so the tree under test cannot supply the version
    # through its own pluginManagement (the pinned tree pins 2.1). Cache
    # exactly that version, and assert it.
    test -f /opt/m2/org/apache/maven/plugins/maven-dependency-plugin/3.7.0/maven-dependency-plugin-3.7.0.jar; \
    rm -rf /warm /opt/m2/com/madgag/mini-git-server-*

# ---------------------------------------------------------------------------
# The instrument guard (wave H, rootcfg sweep). Two scored scans run a plugin
# over the candidate's reactor -- scan.sh's dependency listing and step 10's
# OpenRewrite dry run -- and give it its options as -D user properties, which
# Maven lets the pom's own plugin configuration, plugin dependencies and
# properties override. This Maven core extension is loaded into those two runs
# only and drops what the poms say about the instrument plugin before Maven
# plans the run (guard/InstrumentGuard.java says exactly what). Compiled here,
# against this image's own Maven, so no scored run compiles anything.
#
# And the bytes the instruments load (wave H round 3): /opt/m2 belongs to the
# user the candidate's build runs as, so a build could replace a pinned
# plugin's jar before an instrument run loads it. m2.sha256 records every jar
# and pom the warm repository holds now -- both instruments' whole closures,
# since the warm step above ran them -- root-owned, and the verifier checks it
# before and after each instrument run (helpers.sh, instrument_repo_intact).
# ---------------------------------------------------------------------------
COPY guard /opt/guardsrc
RUN set -eux; \
    mkdir -p /opt/guard/classes/META-INF/sisu; \
    javac -nowarn -cp '/opt/maven/lib/*' -d /opt/guard/classes \
      /opt/guardsrc/InstrumentGuard.java; \
    echo scoreguard.InstrumentGuard \
      > /opt/guard/classes/META-INF/sisu/javax.inject.Named; \
    jar cf /opt/guard/instrument-guard.jar -C /opt/guard/classes .; \
    rm -rf /opt/guard/classes /opt/guardsrc; \
    chmod 0755 /opt/guard; \
    chmod 0644 /opt/guard/instrument-guard.jar; \
    test -s /opt/guard/instrument-guard.jar; \
    find /opt/m2 -type f \( -name '*.jar' -o -name '*.pom' \) -print0 \
      | sort -z | xargs -0 sha256sum > /opt/guard/m2.sha256; \
    chmod 0644 /opt/guard/m2.sha256; \
    grep -q '/maven-dependency-plugin-3.7.0.jar$' /opt/guard/m2.sha256

COPY . /tests
RUN set -eux; \
    chmod 0755 /tests/*.sh; \
    rm -rf /tests/warm /tests/gates /tests/guard; \
    find /tests -name '__pycache__' -type d -prune -exec rm -rf {} + || true; \
    mkdir -p /app /logs/verifier; \
    test -s /tests/expected.jsonl; \
    test -s /tests/drive.py; \
    chmod -R a+rX /tests; \
    # The fixture ssh keys are read by the unprivileged user that drives the
    # suite, and ssh refuses a private key it can see is readable by anyone
    # else. Give them to that user outright rather than loosening the mode.
    chown -R 65534:65534 /tests/keys; \
    chmod 0700 /tests/keys; \
    chmod 0600 /tests/keys/*; \
    # Round-3 migration review: the recording and the must-flip list are
    # read only by `drive.py compare`, which runs as root. The candidate's
    # server runs as the same user as the driver, so neither may be readable
    # to that user.
    chmod 0600 /tests/expected.jsonl; \
    if [ -e /tests/must-flip.jsonl ]; then chmod 0600 /tests/must-flip.jsonl; fi; \
    # Assert that the user that will actually read these can read these. A
    # mode the build inherited from the authoring tree surfaces at score time
    # as a driver that produced nothing, which is indistinguishable from a
    # candidate whose artifact answered nothing. Count lines rather than test
    # -r: the number has to come out right, not merely be permitted.
    n=$(setpriv --reuid 65534 --regid 65534 --clear-groups \
          cat /tests/cases/*.jsonl | grep -c .); \
    echo "readable-as-nobody lines=$n"; \
    test "$n" -eq "$(grep -c . /tests/expected.jsonl)"; \
    if setpriv --reuid 65534 --regid 65534 --clear-groups \
         cat /tests/expected.jsonl > /dev/null 2>&1; then \
      echo "expected.jsonl is readable by uid 65534" >&2; exit 1; \
    fi; \
    setpriv --reuid 65534 --regid 65534 --clear-groups \
      cat /tests/keys/tester > /dev/null

# ARTIFACT_KIND decides how build.sh looks for the deployable and how
# launch.sh starts it. HARBOR_STEP is stamped so that a job directory can be
# checked for having built one verifier image per step, which local docker does
# not always do.
ENV ARTIFACT_KIND=bootjar \
    HARBOR_STEP=step06 \
    M2_REPO=/opt/m2 \
    SCORE_OUT=/score/out \
    SCORE_LOG=/score/log \
    PYTHONPATH=/tests \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX=/tmp/pycache

WORKDIR /app

# build-context guard (2026-10-05): every step's verifier build context is a
# directory named tests, and BuildKit reuses its cached copy of a context
# file whose relpath, size, mode and mtime all match, so a file that differs
# between steps only in its step id can reach an image as another step's
# copy. The pad below keeps this file's size unique per step (sizes survive
# git and tar; mtimes do not). It is a comment and changes no behaviour; keep
# a per-step pad like it if this file is edited or regenerated.
