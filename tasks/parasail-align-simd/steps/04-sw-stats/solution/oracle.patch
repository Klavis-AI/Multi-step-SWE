+    int8_t matches = 0;
+    int8_t similar = 0;
+    int8_t length = 0;
+    __m256i vNegLimit;
+    __m256i vPosLimit;
+    __m256i vSaturationCheckMin;
+    __m256i vSaturationCheckMax;
+    __m256i vNegInf;
+    __m256i vNegInf0;
+    __m256i vOpen;
