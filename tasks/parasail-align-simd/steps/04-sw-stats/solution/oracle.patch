+        col[(i+10)] = (int16_t)_mm256_extract_epi16_rpl(vWH, 5);
+    }
+    if (i+11 == s1Len-1 && 0 <= j-11 && j-11 < s2Len) {
+        row[j-11] = (int16_t)_mm256_extract_epi16_rpl(vWH, 4);
+    }
