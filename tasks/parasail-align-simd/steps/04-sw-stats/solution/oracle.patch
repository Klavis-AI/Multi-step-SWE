+        vec128i vE_opn = vNegInf;
+        vec128i vE_ext = vNegInf;
+        vec128i vEM = vZero;
+        vec128i vES = vZero;
+        vec128i vEL = vZero;
+        vec128i vF = vNegInf;
+        vec128i vF_opn = vNegInf;
+        vec128i vF_ext = vNegInf;
+        vec128i vFM = vZero;
+        vec128i vFS = vZero;
+        vec128i vFL = vZero;
