+        vec128i case2 = vZero;
+        vec128i case0 = vZero;
+        vec128i vNH = vNegInf0;
+        vec128i vNM = vZero;
+        vec128i vNS = vZero;
+        vec128i vNL = vZero;
+        vec128i vWH = vNegInf0;
+        vec128i vWM = vZero;
+        vec128i vWS = vZero;
+        vec128i vWL = vZero;
