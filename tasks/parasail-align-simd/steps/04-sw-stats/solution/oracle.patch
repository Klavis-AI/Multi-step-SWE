+        row[j-2] = (int16_t)_mm256_extract_epi16_rpl(vWH, 13);
+    }
+    if (j-2 == s2Len-1 && 0 <= i+2 && i+2 < s1Len) {
+        col[(i+2)] = (int16_t)_mm256_extract_epi16_rpl(vWH, 13);
