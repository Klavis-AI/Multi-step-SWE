+#endif
+
+#ifdef PARASAIL_TABLE
+#define FNAME parasail_nw_table_striped_avx2_256_64
+#define PNAME parasail_nw_table_striped_profile_avx2_256_64
+#else
+#ifdef PARASAIL_ROWCOL
