+        int *col,
+        simde__m128i vH,
+        int32_t t,
+        int32_t seglen)
+{
+    col[ 0*seglen+t] = (int8_t)simde_mm_extract_epi8(vH,  0);
+    col[ 1*seglen+t] = (int8_t)simde_mm_extract_epi8(vH,  1);
+    col[ 2*seglen+t] = (int8_t)simde_mm_extract_epi8(vH,  2);
+    col[ 3*seglen+t] = (int8_t)simde_mm_extract_epi8(vH,  3);
