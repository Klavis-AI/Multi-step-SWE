+#define PNAME parasail_sw_table_scan_profile_sse2_128_8
+#else
+#ifdef PARASAIL_ROWCOL
+#define FNAME parasail_sw_rowcol_scan_sse2_128_8
+#define PNAME parasail_sw_rowcol_scan_profile_sse2_128_8
