+    col[ 7*seglen+t] = (int8_t)_mm_extract_epi8_rpl(vH,  7);
+    col[ 8*seglen+t] = (int8_t)_mm_extract_epi8_rpl(vH,  8);
+    col[ 9*seglen+t] = (int8_t)_mm_extract_epi8_rpl(vH,  9);
+    col[10*seglen+t] = (int8_t)_mm_extract_epi8_rpl(vH, 10);
