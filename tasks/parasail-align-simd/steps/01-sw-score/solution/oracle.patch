+            if (j > PAD) {
+                vSaturationCheckMin = _mm256_min_epi8(vSaturationCheckMin, vWH);
+                vSaturationCheckMax = _mm256_max_epi8(vSaturationCheckMax, vWH);
+            }
+#ifdef PARASAIL_TABLE
+            arr_store_si256(result->tables->score_table, vWH, i, s1Len, j, s2Len);
+#endif
