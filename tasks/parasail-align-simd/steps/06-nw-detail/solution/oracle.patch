+#ifdef PARASAIL_TABLE
+#define FNAME parasail_nw_stats_table_diag_altivec_128_8
+#else
+#ifdef PARASAIL_ROWCOL
+#define FNAME parasail_nw_stats_rowcol_diag_altivec_128_8
+#else
+#define FNAME parasail_nw_stats_diag_altivec_128_8
