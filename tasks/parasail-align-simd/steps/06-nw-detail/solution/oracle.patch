+        row[j-1] = (int8_t)_mm_extract_epi8(vWH, 14);
+    }
+    if (j-1 == s2Len-1 && 0 <= i+1 && i+1 < s1Len) {
+        col[(i+1)] = (int8_t)_mm_extract_epi8(vWH, 14);
