diff --git a/src/nw_trace_diag_sse41_128_64.c b/src/nw_trace_diag_sse41_128_64.c
new file mode 100644
index 0000000..24cbedf
--- /dev/null
+++ b/src/nw_trace_diag_sse41_128_64.c
@@ -0,0 +1,416 @@
+/**
+ * @file
+ *
+ * @author jeffrey.daily@gmail.com
