+    parasail_result_t *result = NULL;
+    __m128i vTIns;
+    __m128i vTDel;
+    __m128i vTDiag;
+    __m128i vTDiagE;
+    __m128i vTInsE;
+    __m128i vTDiagF;
+    __m128i vTDelF;
+
+    /* validate inputs */
