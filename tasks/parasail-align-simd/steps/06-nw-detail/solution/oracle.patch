+static inline void arr_store(
+        simde__m128i *array,
+        simde__m128i vH,
+        int32_t t,
+        int32_t seglen,
+        int32_t d)
+{
+    simde_mm_store_si128(array + (1LL*d*seglen+t), vH);
+}
+
+static inline simde__m128i arr_load(
+        simde__m128i *array,
+        int32_t t,
+        int32_t seglen,
+        int32_t d)
+{
+    return simde_mm_load_si128(array + (1LL*d*seglen+t));
