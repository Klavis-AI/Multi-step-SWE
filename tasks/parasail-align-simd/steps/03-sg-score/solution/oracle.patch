+    vMaxHRow = vNegInf;
+    vMaxHCol = vNegInf;
+    vLastVal = vNegInf;
+    vEndI = vNegInf;
+    vEndJ = vNegInf;
+    vILimit = _mm256_set1_epi8(s1Len);
+    vILimit1 = _mm256_subs_epi8(vILimit, vOne);
+    vJLimit = _mm256_set1_epi8(s2Len);
+    vJLimit1 = _mm256_subs_epi8(vJLimit, vOne);
