+            HS_pr[j] = 0;
+            HL_pr[j] = 0;
+            F_pr[j] = NEG_LIMIT;
+            FM_pr[j] = 0;
+            FS_pr[j] = 0;
+            FL_pr[j] = 0;
+        }
+    }
