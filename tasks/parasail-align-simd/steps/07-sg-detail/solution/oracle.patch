+    int32_t j = 0;
+    int32_t end_query = 0;
+    int32_t end_ref = 0;
+    int8_t NEG_LIMIT = 0;
+    int8_t POS_LIMIT = 0;
+    int8_t score = 0;
+    int8_t matches = 0;
+    int8_t similar = 0;
+    int8_t length = 0;
+    __m128i vNegLimit;
+    __m128i vPosLimit;
+    __m128i vSaturationCheckMin;
+    __m128i vSaturationCheckMax;
+    __m128i vNegInf;
+    __m128i vOpen;
+    __m128i vGap;
+    __m128i vZero;
+    __m128i vOne;
+    __m128i vN;
+    __m128i vGapN;
+    __m128i vNegOne;
+    __m128i vI;
+    __m128i vJreset;
+    __m128i vMaxHRow;
+    __m128i vMaxMRow;
+    __m128i vMaxSRow;
+    __m128i vMaxLRow;
