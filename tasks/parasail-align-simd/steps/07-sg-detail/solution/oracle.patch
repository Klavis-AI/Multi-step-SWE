+#ifdef PARASAIL_TABLE
+#define FNAME parasail_sg_flags_stats_table_diag_neon_128_16
+#else
+#ifdef PARASAIL_ROWCOL
+#define FNAME parasail_sg_flags_stats_rowcol_diag_neon_128_16
+#else
+#define FNAME parasail_sg_flags_stats_diag_neon_128_16
