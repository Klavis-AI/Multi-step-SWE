diff --git a/src/sg_trace_diag_sse41_128_16.c b/src/sg_trace_diag_sse41_128_16.c
new file mode 100644
index 0000000..782f790
--- /dev/null
+++ b/src/sg_trace_diag_sse41_128_16.c
@@ -0,0 +1,449 @@
+/**
+ * @file
+ *
+ * @author jeffrey.daily@gmail.com
