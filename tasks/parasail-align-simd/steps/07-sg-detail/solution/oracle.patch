diff --git a/src/sg_stats_diag_sse41_128_16.c b/src/sg_stats_diag_sse41_128_16.c
new file mode 100644
index 0000000..208615e
--- /dev/null
+++ b/src/sg_stats_diag_sse41_128_16.c
@@ -0,0 +1,743 @@
+/**
+ * @file
+ *
+ * @author jeffrey.daily@gmail.com
