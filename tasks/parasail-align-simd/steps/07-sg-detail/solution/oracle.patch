+            vEM= _mm256_load_si256(pvEM+i);
+            vES= _mm256_load_si256(pvES+i);
+            vEL= _mm256_load_si256(pvEL+i);
+            vW = _mm256_load_si256(pvW+i);
+            vWM = _mm256_load_si256(pvWM+i);
+            vWS = _mm256_load_si256(pvWS+i);
