diff --git a/src/sg_trace_diag_sse2_128_16.c b/src/sg_trace_diag_sse2_128_16.c
new file mode 100644
index 0000000..9fc235a
--- /dev/null
+++ b/src/sg_trace_diag_sse2_128_16.c
@@ -0,0 +1,454 @@
+/**
+ * @file
+ *
+ * @author jeffrey.daily@gmail.com
