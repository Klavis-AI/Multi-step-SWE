diff --git a/src/sg_trace_diag_altivec_128_16.c b/src/sg_trace_diag_altivec_128_16.c
new file mode 100644
index 0000000..4eee60b
--- /dev/null
+++ b/src/sg_trace_diag_altivec_128_16.c
@@ -0,0 +1,444 @@
+/**
+ * @file
+ *
+ * @author jeffrey.daily@gmail.com
