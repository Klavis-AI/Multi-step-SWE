+    __m256i vPosLimit;
+    __m256i vSaturationCheckMin;
+    __m256i vSaturationCheckMax;
+    __m256i vNegInf;
+    __m256i vNegInf0;
+    __m256i vOpen;
+    __m256i vGap;
+    __m256i vZero;
+    __m256i vOne16;
+    __m256i vNegOne16;
+    __m256i vN16;
+    __m256i vILo16;
+    __m256i vIHi16;
+    __m256i vJresetLo16;
+    __m256i vJresetHi16;
+    __m256i vMaxH;
+    __m256i vEndILo;
+    __m256i vEndIHi;
+    __m256i vEndJLo;
+    __m256i vEndJHi;
+    __m256i vILimit16;
+    __m256i vJLimit16;
+    __m256i vTDiag;
+    __m256i vTIns;
+    __m256i vTDel;
+    __m256i vTZero;
+    __m256i vTDiagE;
+    __m256i vTInsE;
+    __m256i vTDiagF;
+    __m256i vTDelF;
+
+    /* validate inputs */
