+            {
+                __m256i cond_zero = _mm256_cmpeq_epi8(vWH, vZero);
+                __m256i case1 = _mm256_cmpeq_epi8(vWH, vNWH);
+                __m256i case2 = _mm256_cmpeq_epi8(vWH, vF);
+                __m256i vT = _mm256_blendv_epi8(
