#!/usr/bin/env python3
"""Exits non-zero WITHOUT writing a CodeGeneratorResponse.

The instruction names three plugin failure modes: an error response, a plugin
that cannot be found, and a plugin that exits non-zero. The first two had
fixtures; this is the third. It is a distinct path from
protoc-gen-failing: there is no response to parse, so a protoc that only checks
the response body -- and never the child's wait status -- reports success and
writes nothing, which is exactly the bug this catches.
"""
import sys

sys.stdin.buffer.read()
sys.stderr.write("protoc-gen-crash: deliberate non-zero exit\n")
sys.exit(3)
