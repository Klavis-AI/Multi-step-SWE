#!/usr/bin/env python3
"""A protoc plugin that grades the REQUEST rather than generating anything.

The candidate's own protoc has to build a CodeGeneratorRequest and hand it over
on stdin. This reads that request, checks the properties that were measured off
protoc 32.1, and answers with an error response when they do not hold -- which
makes the candidate's protoc exit non-zero. The candidate's generator is never
involved, so this isolates the compiler side.

Parses the wire itself: the verifier image has no protobuf module.

It does NOT require source_code_info. protoc always sends it, but a candidate
that omits it has not got the compiler side wrong -- it has skipped a feature
that costs nothing here, and failing it would fail this reference too.
"""
import sys

def varint(b, i):
    v = s = 0
    while True:
        c = b[i]; i += 1
        v |= (c & 0x7F) << s; s += 7
        if not c & 0x80:
            return v, i

def records(b):
    i = 0
    while i < len(b):
        tag, i = varint(b, i)
        num, wt = tag >> 3, tag & 7
        if wt == 0:
            _, i = varint(b, i)
            yield num, None
        elif wt == 1:
            yield num, b[i:i+8]; i += 8
        elif wt == 5:
            yield num, b[i:i+4]; i += 4
        elif wt == 2:
            n, j = varint(b, i)
            yield num, b[j:j+n]; i = j + n
        else:
            raise ValueError("wire type %d" % wt)

def first(msg, want):
    for num, val in records(msg):
        if num == want:
            return val
    return None

def all_of(msg, want):
    return [v for num, v in records(msg) if num == want]

def fdp_name(fdp):
    v = first(fdp, 1)
    return v.decode("utf-8") if v else None

def check(req):
    errs = []
    to_gen = [v.decode("utf-8") for v in all_of(req, 1)]
    proto_file = all_of(req, 15)
    src_fds = all_of(req, 17)
    ver = first(req, 3)
    param = first(req, 2)

    if not to_gen:
        errs.append("file_to_generate is empty")
    names = [fdp_name(f) for f in proto_file]
    if len(names) != len(set(names)):
        errs.append("proto_file contains duplicates: %r" % (names,))
    for n in to_gen:
        if n not in names:
            errs.append("file_to_generate %r missing from proto_file" % n)

    # every dependency must appear, and appear BEFORE the file naming it
    pos = {n: k for k, n in enumerate(names)}
    for k, f in enumerate(proto_file):
        for dep in all_of(f, 3):
            d = dep.decode("utf-8")
            if d not in pos:
                errs.append("dependency %r of %r absent from proto_file" % (d, names[k]))
            elif pos[d] > k:
                errs.append("dependency %r comes after %r" % (d, names[k]))

    # source_file_descriptors is the files-to-generate, NOT the closure
    sn = [fdp_name(f) for f in src_fds]
    # The instruction says source_file_descriptors carries ONLY the files to
    # generate. It says nothing about ORDER, so comparing sequences pins a
    # choice the spec leaves open.
    if sorted(sn) != sorted(to_gen):
        errs.append("source_file_descriptors %r != file_to_generate %r" % (sn, to_gen))

    if ver is None:
        errs.append("compiler_version absent")
    else:
        have = {num for num, _ in records(ver)}
        for fld, nm in ((1, "major"), (2, "minor"), (3, "patch")):
            if fld not in have:
                errs.append("compiler_version.%s absent" % nm)

    # This checker is invoked with NO options, so `parameter` must be absent.
    # The companion protoc-gen-reqparam covers the other direction: one script
    # cannot distinguish "no options were given" from "this candidate never
    # sends parameter", so a candidate ignoring it entirely would pass here
    # vacuously.
    if param is not None:
        errs.append("parameter %r sent when no options were given" % param.decode("utf-8"))
    return errs

def wvar(v):
    out = bytearray()
    while True:
        c = v & 0x7F; v >>= 7
        out.append(c | (0x80 if v else 0))
        if not v:
            return bytes(out)

def main():
    req = sys.stdin.buffer.read()
    try:
        errs = check(req)
    except Exception as e:                     # a malformed request is a failure
        errs = ["request did not parse: %s" % e]
    if errs:
        msg = "; ".join(errs).encode("utf-8")
        resp = wvar(1 << 3 | 2) + wvar(len(msg)) + msg
        sys.stdout.buffer.write(resp)
        sys.stderr.write("reqcheck: " + "; ".join(errs) + "\n")
        return 0          # protoc turns an error response into a non-zero exit
    sys.stdout.buffer.write(b"")
    return 0

if __name__ == "__main__":
    sys.exit(main())
