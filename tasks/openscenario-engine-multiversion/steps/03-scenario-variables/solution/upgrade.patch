+        {
+            // Lane change action
+            EXPECT_NEAR(se->entities_.object_[0]->pos_.GetVelY(), -1.0116, 1e-4);
+        }
+        else if (time > 7.2)
+        {
+            ASSERT_NEAR(se->entities_.object_[0]->pos_.GetVelY(), 0.0, 1e-4);
+        }
+    }
+
+    delete se;
+}
