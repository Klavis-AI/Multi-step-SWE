+    EXPECT_EQ(is_within, true);
+    EXPECT_NEAR(s_norm, 0.75, 1e-3);
+
+    point_to_test = { -5, -1.1 };
+    ProjectPointOnVector2D(
+        point_to_test.x(), point_to_test.y(),
+        line_v0.x(), line_v0.y(),
+        line_v1.x(), line_v1.y(),
+        projected_point[0], projected_point[1]);
+    is_within = PointInBetweenVectorEndpoints(
