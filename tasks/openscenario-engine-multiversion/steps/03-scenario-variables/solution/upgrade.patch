+        line_v1.x(), line_v1.y(), s_norm);
+    EXPECT_EQ(is_within, false);
+    EXPECT_NEAR(s_norm, 0.1, 1e-3);
+
+    point_to_test = { -5, 1.1 };
+    ProjectPointOnVector2D(
+        point_to_test.x(), point_to_test.y(),
+        line_v0.x(), line_v0.y(),
+        line_v1.x(), line_v1.y(),
