+        if (time > 1.1 + SMALL_NUMBER && time < 3.1 + SMALL_NUMBER)
+        {
+            // Lane change action
+            EXPECT_NEAR(se->entities_.object_[0]->pos_.GetVelY(), 1.535, 1e-3);
