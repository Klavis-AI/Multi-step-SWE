+
+    # Execute the parse_args() method
+    args = parser.parse_args()
+
+    # Read the dat file
+    data = np.genfromtxt(sys.argv[1], delimiter=',', names=True, dtype=None, encoding=None, autostrip=True)
+
+    rows = []
