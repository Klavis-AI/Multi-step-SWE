+    // may not work in other OpenSCENARIO compliant tools
+    {"sin", sin_, NULL, 0},
+    {"cos", cos_, NULL, 0},
+    {"tan", tan_, NULL, 0},
+    {"asin", asin_, NULL, 0},
+    {"acos", acos_, NULL, 0},
+    {"atan", atan_, NULL, 0},
+    {"sign", sign_, NULL, 0},
+    {"abs", abs_, NULL, 0},
+    {"max", max_, NULL, 0},
+    {"min", min_, NULL, 0},
     {NULL, NULL, NULL, 0},
 };
 
