<?xml version="1.0" encoding="UTF-8"?>
<!-- Verifier-owned scenario. Catalog-free: the single vehicle is declared
     inline and the road network is named by a relative path, so this file plus
     fabriksgatan.xodr next to it is the whole fixture.

     The Ego is parked (speed 0) on road 2, lane -1, 24 m short of the junction,
     and carries an inline route whose second waypoint is road 0, straight on through the junction. The route is the
     only thing that differs between the three junction_route_*.xosc fixtures;
     everything else, including the Ego's pose, is identical. Stop trigger at
     2 s so a headless run always terminates. -->
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="0" date="2026-01-01T00:00:00" description="taskgen fixture" author="taskgen"/>
    <ParameterDeclarations/>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="fabriksgatan.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="Ego">
            <Vehicle name="fixture_car" vehicleCategory="car">
                <ParameterDeclarations/>
                <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="5.0" height="1.5"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="2.98" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3"/>
                </Axles>
                <Properties/>
            </Vehicle>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="Ego">
                    <PrivateAction>
                        <RoutingAction>
                            <AssignRouteAction>
                                <Route name="FixtureRoute" closed="false">
                                    <ParameterDeclarations/>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="2" laneId="-1" offset="0" s="280"/></Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                        <Position><LanePosition roadId="0" laneId="-1" offset="0" s="20"/></Position>
                                    </Waypoint>
                                </Route>
                            </AssignRouteAction>
                        </RoutingAction>
                    </PrivateAction>
                    <PrivateAction>
                        <TeleportAction>
                            <Position><LanePosition roadId="2" laneId="-1" offset="0" s="280"/></Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                                <SpeedActionTarget><AbsoluteTargetSpeed value="0"/></SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="StoryboardStop" delay="0" conditionEdge="none">
                    <ByValueCondition><SimulationTimeCondition value="2" rule="greaterThan"/></ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
