<?xml version="1.0" encoding="UTF-8"?>
<!-- Verifier-owned scenario. Catalog-free: the vehicle and the controller are
     both declared inline and the road network is named by a relative path, so
     this file plus e6mini.xodr next to it is the whole fixture.

     The Ego carries a FollowGhostController, which makes esmini launch a ghost
     twin with a head start and record its path as a "ghost trail". The trail is
     sampled at an interval the `ghost_trail_dt` command-line option sets (spelled
     with two leading hyphens, which an XML comment cannot contain), so this fixture is
     the one that lets the runtime half of that option be observed.

     The ghost must not travel in a straight line at constant speed: a straight
     constant-speed trail is the SAME polyline however finely it is sampled, and
     the timestamps read back off it would then be identical for every sampling
     interval. So the ghost accelerates from a standstill and changes lane twice.
     Stop trigger at 12 s so a headless run always terminates. -->
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="0" date="2026-01-01T00:00:00" description="taskgen fixture" author="taskgen"/>
    <ParameterDeclarations/>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="e6mini.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="Ego">
            <Vehicle name="fixture_car" vehicleCategory="car">
                <ParameterDeclarations/>
                <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="5.0" height="1.5"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="2.98" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3"/>
                </Axles>
                <Properties/>
            </Vehicle>
            <ObjectController>
                <Controller name="followGhost">
                    <ParameterDeclarations/>
                    <Properties>
                        <Property name="esminiController" value="FollowGhostController"/>
                        <Property name="headstartTime" value="2.5"/>
                        <Property name="followMode" value="position"/>
                        <Property name="lookaheadSpeed" value="0.5"/>
                        <Property name="minLookaheadSpeed" value="7.0"/>
                        <Property name="lookaheadSteering" value="0.5"/>
                        <Property name="minLookaheadSteering" value="7.0"/>
                        <Property name="steeringSpeedInertia" value="0.02"/>
                    </Properties>
                </Controller>
            </ObjectController>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position><LanePosition roadId="0" laneId="-3" offset="0" s="50"/></Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                                <SpeedActionTarget><AbsoluteTargetSpeed value="0"/></SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                    <PrivateAction>
                        <ActivateControllerAction longitudinal="true" lateral="true"/>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="Story">
            <ParameterDeclarations/>
            <Act name="Act">
                <ManeuverGroup maximumExecutionCount="1" name="Sequence">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Ego"/>
                    </Actors>
                    <Maneuver name="Maneuver1">
                        <Event name="SpeedUp" priority="overwrite" maximumExecutionCount="1">
                            <Action name="SpeedChange">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="4" dynamicsDimension="time"/>
                                            <SpeedActionTarget><AbsoluteTargetSpeed value="27.78"/></SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="SpeedUpTrigger" delay="0" conditionEdge="none">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="story" storyboardElementRef="Story" state="runningState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                        <Event name="LaneChangeOut" priority="overwrite" maximumExecutionCount="1">
                            <Action name="LaneChangeAction1">
                                <PrivateAction>
                                    <LateralAction>
                                        <LaneChangeAction>
                                            <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="2" dynamicsDimension="time"/>
                                            <LaneChangeTarget><AbsoluteTargetLane value="-2"/></LaneChangeTarget>
                                        </LaneChangeAction>
                                    </LateralAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="LaneChangeTrigger1" delay="0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="3" rule="greaterThan"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                        <Event name="LaneChangeBack" priority="overwrite" maximumExecutionCount="1">
                            <Action name="LaneChangeAction2">
                                <PrivateAction>
                                    <LateralAction>
                                        <LaneChangeAction>
                                            <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="2" dynamicsDimension="time"/>
                                            <LaneChangeTarget><AbsoluteTargetLane value="-3"/></LaneChangeTarget>
                                        </LaneChangeAction>
                                    </LateralAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="LaneChangeTrigger2" delay="0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="6" rule="greaterThan"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="StoryboardStop" delay="0" conditionEdge="none">
                    <ByValueCondition><SimulationTimeCondition value="12" rule="greaterThan"/></ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
