+    EXPECT_NEAR(entities->object_[0]->pos_.GetP(), 5.3026, 1E-3);
+    EXPECT_NEAR(entities->object_[0]->pos_.GetR(), 0.7853, 1E-3);
+
+    // step simulation until bike is almost at top
+    while (se->getSimulationTime() < 9.0 + SMALL_NUMBER)
+    {
+        scenario_step(se, dt);
+    }
+
+    // Check pose
