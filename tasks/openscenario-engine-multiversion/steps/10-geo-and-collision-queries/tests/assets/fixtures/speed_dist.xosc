<?xml version="1.0" encoding="UTF-8"?>
<!-- Verifier-owned parameter-value distribution over speed_param.xosc.
     Three Ego speeds crossed with two Target positions: six permutations,
     each of which produces a different initial state. -->
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="1" date="2026-01-01T00:00:00" description="taskgen fixture" author="taskgen"/>
    <ParameterValueDistribution>
        <ScenarioFile filepath="speed_param.xosc"/>
        <Deterministic>
            <DeterministicSingleParameterDistribution parameterName="EgoSpeed">
                <DistributionSet>
                    <Element value="10.0"/>
                    <Element value="20.0"/>
                    <Element value="30.0"/>
                </DistributionSet>
            </DeterministicSingleParameterDistribution>
            <DeterministicSingleParameterDistribution parameterName="TargetS">
                <DistributionSet>
                    <Element value="100.0"/>
                    <Element value="200.0"/>
                </DistributionSet>
            </DeterministicSingleParameterDistribution>
        </Deterministic>
    </ParameterValueDistribution>
</OpenSCENARIO>
