<?xml version="1.0" encoding="UTF-8"?>
<!-- Verifier-owned scenario, deliberately catalog-free. Four identical
     vehicles parked on four different lanes of tri_lane_600m.xodr, one per
     neighbour configuration, so a single run can be asked the same question
     four times and must give four different answers:

       id 0  "LaneMinus1" on lane -1
       id 1  "LaneMinus2" on lane -2
       id 2  "LaneMinus3" on lane -3
       id 3  "LanePlus1"  on lane  1

     Everything is at standstill; the storyboard stops itself at 1 s so a
     headless run always terminates. -->
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="0" date="2026-01-01T00:00:00" description="taskgen fixture" author="taskgen"/>
    <ParameterDeclarations/>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="tri_lane_600m.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="LaneMinus1">
            <Vehicle name="fixture_car" vehicleCategory="car">
                <ParameterDeclarations/>
                <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="5.0" height="1.5"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="2.98" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3"/>
                </Axles>
                <Properties/>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="LaneMinus2">
            <Vehicle name="fixture_car" vehicleCategory="car">
                <ParameterDeclarations/>
                <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="5.0" height="1.5"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="2.98" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3"/>
                </Axles>
                <Properties/>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="LaneMinus3">
            <Vehicle name="fixture_car" vehicleCategory="car">
                <ParameterDeclarations/>
                <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="5.0" height="1.5"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="2.98" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3"/>
                </Axles>
                <Properties/>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="LanePlus1">
            <Vehicle name="fixture_car" vehicleCategory="car">
                <ParameterDeclarations/>
                <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="5.0" height="1.5"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="2.98" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3"/>
                </Axles>
                <Properties/>
            </Vehicle>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="LaneMinus1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position><LanePosition roadId="1" laneId="-1" offset="0" s="100"/></Position>
                        </TeleportAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="LaneMinus2">
                    <PrivateAction>
                        <TeleportAction>
                            <Position><LanePosition roadId="1" laneId="-2" offset="0" s="200"/></Position>
                        </TeleportAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="LaneMinus3">
                    <PrivateAction>
                        <TeleportAction>
                            <Position><LanePosition roadId="1" laneId="-3" offset="0" s="300"/></Position>
                        </TeleportAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="LanePlus1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position><LanePosition roadId="1" laneId="1" offset="0" s="400"/></Position>
                        </TeleportAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="Story">
            <Act name="Act">
                <ManeuverGroup maximumExecutionCount="1" name="Group">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="LaneMinus1"/>
                    </Actors>
                    <Maneuver name="Maneuver">
                        <Event name="NoopEvent" priority="overwrite">
                            <Action name="NoopAction">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                                            <SpeedActionTarget><AbsoluteTargetSpeed value="0"/></SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="Start" delay="0" conditionEdge="none">
                                        <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="ActStart" delay="0" conditionEdge="none">
                            <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition name="ActStop" delay="0" conditionEdge="none">
                            <ByValueCondition><SimulationTimeCondition value="1" rule="greaterThan"/></ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="StoryboardStop" delay="0" conditionEdge="none">
                    <ByValueCondition><SimulationTimeCondition value="1" rule="greaterThan"/></ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
