+      <Init>
+         <Actions>
+            <Private entityRef="Ego">
+               <PrivateAction>
+                  <TeleportAction>
+                     <Position>
+                        <LanePosition roadId="1" laneId="-1" offset="0.0" s="30.0"/>
+                     </Position>
+                  </TeleportAction>
+               </PrivateAction>
+            </Private>
+            <Private entityRef="Target">
+               <PrivateAction>
+                  <TeleportAction>
+                     <Position>
+                        <LanePosition roadId="1" laneId="1" offset="0.0" s="60.0"/>
+                     </Position>
+                  </TeleportAction>
+               </PrivateAction>
+            </Private>
+         </Actions>
+      </Init>
+      <Story name="MyStory">
+         <Act name="MyAct">
+            <ManeuverGroup maximumExecutionCount="1000" name="EgoManeuverGroup">
+                <Actors
+                  selectTriggeringEntities="true">
+                  <EntityRef entityRef="Ego" />
+               </Actors>
+               <CatalogReference
+                  catalogName="LightStateManeuvers" entryName="LightsOnWhenDrivingManeuver">
