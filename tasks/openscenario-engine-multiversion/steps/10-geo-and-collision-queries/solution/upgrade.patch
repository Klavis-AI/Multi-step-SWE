+                  <ParameterAssignments>
+                     <ParameterAssignment parameterRef="EntityName" value="Target" />
+                  </ParameterAssignments>
+               </CatalogReference>
+               <Maneuver
+                  name="TargetManeuver">
+                  <Event name="AccelerateEvent" priority="override">
+                     <Action name="Accelerate">
+                        <PrivateAction>
+                           <LongitudinalAction>
+                              <SpeedAction>
+                                 <SpeedActionDynamics dynamicsDimension="rate"
+                                    dynamicsShape="linear" value="5" />
+                                 <SpeedActionTarget>
+                                    <AbsoluteTargetSpeed value="5" />
