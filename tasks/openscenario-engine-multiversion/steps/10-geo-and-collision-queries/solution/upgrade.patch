+                    se.space_length   = marking->space_length_;
+                    se.start_offset   = marking->start_offset_;
+                    se.stop_offset    = marking->stop_offset_;
+                    se.lateral_offset = marking->lateral_offset_;
+                    se.color          = marking->color_;
