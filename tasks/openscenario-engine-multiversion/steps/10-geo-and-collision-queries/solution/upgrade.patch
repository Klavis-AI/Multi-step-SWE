+@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap");
+
+:root {
+    --bg: #cadcee;
+    --panel: rgba(28, 29, 26, 0.88);
+    --panel-soft: rgba(42, 44, 38, 0.72);
+    --line: rgba(244, 236, 214, 0.18);
+    --text: #f3ecd8;
+    --muted: #c4bca7;
+    --accent: #efb95f;
+    --accent-strong: #f58f2b;
+    --danger: #e66b4c;
+    --success: #78c59a;
+    --shadow: 0 18px 48px rgba(17, 18, 16, 0.28);
+}
+
+* {
+    box-sizing: border-box;
+}
+
+html,
+body {
+    margin: 0;
+    min-height: 100%;
+    background:
+        radial-gradient(circle at top left, rgba(255, 255, 255, 0.42), transparent 28%),
+        linear-gradient(180deg, #e7eff8 0%, #d6e2ef 38%, #bfd0e2 100%);
+    color: var(--text);
+    font-family: "Space Grotesk", sans-serif;
+}
+
+body {
+    overflow: hidden;
+}
+
+.shell {
+    position: relative;
+    width: 100vw;
+    height: 100vh;
+}
+
+.help-toggle {
+    position: fixed;
+    right: 18px;
+    bottom: 18px;
+    z-index: 3;
+    width: 46px;
+    height: 46px;
+    display: grid;
+    place-items: center;
+    padding: 0;
+    border-radius: 999px;
+    color: var(--text);
+    font: 700 22px/1 "IBM Plex Mono", monospace;
+    cursor: pointer;
+}
+
+.help-toggle[aria-expanded="true"] {
+    background: rgba(239, 185, 95, 0.18);
+    border-color: rgba(239, 185, 95, 0.32);
+}
+
+.help-toggle.hidden {
+    display: none;
+}
+
+.console-toggle {
+    position: fixed;
+    left: 18px;
+    bottom: 18px;
+    z-index: 3;
+    width: 46px;
+    height: 46px;
+    display: grid;
+    place-items: center;
+    padding: 0;
+    border-radius: 999px;
+    color: var(--text);
+    font: 700 18px/1 "IBM Plex Mono", monospace;
+    cursor: pointer;
+}
+
+.console-toggle[aria-expanded="true"] {
+    background: rgba(239, 185, 95, 0.18);
+    border-color: rgba(239, 185, 95, 0.32);
+}
+
+.console-toggle.hidden {
+    display: none;
+}
+
+.chrome {
+    position: absolute;
+    top: 18px;
+    left: 18px;
+    pointer-events: none;
+    z-index: 2;
+}
+
+.panel {
+    pointer-events: auto;
+    background: linear-gradient(180deg, rgba(35, 37, 32, 0.92), rgba(20, 21, 19, 0.82));
+    border: 1px solid var(--line);
+    border-radius: 24px;
+    box-shadow: var(--shadow);
+    backdrop-filter: blur(18px);
+}
+
+.sidebar {
+    width: max-content;
+    max-width: min(296px, calc(100vw - 36px));
+    max-height: calc(100vh - 36px);
+    display: flex;
+    flex-direction: column;
+    padding: 18px;
+    gap: 14px;
+    overflow: auto;
+}
+
+.title-block {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+}
+
+.eyebrow {
+    display: inline-flex;
+    align-self: flex-start;
+    padding: 6px 10px;
+    border-radius: 999px;
+    background: rgba(239, 185, 95, 0.14);
+    color: var(--accent);
+    font-size: 12px;
+    letter-spacing: 0.14em;
+    text-transform: uppercase;
+}
+
+.title {
+    margin: 0;
+    font-size: clamp(24px, 2.2vw, 34px);
+    line-height: 0.96;
+    letter-spacing: -0.04em;
+}
+
+.subtitle {
+    margin: 0;
+    color: var(--muted);
+    font-size: 13px;
+    line-height: 1.4;
+}
+
+.toolbar,
+.stats,
+.legend,
+.info-section {
+    display: grid;
+    gap: 8px;
+}
+
+.toolbar-row {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 8px;
+    width: 100%;
+    max-width: 100%;
+    box-sizing: border-box;
+}
+
+.toolbar-stack {
+    flex-direction: column;
+    align-items: stretch;
+}
+
+.toolbar-stack > * {
+    width: 100%;
+    max-width: 100%;
+    box-sizing: border-box;
+}
+
+.playback-row > button {
+    flex: 1 1 0;
+    min-width: 0;
+    padding-inline: 18px;
+}
+
+.playback-row > select {
+    flex: 0 1 4.0rem;
+    min-width: 4.0rem;
+}
+
+.toolbar-note {
+    width: 100%;
+    max-width: 100%;
+    box-sizing: border-box;
+    color: var(--muted);
+    font-size: 12px;
+    line-height: 1.45;
+}
+
+.toolbar-note.hidden {
+    display: none;
+}
+
+.toggle-control {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    padding: 9px 12px;
+    border: 1px solid rgba(255, 255, 255, 0.12);
+    border-radius: 14px;
+    background: rgba(255, 255, 255, 0.04);
+    color: var(--text);
+    font: inherit;
+}
+
+.toggle-control input {
+    appearance: none;
+    position: relative;
+    width: 44px;
+    height: 24px;
+    margin: 0;
+    border-radius: 999px;
+    background: rgba(255, 255, 255, 0.14);
+    border: 1px solid rgba(255, 255, 255, 0.14);
+    cursor: pointer;
+    transition: background 160ms ease, border-color 160ms ease;
+}
+
+.toggle-control input::before {
+    content: "";
+    position: absolute;
+    top: 2px;
+    left: 2px;
+    width: 18px;
+    height: 18px;
+    border-radius: 999px;
+    background: var(--text);
+    transition: transform 160ms ease;
+}
+
+.toggle-control input:checked {
+    background: rgba(239, 185, 95, 0.34);
+    border-color: rgba(239, 185, 95, 0.4);
+}
+
+.toggle-control input:checked::before {
+    transform: translateX(20px);
+}
+
+.toggle-control input:focus-visible {
+    outline: 2px solid rgba(239, 185, 95, 0.7);
+    outline-offset: 2px;
+}
+
+button,
+select {
+    appearance: none;
+    border: 1px solid rgba(255, 255, 255, 0.12);
+    border-radius: 14px;
+    background: rgba(255, 255, 255, 0.06);
+    color: var(--text);
+    padding: 9px 12px;
+    font: inherit;
+}
+
+button {
+    cursor: pointer;
+    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
+}
+
+button:hover {
+    transform: translateY(-1px);
+    background: rgba(255, 255, 255, 0.1);
+    border-color: rgba(255, 255, 255, 0.22);
+}
+
+button:disabled,
+select:disabled {
+    cursor: not-allowed;
+    opacity: 0.6;
+}
+
+button.primary {
+    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
+    color: #231e18;
+    border-color: transparent;
+    font-weight: 700;
+}
+
+button.ghost {
+    background: rgba(255, 255, 255, 0.04);
+}
+
+.stat-grid {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 8px;
+}
+
+.stat-card {
+    padding: 12px;
+    border-radius: 18px;
+    background: var(--panel-soft);
+    border: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.stat-label {
+    display: block;
+    color: var(--muted);
+    font-size: 12px;
+    text-transform: uppercase;
+    letter-spacing: 0.08em;
+}
+
+.stat-value {
+    display: block;
+    margin-top: 4px;
+    font-family: "IBM Plex Mono", monospace;
+    font-size: 16px;
+}
+
+.legend-item,
+.status-row {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 10px;
+    padding: 9px 11px;
+    border-radius: 14px;
+    background: rgba(255, 255, 255, 0.04);
+}
+
+.toggle-control,
+.status-row {
+    width: 100%;
+    max-width: 100%;
+    box-sizing: border-box;
+}
+
+.legend-swatch {
+    width: 14px;
+    height: 14px;
+    border-radius: 999px;
+    margin-right: 10px;
+    flex: 0 0 auto;
+}
+
+.legend-label {
