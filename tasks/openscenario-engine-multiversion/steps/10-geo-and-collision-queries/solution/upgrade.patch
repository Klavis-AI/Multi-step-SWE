+                                    dynamicsShape="linear" value="5" />
+                                 <SpeedActionTarget>
+                                    <AbsoluteTargetSpeed value="-5" />
+                                 </SpeedActionTarget>
+                              </SpeedAction>
+                           </LongitudinalAction>
+                        </PrivateAction>
+                     </Action>
