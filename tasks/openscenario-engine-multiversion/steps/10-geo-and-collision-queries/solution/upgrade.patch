+                            v0 = -half_w;
+                            u1 = half_l;
+                            v1 = half_w;
+                            break;
+                        case roadmanager::ObjectMarking::Side::REAR:
+                            u0 = -half_l;
+                            v0 = -half_w;
+                            u1 = -half_l;
+                            v1 = half_w;
+                            break;
+                        case roadmanager::ObjectMarking::Side::LEFT:
+                            u0 = -half_l;
+                            v0 = half_w;
+                            u1 = half_l;
+                            v1 = half_w;
+                            break;
+                        case roadmanager::ObjectMarking::Side::RIGHT:
+                            u0 = -half_l;
+                            v0 = -half_w;
+                            u1 = half_l;
+                            v1 = -half_w;
