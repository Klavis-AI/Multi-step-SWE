+                                 <TriggeringEntities triggeringEntitiesRule="all">
+                                    <EntityRef entityRef="Ego" />
+                                 </TriggeringEntities>
+                                 <EntityCondition>
+                                    <SpeedCondition rule="lessThan" value="0.05"/>
+                                 </EntityCondition>
