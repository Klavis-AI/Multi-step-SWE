+
+    cond.cs_ = roadmanager::CoordinateSystem::CS_LANE;
+    obj.pos_.SetInertiaPos(50, 1.5, M_PI);
+    EXPECT_NEAR(obj.pos_.GetH(), M_PI, 1e-3);
