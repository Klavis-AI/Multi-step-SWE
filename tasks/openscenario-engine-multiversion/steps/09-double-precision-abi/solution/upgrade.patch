+
+    cond.value_ = 0.3;
+    cond.cs_    = roadmanager::CoordinateSystem::CS_ROAD;
+    obj.pos_.SetInertiaPos(50, -1.5, 0.321);
+    EXPECT_EQ(cond.Evaluate(0.0), false);
+    obj.pos_.SetInertiaPos(50, -1.5, 0.320);
+    EXPECT_EQ(cond.Evaluate(0.0), true);
+
+    cond.value_ = -0.3;
+    cond.cs_    = roadmanager::CoordinateSystem::CS_ROAD;
+    obj.pos_.SetInertiaPos(50, -1.5, -0.321);
+    EXPECT_EQ(cond.Evaluate(0.0), false);
+    obj.pos_.SetInertiaPos(50, -1.5, -0.320);
