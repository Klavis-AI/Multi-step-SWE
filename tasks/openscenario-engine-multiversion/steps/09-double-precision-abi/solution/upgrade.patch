+void ScenarioEngine::SwapAndClearDirtyBits()
+{
+    for (auto& obj : entities_.object_)
+    {
+        // reset update bits and indicators of applied control
+        obj->dirty_.SwapAndClear();
+    }
+}
+
+void ScenarioEngine::ClearDirtyBits()
+{
+    for (auto& obj : entities_.object_)
+    {
+        // reset update bits and indicators of applied control
+        obj->dirty_.Clear();
+    }
+}
