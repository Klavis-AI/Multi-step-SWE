+name: Setup tools shared
+description: Setup platform tools
+
+runs:
+  using: 'composite'
+
+  steps:
+    - if: runner.os == 'Linux'
+      shell: bash
+      run: sudo apt-get update -q
+        && sudo apt-get install -q -y gcc-7 g++-7
+        && sudo update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-7 200
+        && sudo update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-7 200
+
+    - uses: actions/setup-python@v4.5.0
+      with:
+        python-version: '3.8'
+        cache: 'pip'
+    - run: pip install -r support/python/requirements.txt
+      shell: bash
+
+    - uses: seanmiddleditch/gha-setup-ninja@v3
+
+    - uses: jwlawson/actions-setup-cmake@v1.13.1
+      if: runner.os != 'macOS'
+
+    - name: Setup VS Dev Environment - Windows
+      if: runner.os == 'Windows'
+      uses: seanmiddleditch/gha-setup-vsdevenv@v4
+
+    - name: Install OSG dependencies - Ubuntu
+      if: runner.os == 'Linux'
+      shell: bash
+      run: sudo apt-get install -y -q libx11-dev libxrandr-dev libxinerama-dev libgl1-mesa-dev libegl1-mesa-dev
+        && sudo apt-get install -y -q libglu1-mesa-dev xorg-dev mesa-utils
+
+    - name: Install Mesa3D - Windows
+      if: runner.os == 'Windows'
+      uses: ssciwr/setup-mesa-dist-win@v1
+      with:
+        version: '22.3.5'
+
+    - name: Install wglinfo - Windows
+      if: runner.os == 'Windows'
+      shell: cmd
+      run: curl.exe -L --output wglinfo64.exe --url https://github.com/gkv311/wglinfo/releases/download/22_03/wglinfo64.exe
+
+    - name: Output glxinfo - Ubuntu
+      uses: GabrielBB/xvfb-action@v1.6
+      if: runner.os == 'Linux'
+      with:
+        run: glxinfo
+
+    - name: Output wglinfo - Windows
+      if: runner.os == 'Windows'
+      shell: cmd
+      env:
+        GALLIUM_DRIVER: llvmpipe
+      run: wglinfo64
diff --git a/trees/v2.31.10/.github/actions/upload_esmini_artifacts/action.yml b/trees/v2.31.10/.github/actions/upload_esmini_artifacts/action.yml
new file mode 100644
index 0000000..5796c8e
--- /dev/null
+++ b/trees/v2.31.10/.github/actions/upload_esmini_artifacts/action.yml
@@ -0,0 +1,64 @@
+name: Upload esmini artifacts
+description: Upload esmini artifacts
+
+runs:
+  using: 'composite'
+
+  steps:
+    - name: Bundle Release artifacts - MacOS
+      if: runner.os == 'macOS'
+      shell: bash
+      run: lipo -create bin/libesminiRMLib.dylib -output bin/esminiRMLib.bundle
+        && lipo -create bin/libesminiLib.dylib -output bin/esminiLib.bundle
+
+    - name: Copy Release artifacts to esmini prefix folder structure
+      shell: bash
+      run: >
+        mkdir esmini &&
+        tar -c -p
+        bin/
+        EnvironmentSimulator/Applications/odrplot/xodr.py
+        EnvironmentSimulator/Libraries/esminiRMLib/esminiRMLib.hpp
+        EnvironmentSimulator/Libraries/esminiRMLib/esminiRMWrapper.cs
+        EnvironmentSimulator/Libraries/esminiRMLib/esminiRMUnityUtil.cs
+        EnvironmentSimulator/Libraries/esminiLib/esminiLib.hpp
+        EnvironmentSimulator/Libraries/esminiLib/ESMiniWrapper.cs
+        version.txt
+        | tar -p -C esmini -x
+
+    - name: Make scripts and binaries runnable for Release - Unix
+      if: runner.os == 'macOS' || runner.os == 'Linux'
+      shell: bash
+      run: sudo chmod -R +x ./esmini/bin/
+
+    - name: Archive release binaries
+      shell: bash
+      run: 7z a esmini-bin_${{ runner.os }}.zip esmini/*
+
+    - name: Upload release artifact
+      uses: actions/upload-artifact@v3.1.2
+      with:
+        name: esmini-bin_${{ runner.os }}
+        path: esmini-bin_${{ runner.os }}.zip
+
+    - name: Copy demo artifacts to esmini prefix folder structure
+      shell: bash
+      run: >
+        ./scripts/generate_binary_dist.sh
+
+    - name: Make scripts and binaries runnable for Demo - Unix
+      if: runner.os == 'macOS' || runner.os == 'Linux'
+      shell: bash
+      run: sudo chmod -R +x ./esmini-demo/run/
+        && sudo chmod -R +x ./esmini-demo/scripts/
+        && sudo chmod -R +x ./esmini-demo/bin/
+
+    - name: Archive demo binaries
+      shell: bash
+      run: 7z a esmini-demo_${{ runner.os }}.zip esmini-demo/*
+
+    - name: Upload demo artifact
+      uses: actions/upload-artifact@v3.1.2
+      with:
+        name: esmini-demo_${{ runner.os }}
+        path: esmini-demo_${{ runner.os }}.zip
diff --git a/trees/v2.31.10/.github/workflows/ci.yml b/trees/v2.31.10/.github/workflows/ci.yml
