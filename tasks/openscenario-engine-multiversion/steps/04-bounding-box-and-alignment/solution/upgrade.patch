+                                    // Add lane links - assume only one lane section in the connecting road
+                                    LaneSection* ls = newConnection->GetConnectingRoad()->GetLaneSectionByIdx(0);
+                                    for (int l = 0; l < ls->GetNumberOfLanes(); l++)
