diff --git a/trees/v2.31.10/EnvironmentSimulator/code-examples/CMakeLists.txt b/trees/v2.31.10/EnvironmentSimulator/code-examples/CMakeLists.txt
new file mode 100644
index 0000000..d02473d
--- /dev/null
+++ b/trees/v2.31.10/EnvironmentSimulator/code-examples/CMakeLists.txt
@@ -0,0 +1,43 @@
+# ############################### Getting code-examples ################################################################
+
+get_subdirectories(
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    subdirectories)
+
+if(NOT
+   USE_OSI)
+    list(
+        REMOVE_ITEM
+        subdirectories
+        "osi-groundtruth")
+    list(
+        REMOVE_ITEM
+        subdirectories
+        "osi-groundtruth-dyn")
+endif()
+
+# ############################### Building code-examples ###############################################################
+
+foreach(
+    subdir
+    ${subdirectories})
+    if(NOT
+       ${subdir}
+       STREQUAL
+       "trig_lane_change"
+       AND NOT
+           ${subdir}
+           STREQUAL
+           "osi-groundtruth-cs")
+        add_subdirectory(${subdir})
+        if(NOT
+           ${subdir}
+           STREQUAL
+           "hello_world")
+            # Add all code examples to the same folder
+            set_folder(
+                ${subdir}
+                ${CodeExamplesFolder})
+        endif()
+    endif()
+endforeach()
