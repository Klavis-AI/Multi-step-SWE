+            //   case 1
+            //     v1 = 2 * s / t - v2
+            //     a = (v2 - v1) / t
+            //
+            //   case 2 (a & b)
+            //      system:
+            //        s1 = v1 * x + (vx - v1) * x / 2
+            //        s2 = v2 * y + (vx - v2) * y / 2
+            //        t = x + y
+            //        s = s1 + s2
+            // 		  (vx - v1) / x = (vx - v2) / y
+            //
+            //      solve for x and vx
+            //      a = (vx - v1) / x
+            //
+            //   case 3
+            //      system:
+            //        s1 = x * v1 / 2
+            //        s2 = y * v2 / 2
+            //        s = s1 + s2
+            //        v1 / v2 = x / y
+            //
+            //      solve for x
+            //      a = -v1 / x
