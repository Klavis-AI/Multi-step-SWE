diff --git a/trees/v2.31.10/support/cmake/utils/get_subdirectories.cmake b/trees/v2.31.10/support/cmake/utils/get_subdirectories.cmake
new file mode 100644
index 0000000..d5c4f17
--- /dev/null
+++ b/trees/v2.31.10/support/cmake/utils/get_subdirectories.cmake
@@ -0,0 +1,38 @@
+include_guard()
+
+# ############################### Getting sub-directories from given path ###########################################
+
+macro(
+    get_subdirectories
+    path
+    subdirectories)
+
+    file(
+        GLOB
+        children
+        RELATIVE ${path}
+        ${path}/*)
+
+    set(dirlist
+        "")
+
+    foreach(
+        child
+        ${children})
+
+        if(IS_DIRECTORY
+           ${path}/${child})
+
+            list(
+                APPEND
+                dirlist
+                ${child})
+
+        endif()
+
+    endforeach()
+
+    set(${subdirectories}
+        ${dirlist})
+
+endmacro()
