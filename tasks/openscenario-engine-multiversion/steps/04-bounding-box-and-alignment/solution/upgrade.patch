+    RM_DLL_API int RM_CreatePosition()
+    {
+        if (odrManager == nullptr)
+        {
+            return -1;
+        }
+
+        roadmanager::Position newPosition;
+        position.push_back(newPosition);
+        return static_cast<int>((position.size() - 1));  // return index of newly created
+    }
