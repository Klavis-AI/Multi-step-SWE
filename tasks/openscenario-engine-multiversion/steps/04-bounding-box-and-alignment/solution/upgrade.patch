+            // Calculate both solutions from the quadratic equation
+            double vx = 0;
+            if (fabs(v1 - v0) < SMALL_NUMBER)
+            {
+                // When v0 == v1, x is simply t/2
+                // s = (T / 2) * v_cur + (T / 2) * vx -> vx = (s - (T / 2) * v_cur) / (T / 2)
