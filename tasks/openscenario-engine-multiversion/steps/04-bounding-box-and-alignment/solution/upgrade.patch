+                    osg::ref_ptr<osg::Geode> geode = new osg::Geode;
+                    geode->addDrawable(geom.get());
+
+                    // osgUtil::Optimizer optimizer;
+                    // optimizer.optimize(geode);
+
+                    root_->addChild(geode);
+                }
+                AddRoadMarks(lane, root_);
+            }
+        }
+    }
