+        // no speed limit defined, set something with regards to number of lanes
+        if (object_->pos_.GetRoadById(object_->pos_.GetTrackId())
+                ->GetNumberOfDrivingLanesSide(object_->pos_.GetS(), SIGN(object_->pos_.GetLaneId())) > 1)
+        {
+            speed_limit = 110 / 3.6;
+        }
+        else
+        {
+            speed_limit = 60 / 3.6;
+        }
+    }
