+                 bb_z,
+                 bb_length,
+                 bb_width,
+                 bb_height,
+                 posX,
+                 posY,
+                 posZ,
+                 velX,
+                 velY,
+                 velZ,
+                 accX,
+                 accY,
+                 accZ,
+                 distance_road,
+                 distance_lanem,
+                 lane_id,
+                 lane_offset,
+                 heading,
+                 heading_rate,
+                 heading_angle,
