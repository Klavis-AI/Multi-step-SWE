+                                            int to_id   = lane->GetLink(newLinkType)->GetId();
+                                            newConnection->AddJunctionLaneLink(to_id, from_id);
+                                        }
+                                    }
+                                    if (newConnection->GetNumberOfLaneLinks() > 0)
