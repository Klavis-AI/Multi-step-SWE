+    RM_DLL_API int RM_DeletePosition(int handle)
+    {
+        if (odrManager == nullptr)
+        {
+            return -1;
+        }
+
+        if (handle == -1)
+        {
+            // Delete all items
+            position.clear();
+        }
+        else if (handle >= 0 && handle < static_cast<int>(position.size()))
+        {
+            // Delete specific item
+            position.erase(position.begin() + handle);
+        }
+        else
+        {
+            return -1;
+        }
+
+        return 0;
+    }
