+                        obj->trail_.AddVertex({0.0,
+                                               obj->pos_.GetX(),
+                                               obj->pos_.GetY(),
+                                               obj->pos_.GetZ(),
+                                               obj->pos_.GetH(),
+                                               simulationTime_,
+                                               obj->GetSpeed(),
+                                               0.0,
+                                               false});
+                    }
+                }
+            }
+        }
+
+        // Report updated pos values to the gateway
