+                osg::ref_ptr<osg::Vec2Array>        texcoordsLocal;
+                osg::ref_ptr<osg::DrawElementsUInt> indices;
+                int                                 vidxLocal = 0;
+                lane                                          = lsec->GetLaneByIdx(static_cast<int>(k));
