diff --git a/trees/v2.31.10/EnvironmentSimulator/Unittest/xosc/direction_dimension_demo.xosc b/trees/v2.31.10/EnvironmentSimulator/Unittest/xosc/direction_dimension_demo.xosc
new file mode 100644
