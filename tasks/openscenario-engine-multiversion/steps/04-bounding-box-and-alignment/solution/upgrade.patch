+                        (*verticesLocal)[static_cast<unsigned int>(vidxLocal)]  = (*verticesAll)[k * geom_point_list.size() + l];
+                        (*texcoordsLocal)[static_cast<unsigned int>(vidxLocal)] = (*texcoordsAll)[k * geom_point_list.size() + l];
