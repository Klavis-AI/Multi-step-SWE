+                                                              1.1 * OSI_POINT_CALC_STEPSIZE,
+                                                              SE_Env::Inst().GetOSIMaxLongitudinalDistance(),
+                                                              OSI_POINT_DIST_SCALE,
+                                                              OSI_POINT_DIST_SCALE,
+                                                              osi_requirement);
+                    }
