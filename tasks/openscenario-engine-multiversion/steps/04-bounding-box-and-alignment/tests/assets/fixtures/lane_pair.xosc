<?xml version="1.0" encoding="UTF-8"?>
<!-- Verifier-owned scenario. Deliberately catalog-free: both vehicles are
     declared inline, so this file plus straight_500m.xodr next to it is the
     whole fixture. The two entities sit in OPPOSITE driving lanes (-1 and 1)
     of the same straight road and have DIFFERENT bounding boxes, so the
     longitudinal, lateral, lane-delta and opposite-direction components of an
     inter-object delta query are all non-trivial. Both are stationary; the
     stop trigger at 5 s bounds any run that plays it. -->
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="0" date="2026-01-01T00:00:00" description="taskgen fixture" author="taskgen"/>
    <ParameterDeclarations/>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="straight_500m.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="Ego">
            <Vehicle name="fixture_car" vehicleCategory="car">
                <ParameterDeclarations/>
                <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="5.0" height="1.5"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="2.98" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3"/>
                </Axles>
                <Properties/>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="Oncoming">
            <Vehicle name="fixture_truck" vehicleCategory="truck">
                <ParameterDeclarations/>
                <Performance maxSpeed="30" maxAcceleration="5" maxDeceleration="8"/>
                <BoundingBox>
                    <Center x="3.5" y="0.0" z="1.6"/>
                    <Dimensions width="2.5" length="9.0" height="3.2"/>
                </BoundingBox>
                <Axles>
                    <FrontAxle maxSteering="0.4" wheelDiameter="0.9" trackWidth="2.2" positionX="6.0" positionZ="0.45"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.9" trackWidth="2.2" positionX="0.0" positionZ="0.45"/>
                </Axles>
                <Properties/>
            </Vehicle>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-1" offset="0" s="50"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="Oncoming">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="1" offset="0" s="200"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="Story">
            <Act name="Act">
                <ManeuverGroup maximumExecutionCount="1" name="Group">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Ego"/>
                    </Actors>
                    <Maneuver name="Maneuver"/>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="ActStart" delay="0" conditionEdge="none">
                            <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition name="ActStop" delay="0" conditionEdge="none">
                            <ByValueCondition><SimulationTimeCondition value="5" rule="greaterThan"/></ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="StoryboardStop" delay="0" conditionEdge="none">
                    <ByValueCondition><SimulationTimeCondition value="5" rule="greaterThan"/></ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
