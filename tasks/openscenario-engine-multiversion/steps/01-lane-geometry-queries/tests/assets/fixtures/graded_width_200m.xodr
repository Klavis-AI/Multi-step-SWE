<?xml version="1.0" standalone="yes"?>
<!-- A 200 m straight road whose lane widths are genuine cubic polynomials in
     the lane section's own s offset, and which carries two lane sections so
     that the offset a <width> element is evaluated at is the section's, not
     the road's.

     laneSection 0 (road s = 0 .. 100), ds = s
         lane  1  driving  w(ds) = 3.5
         lane -1  driving  w(ds) = 3.0 + 1.0e-2 * ds
         lane -2  driving  w(ds) = 2.0 + 1.0e-4 * ds^2
     laneSection 1 (road s = 100 .. 200), ds = s - 100
         lane  1  driving  w(ds) = 3.5
         lane -1  driving  w(ds) = 5.0 - 2.0e-2 * ds
         lane -2  driving  w(ds) = 3.0 + 1.0e-6 * ds^3
-->
