+		obj_z = osi_gt.mutable_moving_object(0)->mutable_base()->mutable_position()->z();
+		EXPECT_NEAR(obj_x, x_vals[i], 1E-5);
+		EXPECT_NEAR(obj_y, -1.535, 1E-5);
+		EXPECT_NEAR(obj_z, 0.0, 1E-5);
+	}
+
+	fclose(file);
+}
