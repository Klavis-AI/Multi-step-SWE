+    {
+        if (strcmp(argv[i], "--help") == 0 || strcmp(argv[i], "-h") == 0)
+        {
+            opt.PrintUsage();
+#ifdef _USE_OSG
+            PrintOSGUsage();
+#endif  // _USE_OSG
