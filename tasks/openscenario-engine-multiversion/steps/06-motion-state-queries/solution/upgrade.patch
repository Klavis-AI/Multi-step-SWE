+        self.run_repeat(os.path.join(ESMINI_PATH, scenario), COMMON_ESMINI_ARGS + " --disable_controllers", 0.001, 0.10, 40 if args.runs < 0 else args.runs)
+
+    def test_perf_swarm(self):
