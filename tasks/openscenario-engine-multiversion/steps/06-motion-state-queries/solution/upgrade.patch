+                                            <LaneOffsetActionDynamics maxLateralAcc="0.3" dynamicsShape="cubic"/>
+                                            <LaneOffsetTarget>
+                                                <RelativeTargetLaneOffset value="-3.0" entityRef="host_Car"/>
