<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="0" date="2024-01-15" description="Three variables scenario" author="verifier"/>
  <VariableDeclarations>
    <VariableDeclaration name="firstVar" variableType="double" value="10.0"/>
    <VariableDeclaration name="secondVar" variableType="integer" value="5"/>
    <VariableDeclaration name="thirdVar" variableType="double" value="3.0"/>
  </VariableDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="curves_elevation.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Car">
      <Vehicle name="car" vehicleCategory="car">
        <BoundingBox><Center x="1.4" y="0.0" z="0.9"/><Dimensions width="2.0" height="1.8" length="5.0"/></BoundingBox>
        <Performance maxSpeed="69" maxAcceleration="10" maxDeceleration="10"/>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.8" trackWidth="1.68" positionX="0.0" positionZ="0.4"/>
        </Axles>
        <Properties/>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Car">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" offset="0" s="50"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="20"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Story">
      <Act name="Act">
        <ManeuverGroup maximumExecutionCount="1" name="Sequence">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Car"/>
          </Actors>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0" rule="greaterThan"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger>
          <ConditionGroup>
            <Condition name="ActStop" delay="0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition value="1.0" rule="greaterThan"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StopTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="Stop" delay="0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="1.0" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
