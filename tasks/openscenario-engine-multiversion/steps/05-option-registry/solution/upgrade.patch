+    <xs:simpleType name="e_laneAdvisory">
+        <xs:restriction base="xs:string">
+            <xs:enumeration value="both">
+                <xs:annotation>
+                    <xs:documentation>May be used by traffic from both adjacent lanes as an advisory lane. </xs:documentation>
