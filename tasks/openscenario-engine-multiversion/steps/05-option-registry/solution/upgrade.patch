+                                       <LanePosition roadId="1" laneId="-1" s="100.0">
+                                          <Orientation type="relative" r="0.0"/>
+                                       </LanePosition>
+                                    </Position>
+                                 </Vertex>
+                                 <Vertex time="2">
+                                    <Position>
+                                       <LanePosition roadId="1" laneId="-1" s="120.0">
+                                          <Orientation type="relative" r="0.0"/>
+                                       </LanePosition>
+                                    </Position>
+                                 </Vertex>
+                                 <Vertex time="2.5">
+                                    <Position>
+                                       <LanePosition roadId="1" laneId="-1" s="125.0">
+                                          <Orientation type="relative" r="1.5"/>
+                                       </LanePosition>
+                                    </Position>
+                                 </Vertex>
+                                 <Vertex time="3.5">
+                                    <Position>
+                                       <LanePosition roadId="1" laneId="-1" s="130.0">
+                                          <Orientation type="relative" r="1.5"/>
+                                       </LanePosition>
+                                    </Position>
+                                 </Vertex>
+                                 <Vertex time="4">
+                                    <Position>
+                                       <LanePosition roadId="1" laneId="-1" s="130.0">
+                                          <Orientation type="relative" r="1.5"/>
+                                       </LanePosition>
+                                    </Position>
+                                 </Vertex>
+                              </Polyline>
+                           </Shape>
+                        </Trajectory>
+                        <TimeReference>
+                           <Timing domainAbsoluteRelative="relative" offset="0" scale="1"/>
+                        </TimeReference>
+                        <TrajectoryFollowingMode followingMode="follow"/>
+                     </FollowTrajectoryAction>
+                  </RoutingAction>
+               </PrivateAction>
+            </Private>
+         </Actions>
+      </Init>
+      <StopTrigger>
+         <ConditionGroup>
+            <Condition name="StopTrigger" delay="0" conditionEdge="none">
+               <ByValueCondition>
+                  <SimulationTimeCondition value="6" rule="greaterThan"/>
+               </ByValueCondition>
+            </Condition>
+         </ConditionGroup>
+      </StopTrigger>
+   </Storyboard>
