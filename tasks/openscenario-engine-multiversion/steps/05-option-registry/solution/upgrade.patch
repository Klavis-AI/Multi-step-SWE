+  const std::string xosc_path =  fmi_xosc_path();
+  if (xosc_path.empty()) {
+    std::cerr << "No OpenScenario file selected!" << std::endl;
+    return fmi2Error;
+  }
+  if (SE_Init(xosc_path.c_str(), 0, fmi_use_viewer(), 0, 0) != 0)
