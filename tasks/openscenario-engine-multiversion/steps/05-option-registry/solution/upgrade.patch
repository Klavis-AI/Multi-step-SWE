+			<xs:documentation>Each &lt;platform&gt; element is valid on one or more track segments. The &lt;segment&gt; element must be specified.</xs:documentation>
+		</xs:annotation>
+		<xs:complexContent>
+			<xs:extension base="_OpenDriveElement">
+				<xs:sequence/>
+				<xs:attribute name="roadId" use="required" type="xs:string">
