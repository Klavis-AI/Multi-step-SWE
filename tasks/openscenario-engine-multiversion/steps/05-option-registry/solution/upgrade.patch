+
+    if (!value.empty())
+    {
+        if (!option->opt_arg_.empty())
+        {
+            if (!add)
+            {
+                option->arg_value_.clear();
+            }
+            option->arg_value_.push_back(value);
+        }
+        else
+        {
+            LOG_ERROR("Argument parser error: Missing option {} argument", opt);
+            return -1;
+        }
+    }
+
+    option->persistent_ = persistent;
+    option->set_        = true;
+
+    return 0;
+}
