-fmi2Status EsminiOsiSource::doInit()
-{
-  DEBUGBREAK();
-
-  /* Booleans */
-  for (int i = 0; i<FMI_BOOLEAN_VARS; i++)
-    boolean_vars[i] = fmi2False;
-
-  /* Integers */
-  for (int i = 0; i<FMI_INTEGER_VARS; i++)
-    integer_vars[i] = 0;
-
-  /* Reals */
-  for (int i = 0; i<FMI_REAL_VARS; i++)
-    real_vars[i] = 0.0;
-
-  /* Strings */
-  for (int i = 0; i<FMI_STRING_VARS; i++)
-    string_vars[i] = "";
-
-  return fmi2OK;
-}
