+                    <xs:element maxOccurs="1" minOccurs="0" name="explicit" type="t_road_lanes_laneSection_lcr_lane_roadMark_explicit"/>
+                    <xs:group maxOccurs="unbounded" minOccurs="0" ref="g_additionalData"/>
