+                    <xs:documentation>Lane used by trains only.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="bus">
+                <xs:annotation>
+                    <xs:documentation>Use &lt;access&gt; instead</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="taxi">
+                <xs:annotation>
+                    <xs:documentation>Use &lt;access&gt; instead</xs:documentation>
+                </xs:annotation>
