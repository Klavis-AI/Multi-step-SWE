+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="b" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>Polynom parameter b</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="c" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>Polynom parameter c</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="d" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>Polynom parameter d</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="s" use="required" type="t_grEqZero">
+					<xs:annotation>
+						<xs:documentation>s-coordinate of start position</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="t" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>t-coordinate of start position </xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+			</xs:extension>
+		</xs:complexContent>
+	</xs:complexType>
+	<xs:element name="t_road_lateralProfile_superelevation" type="t_road_lateralProfile_superelevation"/>
+	<xs:complexType name="t_road_lateralProfile_superelevation">
+		<xs:annotation>
+			<xs:documentation>Defined as the road section’s roll angle around the s-axis. Elements must be defined in ascending order along the reference line. The parameters of an element are valid until the next element starts or the road reference line ends. Per default, the superelevation of a road is zero.</xs:documentation>
+		</xs:annotation>
+		<xs:complexContent>
+			<xs:extension base="_OpenDriveElement">
+				<xs:sequence/>
+				<xs:attribute name="a" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>Polynom parameter a, superelevation at @s (ds=0)</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="b" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>Polynom parameter b</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="c" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>Polynom parameter c</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="d" use="required" type="xs:double">
+					<xs:annotation>
+						<xs:documentation>Polynom parameter d</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+				<xs:attribute name="s" use="required" type="t_grEqZero">
+					<xs:annotation>
+						<xs:documentation>s-coordinate of start position</xs:documentation>
+					</xs:annotation>
+				</xs:attribute>
+			</xs:extension>
+		</xs:complexContent>
+	</xs:complexType>
+	<xs:element name="t_road_link" type="t_road_link"/>
+	<xs:complexType name="t_road_link">
+		<xs:annotation>
+			<xs:documentation>Follows the road header if the road is linked to a successor or a predecessor. Isolated roads may omit this element.</xs:documentation>
+		</xs:annotation>
+		<xs:complexContent>
+			<xs:extension base="_OpenDriveElement">
+				<xs:sequence>
+					<xs:element name="predecessor" type="t_road_link_predecessorSuccessor" minOccurs="0" maxOccurs="1"/>
+					<xs:element name="successor" type="t_road_link_predecessorSuccessor" minOccurs="0" maxOccurs="1"/>
+					<xs:group ref="g_additionalData" minOccurs="0" maxOccurs="unbounded"/>
+				</xs:sequence>
+			</xs:extension>
+		</xs:complexContent>
+	</xs:complexType>
+	<xs:element name="t_road_link_predecessorSuccessor" type="t_road_link_predecessorSuccessor"/>
+	<xs:complexType name="t_road_link_predecessorSuccessor">
+		<xs:annotation>
+			<xs:documentation>Successors and predecessors can be junctions or roads. For each, different attribute sets shall be used.</xs:documentation>
+		</xs:annotation>
+		<xs:complexContent>
