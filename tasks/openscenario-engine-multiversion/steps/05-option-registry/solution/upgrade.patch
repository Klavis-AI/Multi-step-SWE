diff --git a/trees/v2.44.2/EnvironmentSimulator/Modules/ScenarioEngine/SourceFiles/OSITrafficCommand.cpp b/trees/v2.44.2/EnvironmentSimulator/Modules/ScenarioEngine/SourceFiles/OSITrafficCommand.cpp
