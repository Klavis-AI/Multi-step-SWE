+    if (lane_id == 0 || offset == 0)
+    {
+        return result;
+    }
+    else if (result == 0 || SIGN(result) != SIGN(lane_id))
+    {
+        result += 1 * SIGN(offset);  // skip reference lane
+    }
+
+    return result;
