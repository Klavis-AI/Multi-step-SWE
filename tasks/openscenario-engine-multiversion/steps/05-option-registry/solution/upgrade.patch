+			<xs:enumeration value="pedestrian"/>
+			<xs:enumeration value="bicycle"/>
+			<xs:enumeration value="townExpressway"/>
+			<xs:enumeration value="townCollector"/>
+			<xs:enumeration value="townArterial"/>
