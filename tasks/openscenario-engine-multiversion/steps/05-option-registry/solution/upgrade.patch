+            {
+                s += segment->length_;
+                segment = &segments_[i + 1];
+            }
+
+            if (i == segments_.size() - 1)
+            {
+                // at last segment, fetch global end time
+                time_end = GetEndTime();
+            }
+            else
+            {
+                // fetch end time of segment from next segment start timestamp
+                time_end = segments_[i + 1].time_;
