+    <xs:simpleType name="e_laneType">
+        <xs:annotation>
+            <xs:documentation>The lane type is defined per lane. A lane type defines the main purpose of a lane and its corresponding traffic rules.</xs:documentation>
+        </xs:annotation>
+        <xs:restriction base="xs:string">
+            <xs:enumeration value="shoulder">
+                <xs:annotation>
+                    <xs:documentation>Soft border at the edge of the road.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="border">
+                <xs:annotation>
+                    <xs:documentation>Hard border at the edge of the road. It has the same height as the adjacent drivable lane.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="driving">
+                <xs:annotation>
+                    <xs:documentation>Normal drivable road that is not one of the other types.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="stop">
+                <xs:annotation>
+                    <xs:documentation>Hard shoulder on motorways for emergency stops.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="none">
+                <xs:annotation>
+                    <xs:documentation>Space on the outermost edge of the road. A none lane does not have actual content. Its only purpose is for applications to register that ASAM OpenDRIVE is still present in case the (human) driver leaves the road.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="restricted">
+                <xs:annotation>
+                    <xs:documentation>Lane on which cars should not drive. The lane has the same height as drivable lanes. Typically, the lane is separated with lines and often contains dotted lines as well.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="parking">
+                <xs:annotation>
+                    <xs:documentation>Lane with parking spaces.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="median">
+                <xs:annotation>
+                    <xs:documentation>Lane that sits between driving lanes that lead in opposite directions. It is typically used to separate traffic in towns on large roads.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="biking">
+                <xs:annotation>
+                    <xs:documentation>Lane that is reserved for cyclists.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="shared">
+                <xs:annotation>
+                    <xs:documentation>Shared by all traffic participants.
+For shared walking/biking lanes use &lt;access&gt;.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="sidewalk">
+                <xs:annotation>
+                    <xs:documentation>Use walking instead</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="curb">
+                <xs:annotation>
+                    <xs:documentation>Curb at the edge of the road. Curb stones have a different height than the adjacent drivable lanes.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="exit">
+                <xs:annotation>
+                    <xs:documentation>Lane that is used for sections that are parallel to the main road and lead to an exit from the main road. It is mainly used for deceleration lanes.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="entry">
+                <xs:annotation>
+                    <xs:documentation>Lane that is used for sections that are parallel to the main road and merge into the main road. It is mainly used for acceleration lanes.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="onRamp">
+                <xs:annotation>
+                    <xs:documentation>Ramp leading to a motorway from rural or urban roads.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="offRamp">
+                <xs:annotation>
+                    <xs:documentation>Ramp leading away from a motorway and onto rural urban roads.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="connectingRamp">
+                <xs:annotation>
+                    <xs:documentation>Ramp that connects two motorways, for example, motorway junctions.</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="bidirectional">
+                <xs:annotation>
+                    <xs:documentation>This lane type has two use cases:
+a) only driving lane on a narrow road which may be used in both directions;
+b) continuous two-way left turn lane on multi-lane roads – US road networks
+Use @direction instead</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="special1">
+                <xs:annotation>
+                    <xs:documentation>deprecated</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="special2">
+                <xs:annotation>
+                    <xs:documentation>deprecated</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="special3">
+                <xs:annotation>
+                    <xs:documentation>deprecated</xs:documentation>
+                </xs:annotation>
+            </xs:enumeration>
+            <xs:enumeration value="roadWorks"/>
+            <xs:enumeration value="tram">
+                <xs:annotation>
+                    <xs:documentation>Lane used by trams only.</xs:documentation>
+                </xs:annotation>
