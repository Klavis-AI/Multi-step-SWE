+                    <xs:element maxOccurs="unbounded" minOccurs="0" name="successor" type="t_road_lanes_laneSection_lcr_lane_link_predecessorSuccessor"/>
+                    <xs:group maxOccurs="unbounded" minOccurs="0" ref="g_additionalData"/>
+                </xs:sequence>
+            </xs:extension>
