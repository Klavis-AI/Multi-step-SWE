+        std::optional<Fog>           fog_;
+        std::optional<Precipitation> precipitation_;
+        std::optional<Wind>          wind_;
+        std::optional<RoadCondition> roadcondition_;
+        bool                         isEnvironmentUpdatedInViewer_ = false;
+    };
+
+}  // namespace scenarioengine
