     velAngleRelVehicleLongAxis_ = atan(0.15 * tan(wheelAngle_));  // Origo is between rear wheel axles on ground level, estimated 15% along X axis
     velAngle_                   = velAngleRelVehicleLongAxis_ + heading_;
