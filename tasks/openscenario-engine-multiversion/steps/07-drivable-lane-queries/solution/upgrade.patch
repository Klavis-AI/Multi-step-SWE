+
+    class VehiclePool
+    {
+    public:
+        VehiclePool() = default;
+        VehiclePool(ScenarioReader* reader, const std::vector<std::pair<int, double>>* categories, bool accept_cars_with_trailer);
+        ~VehiclePool();
+
