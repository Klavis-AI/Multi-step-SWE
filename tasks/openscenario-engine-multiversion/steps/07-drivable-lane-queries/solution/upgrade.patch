-                if "docs" in child_sub_dict:
-                    doc = child_sub_dict["docs"]
-                attributes = child.attrib
-                if len(attributes) > 1:
-                    attributes["type"] = self.xsd_to_cpp_types(attributes["type"])
-                attributes.update({"docs": doc})
