+{
+    if (!throttle_disabled_)
+    {
+        speed_ += acceleration * dt;
+        speed_ = CLAMP(speed_, -max_speed_, max_speed_);
+    }
+    if (!steering_disabled_)
+    {
+        wheelAngle_ = steering_angle;
+        wheelAngle_ = CLAMP(wheelAngle_, -MAX_WHEEL_ANGLE, MAX_WHEEL_ANGLE);
+    }
+    Update(dt);
