@@ -0,0 +1,60 @@
+name: MemoryLeak
+
+on:
+  schedule:
+    # This will run the memory leak check job Nightly at 1AM every day for the dev branch
+    # * is a special character in YAML so you have to quote this string
+    - cron: '0 1 * * *'
+
+  workflow_dispatch:
+
+jobs:
+  memoryleak:
+    strategy:
+      matrix:
+        configuration: [RelWithDebInfo]
+        os: [ubuntu-22.04]
+
+    runs-on: ${{ matrix.os }}
+
+    steps:
+      - uses: actions/checkout@v4.1.7
+        with:
+          ref: ${{ github.event.ref }}
+          submodules: true
+          fetch-depth: 0  # Fetch all history for proper branch switching
+      
+      - name: Install valgrind
+        run: |
+          sudo apt update
+          sudo apt install -y valgrind
+
+      - name: Conditional Checkout
+        run: |
+          if [ "${{ github.ref }}" == "refs/heads/master" ]; then
+            git checkout dev
+          fi
+
+      - uses: ./.github/actions/setup_tools_shared
+
+      - name: Cache
+        uses: actions/cache@v4
+        with:
+          path: |
+            externals/googletest
+            externals/osg
+            externals/osi
+            externals/sumo
+            resources/models
+          key: ${{ runner.os }}-external-resources
+
+      - name: CMake Configure - Ubuntu
+        if: runner.os == 'Linux'
+        run: cmake -B build -DCMAKE_BUILD_TYPE:STRING=${{ matrix.configuration }}
+
+      - name: CMake Build
+        run: cmake --build build --config ${{ matrix.configuration }} --target install -j 2
+
+      - name: Run Tests
+        # Use xvfb on Linux and extend timeout allowing for slow execution
+        run: ${{ matrix.os == 'ubuntu-22.04' && 'xvfb-run' || '' }} ./scripts/run_memory_leak_tests.sh
diff --git a/trees/v2.51.1/.github/workflows/wrapper_check.yml b/trees/v2.51.1/.github/workflows/wrapper_check.yml
new file mode 100644
index 0000000..b2503ad
--- /dev/null
+++ b/trees/v2.51.1/.github/workflows/wrapper_check.yml
@@ -0,0 +1,62 @@
+name: WrapperCheck
+
+on:
+  schedule:
+    # This will run the wrapper check job Nightly at 2AM every day for the dev branch
+    # * is a special character in YAML so you have to quote this string
+    - cron: '0 2 * * *'
+
+  workflow_dispatch:
+
+jobs:
+  wrapper_check:
+    runs-on: windows-2022
+    steps:
+
+    - name: Checkout
+      uses: actions/checkout@v4.1.7
+      with:
+        ref: ${{ github.event.ref }}
+        submodules: false
+        fetch-depth: 1  # shallow checkout
+
+    - name: Conditional checkout dev if master
+      shell: bash
+      run: |
+        if [ "${{ github.ref }}" == "refs/heads/master" ]; then
+          git fetch origin dev
+          git checkout dev
+        fi
+
+    - name: Build wrapper
+      run: |
+        cd EnvironmentSimulator/Libraries/esminiRMLib/CSWrapperGenerator
+        dotnet build --configuration Release
+
+    - name: Generate wrapper
+      run: |
+        cd EnvironmentSimulator/Libraries/esminiRMLib/CSWrapperGenerator
+        ./bin/Release/net8.0/win-x64/Cpp2CSWrapperCreator.exe ../esminiRMLib.hpp esminiRMWrapper.cs
+
+    - name: Upload generated wrapper
+      uses: actions/upload-artifact@v4.3.6
+      with:
+        name: esminiRMWrapper
+        path: EnvironmentSimulator/Libraries/esminiRMLib/CSWrapperGenerator/esminiRMWrapper.cs
+
+    - name: Check
+      # Check that generated wrapper is identical to the checked in one
+      shell: bash
+      run: |
+        cd EnvironmentSimulator/Libraries/esminiRMLib/CSWrapperGenerator
+        diff ../esminiRMWrapper.cs esminiRMWrapper.cs
+
+    - name: What to do
+      if: ${{ failure() }}
+      run: |
+        echo "Warning::If this job fails, check the diff output above."
+        echo "The wrapper needs to be regenerated and committed"
+        echo "On Windows, run from CSWrapperGenerator:"
+        echo "dotnet build --configuration Release"
+        echo ".\bin\Release\net8.0\win-x64\Cpp2CSWrapperCreator.exe ./esminiRMLib.hpp ../esminiRMWrapper.cs"
+        echo "Alternatively, use the generated one in the 'Upload generated wrapper' job"
