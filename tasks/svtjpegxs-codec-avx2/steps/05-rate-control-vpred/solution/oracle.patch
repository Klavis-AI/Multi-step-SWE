+    __m128i n1 = _mm_add_epi16(x, max_avx2);
+    //    }
+    //    else {
+    //        x = x * 2;
+    x = _mm_slli_epi16(x, 1);
+    //        if (x < 0) {
+    const __m128i cmp2 = _mm_cmpgt_epi16(_mm_setzero_si128(), x);
+    //            n = -x - 1;
