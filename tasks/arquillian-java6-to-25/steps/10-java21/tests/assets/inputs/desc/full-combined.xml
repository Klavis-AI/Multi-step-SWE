<?xml version="1.0" encoding="UTF-8"?>
<arquillian>
   <engine>
      <property name="deploymentExportPath">target/deployments</property>
      <property name="maxTestClassesBeforeRestart">7</property>
   </engine>
   <defaultProtocol type="Servlet 3.0"/>
   <container qualifier="remote" default="true">
      <configuration>
         <property name="managementPort">9999</property>
      </configuration>
      <protocol type="Servlet 3.0">
         <property name="port">8080</property>
      </protocol>
      <dependencies>
         <dependency>org.a:b:1</dependency>
      </dependencies>
   </container>
   <group qualifier="cluster">
      <container qualifier="n1"/>
      <container qualifier="n2"/>
   </group>
   <extension qualifier="drone">
      <property name="t">1</property>
   </extension>
</arquillian>
