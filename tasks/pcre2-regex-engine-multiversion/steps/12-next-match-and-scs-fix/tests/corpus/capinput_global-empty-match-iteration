# pcre2test's repeated-match handling now follows pcre2_next_match(): after an
# empty match the next attempt sets PCRE2_NOTEMPTY_ATSTART alone, it is no
# longer also anchored, and pcre2test no longer advances the start offset
# itself -- in particular it no longer skips a CRLF pair.
# ChangeLog 10.47 item 11; pcre2api.3, "ITERATING OVER ALL MATCHES";
# pcre2test.1, "DEFAULT OUTPUT FROM pcre2test".

/\n|/g,newline=crlf
    \r\n

/\n|/g,newline=crlf
    x\r\ny

/\n|/g,newline=anycrlf
    \r\n

/\n|/g,newline=any
    \r\n

/\n|/g
    \r\n

/(\n)|/g,newline=crlf
    p\r\nq

/\r\n|/g,newline=crlf
    \r\n\r\n

# Ordinary empty-match iteration is unchanged.
/a*/g
    xaaxa

/\b/g,newline=crlf
    two words
