# pcre2test gains "#if CONDITION ... #endif" input commands.  The condition is
# any condition testable by -C that sets a boolean exit code, and may be
# negated with "!".  ChangeLog 10.47; pcre2test.1, "COMMAND LINES".

#if !ebcdic
/^\x{41}quay$/
    Aquay

#endif

#if ebcdic
/this-pattern-is-skipped-entirely/
    and so is this subject line

#endif

#if pcre2-8
/(quay)side/
    quayside

#endif

#if !pcre2-16
/skipped-because-the-16-bit-library-is-built/

#endif

#if backslash-C
/w\Cz/
    wxz

#endif

#if !ebcdic-nl25
/^harbour$/
    harbour

#endif
