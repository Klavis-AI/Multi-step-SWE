# pcre2_match() supports lookbehind branches of differing lengths.
# pcre2pattern.3, "Lookbehind assertions"; ChangeLog 10.43 item 24.

/(?<=harbou?r)side/
    harborside
 0: side
    harbourside
 0: side
    riverside
No match

# A negative variable-length lookbehind.
/(?<!gr[ae]?y)hound/
    greyhound
No match
    grayhound
No match
    ghound
 0: hound
    wolfhound
 0: hound

# Bounded repetition inside the assertion.
/(?<=\d{1,4}kg)\./
    load 7kg.
 0: .
    load 1250kg.
 0: .

# A subroutine call is allowed while the called group is length-limited.
/(?<=(?1)!)Z(?<t>ta?p)/
    tap!Ztap
 0: Ztap
 1: tap
    tp!Ztp
 0: Ztp
 1: tp
    xy!Ztap
No match

# A backreference of varying length inside the assertion.
/(?<x>fo?o)-(?<=\k<x>-)/
    foo-
 0: foo-
 1: foo
    fo-
 0: fo-
 1: fo

# A variable branch beside a fixed one.
/(?<=jib|mizz?en)sail/
    jibsail
 0: sail
    mizensail
 0: sail
    mizzensail
 0: sail
    mainsail
No match
