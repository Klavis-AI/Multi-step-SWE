# pcre2_dfa_match() still accepts only fixed-length lookbehind branches, so a
# pattern that compiles for pcre2_match() may be refused for DFA matching.
# pcre2pattern.3, "Lookbehind assertions".

/(?<=quays?)Z/
    quayZ
    quaysZ
    pierZ

/(?<=wharf)Z/
    wharfZ
    pierZ

/(?<=dock|jetty)Z/
    dockZ
    jettyZ

/(?<=\d{2,3}m)Z/
    45mZ
    450mZ
