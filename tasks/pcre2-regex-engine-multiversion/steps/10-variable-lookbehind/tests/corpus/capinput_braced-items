# {,m} is a quantifier meaning {0,m}; {,} remains a literal.  Space and
# horizontal tab are allowed inside the braces of numeric items.
# ChangeLog 10.43 items 29 and 30; pcre2pattern.3, "REPETITION";
# pcre2syntax.3, "QUANTIFIERS" and "BRACED ITEMS".

/^ker{,3}$/
    ke
    kerrr
    kerrrr

/^(?:mew){,2}!$/
    !
    mewmew!
    mewmewmew!

# {,} is not a quantifier.
/^pin{,}$/
    pin{,}
    pin
    pi

/^plum{,}?$/
    plum{,}?

# White space inside numeric braced items.
/^ker{ 2 , 4 }$/
    kerrr
    ker

/^ker{	3	}$/
    kerrr

/^\x{ 4b }it$/
    Kit

/^(?<tag>ab)\g{ 1 }$/
    abab

/^a{ ,2 }b$/
    b
    aab
