# PCRE2_SUBSTITUTE_LITERAL suppresses all interpretation of the replacement.
/(\w+)-(\w+)/
    ab-cd\=replace=<$2:$1>
 1: <cd:ab>
    ab-cd\=replace=<$2:$1>,substitute_literal
 1: <$2:$1>
    ab-cd\=replace=$1,substitute_literal,global
 1: $1

# PCRE2_SUBSTITUTE_REPLACEMENT_ONLY returns only the replacement text.
/(\w+)-(\w+)/
    ab-cd\=replace=<$0>,substitute_replacement_only
 1: <ab-cd>
    ab-cd ef-gh\=replace=<$2>,substitute_replacement_only,global
 2: <cd><gh>

/x/
    axbxc\=replace=Y,substitute_replacement_only,global
 2: YY

# PCRE2_SUBSTITUTE_MATCHED reuses a match data block already filled in by an
# external call to pcre2_match().
/(\w+)-(\w+)/
    ab-cd ef-gh\=replace=<$0>,global,substitute_matched
 2: <ab-cd> <ef-gh>
    ab-cd\=replace=<$2:$1>,substitute_matched
 1: <cd:ab>
