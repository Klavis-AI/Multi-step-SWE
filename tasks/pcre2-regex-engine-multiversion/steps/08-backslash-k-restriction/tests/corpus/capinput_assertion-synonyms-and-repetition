# (?* and (?<* are synonyms for (*napla: and (*naplb:.
/(?*\w*(\w))\1\w*$/
    abcd
    xyzx

/(?<*(\w\w)|(\w)(\w))\3/
    qzz

# The atomic forms still behave atomically.
/(?=\w*(\w))\1\w*$/
    abcd

# A non-atomic assertion containing (*ACCEPT) is treated as atomic.
/(?*\w*(\w)(*ACCEPT))\1\w*$/
    abcd

# A repeated assertion is no longer clamped to one repetition; the callouts
# count how many times the assertion is actually run.
/(?=(?C2)a|(?C3)b){2}b/
    ab

/(?!(?C4)z){3}a/
    a

/(?=(?C5)a){2,}b/
    ab
