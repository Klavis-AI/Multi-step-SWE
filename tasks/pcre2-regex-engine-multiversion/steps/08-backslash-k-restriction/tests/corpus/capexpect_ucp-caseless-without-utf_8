# With PCRE2_UCP but not PCRE2_UTF, Unicode properties are now used for the
# case computations of code points above 127 in the 8-bit library.
/\x{e9}/i,ucp
    \x{c9}
 0: \xc9
    \x{e9}
 0: \xe9

/\x{c0}/i,ucp
    \x{e0}
 0: \xe0

/[\x{e0}-\x{e5}]/i,ucp
    \x{c2}
 0: \xc2

# Without PCRE2_UCP the default tables still say these are unrelated.
/\x{e9}/i
    \x{c9}
No match

/[\x{e0}-\x{e5}]/i
    \x{c2}
No match
