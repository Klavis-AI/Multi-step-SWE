# An over-large number after a backslash is now an octal escape followed by
# literal digits, as in Perl, instead of an error.
/\214748364/
    \x8c748364

# A { that is not followed by a valid quantifier is a literal, so no
# "number too big" error arises.
/x{65536/
    x{65536

/x{65536}/
    xx

# A pattern ending in (?(VERSION=n.d is diagnosed, not read past.
/(?(VERSION=10.3/
    abc

# (?(DEFINE) groups are skipped when a lookbehind's length is computed, and a
# DEFINE group immediately before a lookbehind no longer breaks it.
/(?<=(?(DEFINE)(qrs))ab)c/
    abc
    zbc

/(?(DEFINE)(qrs))(?<=ab)c/
    abc

# The effect of \K now propagates back out of a whole-pattern recursion.
/p\K.(?0)*/
    pqpr
