# Script runs: the matched characters must all belong to one script.
# pcre2pattern.3, "SCRIPT RUNS"; pcre2unicode.3, "Basic script run rules".

/^(*script_run:\S+)$/utf
    manifest
    \x{0441}\x{043B}\x{043E}\x{0432}\x{043E}
    \x{03B4}\x{03BF}\x{03BA}\x{03B9}
    \x{0561}\x{0562}\x{0563}
    man\x{0456}fest
    \x{0441}lovo
    \x{03BF}\x{043E}
    \x{0561}\x{03B4}

# (*sr: is the documented synonym of (*script_run:
/^(*sr:\S+)$/utf
    manifest
    man\x{0456}fest
    \x{03BF}\x{043E}
