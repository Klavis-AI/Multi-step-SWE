# A capturing group containing a backreference to itself is no longer made
# atomic, so a later failure can backtrack into the middle of the group.
/^(aa|a\1)+z$/
    aaaaaz
    aaaaz
    aaaaaaaz

/^(pp|p\1)+q$/
    pppppq
    ppppq

/^(aa|a\1)+(z|aa)$/
    aaaaaaa

/^(aa|a\1)+a$/
    aaaaaa

# A backreference to its own group still fails on the group's first use.
/^(q\1)/
    qq
