# PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK restores the previous behaviour: \K is
# acted upon inside positive assertions ...
/(?=ab\K)/allow_lookaround_bsk
    ab

/(*plb:a\K)bc/allow_lookaround_bsk
    abc

# ... and the reported start can be earlier than where matching began.
/(?<=\Kab)cd/allow_lookaround_bsk
    abcd\=offset=2

# ... but it is ignored inside negative assertions.
/pq(?!q\Kz)/allow_lookaround_bsk
    pqq

/(?<!\Kzz)pq/allow_lookaround_bsk
    xxpq

# Without the option the same patterns do not compile.
/(?=ab\K)/
    ab

/pq(?!q\Kz)/
    pqq
