 1: ppp
    ppppq
 0: ppppq
 1: pp

/^(aa|a\1)+(z|aa)$/
    aaaaaaa
 0: aaaaaaa
 1: aaa
 2: aa

/^(aa|a\1)+a$/
    aaaaaa
 0: aaaaaa
 1: aaa

