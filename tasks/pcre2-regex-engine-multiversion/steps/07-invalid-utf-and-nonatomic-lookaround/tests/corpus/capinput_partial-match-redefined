# A pattern that contains a lookbehind can now give an empty partial match.
/z*+(?<=[yz])/
    xy\=ph
    xy\=ps
    xz\=ph

# So can a pattern that could match an empty string, but under hard partial
# matching only.
/(?![pq]).*/
    pq\=ph
    pq\=ps

# An empty partial hard match can be returned for \z and \Z.
/\z/
    ab\=ph

/\Z/
    ab\=ph

/(?<=b)\z/
    ab\=ph

# For a partial match, allusedtext now governs whether the preceding consulted
# text is shown, and only the text before the match point is shown.
/(?<=mn)op/
    zzmno\=ph
    zzmno\=ph,allusedtext
    zzmnop\=ph,allusedtext
