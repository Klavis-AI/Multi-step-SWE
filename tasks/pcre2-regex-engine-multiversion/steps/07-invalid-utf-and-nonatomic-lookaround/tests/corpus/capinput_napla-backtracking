# Non-atomic positive lookaround assertions (*napla: and (*naplb:.
# A non-atomic assertion that has succeeded can be re-entered when a later
# part of the pattern fails, so a capture made inside it takes a new value.

/(*napla:\w*(\w))\1\w*$/
    abcd
    xyzx
    q

# The atomic equivalent keeps the first value it found and cannot be re-entered.
/(*pla:\w*(\w))\1\w*$/
    abcd
    xyzx

# The long spelling means the same thing.
/(*non_atomic_positive_lookahead:\w*(\w))\1\w*$/
    abcd

# Non-atomic lookbehind: the second branch is reached only on re-entry.
/(*naplb:(\w\w)|(\w)(\w))\3/
    qzz

/(*plb:(\w\w)|(\w)(\w))\3/
    qzz

/(*non_atomic_positive_lookbehind:(\w\w)|(\w)(\w))\3/
    qzz

# There is no non-atomic negative assertion.
/(*nanla:pq)rs/
    rs

/(*naplb_foo:pq)rs/
    rs

# The short synonyms (?* and (?<* do not exist at this release (step 8).
/(?*pq)rs/
    rs

/(?<*pq)rs/
    rs
