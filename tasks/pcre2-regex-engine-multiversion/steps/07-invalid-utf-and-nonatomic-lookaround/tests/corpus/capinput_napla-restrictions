# An assertion used as the condition of a conditional group must be atomic.
/(?(*napla:pq)ab|cd)/
    pqab
    zzcd

/(?(*naplb:pq)ab|cd)/
    pqab

/(?(*non_atomic_positive_lookahead:pq)ab|cd)/
    pqab

# The atomic forms are still accepted there.
/(?(*pla:pq)ab|cd)/
    pqab
    zzcd

# pcre2_dfa_match() does not support non-atomic assertions.
/(*napla:\w*(\w))\1\w*$/
    abcd

/(*naplb:(\w\w)|(\w)(\w))\3/
    qzz

# A lookbehind inside a lookahead inside a lookbehind is now processed correctly.
/(?<=(?=(?<=q)))r/
    qr
    zr
