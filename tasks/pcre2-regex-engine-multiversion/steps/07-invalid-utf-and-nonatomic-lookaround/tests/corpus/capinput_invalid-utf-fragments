# The subject is matched fragment by fragment, but every reported offset is an
# offset into the whole subject; the replacement output shows where they fell.
/\w+/utf,match_invalid_utf
    ab\x80cde\=replace=<$0>,global
    ab\x80cde\=replace=<$0>,global,offset=3
    \xe0\xa0uv\xf0wxy\=replace=<$0>,global

# A starting offset inside an invalid sequence moves on to the next character.
/\w/utf,match_invalid_utf
    \xe2\x82zz\=offset=1,replace=-
    \xe2\x82zz\=offset=3,replace=-

# An invalid sequence is not matched even by \w+ scanning the whole subject.
/\w+/utf,match_invalid_utf
    \x80\x80
