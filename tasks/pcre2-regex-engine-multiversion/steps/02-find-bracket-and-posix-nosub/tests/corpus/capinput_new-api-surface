# New API surface: offset limits and the new substitution options.
/grebe/use_offset_limit
    a grebe swims\=offset_limit=4
    a grebe swims\=offset_limit=1
    a grebe swims\=offset_limit=2
    a grebe swims

/grebe/
    a grebe swims\=offset_limit=4

/\bteal\b/g,use_offset_limit
    teal teal teal\=offset_limit=6

/^snipe/use_offset_limit
    a snipe\=offset_limit=9

/(\w+)=(\w+)/replace=$2=$1
    key=value\=substitute_extended

/(?<k>\w+):(?<v>\w+)/replace=${v:-none}/${k}
    alpha:beta\=substitute_extended

/x(y)?z/replace=<${1:-empty}>
    xz\=substitute_extended
    xyz\=substitute_extended

/x(y)?z/replace=<$1>
    xz\=substitute_unset_empty
    xz

/(\w+)/replace=\U$1
    otter\=substitute_extended

/(\w+)/replace=<${missing}>
    otter\=substitute_unknown_unset,substitute_unset_empty

/(*MARK:tail)\w+/replace=${*MARK}
    weasel

/heron/replace=cormorant
    a heron here\=replace=[6]cormorant,substitute_overflow_length
