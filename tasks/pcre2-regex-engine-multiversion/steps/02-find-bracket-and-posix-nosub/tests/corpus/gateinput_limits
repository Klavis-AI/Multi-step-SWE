# The two match limits, inherited from step 1. This release extends
# match-limit checking into recursion; the limits themselves, their names and
# their error codes must not move. The counts find_limits prints are
# implementation-defined and are deliberately not here.
/^(a+)+$/
    aaaaaaaaaaaaaaaaaaaaX\=match_limit=100

/^(a+)+$/
    aaaaaaaaaaaaaaaaaaaaX\=recursion_limit=8

/(*LIMIT_MATCH=120)^(b+)+$/
    bbbbbbbbbbbbbbbbbbbbY

/(*LIMIT_RECURSION=9)^(c+)+$/
    ccccccccccccccccccccZ

/(*LIMIT_RECURSION=100000)^(d+)+$/
    ddddddddddddddddddddQ\=recursion_limit=9
