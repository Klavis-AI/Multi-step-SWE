# Character-class corrections.
/^[[:punct:]b]+$/ucp,utf
    b;!
    \x{a1}

/^[[:punct:]]$/ucp,utf
    \x{a1}
    \x{b7}
    \x{d7}

/^[[:^ascii:]\d]+$/ucp,utf
    5\x{14b}
    \x{2027}

/^[^[:^ascii:]\d]+$/ucp,utf
    q
    5

/^[\W\p{Nd}]+$/utf
    -7

/^[[:^xdigit:]]$/ucp,utf
    \x{100}

/^[[:<:]]\w+/ucp
    stoat
