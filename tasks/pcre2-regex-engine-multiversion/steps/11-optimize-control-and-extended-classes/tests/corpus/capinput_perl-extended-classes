# Perl's (?[...]) extended character classes: an expression syntax with
# set operators, always with PCRE2_EXTENDED_MORE in force.
# ChangeLog 10.45 item 42; pcre2pattern.3, "PERL EXTENDED CHARACTER CLASSES".

# & is intersection, | and + are union, - is subtraction, ^ is symmetric
# difference, ! is complement.
/^(?[ \w & [^\d] ])+$/
    hedge
    hedge7

/^(?[ [aeiou] + \d ])+$/
    oi42
    oiz

/^(?[ [aeiou] | \d ])+$/
    ea90

/^(?[ \w - [aeiou] ])+$/
    rhythm
    rhyme

/^(?[ [a-m] ^ [g-z] ])+$/
    abcdef
    nopqrs
    ghijk

/^(?[ ! \W ])+$/
    word7
    wo rd

/^(?[ [:alpha:] & [^p-z] ])+$/
    cabbage
    zap

# & binds tighter than -, and parentheses group.
/^(?[ \w - [:digit:] & [0-4] ])+$/
    tin7
    tin3

/^(?[ ( \w - [:digit:] ) & [a-c] ])+$/
    cab
    tin

# A nested ordinary class follows the ordinary rules, so literals and ranges
# are allowed there and nowhere else.
/^(?[ [a-c[] ])+$/
    ab[c

/(?[ a ])/

/(?[ a-c ])/

# ^ is an operator, not a negation.
/(?[ ^\d ])/

# The extended syntax adds no escape sequences.
/(?[ \y ])/
