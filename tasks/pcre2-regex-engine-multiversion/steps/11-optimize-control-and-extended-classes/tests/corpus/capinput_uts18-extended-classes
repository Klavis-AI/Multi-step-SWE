# PCRE2_ALT_EXTENDED_CLASS turns ordinary [...] classes into the UTS#18
# extended form.  ChangeLog 10.45 item 41; pcre2pattern.3, "UTS#18 EXTENDED
# CHARACTER CLASSES".

# || union, && intersection, -- subtraction, ~~ symmetric difference.
/^[\w&&[^\d]]+$/alt_extended_class
    hedge
    hedge7

/^[[aeiou]||\d]+$/alt_extended_class
    ea90
    eaz

/^[\w--[aeiou]]+$/alt_extended_class
    rhythm
    rhyme

/^[[a-m]~~[g-z]]+$/alt_extended_class
    abcdef
    ghijk

# "[" becomes a metacharacter inside a class and must be escaped.
/^[a\[b]+$/alt_extended_class
    a[b

/^[a[b]+$/alt_extended_class

# Juxtaposition is an implicit union that binds tighter than any explicit
# operator.
/^[[abc][xyz]--[cx]]+$/alt_extended_class
    abyz
    abcx

# Precedence between two explicit operators is undefined, so it is an error.
/^[\w&&[a-z]--[q]]+$/alt_extended_class

# A literal "-" at the start or end of a range must be escaped.
/^[\--1]+$/alt_extended_class
    -0.1

/^[--1]+$/alt_extended_class

# Nested classes are themselves extended.
/^[[a-z]&&[[a-c]||[x-z]]]+$/alt_extended_class
    abz
    abm

# Without the option the same text is ordinary Perl class syntax: the class
# ends at the first unescaped ], "&" and "[" are literal members of it, and
# the second ] is a literal that must be matched.
/^[\w&&[^\d]]+$/
    a]
    &]]]
    hedge
