# The capture group name maximum rises from 32 to 128 code units;
# pcre2_set_max_pattern_compiled_length() limits compiled pattern size; and
# (*TURKISH_CASING), (*CASELESS_RESTRICT) and PCRE2_EXTRA_NEVER_CALLOUT are
# new.  ChangeLog 10.44 items 3 and 6; ChangeLog 10.45 items 34 and 40;
# pcre2pattern.3, "NAMED CAPTURE GROUPS" and "SPECIAL START-OF-PATTERN ITEMS".

/(?<qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq>x)y/
    xy

/(?<rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr>x)y/
    xy

/(?<sssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss>x)y/

# Turkish casing changes the equivalences of i, I, U+0130 and U+0131.
/(*TURKISH_CASING)^i$/utf,caseless
    \x{130}
    I

/^i$/utf,caseless,turkish_casing
    \x{130}
    I

/^i$/utf,caseless
    \x{130}
    I

/(*TURKISH_CASING)^I$/utf,caseless
    \x{131}
    i

# (*CASELESS_RESTRICT) sets the caseless restriction from the pattern.
/(*CASELESS_RESTRICT)^K$/utf,caseless
    \x{212a}
    k

# PCRE2_EXTRA_NEVER_CALLOUT makes a callout-bearing pattern fail to compile.
/quay(?C1)side/never_callout

/quay(?C1)side/
    quayside

# A compiled-length limit set by the application.
/abcdefghij/max_pattern_compiled_length=8

/abcdefghij/max_pattern_compiled_length=200
    abcdefghij
