# pcre2_set_optimize() lets a caller turn individual compile-time
# optimisations on and off; pcre2test exposes optimization_full,
# optimization_none, auto_possess, dotstar_anchor and start_optimize, each
# with an _off form.  ChangeLog 10.45 item 32; pcre2api.3, "PCRE2 CONTEXTS";
# pcre2pattern.3, "Disabling start-up optimizations".

# The set of enabled optimisations is reported by the info modifier.
/^quay.*Z/info

/^quay.*Z/info,optimization_none

/^quay.*Z/info,optimization_full

/^quay.*Z/info,auto_possess_off

/^quay.*Z/info,dotstar_anchor_off,start_optimize_off

# Turning the dot-star anchor off removes the start-of-line deduction.
/.*wharf/info

/.*wharf/info,dotstar_anchor_off

# Turning the start-of-match optimisation off changes the result whenever a
# backtracking verb depends on where matching was attempted.
/(*COMMIT)ZZ/
    yZZ

/(*COMMIT)ZZ/start_optimize_off
    yZZ

/(*COMMIT)ZZ/optimization_none
    yZZ

# Auto-possessification is visible through a callout trace.
/(?=b+)b+Q/auto_callout
    bbbc

/(?=b+)b+Q/auto_callout,start_optimize_off
    bbbc
