# Under caseless matching the general categories Ll, Lt and Lu are all
# treated as Lc.  ChangeLog 10.45 item 6; pcre2pattern.3, "The general
# category property for \p and \P".

/^\p{Lu}+$/utf,caseless
    HAT
 0: HAT
    hat
 0: hat
    Hat
 0: Hat

/^\p{Ll}+$/utf,caseless
    hat
 0: hat
    HAT
 0: HAT

/^\p{Lt}+$/utf,caseless
    \x{1c5}
 0: \x{1c5}
    \x{1c4}
 0: \x{1c4}
    \x{1c6}
 0: \x{1c6}

/^\p{Lu}$/utf
    hat
No match

/^\p{Ll}$/utf
    H
No match

/^[\p{Lu}]+$/utf,caseless
    dog
 0: dog

/^\P{Lu}+$/utf,caseless
    hat
No match
    7.9
 0: 7.9

# White space is ignored around the name, including before ^.
/^\p{ ^L }$/utf
    7
 0: 7
    q
No match

/^\p{ Nd }$/utf
    7
 0: 7
