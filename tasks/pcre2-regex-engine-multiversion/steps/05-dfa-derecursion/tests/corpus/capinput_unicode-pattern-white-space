# With Unicode support, PCRE2_EXTENDED (and so PCRE2_EXTENDED_MORE) also
# discards U+0085, U+200E, U+200F, U+2028 and U+2029 from a pattern.
# ChangeLog 10.32-RC1 item 31; pcre2api.3, "COMPILING A PATTERN"
# (PCRE2_EXTENDED).

/"^q" E2 80 A8 "r$"/hex,extended,utf,info
    qr
    q\x{2028}r

/"^q" C2 85 "r" E2 80 8E "s$"/hex,extended,utf
    qrs

/"^q" E2 80 A9 "r" E2 80 8F "s$"/hex,extended,utf
    qrs

# PCRE2_EXTENDED_MORE does everything PCRE2_EXTENDED does, so it discards them
# too.
/"^q" E2 80 A8 "r$"/hex,extended_more,utf
    qr

# Without PCRE2_EXTENDED the character is an ordinary literal.
/"^q" E2 80 A8 "r$"/hex,utf
    qr
    q\x{2028}r
