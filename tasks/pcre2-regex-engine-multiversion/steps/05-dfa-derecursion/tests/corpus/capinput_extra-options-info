# The extra compile options are now saved in the compiled pattern and can be
# read back with PCRE2_INFO_EXTRAOPTIONS; pcre2test prints them as an
# "Extra options:" line.  ChangeLog 10.31 item 21; pcre2api.3, "INFORMATION
# ABOUT A COMPILED PATTERN".

/^r\qs$/bad_escape_is_literal,info
    rqs

/^\x{d800}$/utf,allow_surrogate_escapes,info

/^gnu$/match_word,info

/^gnu$/match_line,bad_escape_is_literal,info

# No extra options set: no line at all.
/^gnu$/info

# The options travel with the compiled pattern, so they are still there after
# the pattern has been stacked and retrieved.
/^r\qs$/bad_escape_is_literal,push

#pop info
    rqs
