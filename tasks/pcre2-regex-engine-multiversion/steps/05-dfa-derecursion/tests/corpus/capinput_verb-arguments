# (*ACCEPT:ARG), (*FAIL:ARG) and (*COMMIT:ARG) are now supported, and a name is
# passed back for a positive assertion terminated by (*ACCEPT).
# ChangeLog 10.32-RC1 items 27 and 28; pcre2pattern.3, "Verbs that act
# immediately".

/^qr(*ACCEPT:taken)st/mark
    qrst

/^q(*FAIL:refused)|^r/mark
    qz
    rz

/^(q)(*COMMIT:halted)r|^.s/mark
    qs

/^(?=(q)(*ACCEPT:seen))q/mark
    qz

/^(?=(*MARK:inside)q(*ACCEPT))q/mark
    qz

# An unnamed verb still behaves as before.
/^q(*PRUNE:pruned)r/mark
    qz
