# "match limit recursion" is renamed "depth limit" everywhere a user can see
# it, an explicit heap limit joins it, and the old names remain as synonyms.
# ChangeLog 10.30 items 2 and 22; pcre2pattern.3, "Setting match resource
# limits"; pcre2test.1, "Setting heap, match, and depth limits".

/(*LIMIT_DEPTH=120)(*LIMIT_HEAP=64)quota/info
    quota

# (*LIMIT_RECURSION) is kept as a synonym for (*LIMIT_DEPTH).
/(*LIMIT_RECURSION=77)quota/info
    quota

/(*LIMIT_DEPTH=77)quota/info
    quota

/(*LIMIT_HEAP=8)(*LIMIT_MATCH=3000)quota/info
    quota

# The limits are subject modifiers, not pattern modifiers.
/quota/info,depth_limit=55

/quota/info,heap_limit=99
