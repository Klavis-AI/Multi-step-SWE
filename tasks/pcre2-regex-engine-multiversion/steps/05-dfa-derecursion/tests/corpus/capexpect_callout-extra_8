# Callout blocks gain a callout_flags field with PCRE2_CALLOUT_STARTMATCH and
# PCRE2_CALLOUT_BACKTRACK; pcre2test's new callout_extra modifier makes them
# visible, and pcre2_dfa_match() never sets them.
# ChangeLog 10.31 item 22; pcre2callout.3, "Fields for all callouts";
# pcre2test.1, "Callout modifiers".

/^q(r|s)t/auto_callout
    qst\=callout_extra
New match attempt
--->qst
 +0 ^       ^
 +1 ^       q
 +2 ^^      (
 +3 ^^      r
Backtrack
--->qst
 +5 ^^      s
 +6 ^ ^     )
 +7 ^ ^     t
 +8 ^  ^    End of pattern
 0: qst
 1: s

/^(q|r)z/auto_callout
    ry\=callout_extra
New match attempt
--->ry
 +0 ^      ^
 +1 ^      (
 +2 ^      q
Backtrack
--->ry
 +4 ^      r
 +5 ^^     )
 +6 ^^     z
No match

# A backtrack that ends a match attempt prints all three lines.
/(z+)y/auto_callout,no_start_optimize,no_auto_possess
    zzx\=callout_extra
New match attempt
--->zzx
 +0 ^       (
 +1 ^       z+
 +3 ^ ^     )
 +4 ^ ^     y
Backtrack
--->zzx
 +3 ^^      )
 +4 ^^      y
Backtrack
No other matching paths
New match attempt
--->zzx
 +0  ^      (
 +1  ^      z+
 +3  ^^     )
 +4  ^^     y
Backtrack
No other matching paths
New match attempt
--->zzx
 +0   ^     (
 +1   ^     z+
Backtrack
No other matching paths
New match attempt
--->zzx
 +0    ^    (
 +1    ^    z+
No match

# Under DFA matching the modifier has no effect.
/^q(r|s)t/auto_callout
    qst\=callout_extra,dfa
--->qst
 +0 ^       ^
 +1 ^       q
 +2 ^^      (
 +3 ^^      r
 +5 ^^      s
 +6 ^ ^     )
 +7 ^ ^     t
 +8 ^  ^    End of pattern
 0: qst
