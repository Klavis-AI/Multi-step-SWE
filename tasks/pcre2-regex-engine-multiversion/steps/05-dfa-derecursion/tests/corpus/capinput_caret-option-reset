# "(?^)" unsets imnsx at once, letters may follow it to set options again, and
# a malformed option setting has a message of its own.
# ChangeLog 10.32-RC1 item 30; pcre2pattern.3, "INTERNAL OPTION SETTING".

/(?i)qr(?^)st/info
    QRst
    QRST

/(?i)qr(?-imnsx)st/
    QRst
    QRST

/(?^i)QR(?^)ST/info
    qrST
    qrst

/(?^im)q/info

/(?^)q/info

# A hyphen after the circumflex is an error; a trailing hyphen with nothing
# after it is accepted.
/(?^-i)q/

/(?i-)q/
