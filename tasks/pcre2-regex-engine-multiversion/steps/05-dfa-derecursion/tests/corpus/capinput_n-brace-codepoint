# \N{U+dddd} is supported, but only in Unicode mode; two existing messages
# change with it.  ChangeLog 10.32-RC1 item 29; pcre2pattern.3, "Non-printing
# characters".

/^\N{U+0051}\N{U+00e9}$/utf,info
    Q\x{e9}

/^[\N{U+0051}\N{U+0058}]+$/utf
    QXQ

# Outside Unicode mode it has a message of its own.
/^\N{U+0051}$/

# The unsupported-escape message now names \N{name} alongside \F.
/^\N{LATIN CAPITAL LETTER Q}$/utf

/^q\Fr$/

# "digits missing" now names \N{U+} too.
/^\N{U+}$/utf
