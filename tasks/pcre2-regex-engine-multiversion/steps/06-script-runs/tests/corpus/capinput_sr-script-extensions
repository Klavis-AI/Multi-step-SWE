# Membership is decided by the Script Extension list, not the Script property.
# U+060C has the list Arabic, Hanifi Rohingya, Syriac, Thaana; U+06D4 has only
# Arabic and Hanifi Rohingya -- pcre2unicode.3, "Basic script run rules".

/^(*sr:.+)$/utf
    \x{0627}\x{060C}\x{0628}
    \x{0627}\x{06D4}\x{0628}
    \x{0780}\x{060C}\x{0781}
    \x{0780}\x{06D4}\x{0781}
    \x{0710}\x{060C}\x{0712}
    \x{0710}\x{06D4}\x{0712}
    \x{0780}\x{060C}\x{0710}
