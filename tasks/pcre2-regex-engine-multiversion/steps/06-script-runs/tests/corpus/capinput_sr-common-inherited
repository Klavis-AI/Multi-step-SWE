# Common goes with anything; Inherited takes the script of what it modifies;
# a string under two characters long is always a script run, and that is the
# only case in which an Unknown character can be in one.
# pcre2unicode.3, "Basic script run rules".

/^(*sr:.+)$/utf
    dot.and-dash!
    \x{0441}\x{043B}.\x{043E}\x{0432}
    e\x{0301}clair
    \x{03B4}\x{0301}\x{03BF}
    e\x{0301}\x{0441}
    \x{0378}
    \x{0378}\x{0378}
    a\x{0378}
    .\x{0378}

# One character on its own is a script run whatever its script.
/^(*sr:.)$/utf
    \x{0378}
    \x{0301}
    \x{0441}
