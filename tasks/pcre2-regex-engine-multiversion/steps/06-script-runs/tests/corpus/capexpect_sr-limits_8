# What a script run does not do.
# pcre2pattern.3, "SCRIPT RUNS".

# "Script runs are not supported by the alternate matching function,
# pcre2_dfa_match()".
/^(*sr:\S+)$/utf
    manifest\=dfa
Failed: error -42: pattern contains an item that is not supported for DFA matching
    man\x{0456}fest\=dfa
Failed: error -42: pattern contains an item that is not supported for DFA matching

# "The (*ACCEPT) control verb should not be used within a script run group,
# because it causes an immediate exit from the group, bypassing the script run
# checking."
/^(*sr:\S+(*ACCEPT))$/utf
    man\x{0456}fest
 0: man\x{456}fest

/^(*sr:\S+)$/utf
    man\x{0456}fest
No match

# Only the characters matched inside the parentheses are checked.
/^(*sr:\p{L}{3})\S+$/utf
    man\x{0456}fest
 0: man\x{456}fest

# The construct is an assertion over the text, not a capture: it does not
# consume a group number.
/^(*sr:(\w)(\w))(\w)$/utf
    abc
 0: abc
 1: a
 2: b
 3: c
