# Alphabetic assertion names and error 195.
# pcre2pattern.3, "Alphabetic assertion names"; pcre2api.3, "Error codes".
# instruction L57-61: a lower-case-only (*name: that is not a recognised
# assertion gives error 195, not the verb-not-recognised error 160.

# (*nla: is the documented short form of (*negative_lookahead:
# Both must behave identically to (?!...).
/(*nla:foo)bar/
    foobar
    bar
    fooXbar

# Long form behaves identically.
/(*negative_lookahead:foo)bar/
    bar
    foobar

# An unrecognised lower-case (*name: gives error 195, not 160.
/(*qwerty:abc)/

# allvector modifier shows the full ovector including under -dfa.
# pcre2test.1, "Showing the entire ovector, for all outcomes".
/^(a)(b)(c)$/allvector
    abc\=dfa

