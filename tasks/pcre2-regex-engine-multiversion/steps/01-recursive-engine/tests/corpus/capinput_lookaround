# Lookahead and lookbehind assertions.
/(?<=badger)brock/
    badgerbrock\=allusedtext
    otterbrock

/(?<!badger)brock/
    otterbrock\=allusedtext

/heron(?=fish)/
    heronfish\=allusedtext
    heronfrog

/heron(?!fish)/
    heronfrog

/(?<=\bshrew|\bmole)tunnel/
    the moletunnel
    a shrewtunnel

/^(?=.*vole)(?=.*[0-9])\w+$/
    vole42
    vole

/\bcrane(?=\s+(fly|bird))/
    a crane fly here\=allusedtext

/(?<=^.{3})owl/
    theowl\=startchar

/crow\Kbar/
    crowbar\=startchar
