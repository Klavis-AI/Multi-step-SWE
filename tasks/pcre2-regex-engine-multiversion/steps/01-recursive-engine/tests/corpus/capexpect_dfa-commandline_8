# The alternative matching function selected on the COMMAND LINE with -dfa,
# not by a `dfa` modifier on a subject line. Every pattern below is graded
# twice over the same input file -- once with the standard matching function
# and once with -dfa -- and the two transcripts differ, so a pcre2test that
# ignores the command-line flag produces the standard transcript for the
# -dfa run and fails.
#
# pcre2matching.3, "THE ALTERNATIVE MATCHING ALGORITHM": the alternative
# function finds every matching substring at the first position it matches
# and reports them longest first, and it does not support capturing.
# pcre2test.1, "OUTPUT FROM THE ALTERNATIVE MATCHING FUNCTION".

/^(cat|caterpillar|cats)/
    caterpillar
 0: cat
 1: cat
    cats
 0: cat
 1: cat
    dog
No match

/(\d+)-(\d+)/
    range 100-250 here
 0: 100-250
 1: 100
 2: 250

/^a.*?b/
    axxbxxb
 0: axxb

/^\w+/
    badgers
 0: badgers
