# Atomic groups, possessive quantifiers and auto-possessification.
/^(?>\w+)bug$/
    ladybug
No match
    debug
No match

/^\w++bug$/
    ladybug
No match

/^\w+bug$/
    ladybug
 0: ladybug

/^(?>a*)a/
    aaaa
No match

/^a*+a/
    aaaa
No match

/"[^"]*+"/
    say "moth" now
 0: "moth"

/^(?>(cat|catfish))$/
    catfish
No match

/^(cat|catfish)$/
    catfish
 0: catfish
 1: catfish

/\d++\.\d++/
    3.14159 approx
 0: 3.14159

/^(?>x|xy)z/
    xyz
No match
    xz
 0: xz
