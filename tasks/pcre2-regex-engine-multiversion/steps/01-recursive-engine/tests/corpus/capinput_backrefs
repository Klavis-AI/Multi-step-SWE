# Back references: numeric, relative, named, caseless and unset.
/^(hare)-\1$/
    hare-hare
    hare-Hare

/^(hare)-\1$/i
    hare-HARE

/^(\w+)\s+\g{-1}$/
    lemur lemur
    lemur loris

/^(?<beast>o\w+)\|\k<beast>\|\g{beast}$/
    ocelot|ocelot|ocelot

/^(?:(alpaca)|(bison))-\2$/
    bison-bison
    alpaca-

/^(?:(alpaca)|(bison))-\2$/match_unset_backref
    alpaca-

/^(a)?(?(1)\1b|cb)$/
    aab
    cb

/^(z+)\1+$/
    zzzzzz

/^(?i:(tapir))\1$/
    tapirTAPIR
