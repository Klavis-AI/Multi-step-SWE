# The alternative (DFA) matching function.
/tad|tadpole|tadpoles/
    tadpoles here\=dfa
    tadpoles here\=dfa,dfa_shortest

/^(?:new|newt|newts)/
    newts\=dfa,ovector=1
    newts\=dfa

/^(?:spring|summer)-\d\d\d\d$/
    spring-20\=ps,dfa
    15\=dfa,dfa_restart
    summer-20\=ph,dfa

/(toad)\1/
    toadtoad\=dfa

/^\w+(?=t)/
    newt\=dfa

/\b(?:eft|efts)\b/g
    eft efts\=dfa

/gecko\Kskin/
    geckoskin\=dfa
