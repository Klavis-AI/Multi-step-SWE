# Substring extraction and pcre2_substitute().
/^(?<who>\w+)-the-(?<what>\w+)$/
    Basil-the-badger\=copy=who,copy=2,get=what,get=1
    Basil-the-badger\=getall
    Basil-the-badger\=allcaptures

/^(\w+)(?:-(\w+))?$/
    stoat\=allcaptures
    stoat-weasel\=getall

/(?J)^(?<tag>a\w+)|(?<tag>b\w+)$/
    bobcat\=get=tag,copy=tag

/^\w+$/
    heron\=copy=3
    heron\=get=nosuch

/badger/replace=otter
    a-badger-here
    a-badger-and-a-badger\=global

/(\w+)@(\w+)/replace=$2.at.$1
    fox@den

/(?<user>\w+)@(?<host>\w+)/replace=<${user}/${host}>
    vole@burrow

/a(b)c/replace=+$1$0$1+
    =abc=

/e/replace=E
    weasel\=global,replace=[8]E
    weasel\=global,replace=[6]E

/x/replace=$q
    axb
