# Atomic groups, possessive quantifiers and auto-possessification.
/^(?>\w+)bug$/
    ladybug
    debug

/^\w++bug$/
    ladybug

/^\w+bug$/
    ladybug

/^(?>a*)a/
    aaaa

/^a*+a/
    aaaa

/"[^"]*+"/
    say "moth" now

/^(?>(cat|catfish))$/
    catfish

/^(cat|catfish)$/
    catfish

/\d++\.\d++/
    3.14159 approx

/^(?>x|xy)z/
    xyz
    xz
