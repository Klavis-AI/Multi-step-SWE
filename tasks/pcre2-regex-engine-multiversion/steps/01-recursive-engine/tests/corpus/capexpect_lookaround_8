# Lookahead and lookbehind assertions.
/(?<=badger)brock/
    badgerbrock\=allusedtext
 0: badgerbrock
    <<<<<<     
    otterbrock
No match

/(?<!badger)brock/
    otterbrock\=allusedtext
 0: brock

/heron(?=fish)/
    heronfish\=allusedtext
 0: heronfish
         >>>>
    heronfrog
No match

/heron(?!fish)/
    heronfrog
 0: heron

/(?<=\bshrew|\bmole)tunnel/
    the moletunnel
 0: tunnel
    a shrewtunnel
 0: tunnel

/^(?=.*vole)(?=.*[0-9])\w+$/
    vole42
 0: vole42
    vole
No match

/\bcrane(?=\s+(fly|bird))/
    a crane fly here\=allusedtext
 0:  crane fly
    <     >>>>
 1: fly

/(?<=^.{3})owl/
    theowl\=startchar
 0: owl

/crow\Kbar/
    crowbar\=startchar
 0: crowbar
    ^^^^
