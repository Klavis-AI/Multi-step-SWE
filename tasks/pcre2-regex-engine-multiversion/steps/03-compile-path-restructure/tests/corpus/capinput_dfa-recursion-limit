# pcre2_dfa_match() now observes the recursion limit.
/(?<=(?<=(?<=(?<=(?<=a)b)c)d)e)f/
    abcdef\=dfa,recursion_limit=2
    abcdef\=dfa,recursion_limit=100
    abcdef\=dfa

/\((?:[^()]|(?R))*\)/
    (a(b(c(d(e)))))\=dfa,recursion_limit=3
    (a(b(c(d(e)))))\=dfa

/^(?=(?=(?=(?=(?=x))))).*/
    xyz\=dfa,recursion_limit=2
    xyz\=dfa
