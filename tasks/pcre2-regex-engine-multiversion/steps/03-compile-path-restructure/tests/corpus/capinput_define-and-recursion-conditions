/^(?<DEFINE>a)(?(DEFINE)b)$/
    ab
    a

/^(?<DEFINE>a)(?(DEFINE)b|c)$/
    ac

/(?(DEFINE)(?<word>\w+))^(?&word)$/
    stoat

/^(a)(?(R2)b|c)$/
    ac

/^(a)(?(R1)b|c)$/
    ac

/^(?<Rook>k)(?(R)x|y)$/
