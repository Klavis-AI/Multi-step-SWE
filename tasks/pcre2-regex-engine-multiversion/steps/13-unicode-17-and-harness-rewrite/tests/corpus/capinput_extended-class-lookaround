# Extended (Boolean) character classes may now be used immediately before a
# lookbehind and inside any lookaround assertion.

/(?[\p{L} - [q]])(?<=w)/
    w
    q

/(?<=(?[\p{Lu} + \p{Nd}]))z/
    Az
    7z
    az

/(?=(?[\p{L} & \p{Xan}]))../
    ab

/(?!(?[\p{N} - [5]]))./
    5
    7

/^[[\p{L}&&[^q]]](?<=w)/alt_extended_class
    w

/(?<=[[\p{Lu}||\p{Nd}]])z/alt_extended_class
    Az
