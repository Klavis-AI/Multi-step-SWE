# pcre2_substitute() now supports partial matching, but only together with
# PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, and $' or $_ in the replacement is
# rejected with PCRE2_ERROR_PARTIALSUBS whenever partial matching is enabled.

/qr/
    pqrs\=ps,replace=<[$&]>,substitute_replacement_only
    pqrs\=ph,replace=<[$&]>,substitute_replacement_only
    pq\=ph,replace=<[$&]>,substitute_replacement_only
    pq\=ps,replace=<[$&]>,substitute_replacement_only
    pqrs\=ps,replace=<A$'B>,substitute_replacement_only
    pqrs\=ps,replace=<A$_B>,substitute_replacement_only
    pqrs\=ps,replace=<A$`B>,substitute_replacement_only
    pqrs\=ps,replace=<[$&]>
    pqrsqr\=ps,global,replace=<[$&]>,substitute_replacement_only
