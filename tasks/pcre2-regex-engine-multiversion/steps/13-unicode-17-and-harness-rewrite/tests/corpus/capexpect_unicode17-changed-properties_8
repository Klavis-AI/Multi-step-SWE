# Unicode 17.0 changes properties of code points that were already assigned:
# U+0295 moves from Ll to Lo (and loses Lowercase and Cased), and the
# Diacritic property gains U+05A2, U+05C5, U+05C7 and U+1D9B..U+1DB0.

/^\p{Lo}$/utf
    \x{295}
 0: \x{295}

/^\p{Ll}$/utf
    \x{295}
No match

/^[\p{Lowercase}\p{Cased}]$/utf
    \x{295}
No match

/^\p{Lo}\p{Ll}$/utf
    \x{295}\x{296}
 0: \x{295}\x{296}

/^\p{Diacritic}{3}$/utf
    \x{5a2}\x{5c5}\x{5c7}
 0: \x{5a2}\x{5c5}\x{5c7}

/^\p{Diacritic}{3}$/utf
    \x{1d9b}\x{1da0}\x{1db0}
 0: \x{1d9b}\x{1da0}\x{1db0}

/^\P{Diacritic}$/utf
    \x{5a2}
No match

/^[^\p{Diacritic}]+$/utf
    \x{1d9b}\x{1da0}
No match
