# A script name written with no property type now means scx:, so a character
# whose own script is Common or Inherited matches the bare form of every
# script in its extensions list.
/^\p{Arabic}+$/utf
    \x{627}
    \x{640}
    \x{64b}
    \x{640}\x{64b}\x{627}

/^\p{Katakana}$/utf
    \x{30a2}
    \x{30fc}

/^\p{Han}$/utf
    \x{4e00}
    \x{3006}

# The same redefinition applies inside a class and under negation.
/^[\p{Katakana}\s]+$/utf
    \x{30a2} \x{30fc}

/^\P{Arabic}$/utf
    \x{640}
    \x{4e00}

/^[^\p{Han}]$/utf
    \x{3006}
    \x{30a2}

# Characters whose basic script is their only script are unaffected.
/^\p{Latin}+$/utf
    Latin
    \x{3b1}

/^\p{Greek}$/utf
    \x{3b1}
