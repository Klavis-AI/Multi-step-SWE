# Unicode 17.0 adds case pairings for the Latin Epigraphic letters
# U+A7D2/U+A7D3 and U+A7D4/U+A7D5.

/^\x{a7d3}$/utf,caseless
    \x{a7d2}
 0: \x{a7d2}
    \x{a7d3}
 0: \x{a7d3}

/^\x{a7d5}$/utf,caseless
    \x{a7d4}
 0: \x{a7d4}
    \x{a7d5}
 0: \x{a7d5}

/^\x{a7d2}\x{a7d4}$/utf,caseless
    \x{a7d3}\x{a7d5}
 0: \x{a7d3}\x{a7d5}

/^\p{Changes_When_Uppercased}{2}$/utf
    \x{a7d3}\x{a7d5}
 0: \x{a7d3}\x{a7d5}

/^\p{Changes_When_Casemapped}{2}$/utf
    \x{a7d3}\x{a7d5}
 0: \x{a7d3}\x{a7d5}

/^[\x{a7d3}]$/utf,caseless
