# From 10.38, \K inside a lookaround assertion is a compile error by default.
/(?=pq\K)rs/
    pqrs

/(?<=\Kpq)rs/
    pqrs

/(?!pq\Kz)rs/
    rs

/(?<!\Kpq)rs/
    zzrs

/(*pla:a\Kb)/
    ab

/(*naplb:a\Kb)cd/
    abcd

# It is an error however deeply the \K is buried inside the assertion.
/x(?:y(?=z\Kq))/
    xyzq

/(?=(?:a|b(?:c\K))d)/
    bcd

# \K outside an assertion is untouched, and does not disturb captures.
/(foo)\Kbar/
    foobar

/^pq\Krs/
    pqrs
