# A NULL subject pointer with a zero length is treated as an empty string ...
/^(?:pq)*$/
    \=null_subject,offset=0

/^\w{0,3}$/
    \=null_subject

/pqrst/
    \=null_subject

# ... but a NULL pointer with a non-zero length is an error.
/pqrst/
    pqrst\=null_subject

# The replacement of pcre2_substitute() behaves the same way.
/z*/
    \=replace=ZZZ,null_replacement
    \=replace=ZZZ

/z/
    pzq\=replace=ZZZ,null_replacement
    pzq\=replace=ZZZ
