# The standard four-letter script abbreviations work wherever a full script
# name does.
/^\p{Latn}+$/utf
    abc

/^\p{sc:Grek}$/utf
    \x{3b1}

/^\p{scx:Kana}$/utf
    \x{30fc}

/^\p{sc:Kana}$/utf
    \x{30fc}

/^\p{script=Hani}$/utf
    \x{4e00}

/^\p{script_extensions:Hani}$/utf
    \x{3006}

/^\p{Adlm}$/utf
    \x{1e900}

/^\p{Arab}+$/utf
    \x{627}\x{640}

# An abbreviation that is not a script is still an error.
/\p{sc:Qqqq}/utf
    a
