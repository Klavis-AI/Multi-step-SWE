# Unicode's loose matching: spaces, hyphens and underscores are ignored in a
# property name, and what is left is matched independently of case.
/^\p{Bidi_Control}$/utf
    \x{200e}
 0: \x{200e}

/^\p{bidicontrol}$/utf
    \x{200e}
 0: \x{200e}

/^\p{ bidi_control }$/utf
    \x{200e}
 0: \x{200e}

/^\p{BIDI-CONTROL}$/utf
    \x{200e}
 0: \x{200e}

/^\p{script extensions:katakana}$/utf
    \x{30fc}
 0: \x{30fc}

/^\p{Script_Extensions=KATAKANA}$/utf
    \x{30fc}
 0: \x{30fc}

/^\p{s-c-x:arab}$/utf
    \x{640}
 0: \x{640}

/^\p{White_Space}+$/utf
    \x{20}\x{a0}
 0:  \x{a0}
