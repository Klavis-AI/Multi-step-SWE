# The Bidi_Class property, by short class name only, with : or = and either
# spelling of the property type.
/^\p{bc:AL}+$/utf
    \x{627}\x{640}

/^\p{Bidi_Class=R}$/utf
    \x{5d0}

/^\p{BC=EN}+$/utf
    12345

/^\p{bc:WS}$/utf
    \x{20}

# Only the short class names are recognized.
/\p{bc:Arabic_Letter}/utf
    \x{627}

# Binary properties, negated with \P and with a leading circumflex, and
# quantified greedily, lazily and possessively.
/^\p{Bidi_Control}$/utf
    \x{200e}
    \x{200f}
    a

/^\P{Bidi_Control}$/utf
    \x{200e}
    a

/^\p{^Bidi_Control}$/utf
    a

/^[\p{Bidi_Control}x]+$/utf
    x\x{200e}x

/^\p{Ideographic}+\p{Ideographic}+?\p{Ideographic}++$/utf
    \x{4e00}\x{4e8c}\x{4e09}

/^\p{ASCII}+$/utf
    plain

/^\P{ASCII}$/utf
    \x{3b1}
