# The match frame vector is always on the heap, so a heap limit of zero
# guarantees a heap limit error instead of a match.
/(*LIMIT_HEAP=0)abc/
    abc
Failed: error -63: heap limit exceeded

/abc/
    abc\=heap_limit=0
Failed: error -63: heap limit exceeded

/(*LIMIT_HEAP=1)abc/
    abc
 0: abc

# find_limits now reports the heap limit as well as the match and depth
# limits; find_limits_noheap omits it.
/abcd/
    abcd\=find_limits
Minimum heap limit = 1
Minimum match limit = 2
Minimum depth limit = 2
 0: abcd
    abcd\=find_limits_noheap
Minimum match limit = 2
Minimum depth limit = 2
 0: abcd
