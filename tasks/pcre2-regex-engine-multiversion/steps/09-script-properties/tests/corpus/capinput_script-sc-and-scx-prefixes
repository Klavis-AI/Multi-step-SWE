# sc: matches the basic script only; scx: also matches the extensions list.
/^\p{sc:Arabic}$/utf
    \x{627}
    \x{640}
    \x{64b}

/^\p{scx:Arabic}$/utf
    \x{627}
    \x{640}
    \x{64b}

/^\p{sc:Katakana}$/utf
    \x{30fc}

/^\p{scx:Katakana}$/utf
    \x{30fc}

# "script" and "script_extensions" are the full names, and = replaces :.
/^\p{script:Greek}$/utf
    \x{3b1}

/^\p{script=Greek}$/utf
    \x{3b1}

/^\p{script_extensions:Katakana}$/utf
    \x{30fc}

/^\p{scx=Katakana}$/utf
    \x{30fc}

# Unassigned characters are in the Unknown script.
/^\p{sc:Unknown}$/utf
    \x{378}
    a

# A general category name is not a script name, and an unknown name is still
# a compile error.
/\p{sc:L}/utf
    a

/\p{scx:Nosuchscript}/utf
    a

/\P{script=Zzzz_Not_A_Script}/utf
    a
