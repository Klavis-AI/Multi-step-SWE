# PCRE2_LITERAL makes the whole pattern a literal string, and the extra options
# MATCH_LINE and MATCH_WORD wrap it so that it matches only a complete line or
# word.  ChangeLog 10.30 items 40, 41 and 42; pcre2api.3, "Extra compile
# options"; pcre2test.1, "Setting compilation options" / "Specifying literal
# subject lines".

/r.t*/literal,info
    xr.t*y
    rat

/r+t/literal,caseless
    xR+Ty

# Option bits that cannot apply to a literal are a compile error.
/r.t/literal,dotall

/gnu/match_word,info
    the gnu grazes
    lawngnuts
    gnu

/gnu/match_line,info
    gnu
    a gnu

/r+t/subject_literal
    r+t
    rrt
