# PCRE2_ENDANCHORED requires the match to end at the end of the subject.  It is
# both a compile option and a match option, and it applies to the alternative
# matching function too.  ChangeLog 10.30 item 19; pcre2api.3, "Compiling a
# pattern"; pcre2test.1, "Setting compilation options" / "Setting match
# options".

/mark\d/endanchored,info
    see mark7
    see mark7 here

/mark\d/
    see mark7\=endanchored
    see mark7 here\=endanchored
    see mark7 here

/mark\d/
    see mark7\=endanchored,dfa
    see mark7 here\=endanchored,dfa

# With a global match the option applies to every attempt.
/\w+/g,endanchored
    one two three

# ENDANCHORED still allows the match to start anywhere.
/(\w)\w*/endanchored
    abc def
