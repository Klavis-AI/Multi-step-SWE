# The experimental foreign-pattern conversion facility: a converted pattern is
# printed and then compiled, and a failed conversion reports an offset and a
# message.  ChangeLog 10.30 item 50; pcre2convert.3, "THE CONVERSION FUNCTION" /
# "CONVERTING GLOBS" / "CONVERTING POSIX PATTERNS"; pcre2test.1, "Testing
# foreign pattern conversion".

/*.tar.gz/convert=glob
    notes.tar.gz
    deep/notes.tar.gz

!data/**/report?.txt!convert=glob,convert_glob_separator=/
    data/q1/q2/reportA.txt
    data/reportA.txt

/*.tar.gz/convert=glob:glob_no_wild_separator
    deep/notes.tar.gz

/^ab*\(c\)$/convert=posix_basic,info
    abbbc

/^a(b|c)+d$/convert=posix_extended
    abcbd

/[abc/convert=posix_extended

/*.log/convert=glob,convert_length=4
