# A second option word on the compile context: the PCRE2_EXTRA_* mechanism with
# its first two members.  ChangeLog 10.30 items 33 and 37; pcre2api.3, "Extra
# compile options"; pcre2test.1, "Setting compilation options".

# ALLOW_SURROGATE_ESCAPES permits \x{d800}-\x{dfff} in UTF-8 and UTF-32 mode and
# is a compile error, with its own message, in UTF-16 mode.
/^\x{d800}\x{dfff}$/utf,allow_surrogate_escapes,info

/^\x{db80}$/utf,allow_surrogate_escapes,caseless

/^\x{d800}$/utf

# BAD_ESCAPE_IS_LITERAL turns an unrecognized escape into the literal
# character instead of a compile error.
/^r\qs$/bad_escape_is_literal,info
    rqs

/^r\qs$/

/^[r\q]+$/bad_escape_is_literal
    rqqr

/^[r\q]+$/
