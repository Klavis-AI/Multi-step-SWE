# "Starting with release 10.30, recursive subroutine calls are no longer
# treated as atomic. That is, they can be re-entered to try unused
# alternatives if there is a matching failure later in the pattern."
# ChangeLog 10.30 item 1; pcre2pattern.3, "Differences in recursion processing
# between PCRE2 and Perl".

/^(p|pq)(?1)$/
    pqpq
    pp
    pqp

/^(p|pq)(?1)(?1)$/
    ppqpq
    ppp

# A palindrome written with the short branch first only works if the recursion
# can be re-entered to try its other branch.
/^([0-9]?|([a-z])(?1)\2)$/
    abc7cba
    abccba
    abc8dba
    q

# "If you want a subroutine call to be atomic, you must explicitly enclose it
# in an atomic group."
/^(?>(p|pq))(?>(?1))$/
    pqpq
    pp
