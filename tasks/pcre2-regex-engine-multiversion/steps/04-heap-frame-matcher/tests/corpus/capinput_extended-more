# PCRE2_EXTENDED_MORE does everything PCRE2_EXTENDED does and also ignores an
# unescaped space or horizontal tab inside a character class.  /xx is its short
# spelling, (?xx) sets it and (?-xx) unsets it, and (?x) does not imply it.
# ChangeLog 10.30 item 29; pcre2pattern.3, "INTERNAL OPTION SETTING";
# pcre2test.1, "Setting compilation options".

/a b[c d]e/xx,info
    abce
    abde
    ab e

/a b[c d]e/x,info
    abce
    ab e

/^a(?xx) b[c d]e$/
    abce
    ab e

/^(?xx)a b[c d](?-xx)f g$/
    abcf g
    abcfg

# A space in a class can still be matched when it is escaped or in a range.
/^[a\ b]+$/xx
    a b
