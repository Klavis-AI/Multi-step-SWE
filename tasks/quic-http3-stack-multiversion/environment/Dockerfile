# Agent environment. The candidate implements the QUIC and HTTP/3 stack as a
# Rust workspace at /app; this image carries the same toolchain the verifiers
# use, plus the one thing the candidate cannot produce for itself.
#
# One image serves all fifteen steps (`environment_mode = "separate"` gives each
# step a fresh container from it), so everything a *later* step needs is present
# from step 1. The agent phase has no network -- `task.toml` -> `[agent]
# network_mode = "allowlist"` leaves the model's own inference endpoint as the
# only reachable host -- so everything the candidate's build resolves has to be
# in this image already, exactly as it is in the verifier images. Both are
# pre-populated here: BoringSSL below, the crate graph after it.
FROM rust:1.88-bookworm
# 1.88 is not an arbitrary modern toolchain: it is exactly the last milestone's
# declared `rust-version`, and it satisfies every earlier milestone's. Pinning
# it here and generating each step's Cargo.lock with the same cargo is what
# keeps a lockfile from resolving to a crate the toolchain cannot compile.

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash build-essential ca-certificates clang libclang-dev cmake coreutils curl \
       diffutils gawk git golang-go iproute2 jq less libev-dev libssl-dev \
       ninja-build perl pkg-config procps python3 ripgrep tar uuid-dev \
       xxd zstd \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_TERM_COLOR=never

# --- BoringSSL ---------------------------------------------------------------
#
# Upstream carries BoringSSL as a git submodule and rebuilds it from source on
# every `cargo build`. The candidate's workspace never contains it: a submodule
# is not source the milestone is about, it is 400 MB of someone else's C, and
# the verifier has neither the network to fetch it nor the hour to compile it.
#
# So each release's pinned commit is built here, once, and the candidate's build
# script is pointed at the result through `QUICHE_BSSL_PATH` -- the escape hatch
# upstream's own build script reads, so nothing about this is special-cased for
# the task. Which pin belongs to which step is in that step's workdir, and the
# verifier sets the variable itself at grade time.
#
# Fifteen releases share six pins: steps 6 to 14 all pin f1c75347, and step 15
# has no submodule at all -- it links the crates.io binding, whose source ships
# inside the crate.
COPY bssl-build.sh /usr/local/bin/bssl-build.sh
RUN chmod +x /usr/local/bin/bssl-build.sh \
    && bssl-build.sh f18bd55240b229a65df48e7905da98fff18cbf59 /opt/bssl/f18bd552 \
    && bssl-build.sh 1e859054c31ec7b974e998373e85fadea56d93ad /opt/bssl/1e859054 \
    && bssl-build.sh 88024df12147e56b6abd66b743ff441a0aaa09a8 /opt/bssl/88024df1 \
    && bssl-build.sh 597b810379e126ae05d32c1d94b1a9464385acd0 /opt/bssl/597b8103 \
    && bssl-build.sh 067cfd92f4d7da0edfa073b096d090b98a83b860 /opt/bssl/067cfd92 \
    && bssl-build.sh f1c75347daa2ea81a941e953f2263e0a4d970c8d /opt/bssl/f1c75347

# --- registry cache ----------------------------------------------------------
#
# The candidate implements the stack in a Rust workspace whose dependency graph
# is the release's own: ring or boring for crypto, mio for the sockets, tokio,
# serde, url, the benchmarks. With no network at agent time, none of that can be
# resolved at /app -- `cargo build` would fail on its first dependency and the
# step would score zero for what looks like a model failure.
#
# So each step's dependency set is fetched here, once. assets/prefetch/NN holds
# a stand-in crate for step NN -- a manifest pinning that step's whole fetched
# dependency set to the exact versions its own Cargo.lock names, a stub src/,
# and the step's frozen lock with its workspace members replaced by the
# stand-in -- generated by environment/bin/gen-prefetch.py. NN is the lock that
# ships in that step's workdir; three steps (07, 09, 10) ship the *previous*
# release's lock over the target release's tree, so their target graph is a
# second directory, NN-target. NN-prev and NN-harness are the two graphs the
# verifier prewarms beside those and that a milestone's own resolution can
# reach: the previous release's, which a candidate who has not done the work
# yet presents, and the grader's harness crate's, which the union has to cover
# for the subsets below to be the verifier's cache exactly. One CARGO_HOME
# accumulates their union, so everything any of the fifteen steps can resolve
# is present from step 1.
#
# The milestone's own crates -- quiche, qlog, octets, h3i, tokio-quiche -- are
# path packages with no source in any lock, so they are dropped rather than
# fetched: this bakes the dependencies, never the answer. Step 14's
# `wirefilter-engine`, which is a git dependency of qlog-dancer, is pinned to
# its revision and fetched into $CARGO_HOME/git for the same reason -- with no
# network, a checkout that is not already there is a build failure.
COPY assets/prefetch /opt/prefetch
RUN set -eu; \
    for d in /opt/prefetch/*/; do \
        [ -f "$d/Cargo.toml" ] || continue; \
        echo "prefetching $d"; \
        ( cd "$d" && cargo fetch --locked ); \
    done

# --- per-milestone dependency sets -------------------------------------------
#
# A union cache is one thing; what a *milestone* may resolve is another. The
# verifier image for step NN carries step NN's set alone -- its shipped lock,
# the graph the target manifests resolve to, the previous release's graph and
# its own harness crate's graph -- and a candidate whose build resolves
# something outside it loses the step at grading time. Offline, that failure is
# silent from inside this container: the union answers, the build succeeds, and
# nothing says the grader's cache will not.
#
# So each milestone's subset of the union is materialised here as a cargo
# *directory source*, and the step itself points `crates-io` at it (the step's
# `workdir/setup.sh` writes `$CARGO_HOME/config.toml` before the agent starts;
# see `bin/make-vendor.py` for why the links are hard links).
#
# It is built from NN-locks/ -- the four REAL lock files, copied here by
# gen-prefetch.py -- and not from the NN* stand-in locks the loop above
# fetches. Those are supersets: a stand-in names every crate as a direct
# dependency with default features, so cargo's feature unification reaches
# optional dependencies the real graph never enables (crossbeam-deque is in
# step 13's prefetch lock and in no lock of step 13's tree), and a vendor
# directory built from them would keep exactly the hole this is here to close.
# The stand-ins stay what the image fetches, so the cache is a superset of the
# four locks and nothing is missing from it.
COPY bin/make-vendor.py /usr/local/bin/make-vendor.py
RUN chmod +x /usr/local/bin/make-vendor.py \
    && set -eu; \
    mkdir -p /opt/vendor; \
    for d in /opt/prefetch/[0-9][0-9]; do \
        num=$(basename "$d"); \
        python3 /usr/local/bin/make-vendor.py \
            "/opt/vendor/$num" "$CARGO_HOME" /opt/prefetch/$num-locks/*.lock; \
    done; \
    rm -rf /opt/prefetch

# The file the step's setup.sh rewrites. Empty to begin with: with no
# replacement in it, `crates-io` is the ordinary registry, which is what the
# image-build fetches above needed. World-writable so the step can write it
# whatever user it runs as.
RUN set -eu; \
    : > "$CARGO_HOME/config.toml"; \
    chmod a+rw "$CARGO_HOME/config.toml"

# Same widening the verifier images do, and for the same reason: some crates
# ship source with no other-read bit, and an agent that chooses to build as a
# non-root user must not hit a permission error on a dependency it never named.
#
# The vendor trees are deliberately NOT in this loop. Their files are hard
# links into the registry cache, so widening the cache widens them too -- one
# inode, one mode -- and the directories `make-vendor.py` creates are already
# 0755. Walking them here would be a quarter of a million chmods that change
# nothing, and it measurably costs minutes of image-build time.
RUN set -eu; \
    for d in "$CARGO_HOME/registry" "$CARGO_HOME/git"; do \
        [ -d "$d" ] || continue; \
        chmod -R a+rX "$d"; \
        find "$d" -type d -exec chmod a+w {} +; \
    done

WORKDIR /app

# Keep the script and every step's timeout_sec synchronized. The script is an
# agent-visible countdown; Harbor enforces the actual timeout.
COPY timer.sh /app/timer.sh
RUN chmod +x /app/timer.sh
