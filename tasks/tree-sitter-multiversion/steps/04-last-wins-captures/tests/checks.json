      "predicate_capture": "pattern: 1\n    capture: 1 - i, start: (0, 4), end: (0, 5), text: `a`",
      "negated_field_capture": "pattern: 2\n    capture: 2 - g, start: (2, 0), end: (2, 2), text: `c!`"
