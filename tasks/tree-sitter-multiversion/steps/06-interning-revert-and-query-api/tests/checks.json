      "id": "s06_single_element_unreported_bodies",
      "stage": {
        "s06/single_element": "."
      },
      "write": {
        "grammar.js": "module.exports = grammar({\n  name: 'alxsingle',\n  extras: $ => [/\\s/],\n  rules: {\n    source_file: $ => repeat($.item),\n    item: $ => seq($.seq_of_string, $.choice_of_pattern,\n                   $.choice_of_string, $.seq_of_pattern,\n                   $.seq_of_two, $.repeat_one, $._plain_wrap, $._hidden_seq, ';'),\n    seq_of_string: $ => seq('aa'),\n    choice_of_pattern: $ => choice(/[0-9]+/),\n    choice_of_string: $ => choice('bb'),\n    seq_of_pattern: $ => seq(/[A-Z]+/),\n    seq_of_two: $ => seq('a', 'b'),\n    repeat_one: $ => repeat1('rr'),\n    _plain_wrap: $ => seq($.id),\n    _hidden_seq: $ => seq('cc'),\n    id: $ => /[a-z]+/,\n  }\n});\n"
      },
      "steps": [
        {
          "kind": "cli",
          "args": [
            "generate"
          ],
          "stream": "stderr",
          "contains": {
            "seq_of_string": "seq_of_string",
            "choice_of_pattern": "choice_of_pattern",
            "choice_of_string": "choice_of_string",
            "seq_of_pattern": "seq_of_pattern",
            "seq_of_two": "seq_of_two",
            "repeat_one": "repeat_one",
            "hidden_seq": "_hidden_seq"
          }
        }
      ],
      "expect": {
        "cli_exit_code": 0,
        "cli_exit_zero": true,
        "contains:choice_of_pattern": true,
        "contains:choice_of_string": true,
        "contains:repeat_one": false,
        "contains:seq_of_pattern": true,
        "contains:seq_of_string": true,
        "contains:seq_of_two": false,
        "contains:hidden_seq": true
      }
    },
