  {
   "id": "g01_expression_precedence",
   "stage": {
    "common/alx": "."
   },
   "remove": [
    "test"
   ],
   "write": {
    "grammar.js": "module.exports = grammar({\n  name: 'alx',\n  extras: $ => [/\\s/],\n  rules: {\n    source_file: $ => repeat($._stmt),\n    _stmt: $ => seq($._expr, ';'),\n    _expr: $ => choice($.num, $.ident, $.bin, $.paren),\n    paren: $ => seq('(', $._expr, ')'),\n    bin: $ => choice(\n      prec.left(1, seq($._expr, '+', $._expr)),\n      prec.left(2, seq($._expr, '*', $._expr))\n    ),\n    num: $ => /[0-9]+/,\n    ident: $ => /[a-z]+/,\n  }\n});\n",
    "in.alx": "1 + 2 * x;\n(a+b)*3;\n"
   },
   "steps": [
    {
     "kind": "generate"
    },
    {
     "kind": "parse",
     "input": "in.alx"
    }
   ],
   "expect": {
    "generate_exit_zero": true,
    "parse_exit_zero": true,
    "tree": "(source_file [0, 0] - [2, 0]\n  (bin [0, 0] - [0, 9]\n    (num [0, 0] - [0, 1])\n    (bin [0, 4] - [0, 9]\n      (num [0, 4] - [0, 5])\n      (ident [0, 8] - [0, 9])))\n  (bin [1, 0] - [1, 7]\n    (paren [1, 0] - [1, 5]\n      (bin [1, 1] - [1, 4]\n        (ident [1, 1] - [1, 2])\n        (ident [1, 3] - [1, 4])))\n    (num [1, 6] - [1, 7])))"
   }
  },
  {
   "id": "g02_associativity_and_unary",
   "stage": {
    "common/alx": "."
   },
   "remove": [
