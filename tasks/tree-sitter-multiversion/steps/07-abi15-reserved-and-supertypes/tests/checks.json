   "write": {
    "grammar.js": "module.exports = grammar({\n  name: 'alx',\n  extras: $ => [/\\s/],\n  rules: {\n    source_file: $ => $._expr,\n    _expr: $ => choice($.id, $.add, $.pow, $.neg),\n    add:  $ => prec.left(1, seq($._expr, '-', $._expr)),\n    pow:  $ => prec.right(2, seq($._expr, '^', $._expr)),\n    neg:  $ => prec(3, seq('-', $._expr)),\n    id: $ => /[a-z]+/,\n  }\n});\n",
    "l.alx": "a - b - c",
    "r.alx": "a ^ b ^ c",
    "m.alx": "a - b ^ c",
    "u.alx": "- a - b"
   },
   "steps": [
    {
     "kind": "generate"
    },
    {
     "kind": "parse",
     "input": "l.alx",
     "prefix": "left_"
    },
    {
     "kind": "parse",
     "input": "r.alx",
     "prefix": "right_"
    },
    {
     "kind": "parse",
     "input": "m.alx",
     "prefix": "mixed_"
    },
    {
     "kind": "parse",
     "input": "u.alx",
     "prefix": "unary_"
    }
   ],
   "expect": {
    "generate_exit_zero": true,
    "left_parse_exit_zero": true,
    "left_tree": "(source_file [0, 0] - [0, 9]\n  (add [0, 0] - [0, 9]\n    (add [0, 0] - [0, 5]\n      (id [0, 0] - [0, 1])\n      (id [0, 4] - [0, 5]))\n    (id [0, 8] - [0, 9])))",
    "mixed_parse_exit_zero": true,
    "mixed_tree": "(source_file [0, 0] - [0, 9]\n  (add [0, 0] - [0, 9]\n    (id [0, 0] - [0, 1])\n    (pow [0, 4] - [0, 9]\n      (id [0, 4] - [0, 5])\n      (id [0, 8] - [0, 9]))))",
    "right_parse_exit_zero": true,
    "right_tree": "(source_file [0, 0] - [0, 9]\n  (pow [0, 0] - [0, 9]\n    (id [0, 0] - [0, 1])\n    (pow [0, 4] - [0, 9]\n      (id [0, 4] - [0, 5])\n      (id [0, 8] - [0, 9]))))",
