    "q.scm": "((item (id)+ @all) (#eq? @all \"keep\"))\n((item (id) @m) (#match? @m \"^d\"))\n((item (id) @n) (#not-eq? @n \"keep\"))\n",
    "in.alx": "keep;\ndrop other;\n"
   },
   "steps": [
    {
     "kind": "generate"
    },
    {
     "kind": "cli",
     "stream": "stdout",
     "args": [
      "query",
      "q.scm",
      "in.alx"
     ],
     "contains": {
      "path_line": "in.alx",
      "eq_capture": "pattern: 0\n    capture: 0 - all, start: (0, 0), end: (0, 4), text: `keep`",
      "match_capture": "pattern: 1\n    capture: 1 - m, start: (1, 0), end: (1, 4), text: `drop`",
      "noteq_first": "pattern: 2\n    capture: 2 - n, start: (1, 0), end: (1, 4), text: `drop`",
      "noteq_second": "pattern: 2\n    capture: 2 - n, start: (1, 5), end: (1, 10), text: `other`"
     }
    }
   ],
