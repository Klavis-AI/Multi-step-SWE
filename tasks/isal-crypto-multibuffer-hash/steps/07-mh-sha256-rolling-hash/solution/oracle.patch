+	vadd.vv	\T1, \T1, TT4
+	vle32.v	TT4, (P3)
+	vadd.vv	TT6, TT6, TT4
+	vadd.vv	\T1, \T1, TT6
+
+	ROUND_00_15_W \a, \b, \c, \d, \e, \f, \g, \h, \T1, \i, \data
