+ISAL_SHA512_HASH_CTX *
+_sha512_ctx_mgr_submit_avx(ISAL_SHA512_HASH_CTX_MGR *mgr, ISAL_SHA512_HASH_CTX *ctx,
+                           const void *buffer, uint32_t len, ISAL_HASH_CTX_FLAG flags)
