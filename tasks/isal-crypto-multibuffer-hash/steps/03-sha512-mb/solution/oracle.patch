index 0000000..098b612
--- /dev/null
+++ b/sha512_mb/aarch64/sha512_mb_x1_ce.S
@@ -0,0 +1,270 @@
+/**********************************************************************
+  Copyright(c) 2019 Arm Corporation All rights reserved.
+
+  Redistribution and use in source and binary forms, with or without
