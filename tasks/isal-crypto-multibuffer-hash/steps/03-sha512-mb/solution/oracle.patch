+static inline void
+hash_init_digest(ISAL_SHA512_WORD_T *digest)
+{
+        static const ISAL_SHA512_WORD_T hash_initial_digest[ISAL_SHA512_DIGEST_NWORDS] = {
+                ISAL_SHA512_INITIAL_DIGEST
