+DEFINE_INTERFACE_DISPATCHER(_sha512_ctx_mgr_submit)
+{
+        unsigned long auxval = getauxval(AT_HWCAP);
+        if (auxval & HWCAP_SHA3)
+                return PROVIDER_INFO(sha512_ctx_mgr_submit_ce);
+
+        return PROVIDER_BASIC(_sha512_ctx_mgr_submit);
+}
+
+DEFINE_INTERFACE_DISPATCHER(_sha512_ctx_mgr_init)
+{
+        unsigned long auxval = getauxval(AT_HWCAP);
+        if (auxval & HWCAP_SHA3)
+                return PROVIDER_INFO(sha512_ctx_mgr_init_ce);
+
+        return PROVIDER_BASIC(_sha512_ctx_mgr_init);
+}
+
+DEFINE_INTERFACE_DISPATCHER(_sha512_ctx_mgr_flush)
+{
+        unsigned long auxval = getauxval(AT_HWCAP);
+        if (auxval & HWCAP_SHA3)
+                return PROVIDER_INFO(sha512_ctx_mgr_flush_ce);
+
+        return PROVIDER_BASIC(_sha512_ctx_mgr_flush);
+}
