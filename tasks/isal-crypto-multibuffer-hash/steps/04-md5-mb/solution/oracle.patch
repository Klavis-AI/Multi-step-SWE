+
+%define p               r11
+
+%define unused_lanes    rbx
+
+%define job_rax         rax
+%define len             rax
+
+%define num_lanes_inuse r9
+
+%define lane_data       r10
+
+%endif ; if 1
+
+; STACK_SPACE needs to be an odd multiple of 8
+%define STACK_SPACE     8*8 + 16*10 + 8
