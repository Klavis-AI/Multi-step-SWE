+
+.macro	declare_var_vector_reg name:req,reg:req
+	q_\name	.req	q\reg
+	v_\name	.req	v\reg
+	s_\name	.req	s\reg
+.endm
+
+
+.macro	round_0_15	d_a:req,d_b:req,d_c:req,d_d:req,kh:req,kl:req,w:req,r:req
+	eor	tmp0,\d_c,\d_d
+	mov	k,\kl
+	and	tmp0,tmp0,\d_b
+	movk	k,\kh,lsl 16
+	eor	tmp0,tmp0,\d_d
+	add	tmp1,k,\w
+	add	tmp0,tmp1,tmp0
+	add	tmp0,\d_a,tmp0
+	ror	tmp0,tmp0,32 - \r
+	add	\d_a,\d_b,tmp0
+.endm
+
+.macro	round_16_31	d_a:req,d_b:req,d_c:req,d_d:req,kh:req,kl:req,w:req,r:req
+	eor	tmp0,\d_b,\d_c
+	mov	k,\kl
+	and	tmp0,tmp0,\d_d
+	movk	k,\kh,lsl 16
