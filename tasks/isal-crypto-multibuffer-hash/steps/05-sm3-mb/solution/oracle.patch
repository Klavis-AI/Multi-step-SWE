+static ISAL_SM3_HASH_CTX *
+sm3_ctx_mgr_resubmit(ISAL_SM3_HASH_CTX_MGR *mgr, ISAL_SM3_HASH_CTX *ctx)
+{
+        while (ctx) {
+
+                if (ctx->status & ISAL_HASH_CTX_STS_COMPLETE) {
+                        ctx->status = ISAL_HASH_CTX_STS_COMPLETE; // Clear PROCESSING bit
