+	ext	vjob0_dig0.16b,vjob0_dig0.16b,vjob0_dig0.16b,#8
+	ext	vjob0_dig1.16b,vjob0_dig1.16b,vjob0_dig1.16b,#8
+	rev64	vjob0_dig0.16b,vjob0_dig0.16b
+	rev64	vjob0_dig1.16b,vjob0_dig1.16b
