+	mov 	Tj, 17689
+	umov	dig_A,vdig0.s[0]
+	movk	Tj, 0x79cc, lsl 16
+	rev32	vvect_msg0.16b,vvect_msg0.16b
+	umov	dig_B,vdig0.s[1]
+	rev32	vvect_msg1.16b,vvect_msg1.16b
