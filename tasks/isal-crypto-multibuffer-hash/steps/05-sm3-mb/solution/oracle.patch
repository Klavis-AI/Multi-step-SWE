+%macro ROTATE_ARGS 0
+	%xdefine TMP_ D
+	%xdefine D C
+	%xdefine C B
+	%xdefine B A
+	%xdefine A TMP3
+	%xdefine TMP3 TMP_
+
+	%xdefine TMP2_ H
+	%xdefine H G
+	%xdefine G F
+	%xdefine F E
+	%xdefine E TMP0
+	%xdefine TMP0 TMP2_
+%endmacro
+
+;
+; P() Save in TMP0
+; used TMP1
+%macro P 1
+%define %%A     %1
+        vprold TMP0,%%A,9
+        vprold TMP1,%%A,17
+
+        vpternlogd TMP0,TMP1,%%A,0x96
+
+%endmacro
+
+;
+; P1() Save in TMP0
+; used TMP1
+%macro P1 1
+%define %%A 	%1
+
+	vprold TMP0,%%A,15
+	vprold TMP1,%%A,23
+
+	vpternlogd TMP0,TMP1,%%A,0x96
+%endmacro
+
+;
+; FF_16() Save in TMP0
+;
+%macro FF_16 3
+%define %%X 	%1
+%define %%Y 	%2
+%define %%Z 	%3
+	; I < 16 return (X ^ Y ^ Z)
+	vmovups TMP0,%%X
+	vpternlogd TMP0,%%Y,%%Z,0x96
+%endmacro
+
+
+;
+; FF_64() Save in TMP0
+; used TMP1
+%macro FF_64 3
+
+%define %%X 	%1
+%define %%Y 	%2
+%define %%Z 	%3
+	; I > 16 return (x & y) | (x & z) | (y & z)
+	; Same as (x & y) | (z & (x | y))
+	vmovdqa32 TMP0,%%X
+	vpternlogd TMP0, %%Y, %%Z, 0xE8 ; Majority function
+%endmacro
+
+
+;
+; GG() Save in TMP0
+; used TMP1
+%macro GG_16 3
+%define %%X 	%1
+%define %%Y 	%2
+%define %%Z 	%3
+	; I < 16 return (x ^ y ^ z)
+        vmovups TMP0,%%X
+        vpternlogd TMP0,%%Y,%%Z,0x96
+%endmacro
+
+%macro GG_64 3
+
+%define %%X 	%1
+%define %%Y 	%2
+%define %%Z 	%3
+
+	; I > 16 return (x & y) | ((~x) & z)
+	vmovdqa32 TMP0,%%X
+	vpternlogd TMP0, %%Y, %%Z, 0xCA	; X? Y : Z
+%endmacro
