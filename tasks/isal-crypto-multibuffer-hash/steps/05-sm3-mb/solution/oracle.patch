+	VA	.req z0
+	VB	.req z1
+	VC	.req z2
+	VD	.req z3
+	VE	.req z4
+	VF	.req z5
+	VG	.req z6
+	VH	.req z7
+	TMPV0	.req v8
+	TMPV1	.req v9
+	TMPV2	.req v10
+	TMPV3	.req v11
+	WORD0	.req z8
+	WORD1	.req z9
+	WORD2	.req z10
+	WORD3	.req z11
+	WORD4	.req z12
+	WORD5	.req z13
+	WORD6	.req z14
