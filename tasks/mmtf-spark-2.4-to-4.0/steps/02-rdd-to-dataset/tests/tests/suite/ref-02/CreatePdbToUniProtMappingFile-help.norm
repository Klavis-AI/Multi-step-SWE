usage: CreatePdbToUniProtMappingFile
 -b,--build                     build a new dataset (slow!)
 -c,--compression-codec <arg>   gzip or snappy for parquet, zlib or lzo
                                for orc
 -f,--file-format <arg>         parquet, orc
 -h,--help                      help
 -o,--output-file <arg>         path to output file
 -u,--update                    update cached dataset
