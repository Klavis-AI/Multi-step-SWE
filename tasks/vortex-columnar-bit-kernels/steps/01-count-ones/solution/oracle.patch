+unsafe fn count_ones_aligned_avx2_any_len(bytes: &[u8]) -> usize {
+    if bytes.len() >= 32 {
+        // SAFETY: the caller guarantees AVX2.
+        return unsafe { count_ones_aligned_avx2(bytes) };
+    }
     count_ones_aligned_scalar(bytes)
 }
 
