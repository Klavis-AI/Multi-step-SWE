[package]
name = "probe"
version = "0.1.0"
edition = "2021"
publish = false

# Its own workspace root, so the path dependencies below resolve against the
# tree under test without this crate joining that tree's workspace.
[workspace]

# @TREEROOT@ is substituted at build time: /base for the denominator binary that
# the verifier image bakes, /app/vortex for the candidate's.
[dependencies]
vortex-buffer = { path = "@TREEROOT@/vortex-buffer" }
vortex-mask = { path = "@TREEROOT@/vortex-mask" }
vortex-array = { path = "@TREEROOT@/vortex-array" }
vortex-error = { path = "@TREEROOT@/vortex-error" }

[profile.release]
debug = false
