# MySQL 5.7 server configuration for the WebGoatPHP deployment.
#
# sql_mode is the permissive setting this deployment has always run with: it is
# what MySQL 5.5/5.6 shipped as the default, kept unchanged when the server was
# upgraded to 5.7 binaries. Server character set is latin1, as it was when the
# schema in SQL/webgoat.sql was first loaded.
[mysqld]
user                            = mysql
basedir                         = /opt/mysql57
datadir                         = /var/lib/mysql
socket                          = /var/run/mysqld/mysqld.sock
pid-file                        = /var/run/mysqld/mysqld.pid
port                            = 3306
bind-address                    = 127.0.0.1
log-error                       = /var/log/mysql/error.log
secure_file_priv                = /var/lib/mysql-files

sql_mode                        = NO_ENGINE_SUBSTITUTION
character-set-server            = latin1
collation-server                = latin1_swedish_ci
default-storage-engine          = InnoDB
explicit_defaults_for_timestamp = OFF

innodb_buffer_pool_size         = 256M
innodb_log_file_size            = 24M
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT_NO_FSYNC
max_connections                 = 200
performance_schema              = OFF

[client]
socket                          = /var/run/mysqld/mysqld.sock
port                            = 3306

[mysqld_safe]
socket                          = /var/run/mysqld/mysqld.sock
