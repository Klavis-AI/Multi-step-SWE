#!/bin/sh
### BEGIN INIT INFO
# Provides:          mysql
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MySQL 5.7 Community Server
### END INIT INFO
#
# MySQL 5.7.44 is installed under /opt/mysql57 (the Debian archive carries no
# 5.7 packages). This script gives it the usual "service mysql start|stop"
# interface, reading /etc/mysql/my.cnf like the distribution package would.

set -e

BASEDIR=/opt/mysql57
DATADIR=/var/lib/mysql
PIDFILE=/var/run/mysqld/mysqld.pid
SOCKET=/var/run/mysqld/mysqld.sock
LOGFILE=/var/log/mysql/error.log

export LD_LIBRARY_PATH=/opt/mysql57/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

prepare_dirs() {
	mkdir -p /var/run/mysqld /var/log/mysql /var/lib/mysql-files
	chown mysql:mysql /var/run/mysqld /var/log/mysql /var/lib/mysql-files
	chmod 750 /var/lib/mysql-files
}

running() {
	[ -S "$SOCKET" ] && "$BASEDIR/bin/mysqladmin" --socket="$SOCKET" -uroot ping >/dev/null 2>&1
}

case "$1" in
	start)
		if running; then
			echo "mysql is already running."
			exit 0
		fi
		prepare_dirs
		echo -n "Starting MySQL 5.7 ..."
		nohup "$BASEDIR/bin/mysqld" --defaults-file=/etc/mysql/my.cnf \
			>>"$LOGFILE" 2>&1 &
		i=0
		while [ $i -lt 90 ]; do
			if running; then
				echo " done."
				exit 0
			fi
			i=$((i + 1))
			sleep 1
		done
		echo " failed. See $LOGFILE."
		exit 1
		;;
	stop)
		if ! running; then
			echo "mysql is not running."
			exit 0
		fi
		echo -n "Stopping MySQL 5.7 ..."
		"$BASEDIR/bin/mysqladmin" --socket="$SOCKET" -uroot shutdown
		i=0
		while [ $i -lt 90 ]; do
			if ! running; then
				echo " done."
				exit 0
			fi
			i=$((i + 1))
			sleep 1
		done
		echo " failed."
		exit 1
		;;
	restart | force-reload)
		"$0" stop
		"$0" start
		;;
	status)
		if running; then
			echo "mysql is running."
			exit 0
		fi
		echo "mysql is not running."
		exit 3
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 2
		;;
esac
