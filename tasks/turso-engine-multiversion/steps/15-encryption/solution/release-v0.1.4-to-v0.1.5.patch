+                                assert_eq!(scan.table_name, "users");
+                            }
+                            _ => panic!("Expected TableScan"),
+                        }
+                    }
+                    _ => panic!("Expected Filter"),
+                }
+            }
+            _ => panic!("Expected Projection"),
+        }
+    }
