+        let state = pager
+            .io
+            .block(|| filter.commit(init_data.clone(), &mut cursor))
+            .unwrap();
+
+        // Verify initial state (only Alice passes filter)
+        assert_eq!(state.changes.len(), 1);
+        assert_eq!(state.changes[0].0.rowid, 1);
