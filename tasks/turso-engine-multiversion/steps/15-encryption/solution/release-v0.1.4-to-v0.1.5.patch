+        let s = s.as_ref();
+        let bytes = s.as_bytes();
+
+        if s.is_empty() {
+            return Name::Ident(s.to_string());
+        }
+
+        match bytes[0] {
+            b'"' | b'\'' | b'`' | b'[' => Name::Quoted(s.to_string()),
+            _ => Name::Ident(s.to_string()),
+        }
+    }
