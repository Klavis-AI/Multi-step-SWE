+        if st.cursor >= st.end {
+            return None;
+        }
+
+        let (JsonbHeader(_, payload_len), header_len) = self.read_header(st.cursor).ok()?;
+        let start = st.cursor;
+        let stop = start.checked_add(header_len + payload_len)?;
