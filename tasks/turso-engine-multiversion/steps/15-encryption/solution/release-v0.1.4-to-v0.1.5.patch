+        &self,
+        s: &mut S,
+        context: &C,
+    ) -> Result<(), S::Error> {
+        match self {
+            Self::Comma => s.append(TK_COMMA, None),
+            Self::TypedJoin(join_type) => {
+                if let Some(ref join_type) = join_type {
+                    join_type.to_tokens(s, context)?;
