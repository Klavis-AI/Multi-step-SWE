+        // Do a full checkpoint to move all data to DB file
+        {
+            let pager = conn1.pager.borrow();
+            let mut wal = pager.wal.as_ref().unwrap().borrow_mut();
+            run_checkpoint_until_done(&mut *wal, &pager, CheckpointMode::Passive);
