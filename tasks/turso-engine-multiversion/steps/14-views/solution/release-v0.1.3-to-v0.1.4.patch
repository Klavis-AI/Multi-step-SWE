+        program.emit_insn(Insn::MakeRecord {
+            start_reg,
+            count: row_len,
+            dest_reg: record_reg,
+            index_name: Some(index.name.clone()),
+        });
+        program.emit_insn(Insn::IdxInsert {
+            cursor_id: *cursor_id,
+            record_reg,
+            unpacked_start: None,
+            unpacked_count: None,
+            flags: IdxInsertFlags::new().no_op_duplicate(),
+        });
+    }
