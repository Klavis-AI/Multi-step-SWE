+        // I do not see how this can error
+        let offset = &FixedOffset::east_opt(offset_sec).ok_or(TimeError::InvalidFormat)?;
+
+        let timezone_date = self.inner.with_timezone(offset);
+
+        Ok(timezone_date.format(fmt).to_string())
