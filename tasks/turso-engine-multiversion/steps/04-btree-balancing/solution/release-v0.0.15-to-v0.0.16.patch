+        );
+        assert_eq!(cast_text_to_numeric("xxx"), OwnedValue::Integer(0));
+        assert_eq!(
+            cast_text_to_numeric("1.7976931348623157e309"),
+            OwnedValue::Float(f64::INFINITY)
+        );
+        assert_eq!(
+            cast_text_to_numeric("-1.7976931348623157e308"),
+            OwnedValue::Float(f64::MIN)
+        );
+        assert_eq!(
