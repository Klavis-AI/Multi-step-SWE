+                )));
+            };
+
+            let sqlite_schema = schema
+                .get_btree_table(SQLITE_TABLEID)
+                .expect("sqlite_schema should be on schema");
+
+            let cursor_id = program.alloc_cursor_id(crate::vdbe::builder::CursorType::BTreeTable(
