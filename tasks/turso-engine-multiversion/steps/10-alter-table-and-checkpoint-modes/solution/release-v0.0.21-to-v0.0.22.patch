+
+        // Create a two-column index on (x,y)
+        let index = Arc::new(Index {
+            name: "idx_xy".to_string(),
+            table_name: "t1".to_string(),
+            columns: vec![
+                IndexColumn {
+                    name: "x".to_string(),
+                    order: SortOrder::Asc,
+                    pos_in_table: 0,
+                    collation: None,
+                    default: None,
+                },
+                IndexColumn {
+                    name: "y".to_string(),
+                    order: SortOrder::Asc,
+                    pos_in_table: 1,
