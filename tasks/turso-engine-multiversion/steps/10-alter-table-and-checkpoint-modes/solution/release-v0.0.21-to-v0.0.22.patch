+        "UPDATE employees SET salary = 75000 WHERE EXISTS (SELECT 1 FROM orders WHERE orders.employee_id = employees.id AND orders.status = 'pending');"
+    );
+
+    // UPDATE with FROM clause (join-like behavior)
