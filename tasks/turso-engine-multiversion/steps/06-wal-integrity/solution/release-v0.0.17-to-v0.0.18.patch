-fn parse_char_escape_sequence(pair: &Pair<'_, Rule>) -> String {
-    String::from(match pair.as_str() {
-        "b" => "\u{0008}",
-        "f" => "\u{000C}",
-        "n" => "\n",
-        "r" => "\r",
-        "t" => "\t",
-        "v" => "\u{000B}",
-        "0" => "\u{0000}",
-        c => c,
-    })
-}
