-fn parse_hex(s: &str) -> Result<i32> {
-    let (sign, trimmed) = match s.chars().next() {
-        Some('-') => (-1, &s[3..]), // skip "-0x" or "-0X"
-        Some('+') => (1, &s[3..]),  // skip "+0x" or "+0X"
-        _ => (1, &s[2..]),          // skip "0x" or "0X"
-    };
-    i32::from_str_radix(trimmed, 16)
-        .map(|v| v * sign)
-        .map_err(|_| de::Error::custom("error parsing hex"))
