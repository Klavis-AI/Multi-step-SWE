+                        writeln!(f, "{}   {}", indent, line)?;
+                    }
+                }
+            }
+        }
+        if let Some(order_by) = &self.order_by {
+            writeln!(f, "ORDER BY:")?;
+            for (expr, dir) in order_by {
+                writeln!(f, "  - {} {}", expr, dir)?;
+            }
+        }
+        if let Some(limit) = self.limit {
+            writeln!(f, "LIMIT: {}", limit)?;
+        }
