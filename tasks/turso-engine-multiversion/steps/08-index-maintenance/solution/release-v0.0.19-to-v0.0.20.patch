+    let Ok(eval_at_right) = determine_where_to_eval_expr(&rhs, join_order) else {
+        return false;
+    };
+    if eval_at_left == EvalAt::Loop(table_index) && eval_at_right == EvalAt::Loop(table_index) {
+        return false;
+    }
+    true
