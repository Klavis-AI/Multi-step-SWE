+    Sorter {
+        /// Cursor opened for the pseudo table that GROUP BY reads rows from.
+        pseudo_cursor: usize,
+        /// The sorter opened for ensuring the rows are in GROUP BY order.
+        sort_cursor: usize,
+        /// Register holding the key used for sorting in the Sorter
