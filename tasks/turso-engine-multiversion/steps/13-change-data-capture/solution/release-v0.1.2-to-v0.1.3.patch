+        let mut cursor = RecordCursor::with_capacity(key_len);
+        cursor.ensure_parsed_upto(&record, key_len - 1)?;
+        turso_assert!(
+            index_key_info.len() >= cursor.serial_types.len(),
+            "index_key_info.len() < cursor.serial_types.len()"
