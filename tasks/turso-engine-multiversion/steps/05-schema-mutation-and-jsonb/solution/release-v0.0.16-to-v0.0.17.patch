+#[inline]
+fn is_hex_digit(ch: u8) -> bool {
+    (CHARACTER_TYPE[ch as usize] & 3) == 2 || (CHARACTER_TYPE[ch as usize] & 3) == 3
+}
+
+#[inline]
+fn is_json_ok(ch: u8) -> bool {
+    (CHARACTER_TYPE_OK[ch as usize] & 4) != 0
+}
