+impl Jsonb {
+    pub fn new(capacity: usize, data: Option<&[u8]>) -> Self {
+        if let Some(data) = data {
+            return Self {
+                data: data.to_vec(),
+            };
+        }
+        Self {
+            data: Vec::with_capacity(capacity),
+        }
+    }
