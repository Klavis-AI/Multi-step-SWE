+        string.push(']');
+        Ok(current_cursor)
+    }
+
+    fn serialize_string(
+        &self,
+        string: &mut String,
+        cursor: usize,
+        len: usize,
+        kind: &ElementType,
+        quote: bool,
+    ) -> Result<usize> {
+        let word_slice = &self.data[cursor..cursor + len];
+        if quote {
+            string.push('"');
+        }
