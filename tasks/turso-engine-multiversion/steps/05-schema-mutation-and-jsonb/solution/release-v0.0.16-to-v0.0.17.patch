+            // Contain standard json escapes
+            ElementType::TEXTJ => {
+                let word = from_utf8(word_slice).map_err(|_| {
+                    LimboError::ParseError("Failed to serialize string!".to_string())
+                })?;
+                string.push_str(word);
+            }
