+        );
+
+        // Create (a = 1 AND x = 1 AND b = 1) OR (a = 1 AND y = 1 AND b = 1)
+        let or_expr = Expr::Binary(
+            Box::new(ast::Expr::Parenthesized(vec![rebuild_and_expr_from_list(
+                vec![a_expr.clone(), x_expr.clone(), b_expr.clone()],
