+            if let Some(args) = args {
+                for arg in args {
+                    walk_expr(arg, func)?;
+                }
+            }
+            if let Some(order_by) = order_by {
+                for sort_col in order_by {
+                    walk_expr(&sort_col.expr, func)?;
+                }
