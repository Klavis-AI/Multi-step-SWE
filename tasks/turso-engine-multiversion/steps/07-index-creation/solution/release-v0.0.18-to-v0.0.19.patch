+        unreachable!("unexpected Insn {:?}", insn)
+    };
+    state.registers[*dest] = Register::OwnedValue(exec_or(
+        &state.registers[*lhs].get_owned_value(),
+        &state.registers[*rhs].get_owned_value(),
+    ));
+    state.pc += 1;
+    Ok(InsnFunctionStepResult::Step)
+}
