+pub fn op_noop(
+    program: &Program,
+    state: &mut ProgramState,
+    insn: &Insn,
+    pager: &Rc<Pager>,
+    mv_store: Option<&Rc<MvStore>>,
+) -> Result<InsnFunctionStepResult> {
+    // Do nothing
+    // Advance the program counter for the next opcode
+    state.pc += 1;
+    Ok(InsnFunctionStepResult::Step)
+}
