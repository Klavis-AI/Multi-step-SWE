+        source_reg,
+        dest_reg,
+        count,
+    } = insn
+    else {
+        unreachable!("unexpected Insn {:?}", insn)
+    };
+    let source_reg = *source_reg;
+    let dest_reg = *dest_reg;
+    let count = *count;
+    for i in 0..count {
