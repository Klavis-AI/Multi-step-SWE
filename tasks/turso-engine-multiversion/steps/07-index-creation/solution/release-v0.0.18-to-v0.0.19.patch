+    #[test]
+    fn test_bitfield() {
+        let mut bitfield = Bitfield::<4>::new();
+        for i in 0..256 {
+            bitfield.set(i);
+            assert!(bitfield.get(i));
+            for j in 0..i {
+                assert!(bitfield.get(j));
+            }
+            for j in i + 1..256 {
+                assert!(!bitfield.get(j));
+            }
+        }
+        for i in 0..256 {
+            bitfield.unset(i);
+            assert!(!bitfield.get(i));
+        }
+    }
