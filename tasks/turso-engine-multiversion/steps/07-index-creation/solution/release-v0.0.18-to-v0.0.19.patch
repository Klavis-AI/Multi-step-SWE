-        return;
-    }
-    tracing::trace!(
-        "{}",
-        explain::insn_to_str(
-            program,
-            addr,
-            insn,
-            String::new(),
-            program
-                .comments
-                .as_ref()
-                .and_then(|comments| comments.get(&{ addr }).copied())
-        )
-    );
-}
