+                OwnedValue::build_text(reg.to_string().trim_start_matches(&pattern_chars[..]))
+            }
+            _ => reg.to_owned(),
+        },
+        (OwnedValue::Text(t), None) => OwnedValue::build_text(t.as_str().trim_start()),
+        (reg, _) => reg.to_owned(),
+    }
+}
