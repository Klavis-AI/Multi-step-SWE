+            hi = ConditionalAbs<abs>(BinomialSum16(SubUnpackedU8<1>(a[2][0], a[0][0]), SubUnpackedU8<1>(a[2][1], a[0][1]), SubUnpackedU8<1>(a[2][2], a[0][2])));
+        }
+
+        template<bool align, bool abs> SIMD_INLINE void SobelDy(__m512i a[3][3], int16_t * dst)
+        {
