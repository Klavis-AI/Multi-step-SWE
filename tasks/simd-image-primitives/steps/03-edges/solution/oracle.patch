+            svint16x2_t d3 = DxDiff(s3, mask);
+            svint16x2_t d4 = DxDiff(s4, mask);
+            svint16x2_t d5 = DxDiff(s5, mask);
+            AccumulateAbsDx(d0, d1, d2, sum);
+            AccumulateAbsDx(d1, d2, d3, sum);
+            AccumulateAbsDx(d2, d3, d4, sum);
+            AccumulateAbsDx(d3, d4, d5, sum);
