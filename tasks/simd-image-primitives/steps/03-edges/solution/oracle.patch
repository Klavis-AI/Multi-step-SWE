+                uint32x4_t rowSum = K32_00000000;
+
+                LoadNoseDx(src0 + 0, a[0]);
+                LoadNoseDx(src1 + 0, a[1]);
+                LoadNoseDx(src2 + 0, a[2]);
+                SobelDxAbsSum(a, rowSum);
+                for (size_t col = A; col < bodyWidth; col += A)
+                {
+                    LoadBodyDx(src0 + col, a[0]);
+                    LoadBodyDx(src1 + col, a[1]);
