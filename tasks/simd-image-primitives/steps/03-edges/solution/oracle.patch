+            size_t alignedWidth = AlignLo(width, A);
+            uint8x16_t tailMask = ShiftLeft(K8_FF, A - width + alignedWidth);
+            size_t blockSize = A << 6;
+            size_t blockCount = (alignedWidth >> 6) + 1;
