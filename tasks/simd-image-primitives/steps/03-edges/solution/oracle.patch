index 0000000..354f0e0
--- /dev/null
+++ b/src/Simd/SimdNeonLaplace.cpp
@@ -0,0 +1,185 @@
+/*
+* Simd Library (http://ermig1979.github.io/Simd).
+*
+* Copyright (c) 2011-2023 Yermalayeu Ihar.
+*
