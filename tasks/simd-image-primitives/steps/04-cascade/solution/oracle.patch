+                            _result[j] = Base::Detect32f(hid, offset + j, i + 1, _norm[j]) > 0 ? 1 : 0;
+                            break;
+                        }
+                    }
+                    result = vld1q_u32(_result);
+                    return;
+                }
+            }
+        }
