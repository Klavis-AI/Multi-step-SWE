+        SIMD_INLINE uint32x4_t IntegralSum32i(const uint32x4_t & s0, const uint32x4_t & s1, const uint32x4_t & s2, const uint32x4_t & s3)
+        {
+            return vsubq_u32(vsubq_u32(s0, s1), vsubq_u32(s2, s3));
+        }
