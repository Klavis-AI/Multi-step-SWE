+                result = vandq_u32(vcleq_f32(vdupq_n_f32(stage.threshold), stageSum), result);
+                int resultCount = ResultCount32(result);
+                if (resultCount == 0)
+                {
+                    return;
+                }
+                else if (resultCount == 1)
+                {
+                    uint32_t _result[4];
+                    float _norm[4];
+                    vst1q_u32(_result, result);
+                    vst1q_f32(_norm, norm);
+                    for (int j = 0; j < 4; ++j)
