+
+namespace Simd
+{
+#ifdef SIMD_AVX512BW_ENABLE    
+    namespace Avx512bw
+    {
+        namespace
+        {
+            struct Buffer
+            {
+                const int size;
+                __m512 * cos, *sin;
+                __m512i * pos, *neg;
+                int * index;
+                float * value;
+
+                Buffer(size_t width, size_t quantization)
