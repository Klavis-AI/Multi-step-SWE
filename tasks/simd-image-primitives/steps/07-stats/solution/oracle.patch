+                    const __m128i _mask = _mm_and_si128(Compare8u<compareType>(Load<false>((__m128i*)(mask + width - A)), _value), tailMask);
+                    _sum = _mm_add_epi64(_sum, _mm_sad_epu8(_mm_and_si128(_mask, _src), K_ZERO));
+                }
