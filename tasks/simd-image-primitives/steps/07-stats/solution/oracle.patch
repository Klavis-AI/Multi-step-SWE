+++ b/src/Simd/SimdAvx2SquaredDifferenceSum.cpp
@@ -0,0 +1,239 @@
+/*
+* Simd Library (http://ermig1979.github.io/Simd).
+*
+* Copyright (c) 2011-2024 Yermalayeu Ihar.
+*
+* Permission is hereby granted, free of charge, to any person obtaining a copy
