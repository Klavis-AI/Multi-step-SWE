+            size_t alignedSize = AlignLo(size, 4);
+            size_t i = 0;
+            if (alignedSize)
+            {
+                float32x4_t sums = vdupq_n_f32(0);
+                for (; i < alignedSize; i += 4)
+                    SquaredDifferenceSum32f<align>(a, b, i, sums);
+                *sum += ExtractSum32f(sums);
+            }
+            for (; i < size; ++i)
+                *sum += Simd::Square(a[i] - b[i]);
+        }
