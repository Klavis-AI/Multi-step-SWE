+                }
+                if (alignedWidth != width)
+                {
+                    const __m128i mask = _mm_and_si128(Compare16i<compareType>(Load<false>((__m128i*)(s + width - HA)), _value), tailMask);
+                    _count = _mm_add_epi64(_count, _mm_sad_epu8(_mm_and_si128(mask, K16_0001), K_ZERO));
+                }
+                src += stride;
+            }
