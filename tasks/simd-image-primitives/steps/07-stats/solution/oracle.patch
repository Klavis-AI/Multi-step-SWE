+
+        template <bool align, SimdCompareType compareType>
+        void ConditionalSum(const uint8_t * src, size_t srcStride, size_t width, size_t height,
+            const uint8_t * mask, size_t maskStride, uint8_t value, uint64_t * sum)
+        {
