+        //-----------------------------------------------------------------------
+
+        SIMD_INLINE uint16x8_t Square(uint8x8_t value)
+        {
+            return vmull_u8(value, value);
+        }
+
+        SIMD_INLINE uint32x4_t Square(uint8x16_t value)
+        {
+            uint16x8_t lo = Square(vget_low_u8(value));
