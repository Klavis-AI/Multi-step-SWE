+        }
+
+        const __m256i RSB_3_P2 = SIMD_MM256_SETR_EPI32(0, 1, 4, 2, 3, 6, 5, 7);
+
+        SIMD_INLINE __m256i PackU32ToI16Rsb3(__m256i lo, __m256i hi)
+        {
+            return _mm256_permutevar8x32_epi32(_mm256_packus_epi32(lo, hi), RSB_3_P2);
+        }
