+                ays[0] = _mm512_set1_epi16(ay[0]);
+                ays[1] = _mm512_set1_epi16(ay[1]);
+                ays[2] = _mm512_set1_epi16(ay[2]);
+                ays[3] = _mm512_set1_epi16(ay[3]);
