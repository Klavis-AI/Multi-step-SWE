+                    }
+                    if (N == 2)
+                    {
+                        for (; dx < rs8; dx += 8)
+                        {
+                            __m256 fx1 = _mm256_loadu_ps(_ax.data + dx);
+                            __m256 fx0 = _mm256_sub_ps(_1, fx1);
+                            _mm256_storeu_ps(pb + dx, BilColS2(ps, _ix.data + dx, fx0, fx1));
