+                            ResizerByteBilinearOpenCvInterpolateX<N>((__m512i*)(_sx.data + i), (__m512i*)(ax + i), (__m512i*)(pb + i));
+                    }
+                }
+
+                for (size_t i = 0; i < aligned; i += A)
+                    ResizerByteBilinearOpenCvInterpolateY(bx[0] + i, bx[1] + i, a, dst + i);
