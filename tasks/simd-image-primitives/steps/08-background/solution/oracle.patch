+        template <> SIMD_INLINE svuint8_t OperationBinary8u<SimdOperationBinary8uSaturatedSubtraction>(const svbool_t& mask, const svuint8_t& a, const svuint8_t& b)
+        {
+            return svqsub_u8_x(mask, a, b);
