+                    __m128 hor0 = _mm_cvtepi32_ps(_mm_cvtepu8_epi32(_hor));
+                    __m128 ranges0 = Shuffle32f<0x50>(_ranges);
+                    _mm_storeu_ps(cc + o + 0, _mm_add_ps(_mm_mul_ps(_alpha, hor0), _mm_mul_ps(ranges0, pc0)));
