+
+            X1[0] = _mm_min_epu8(X1[0], Y[12]);
+            X1[0] = _mm_max_epu8(X1[0], Y[11]);
+            X1[0] = _mm_min_epu8(X1[0], _mm_max_epu8(X1[1], Y[10]));
+            X1[0] = _mm_min_epu8(X1[0], _mm_max_epu8(X1[2], Y[9]));
+            X1[0] = _mm_min_epu8(X1[0], _mm_max_epu8(X1[3], Y[8]));
+            X1[0] = _mm_min_epu8(X1[0], _mm_max_epu8(X1[4], Y[7]));
+
+            X1[1] = _mm_min_epu8(X2[0], Y[12]);
+            X1[1] = _mm_max_epu8(X1[1], Y[11]);
+            X1[1] = _mm_min_epu8(X1[1], _mm_max_epu8(X2[1], Y[10]));
