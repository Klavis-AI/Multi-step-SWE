+                    PartialSort5(a);
+                    Store<align>((__m128i*)(dst + col), a[2]);
+                }
+
+                size_t col = size - A;
+                LoadTailRhomb3x3<align, step>(y, col, a);
+                PartialSort5(a);
+                Store<align>((__m128i*)(dst + col), a[2]);
