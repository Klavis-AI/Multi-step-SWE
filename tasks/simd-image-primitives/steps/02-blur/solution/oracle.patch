+        RecursiveBilateralFilterPrecize::RecursiveBilateralFilterPrecize(const RbfParam& param)
+            :Base::RecursiveBilateralFilterPrecize(param)
+        {
+            if (_param.width * _param.channels >= A)
+                Prec::Set(_param, _hFilter, _vFilter);
+        }
