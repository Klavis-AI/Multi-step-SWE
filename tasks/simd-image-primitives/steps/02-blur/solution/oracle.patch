+        template <bool align, size_t step> SIMD_INLINE void LoadNoseRhomb3x3(const uint8_t* y[3], size_t offset, __m512i a[5])
+        {
+            a[0] = Load<align>(y[0] + offset);
+            LoadNose3<align, step>(y[1] + offset, a + 1);
+            a[4] = Load<align>(y[2] + offset);
+        }
+
+        template <bool align, size_t step> SIMD_INLINE void LoadBodyRhomb3x3(const uint8_t* y[3], size_t offset, __m512i a[5])
+        {
+            a[0] = Load<align>(y[0] + offset);
+            LoadBody3<align, step>(y[1] + offset, a + 1);
+            a[4] = Load<align>(y[2] + offset);
+        }
+
+        template <bool align, size_t step> SIMD_INLINE void LoadTailRhomb3x3(const uint8_t* y[3], size_t offset, __m512i a[5])
+        {
+            a[0] = Load<align>(y[0] + offset);
+            LoadTail3<align, step>(y[1] + offset, a + 1);
+            a[4] = Load<align>(y[2] + offset);
+        }
+
+        SIMD_INLINE void PartialSort5(__m512i a[5])
+        {
+            SortU8(a[2], a[3]);
+            SortU8(a[1], a[2]);
+            SortU8(a[2], a[3]);
+            a[4] = _mm512_max_epu8(a[1], a[4]);
+            a[0] = _mm512_min_epu8(a[0], a[3]);
+            SortU8(a[2], a[0]);
+            a[2] = _mm512_max_epu8(a[4], a[2]);
+            a[2] = _mm512_min_epu8(a[2], a[0]);
+        }
+
+        template <bool align, size_t step> void MedianFilterRhomb3x3(
+            const uint8_t * src, size_t srcStride, size_t width, size_t height, uint8_t * dst, size_t dstStride)
+        {
+            assert(step*(width - 1) >= A);
+
+            const uint8_t * y[3];
+            __m512i a[5];
+
+            size_t size = step*width;
+            size_t bodySize = Simd::AlignHi(size, A) - A;
+
+            for (size_t row = 0; row < height; ++row, dst += dstStride)
+            {
+                y[0] = src + srcStride*(row - 1);
+                y[1] = y[0] + srcStride;
+                y[2] = y[1] + srcStride;
+                if (row < 1)
+                    y[0] = y[1];
+                if (row >= height - 1)
+                    y[2] = y[1];
+
+                LoadNoseRhomb3x3<align, step>(y, 0, a);
+                PartialSort5(a);
+                Store<align>(dst, a[2]);
