+                    __m128 _pf = _mm_loadu_ps(pf + x);
+                    _mm_storeu_ps(cf + x, _mm_add_ps(_alpha, _mm_mul_ps(_ranges, _pf)));
+                    __m128i _hor = _mm_loadu_si128((__m128i*)(hor + o));
