+
+        SIMD_INLINE void Sort5(__m128i a[5])
+        {
+            SortU8(a[0], a[3]); SortU8(a[1], a[4]);
+            SortU8(a[0], a[2]); SortU8(a[1], a[3]);
+            SortU8(a[0], a[1]); SortU8(a[2], a[4]);
