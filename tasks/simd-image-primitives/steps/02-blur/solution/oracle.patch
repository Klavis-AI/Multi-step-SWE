+                        return;
+                    }
+                    size_t widthF = AlignLo(width, F), x = 0, o = 0;
+                    for (; x < widthF; x += F, o += A)
+                        Ranges4<type>(src0 + o, src1 + o, ranges, dst + x);
+                    if (widthF < width)
+                    {
+                        x = width - F, o = x * 4;
+                        Ranges4<type>(src0 + o, src1 + o, ranges, dst + x);
+                    }
+                }
