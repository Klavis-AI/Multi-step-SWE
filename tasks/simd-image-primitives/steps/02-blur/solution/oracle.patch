+            _mm_storeu_si128((__m128i*)diff, a16);
+            for (size_t i = 0; i < HA; ++i)
+                dst[i] = ranges[diff[i]];
+        }
+
+        template<RbfDiffType type> SIMD_INLINE void Ranges3(const uint8_t* src0, const uint8_t* src1, const float* ranges, float* dst)
