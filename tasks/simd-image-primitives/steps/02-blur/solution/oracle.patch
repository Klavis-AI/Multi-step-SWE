+            SortU8(a[12], a[17]);
+            a[7] = _mm_min_epu8(a[7], a[17]);
+            SortU8(a[7], a[10]); SortU8(a[12], a[18]);
+            a[12] = _mm_max_epu8(a[7], a[12]);
+            a[10] = _mm_min_epu8(a[10], a[18]);
+            SortU8(a[12], a[20]);
+            a[10] = _mm_min_epu8(a[10], a[20]);
