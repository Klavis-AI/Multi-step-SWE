+                for (; x < width; x++, o += 2)
+                {
+                    float factor = 1.0f / (bf[x] + ef[x]);
+                    dst[o + 0] = uint8_t(factor * (bc[o + 0] + ec[o + 0]));
+                    dst[o + 1] = uint8_t(factor * (bc[o + 1] + ec[o + 1]));
