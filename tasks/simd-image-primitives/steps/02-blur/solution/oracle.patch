+            _mm_storeu_si128((__m128i*)diff, d);
+            for (size_t i = 0; i < A; ++i)
+                dst[i] = ranges[diff[i]];
+        }
+
+        template<RbfDiffType type> SIMD_INLINE void Ranges2(const uint8_t* src0, const uint8_t* src1, const float* ranges, float* dst)
+        {
+            __m128i d8 = AbsDiff8u(src0, src1);
