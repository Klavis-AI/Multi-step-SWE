+                    int y = yBeg;
+                    for (; y < yEnd16; y += 16)
+                    {
+                        __m512 _y = _mm512_cvtepi32_ps(_mm512_add_epi32(_mm512_set1_epi32(y), _0123));
+                        __m512i _x = _mm512_cvtps_epi32(_mm512_add_ps(_mm512_mul_ps(_y, _a), _b));
+                        __m512i xBeg = _mm512_loadu_si512((__m512i*)(_beg.data + y));
