  {
   "id": "r5-basic-idonly",
   "release": "R5",
   "topic": {
    "resourceType": "SubscriptionTopic",
    "id": "admission",
    "url": "http://example.org/FHIR/SubscriptionTopic/admission",
    "status": "active",
    "title": "admission",
    "resourceTrigger": [
     {
      "resource": "Encounter",
      "supportedInteraction": [
       "create",
       "update"
      ],
      "queryCriteria": {
       "current": "status=in-progress",
       "resultForCreate": "test-passes"
      }
     }
    ],
    "canFilterBy": [
     {
      "resource": "Encounter",
      "filterParameter": "patient"
     }
    ]
   },
   "subscription": {
    "resourceType": "Subscription",
    "id": "s-r5-basic",
    "status": "requested",
    "topic": "http://example.org/FHIR/SubscriptionTopic/admission",
    "channelType": {
     "system": "http://terminology.hl7.org/CodeSystem/subscription-channel-type",
     "code": "rest-hook"
    },
    "endpoint": "@ENDPOINT@",
    "contentType": "application/fhir+json",
    "content": "id-only"
   },
   "writes": [
    [
     "PUT",
     "Patient/p1",
     {
      "resourceType": "Patient",
      "id": "p1"
     }
    ],
    [
     "PUT",
     "Encounter/e1",
     {
      "resourceType": "Encounter",
      "id": "e1",
      "status": "in-progress",
      "class": [
       {
        "coding": [
         {
          "code": "AMB"
         }
        ]
       }
      ],
      "subject": {
       "reference": "Patient/p1"
      }
     }
    ],
    [
     "PUT",
     "Encounter/e2",
     {
      "resourceType": "Encounter",
      "id": "e2",
      "status": "planned",
      "class": [
       {
        "coding": [
         {
          "code": "AMB"
         }
        ]
       }
      ],
      "subject": {
       "reference": "Patient/p1"
      }
     }
    ]
   ],
   "expect": {
    "events": [
     [
      "Encounter",
      "e1"
     ]
    ],
    "content": "id-only",
    "bundle_type": "subscription-notification",
    "status_type": "event-notification"
   }
  },
