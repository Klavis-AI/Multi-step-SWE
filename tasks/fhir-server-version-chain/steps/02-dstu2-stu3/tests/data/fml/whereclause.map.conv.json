{
  "resourceType" : "StructureMap",
  "url" : "http://ahdis.ch/matchbox/fml/whereclause",
  "name" : "whereclause",
  "status" : "draft",
  "structure" : [{
    "url" : "http://hl7.org/fhir/StructureDefinition/CapabilityStatement",
    "alias" : "CapabilityStatement",
    "mode" : "source"
  },
  {
    "url" : "http://hl7.org/fhir/StructureDefinition/CapabilityStatement",
    "alias" : "CapabilityStatement",
    "mode" : "target"
  }],
  "group" : [{
    "name" : "CapabilityStatement",
    "input" : [{
      "mode" : "source",
      "name" : "src",
      "type" : "CapabilityStatement"
    },
    {
      "mode" : "target",
      "name" : "tgt",
      "type" : "CapabilityStatement"
    }],
    "rule" : [{
      "source" : [{
        "context" : "src",
        "element" : "rest",
        "variable" : "srcrest"
      }],
      "target" : [{
        "context" : "tgt",
        "element" : "rest",
        "variable" : "tgtrest"
      }],
      "rule" : [{
        "source" : [{
          "context" : "srcrest",
          "element" : "resource",
          "variable" : "srcres"
        }],
        "target" : [{
          "context" : "tgtrest",
          "element" : "resource",
          "variable" : "tgtres"
        }],
        "rule" : [{
          "source" : [{
            "context" : "srcres",
            "element" : "interaction",
            "variable" : "srcint",
            "condition" : "srcint.code != 'read'",
            "logMessage" : "srcint.code"
          }],
          "target" : [{
            "context" : "tgtres",
            "element" : "interaction",
            "variable" : "tgtint"
          }],
          "rule" : [{
            "source" : [{
              "context" : "srcint",
              "element" : "code",
              "variable" : "code"
            }],
            "target" : [{
              "context" : "tgtint",
              "element" : "code",
              "transform" : "copy",
              "parameter" : [{
                "valueId" : "code"
              }]
            }],
            "name" : "code"
          }],
          "name" : "interaction"
        }],
        "name" : "resource"
      }],
      "name" : "rest"
    }]
  }],
  "id" : "whereclause"
}