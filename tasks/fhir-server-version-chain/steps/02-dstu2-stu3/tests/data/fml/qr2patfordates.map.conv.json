{
  "resourceType" : "StructureMap",
  "url" : "http://ahdis.ch/matchbox/fml/qr2patfordates",
  "name" : "qr2patfordates",
  "status" : "draft",
  "structure" : [{
    "url" : "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse",
    "alias" : "QuestionnaireResponse",
    "mode" : "source"
  },
  {
    "url" : "http://hl7.org/fhir/StructureDefinition/Patient",
    "alias" : "Patient",
    "mode" : "target"
  }],
  "group" : [{
    "name" : "qrtobundle",
    "input" : [{
      "mode" : "source",
      "name" : "src",
      "type" : "QuestionnaireResponse"
    },
    {
      "mode" : "target",
      "name" : "tgt",
      "type" : "Patient"
    }],
    "rule" : [{
      "source" : [{
        "context" : "src",
        "element" : "extension",
        "variable" : "ext",
        "condition" : "url = 'urn:date'"
      }],
      "rule" : [{
        "source" : [{
          "context" : "ext",
          "element" : "value",
          "variable" : "value"
        }],
        "target" : [{
          "context" : "tgt",
          "element" : "birthDate",
          "transform" : "evaluate",
          "parameter" : [{
            "valueString" : "%value + 5 'days'"
          }]
        }],
        "name" : "plus"
      }],
      "name" : "date"
    },
    {
      "source" : [{
        "context" : "src",
        "element" : "extension",
        "variable" : "ext",
        "condition" : "url = 'urn:dateTime'"
      }],
      "rule" : [{
        "source" : [{
          "context" : "ext",
          "element" : "value",
          "variable" : "value"
        }],
        "target" : [{
          "context" : "tgt",
          "element" : "deceased",
          "transform" : "evaluate",
          "parameter" : [{
            "valueString" : "%value - 5 'days'"
          }]
        }],
        "name" : "minus"
      }],
      "name" : "dateTime"
    }]
  }],
  "id" : "qr2patfordates"
}