+            Response::Nil => "Nil",
+
+            Response::Peers(_) => "Peers",
+
+            Response::Blocks(_) => "Blocks",
+            Response::BlockHashes(_) => "BlockHashes",
+
+            Response::BlockHeaders { .. } => "BlockHeaders",
+
+            Response::Transactions(_) => "Transactions",
+            Response::TransactionIds(_) => "TransactionIds",
+        }
+    }
+}
