+        let rt: [u8; 32] = joinsplit.anchor.into();
+        let mac1: [u8; 32] = (&joinsplit.vmacs[0]).into();
+        let mac2: [u8; 32] = (&joinsplit.vmacs[1]).into();
+        let nf1: [u8; 32] = (&joinsplit.nullifiers[0]).into();
+        let nf2: [u8; 32] = (&joinsplit.nullifiers[1]).into();
