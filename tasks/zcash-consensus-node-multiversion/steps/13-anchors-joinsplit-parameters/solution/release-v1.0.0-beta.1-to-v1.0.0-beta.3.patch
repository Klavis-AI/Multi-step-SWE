+                        block_height: *block_height,
+                        transaction_hash: coinbase.hash(),
+                    })?,
+                    Some(expiry) => {
+                        if expiry != *block_height {
+                            return Err(TransactionError::CoinbaseExpiryBlockHeight {
+                                expiry_height,
+                                block_height: *block_height,
+                                transaction_hash: coinbase.hash(),
+                            })?;
+                        }
+                    }
+                }
+                return Ok(());
