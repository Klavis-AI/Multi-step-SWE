-            "skipping detailed git and target info due to vergen error: {:?}",
-            e
-        ),
+        Err(e) => {
+            eprintln!(
+                "git error in vergen build script: skipping git env vars: {:?}",
+                e
+            );
+            *config.git_mut().enabled_mut() = false;
+            vergen(config).expect("non-git vergen should succeed");
+        }
     }
 }
