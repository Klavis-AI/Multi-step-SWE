diff --git a/zebra-chain/src/history_tree/tests/vectors.rs b/zebra-chain/src/history_tree/tests/vectors.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f2e7ca71df534059ccc904983f4eb46506920c7c
