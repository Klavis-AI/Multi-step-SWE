+            _ => prop_assert!(matches!(collection.iter().sum(),
+                                       Err(ValueBalanceError::Transparent(_)
+                                           | ValueBalanceError::Sprout(_)
+                                           | ValueBalanceError::Sapling(_)
+                                           | ValueBalanceError::Orchard(_))
