+    ) -> Result<Amount<NonNegative>, ValueBalanceError> {
+        if self.is_coinbase() {
+            // TODO: if needed, fixup coinbase:
+            // - miner subsidy
+            // - founders reward or funding streams (hopefully not?)
+            // - remaining transaction value
