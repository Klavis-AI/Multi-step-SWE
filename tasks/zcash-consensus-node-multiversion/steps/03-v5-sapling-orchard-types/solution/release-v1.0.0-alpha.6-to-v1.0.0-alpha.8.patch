+
+impl ZcashSerialize for Option<sapling::ShieldedData<SharedAnchor>> {
+    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
+        match self {
+            None => {
+                // nSpendsSapling
