+
+impl PartialEq for SpendValidatingKey {
+    #[allow(clippy::cmp_owned)]
+    fn eq(&self, other: &Self) -> bool {
+        <[u8; 32]>::from(self.0) == <[u8; 32]>::from(other.0)
+    }
+}
+
+impl PartialEq<[u8; 32]> for SpendValidatingKey {
+    #[allow(clippy::cmp_owned)]
