+    // Create a coinbase V5 tx with an expiry height that matches the height of
+    // the block. Note that this is the only valid expiry height for a V5
+    // coinbase tx.
+    let transaction = Transaction::V5 {
+        inputs: vec![input],
+        outputs: vec![output],
