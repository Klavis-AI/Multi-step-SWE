+        .await
+        .unwrap();
+
+    // Queue second transaction for download and verification.
+    let request = mempool
+        .ready_and()
+        .await
+        .unwrap()
+        .call(Request::Queue(vec![rejected_valid_tx
+            .transaction
+            .id
