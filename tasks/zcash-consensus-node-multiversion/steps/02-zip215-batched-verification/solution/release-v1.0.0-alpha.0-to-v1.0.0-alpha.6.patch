+    let block = zebra_test::vectors::BLOCK_MAINNET_903001_BYTES
+        .clone()
+        .zcash_deserialize_into::<Block>()
+        .expect("a valid block");
+
+    verify_invalid_groth16_output_description(&mut output_verifier, block.transactions)
+        .await
+        .unwrap()
+}
