source 'https://rubygems.org'

ruby '2.3.8'

# Versions move only where Rails 4.2 or Ruby 2.3 forces them to.  Everything
# else stays where the 4.0 lockfile had it, because a gem that changes under a
# migration changes the application's output for reasons the migration did not
# ask for -- the markdown renderer, the analytics snippet and the TwiML
# builder all emit bytes this application serves.
gem 'pg', '~> 0.21'                 # 0.17 does not build against a current libpq
gem 'rails', '4.2.11.3'
gem 'unicorn', '4.8.2'

gem 'high_voltage', '2.1.0'
gem 'jbuilder', '~> 2.0'            # 1.x is Rails 4.0 only
gem 'redcarpet', '3.1.1'
gem 'will_paginate', '~> 3.1'       # 3.0.5 predates Rails 4.1's AR changes

gem 'backbone-rails', '1.1.0'
gem 'foundation-rails', '5.2.2.0'
gem 'jquery-rails', '3.1.0'
gem 'leaflet-rails', '0.7.2'
gem 'sass-rails', '~> 4.0.0'
gem 'twitter-typeahead-rails', '0.10.2'
gem 'uglifier', '2.5.0'

gem 'google-analytics-rails', '0.0.5'
gem 'soda-ruby', '0.2.12', require: 'soda'
gem 'twilio-ruby', '3.11.5'

# Transitive pins that Ruby 2.3 forces.  nokogiri stops at 1.10 there, and
# every loofah after 2.2 wants the Nokogiri::HTML4 namespace 1.12 introduced --
# without these three lines the application does not load ActionView at all.
gem 'nokogiri', '1.10.10'
gem 'loofah', '2.2.3'
gem 'rails-html-sanitizer', '1.0.4'

group :test do
  gem 'shoulda-matchers', '~> 2.8'
  gem 'timecop'
  gem 'vcr'
  gem 'webmock', '~> 2.3'
end

group :development, :test do
  gem 'annotate'
  gem 'capybara', '~> 2.18'
  gem 'dotenv-rails'
  gem 'factory_girl_rails', '~> 4.9'
  gem 'ffaker'
  gem 'launchy'
  gem 'pry'
  gem 'rspec-its'                   # `its(...)` left rspec-core in 3.0
  gem 'rspec-rails', '~> 3.9'       # 2.x caps activesupport below 4.2
  gem 'teaspoon'
end

group :development do
  gem 'foreman'
  gem 'guard-teaspoon'
  gem 'guard-livereload'
  gem 'rack-livereload'
end

group :production do
  gem 'newrelic_rpm'
  gem 'rails_12factor'
end
