source 'https://rubygems.org'

ruby '3.4.10'

# Versions move only where the framework or the interpreter forces them to.
# Everything else stays where the 4.2 lockfile had it, because a gem that
# changes under a migration changes the application's output for reasons the
# migration did not ask for -- the markdown renderer, the analytics snippet
# and the TwiML builder all emit bytes this application serves.
#
# This step moves no framework pin at all.  `rails` stays at 8.1.3.1, every
# other line below stays where the rung before it left it, and the only thing
# that moves is the interpreter underneath them.  What comes with that is not
# a resolution: it is the set of packages the interpreter hands out for free.
# Ruby 3.4 finished the long project of moving libraries out of the default
# set, and three of the ones it moved are libraries this bundle loads, so they
# are named below for the first time.  Three specs arrive in the lockfile and
# 149 gems become 152; a fourth, which has been sitting in the lock since the
# 4.2 baseline without ever being named, finally moves off a 2019 release.
#
# The interpreter moves here, 3.2.11 -> 3.4.10, and this is the last time it
# moves.  Nothing in the graph forced it: railties 8.1.3.1 asks for Ruby
# >= 3.2.0 and 3.2.11 cleared that.  What asks for it is that 3.2 is two
# minor versions behind the release the framework is developed against, and
# the end of a migration is where a tree stops being behind.  The `ruby`
# directive, `.ruby-version` and the lockfile's RUBY VERSION all name it
# together, for the reason they always have: whichever two of them disagree,
# something downstream picks the interpreter the third named.
#
# pg is the framework's floor, not the interpreter's: Active Record 6.1's
# PostgreSQL adapter opens with `gem "pg", "~> 1.1"` where 6.0 asked for
# `>= 0.18, < 2.0`, so the 0.x line this application has been on since 4.2
# stops loading -- `eager_load!` fails with "can't activate pg (~> 1.1),
# already activated pg-0.21.0".  Nothing here touches the PGconn and PGresult
# aliases pg 1.0 removed.  It stops at 1.4 rather than taking the newest 1.x
# because pg 1.5 deprecated `PG::Coder.new(hash)` and this very adapter still
# calls it that way (postgresql_adapter.rb:883), which puts a deprecation on
# every boot that no application code can answer for.
gem 'pg', '1.4.6'
gem 'rails', '8.1.3.1'
gem 'unicorn', '4.8.2'

# Five packages the interpreter used to hand out for free and is done handing
# out, pinned to the versions this 3.4.10 itself ships -- so every declaration
# here names the code that was already going to be loaded rather than choosing
# different code.
#
# `csv`, `mutex_m` and `observer` were default gems through Ruby 3.3 and are
# only bundled gems at 3.4.  The files are still on the box; what changed is
# that a program started under `bundler/setup` may require only what the
# Gemfile names, so the first `require` of one raises LoadError with the copy
# it wanted sitting unreachable beside it.  This application requires `csv` in
# four places -- the top of `app/models/answer_counts.rb`, a model the recorded
# behaviour suite exercises and any eager load reaches, and the top of each of
# the three importers under lib/.  `mutex_m` and `observer` it never requires at all:
# minitest asks for the first (minitest.rb:3) and factory_bot for the second
# (evaluation.rb:1), so no file in this tree names either and nothing short of
# running the suite finds them.
#
# `bigdecimal` is the fourth and it is here for a different reason.  No file
# in this tree names it either -- activesupport and crack are what depend on
# it -- and the lock has carried 1.4.4 since the 4.2 baseline because no
# Gemfile ever named it and `bundle lock --conservative` never had cause to
# move it.  That 2019 C extension defines an allocator for a T_DATA class,
# which Ruby has warned about since 3.2 and this tree has printed on every
# boot since step 08.  3.1.8 is the release 3.4.10 bundles, and taking it is
# what ends the warning.
#
# `ostruct` is the fifth and it is the quietest of them.  It still loads: 4.0.0
# is the release it leaves in, not this one, so all it does on 3.4 is say on
# the first `require` that it will not be there forever.  Nothing breaks and no
# example fails.  It is also the easiest of the five to miss, because it is a
# plain `warning:` and not a `DEPRECATION WARNING:`, so none of the deprecation
# collectors this repository runs sees it.  `app/models/app_content_set.rb:1`
# requires it, and `config/initializers/app_content_set.rb:10` names the
# constant from inside a `to_prepare` block -- so it is reached on every boot
# in every environment, and reached there even though development and test
# both run with `eager_load = false`.
gem 'bigdecimal', '3.1.8'
gem 'csv', '3.3.2'
gem 'mutex_m', '0.3.0'
gem 'observer', '0.1.2'
gem 'ostruct', '0.6.1'

# Bootsnap caches the load path and the compiled bytecode of everything the
# application requires; Rails 5.2 generates a `config/boot.rb` that enables it
# and lists it here.  The pin moves because bootsnap 1.4's compile cache calls
# `RubyVM::InstructionSequence#to_binary` and rescues only SyntaxError, and on
# Ruby 3.0 -- on 3.0 alone, not on 2.7 and not on 3.1 -- `to_binary` raises
# TypeError for any iseq holding a `def m(*)` whose body blocks to `super`.
# thor's `lib/thor/base.rb:138` is exactly that shape and thor is railties'
# dependency, so with bootsnap 1.4 nothing Rails-shaped can be required at all:
# `rails -v` itself raises.  1.9.3 is the first release that rescues the
# TypeError and marks the file uncompilable.  Clearing tmp/cache does not help,
# because the failure is on the WRITE path.
#
# msgpack stays where it is.  1.9.3 asks only for `msgpack ~> 1.0` and 1.4.2
# satisfies it; the pin is kept rather than dropped because bundler would
# otherwise float msgpack on every future resolution for no reason anyone asked
# for.
gem 'bootsnap', '1.9.3', require: false
gem 'msgpack', '1.8.2'

# high_voltage draws this application's `/pages/*id` route, and Rails 8.1 gives
# the routing verbs keyword signatures.  `get HighVoltage.route_drawer
# .match_attributes` passes a Hash held in a variable, which Ruby 3 does not
# convert to keywords, so the call is deprecated and the warning is raised from
# inside the gem while the suite draws its routes.  5.0.0 splats it
# (`get **...`), which is the whole of the fix: it declares no runtime
# dependencies, asks for Ruby >= 3.1, and moves alone under `bundle lock
# --conservative --update high_voltage`.  The pin was 3.0.0 because 2.x's
# StaticPage concern calls `hide_action`, which Rails 5 removed; every release
# since has kept that, so the reason for the floor survives the move.
#
# What comes with the upgrade is narrower than two major versions suggests, and
# it was measured rather than read off a changelog: `show` now passes
# `current_page` to the template as a local, `Page#valid?` asks ActionView which
# handlers are registered instead of matching `\.html`, and `PageFinder`
# refuses a traversal by comparing cleanpaths rather than by deleting the
# characters it dislikes.  All three page views render the same bytes,
# `/pages/no-such-page` and `/pages/..%2F..%2Fconfig%2Fdatabase` both still
# raise `ActionController::RoutingError` -- the second now naming the path it
# refused instead of the stub the old sanitiser left -- and the suite's 504
# examples pass with no deprecation from any file in this tree.
gem 'high_voltage', '5.0.0'
gem 'jbuilder', '~> 2.10'           # 2.9 calls `Proc.new` with no block; Ruby 3.0 removed that
gem 'redcarpet', '3.6.1'
gem 'will_paginate', '~> 3.1'       # 3.0.5 predates Rails 4.1's AR changes

gem 'backbone-rails', '1.1.0'
gem 'foundation-rails', '5.5.3.2'
gem 'jquery-rails', '~> 4.0'   # 3.1 caps railties below 5.0
gem 'leaflet-rails', '0.7.2'
gem 'sass-rails', '~> 5.0.7'   # 5.0.4 caps railties below 5.0
gem 'twitter-typeahead-rails', '0.10.2'
gem 'uglifier', '4.2.1'

gem 'google-analytics-rails', '0.0.5'
gem 'soda-ruby', '0.2.12', require: 'soda'
gem 'twilio-ruby', '3.11.5'

# Two caps on gems nothing in this file used to have to name, both of them
# holding a dependency on the last release that works under Rails 6.0.
#
# concurrent-ruby 1.3.5 dropped the `require "logger"` it had always carried,
# and activesupport 6.0's LoggerThreadSafeLevel reads ::Logger at load time --
# on 1.3.5 the framework does not finish loading.
gem 'concurrent-ruby', '1.3.7'

# json is a default gem and the lockfile takes whatever teaspoon's `>= 1.8.0`
# resolves to.  activesupport 6.0's JSON encoder calls `JSON.generate(value,
# quirks_mode: true, max_nesting: false)` and json 3.0 removed `quirks_mode`,
# so a resolution that floats json turns every `to_json` this application
# serves into an ArgumentError.  The cap holds it on the 2.x line it is on.
gem 'json', '~> 2.7'

# sass 3.2.19 has been held in this file for several releases, and Ruby 3.2
# ends it: sass-3.2.19's own
# version.rb:115 calls `File.exists?`, which this interpreter removed, and it is
# reached from `sass-rails.rb:1` while `Bundler.require` runs -- so the failure
# is a boot failure and there is no prompt to fix it from.  Moving sass forces
# foundation, for the reason the old pin was written down: foundation-rails
# 5.2.2.0 guards every module with `@if (index($modules, $name) == false)`, and
# sass 3.3 changed `index()` to answer `null` rather than `false` for a miss, so
# the framework emits nothing and `application.css` dies on `failed to @extend
# ".left"`.  foundation-rails 5.5.3.2 -- the last 5.x, so the stylesheet keeps
# the major version it was written for -- spells the guard `@if(not
# index($modules, $name))` and adds the `$modules: $modules !global` sass 3.4
# needs for the accumulator to work across files.  Measured together:
# `rake assets:precompile` exits 0 and application.css is 189992 bytes.
gem 'sass', '3.4.25'

group :test do
  # 2.8.0 calls `BigDecimal.new` at load time, in
  # validate_inclusion_of_matcher.rb:251, and Ruby 2.7 removed it.
  gem 'shoulda-matchers', '~> 4.5'
  gem 'timecop'
  gem 'vcr'
  gem 'webmock', '~> 2.3'
end

group :development, :test do
  # `annotate`'s last release is 3.2.0 and its gemspec caps
  # `activerecord < 8.0`.  Asked for a Rails 8 lock, bundler does not
  # report a conflict -- it walks the gem back to 2.6.5, published in
  # 2014, whose only constraint is `activerecord >= 2.3.0`, and the tree
  # still boots and still annotates.  `annotaterb` is the maintained
  # fork of the same tool; its configuration lives in `.annotaterb.yml`
  # and its rake hook in `lib/tasks/annotate_rb.rake`.
  gem 'annotaterb', '~> 4.14'
  # capybara 2.18's `matcher_proxies.rb:14` is `within_element(*args, &Proc.new)`
  # -- the same removal as jbuilder's, so every `within '...' do` in a feature
  # spec raises ArgumentError.  2.18.0 is the last 2.x, so the pin has to cross
  # a major version; the line that costs is written out in the step's own diff.
  gem 'capybara', '~> 3.0'
  # teaspoon ships its runner as 20 .coffee sources and puts `teaspoon/*.js` on
  # config.assets.precompile.  sprockets-rails 3 resolves that whole list the
  # first time any *_path helper runs, so the CoffeeScript compiler stops being
  # lazy the way sprockets 2 had it; without this every asset helper raises
  # `LoadError: cannot load such file -- coffee_script`.
  gem 'coffee-rails', '~> 5.0'   # 4.2's TemplateHandler.call takes one argument
  gem 'dotenv-rails', '~> 2.7'
  # factory_girl has printed its own deprecation on every boot since the
  # 4.9 release; factory_bot 5 is the same library under its current name.
  gem 'factory_bot_rails', '~> 5.2'
  gem 'ffaker', '2.11.0'
  gem 'launchy'
  gem 'pry'
  gem 'rails-controller-testing'    # `assigns` left ActionPack in 5.0
  gem 'rspec-its'                   # `its(...)` left rspec-core in 3.0
  # 4.x's EmptyTemplateResolver::ResolverDecorator is not a String, a
  # Pathname or an ActionView::Resolver, and actionview 7.1's
  # `PathSet#typecast` (path_set.rb:79) refuses everything else -- 57 of
  # the 504 examples raise TypeError before they assert anything.
  gem 'rspec-rails', '~> 6.0'
  gem 'teaspoon'
end

group :development do
  gem 'foreman'
  gem 'guard-teaspoon', '~> 0.8'
  gem 'guard-livereload'
  gem 'rack-livereload'
end

group :production do
  gem 'newrelic_rpm'
  # rails_12factor is gone, and what its two gems set is set directly in
  # config/environments/production.rb instead.  rails_serve_static_assets
  # turns the file server on, which that file has always done for itself;
  # rails_stdout_logging hands Rails a logger writing to STDOUT, and it builds
  # that logger with `include ::LoggerSilence`, which Rails 6.0 deprecates on
  # every boot.  Neither gem has had a release since 2016, so there is no
  # version of this to upgrade to.
end

# build-context guard: keeps this file's size unique per step (BuildKit collision).
# Every step's verifier context is a dir named tests/, and BuildKit reuses a cached
# file when (relpath, size, mode, mtime) match; mtimes do not survive git or tar,
# so this comment-only pad (length = 10 x step 13) keeps the size distinct.
# ==================================================================================================================================
