  "http_edges/accept_nonsense": {
   "cite": "actionpack-4.2.11.3/lib/action_dispatch/http/mime_negotiation.rb:74-76 -- `v.select { |format| format.symbol || format.ref == \"*/*\" }`, applied to the accepts list; no such filter in actionpack-4.0.0/lib/action_dispatch/http/mime_negotiation.rb:54-65, which returns `accepts` unfiltered.",
   "obs": {
    "body": {
     "data": {
      "features": [
       {
        "geometry": {
         "coordinates": [
          -122.269507,
          37.82665
         ],
         "type": "Point"
        },
        "properties": {
         "name": "Eli's Mile High Club",
         "url": "/locations/1-eli-s-mile-high-club"
        },
        "type": "Feature"
       },
       {
        "geometry": {
         "coordinates": [
          -122.276297,
          37.797077
         ],
         "type": "Point"
        },
        "properties": {
         "name": "Beer Revolution",
         "url": "/locations/2-beer-revolution"
        },
        "type": "Feature"
       },
       {
        "geometry": {
         "coordinates": [
          -122.268321,
          37.813142
         ],
         "type": "Point"
        },
        "properties": {
         "name": "Stork Club",
         "url": "/locations/3-stork-club"
        },
        "type": "Feature"
       }
      ],
      "type": "FeatureCollection"
     },
     "kind": "json"
    },
    "headers": {
     "content-type": "application/json; charset=utf-8"
    },
    "request": {
     "method": "GET",
     "path": "/locations"
    },
    "status": 200
   },
   "why": "GET /locations with Accept: application/x-does-not-exist. Rails 4.1 made ActionDispatch::Http::MimeNegotiation#formats drop every parsed media type that is not a registered Mime::Type, keeping only the */* wildcard, so an unregistered Accept value no longer reaches template lookup as a format. On 4.0 it did, no locations/index template matched it, and the request ended as a 500. On 4.2 the negotiated format list is empty, lookup falls through to the only index template the controller has (index.json.jbuilder), and the request is a 200 with the GeoJSON body. The status, the content type and the body all change, and nothing the application declares can restore the 4.0 answer: the filter is in the framework's negotiation, above the controller."
  },
