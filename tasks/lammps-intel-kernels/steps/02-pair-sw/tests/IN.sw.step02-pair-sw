# Scored input: silicon with the Stillinger-Weber three-body potential.
# Verifier-owned; never read from /app.
#
# Same physics and same potential file as the benchmark the package ships
# (`in.intel.sw`), at a system size and step count this tree does not publish.

units           metal
atom_style      atomic
newton          on

lattice         diamond 5.431
region          box block 0 6 0 6 0 6
create_box      1 box
create_atoms    1 box

pair_style      sw
pair_coeff      * * ${ROOT}/bench/POTENTIALS/Si.sw Si
mass            1 28.06

velocity        all create 1000.0 376847 loop geom

neighbor        1.0 bin
neigh_modify    delay 5 every 1

fix             1 all nve
timestep        0.001
thermo          1
thermo_style    custom step temp pe ke etotal press

run             100
run             500
