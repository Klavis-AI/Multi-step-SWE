# Scored input: polyethylene with the AIREBO reactive bond-order potential.
# Verifier-owned; never read from /app.
#
# Same physics, same data file and same potential as the benchmark the package
# ships (`in.intel.airebo`), at a system size and step count this tree does not
# publish.

units           metal
atom_style      atomic
newton          on

read_data       ${ROOT}/examples/airebo/data.airebo
replicate       4 4 4

neighbor        0.5 bin
neigh_modify    delay 5 every 1

pair_style      airebo 3.0 1 1
pair_coeff      * * ${ROOT}/potentials/CH.airebo C H

velocity        all create 300.0 761341

fix             1 all nve
timestep        0.0005
thermo          1
thermo_style    custom step temp pe ke etotal press

run             20
run             60
