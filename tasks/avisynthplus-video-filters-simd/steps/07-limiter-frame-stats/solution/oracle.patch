+++ b/avs_core/filters/conditional/intel/conditional_functions_sse.cpp
@@ -0,0 +1,153 @@
+
+// Avisynth v2.5.  Copyright 2002 Ben Rudiak-Gould et al.
+// http://avisynth.nl
