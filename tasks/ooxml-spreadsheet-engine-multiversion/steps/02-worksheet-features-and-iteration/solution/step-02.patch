+//    xlsx.SearchSheet("Sheet1", "[0-9]", true)
+//
+func (f *File) SearchSheet(sheet, value string, reg ...bool) []string {
+	var regSearch bool
+	for _, r := range reg {
+		regSearch = r
+	}
+	xlsx := f.workSheetReader(sheet)
+	result := []string{}
+	name, ok := f.sheetMap[trimSheetName(sheet)]
