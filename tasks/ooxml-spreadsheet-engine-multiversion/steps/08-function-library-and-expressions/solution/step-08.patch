+		"OCT2BIN": 511,
+		"BIN2HEX": 549755813887,
+		"DEC2HEX": 549755813887,
+		"OCT2HEX": 549755813887,
+		"BIN2OCT": 536870911,
+		"DEC2OCT": 536870911,
+		"HEX2OCT": 536870911,
