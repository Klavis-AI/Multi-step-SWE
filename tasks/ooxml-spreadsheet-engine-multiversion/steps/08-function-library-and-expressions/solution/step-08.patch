+// the precision for the numeric.
+func isNumeric(s string) (bool, int) {
+	dot := false
+	p := 0
+	for i, v := range s {
+		if v == '.' {
+			if dot {
+				return false, 0
+			}
+			dot = true
+		} else if v < '0' || v > '9' {
+			if i == 0 && v == '-' {
+				continue
+			}
+			return false, 0
+		} else if dot {
+			p++
+		}
+	}
+	return true, p
