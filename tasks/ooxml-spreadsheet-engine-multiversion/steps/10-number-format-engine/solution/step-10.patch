+// localMonthsNameEnglish returns the English name of the month.
+func localMonthsNameEnglish(t time.Time, abbr int) string {
+	if abbr == 3 {
+		return t.Month().String()[:3]
+	}
+	if abbr == 4 {
+		return t.Month().String()
+	}
+	return t.Month().String()[:1]
+}
