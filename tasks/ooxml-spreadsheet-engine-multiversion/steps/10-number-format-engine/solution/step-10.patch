+// d1mach returns double precision real machine constants.
+func d1mach(i int) float64 {
+	arr := []float64{
+		2.2250738585072014e-308,
+		1.7976931348623158e+308,
+		1.1102230246251565e-16,
+		2.2204460492503131e-16,
+		0.301029995663981195,
+	}
+	if i > len(arr) {
+		return 0
+	}
+	return arr[i-1]
+}
