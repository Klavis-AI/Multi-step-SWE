+	if sd == 30 && ed == 31 {
+		ed--
+	} else if leap := isLeapYear(sy); sm == 2 && ((leap && sd == 29) || (!leap && sd == 28)) {
+		sd = 30
+		if leap := isLeapYear(ey); em == 2 && ((leap && ed == 29) || (!leap && ed == 28)) {
+			ed = 30
+		}
