+	if _, ok := decimal.SetString(text); ok {
+		value, _ := decimal.Float64()
+		return newNumberFormulaArg(value * percent)
+	}
+	dateValue, timeValue, errTime, errDate := 0.0, 0.0, false, false
+	if !isDateOnlyFmt(text) {
