+	startTime, endTime := timeFromExcelTime(startDate, false), timeFromExcelTime(endDate, false)
+	sy, smM, sd := startTime.Date()
+	ey, emM, ed := endTime.Date()
+	sm, em := int(smM), int(emM)
+	if sd == 31 {
+		sd--
