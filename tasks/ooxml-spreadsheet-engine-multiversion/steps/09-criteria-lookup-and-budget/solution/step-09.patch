+		coupons++
+	}
+	date := changeMonth(startDate, numMonths, endOfMonth)
+	f := func(pcd, ncd time.Time) float64 {
+		return 1
+	}
+	_, _, result := datesAggregate(date, maturityTime, numMonths, basis, f, coupons, endOfMonth)
