+	endOfMonth := endOfMonthTemp
+	if !endOfMonthTemp && mm != 2 && md > 28 && md < getDaysInMonth(my, int(mm)) {
+		endOfMonth = getDaysInMonth(sy, int(sm)) == sd
+	}
+	startDate := changeMonth(settlementTime, 0, endOfMonth)
