+// incompleteGamma is an implementation of the incomplete gamma function.
+func incompleteGamma(a, x float64) float64 {
+	max := 32
+	summer := 0.0
+	for n := 0; n <= max; n++ {
+		divisor := a
+		for i := 1; i <= n; i++ {
+			divisor *= (a + float64(i))
+		}
+		summer += math.Pow(x, float64(n)) / divisor
+	}
+	return math.Pow(x, a) * math.Exp(0-x) * summer
+}
