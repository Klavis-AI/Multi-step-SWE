+			ShowDLblsOverMax: &attrValBool{Val: boolPtr(false)},
+		},
+		SpPr: &cSpPr{
+			SolidFill: &aSolidFill{
+				SchemeClr: &aSchemeClr{Val: "bg1"},
+			},
+			Ln: &aLn{
+				W:    9525,
+				Cap:  "flat",
+				Cmpd: "sng",
+				Algn: "ctr",
+				SolidFill: &aSolidFill{
+					SchemeClr: &aSchemeClr{Val: "tx1",
+						LumMod: &attrValInt{
+							Val: intPtr(15000),
+						},
+						LumOff: &attrValInt{
+							Val: intPtr(85000),
+						},
+					},
+				},
+			},
+		},
+		PrintSettings: &cPrintSettings{
