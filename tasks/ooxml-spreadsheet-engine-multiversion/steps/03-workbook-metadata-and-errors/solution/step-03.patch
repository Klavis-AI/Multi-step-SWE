+// xlsxCalcChainC directly maps the c element.
+type xlsxCalcChainC struct {
+	R string `xml:"r,attr"`
+	I int    `xml:"i,attr"`
+	L bool   `xml:"l,attr,omitempty"`
+	S bool   `xml:"s,attr,omitempty"`
+	T bool   `xml:"t,attr,omitempty"`
+	A bool   `xml:"a,attr,omitempty"`
+}
