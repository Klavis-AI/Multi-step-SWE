-void NumpyReader::setArray(PyObject* array)
-{
-    plang::Environment::get();
-    if (!PyArray_Check(array))
-        throw pdal::pdal_error("object provided to setArray is not a python numpy array!");
-
-    m_array = (PyArrayObject*)array;
-    Py_XINCREF(m_array);
