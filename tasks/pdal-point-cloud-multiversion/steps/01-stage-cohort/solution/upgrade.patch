-        return Type::Signed8;
-    case NPY_INT16:
-        return Type::Signed16;
-    case NPY_INT32:
-        return Type::Signed32;
-    case NPY_INT64:
-        return Type::Signed64;
-    case NPY_UINT8:
-        return Type::Unsigned8;
-    case NPY_UINT16:
-        return Type::Unsigned16;
-    case NPY_UINT32:
-        return Type::Unsigned32;
-    case NPY_UINT64:
-        return Type::Unsigned64;
-    default:
-        return Type::None;
-    }
-    assert(0);
-
-    return Type::None;
-}
