-    m_strideptr = NULL;
-    m_innersizeptr = NULL;
-    m_dtype = NULL;
-
-    if (m_filename.size())
-    {
-        m_array = load_npy(m_filename);
-    }
-    if (m_array)
-        if (!PyArray_Check(m_array))
-            throw pdal::pdal_error("Object in file  '" + m_filename +
-                "' is not a numpy array");
-}
