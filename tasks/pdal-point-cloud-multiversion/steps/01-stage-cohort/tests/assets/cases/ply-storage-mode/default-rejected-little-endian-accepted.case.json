{
 "doc": "stages/writers.ply.rst: 'storage_mode: Type of ply file to write. Valid values are 'ascii', 'little endian', 'big endian'. [Default: \"ascii\"]' -- 'default' is not a valid value and is refused when given in pipeline JSON; 'little endian' is accepted and writes a 'format binary_little_endian 1.0' header.",
 "files": {
  "in.las": {
   "fixture": "dups.las"
  },
  "bad.json": {
   "text": "{\"pipeline\": [\"in.las\", {\"type\": \"writers.ply\", \"filename\": \"bad.ply\", \"storage_mode\": \"default\"}]}"
  },
  "ok.json": {
   "text": "{\"pipeline\": [\"in.las\", {\"type\": \"writers.ply\", \"filename\": \"ok.ply\", \"storage_mode\": \"little endian\"}]}"
  }
 },
 "run": [
  {
   "argv": [
    "pipeline",
    "bad.json"
   ]
  },
  {
   "argv": [
    "pipeline",
    "ok.json"
   ]
  }
 ],
 "checks": [
