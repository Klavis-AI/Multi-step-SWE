-bool OWStatement::Execute(int nRows)
-{
-    sword nStatus = OCIStmtExecute(poConnection->hSvcCtx,
-                                   hStmt,
-                                   hError,
-                                   (ub4) nRows,
-                                   (ub4) 0,
-                                   (OCISnapshot*) NULL,
-                                   (OCISnapshot*) NULL,
-                                   nStmtMode);
-
-    if (CheckError(nStatus, hError))
-    {
-        return false;
-    }
-
-
-    if (nStatus == OCI_SUCCESS_WITH_INFO || nStatus == OCI_NO_DATA)
-    {
-        return false;
-    }
-
-    return true;
-}
