-void OciWriter::createBlockTable()
-{
-    std::ostringstream oss;
-    oss << "CREATE TABLE " << m_blockTableName <<
-        " AS SELECT * FROM MDSYS.SDO_PC_BLK_TABLE";
-
-    runCommand(oss);
-    m_connection->Commit();
-    m_bDidCreateBlockTable = true;
-}
