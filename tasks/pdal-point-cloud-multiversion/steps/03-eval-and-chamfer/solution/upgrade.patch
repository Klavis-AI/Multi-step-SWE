+    else if (auto p = env("AZURE_ENDPOINT"))
+    {
+        return *p;
+    }
+
+    if (!c.is_null() && c.value("verbose", false))
+    {
+        std::cout << "endpoint not found - defaulting to core.windows.net" << std::endl;
+    }
+
+    return "core.windows.net";
+}
