-void OciWriter::runFileSQL(std::string const& sql)
-{
-    if (sql.empty())
-        return;
-
-    std::ostringstream oss;
-    if (!Utils::fileExists(sql))
-        oss << sql;
-    else
-        // Our "sql" is really the filename in the ptree
-        oss << loadSQLData(sql);
-    runCommand(oss);
-}
