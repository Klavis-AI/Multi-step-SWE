{
 "doc": "apps/index.rst: 'Operations are run by invoking the ``pdal`` application along with a command name'",
 "files": {
  "a.txt": {
   "text": "X,Y,Z,Classification\n0,0,0,2\n1,0,0,2\n"
  },
  "b.txt": {
   "text": "X,Y,Z,Classification\n0,0,0,2\n1,0,0,4\n"
  }
 },
 "run": [
  {
   "argv": [
    "chamfer",
    "a.txt",
    "b.txt"
   ],
   "stdout_to": "chamfer.json"
  },
  {
   "argv": [
    "eval",
    "a.txt",
    "b.txt",
    "--labels",
    "2,4"
   ],
   "stdout_to": "eval.json"
  }
 ],
 "checks": [
  {
   "kind": "exit",
   "run": 0,
   "equals": 0
  },
  {
   "kind": "exit",
   "run": 1,
   "equals": 0
  },
  {
   "kind": "file_json",
   "file": "chamfer.json",
   "path": [
    "chamfer"
   ],
   "approx": 0.0,
   "tol": 1e-09
  },
  {
   "kind": "file_json",
   "file": "eval.json",
   "path": [
    "confusion_matrix"
   ],
   "equals": "[[1,0,0],[1,0,0],[0,0,0]]"
  },
  {
   "kind": "file_json",
   "file": "eval.json",
   "path": [
    "overall_accuracy"
   ],
   "approx": 0.5,
   "tol": 0.0005
  }
 ]
}
