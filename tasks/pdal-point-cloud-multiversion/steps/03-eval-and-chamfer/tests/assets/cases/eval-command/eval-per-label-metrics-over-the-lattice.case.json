   ],
   "approx": 0.6,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "labels",
    0,
    "f1_score"
   ],
   "approx": 0.75,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "labels",
    0,
    "accuracy"
   ],
   "approx": 0.8,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "labels",
    1,
    "label"
   ],
   "equals": "2"
