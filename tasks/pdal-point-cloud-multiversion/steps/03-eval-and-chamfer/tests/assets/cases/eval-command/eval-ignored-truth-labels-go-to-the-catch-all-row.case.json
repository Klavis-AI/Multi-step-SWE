{
 "doc": "apps/eval.rst: 'Although unlabeled/ignored truth labels are reported in the confusion matrix, they are excluded from all computed scores.'",
 "files": {
  "in.las": {
   "fixture": "grid.las"
  }
 },
 "run": [
  {
   "argv": [
    "translate",
    "in.las",
    "predicted.las",
    "assign",
    "--filters.assign.assignment=Classification[:]=2",
    "--filters.assign.where=Z < 2"
   ]
  },
  {
   "argv": [
    "eval",
    "predicted.las",
    "in.las",
    "--labels",
    "2"
   ]
  }
 ],
 "checks": [
  {
   "kind": "exit",
   "run": 1,
   "equals": 0
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "confusion_matrix"
   ],
   "equals": "[[500,0],[200,300]]"
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "labels"
   ],
   "length": 1
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "labels",
    0,
    "label"
   ],
   "equals": "2"
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "labels",
    0,
    "support"
   ],
   "equals": 500
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "labels",
    0,
    "intersection_over_union"
   ],
   "approx": 1.0,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "overall_accuracy"
   ],
   "approx": 1.0,
   "tol": 0.0005
  }
 ]
}
