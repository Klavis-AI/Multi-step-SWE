{
 "doc": "apps/eval.rst: '--labels arg        Comma-separated list of classification labels to evaluate.'",
 "files": {
  "predicted.txt": {
   "text": "X,Y,Z,Classification\n0,0,0,2\n1,0,0,2\n2,0,0,4\n3,0,0,4\n"
  },
  "truth.txt": {
   "text": "X,Y,Z,Classification\n0,0,0,2\n1,0,0,4\n2,0,0,4\n3,0,0,4\n"
  }
 },
 "run": [
  {
   "argv": [
    "eval",
    "predicted.txt",
    "truth.txt"
   ]
  },
  {
   "argv": [
    "eval",
    "predicted.txt",
    "truth.txt",
    "--labels",
    "2,4"
   ],
   "stdout_to": "ok.json"
  }
 ],
 "checks": [
  {
   "kind": "exit",
   "run": 0,
   "nonzero": true
  },
  {
   "kind": "stderr_regex",
   "run": 0,
   "regex": "labels"
  },
  {
   "kind": "exit",
   "run": 1,
   "equals": 0
  },
  {
   "kind": "file_json",
   "file": "ok.json",
   "path": [
    "overall_accuracy"
   ],
   "approx": 0.75,
   "tol": 0.0005
  }
 ]
}
