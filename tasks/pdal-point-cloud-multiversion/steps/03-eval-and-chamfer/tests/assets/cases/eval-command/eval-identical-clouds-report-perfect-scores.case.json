{
 "doc": "apps/eval.rst: 'The ``eval`` command is used to compare the ``Classification`` dimensions of two point clouds.' apps/eval.rst: 'The command returns 0 along with a JSON-formatted classification report summarizing various classification metrics.'",
 "files": {
  "truth.las": {
   "fixture": "grid.las"
  }
 },
 "run": [
  {
   "argv": [
    "eval",
    "truth.las",
    "truth.las",
    "--labels",
    "1,2"
   ]
  }
 ],
 "checks": [
  {
   "kind": "exit",
   "run": 0,
   "equals": 0
  },
  {
   "kind": "stdout_json",
   "run": 0,
   "path": [
    "confusion_matrix"
   ],
   "equals": "[[500,0,0],[0,500,0],[0,0,0]]"
  },
  {
   "kind": "stdout_json",
   "run": 0,
   "path": [
    "overall_accuracy"
   ],
   "approx": 1.0,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 0,
   "path": [
    "mean_intersection_over_union"
   ],
   "approx": 1.0,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 0,
   "path": [
    "f1_score"
   ],
   "approx": 1.0,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 0,
   "path": [
    "labels"
   ],
   "length": 2
  },
  {
   "kind": "stdout_json",
   "run": 0,
   "path": [
    "labels",
    0,
    "support"
   ],
   "equals": 500
  },
  {
   "kind": "stdout_json",
   "run": 0,
   "path": [
    "labels",
    1,
    "support"
   ],
   "equals": 500
  }
 ]
}
