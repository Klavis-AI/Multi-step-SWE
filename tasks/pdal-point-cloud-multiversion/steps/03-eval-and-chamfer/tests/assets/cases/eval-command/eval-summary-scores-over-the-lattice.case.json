{
 "doc": "apps/eval.rst: 'Most of the returned metrics will be self explanatory, with scores reported both for individual classes and at a summary level.'",
 "files": {
  "in.las": {
   "fixture": "grid.las"
  }
 },
 "run": [
  {
   "argv": [
    "translate",
    "in.las",
    "predicted.las",
    "assign",
    "--filters.assign.assignment=Classification[:]=2",
    "--filters.assign.where=Z < 2"
   ]
  },
  {
   "argv": [
    "eval",
    "predicted.las",
    "in.las",
    "--labels",
    "1,2"
   ]
  }
 ],
 "checks": [
  {
   "kind": "exit",
   "run": 1,
   "equals": 0
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "overall_accuracy"
   ],
   "approx": 0.8,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "mean_intersection_over_union"
   ],
   "approx": 0.657,
   "tol": 0.0005
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "f1_score"
   ],
   "approx": 0.793,
   "tol": 0.0005
  }
 ]
}
