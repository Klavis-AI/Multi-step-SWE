-            ToDuration,
-            Period,
-            Period::num == 1,
-            Period::den == 1
-        > Aux;
-        BOOST_CONSTEXPR ToDuration operator()(const FromDuration& fd) const
-        {
-            return Aux()(fd);
-        }
-    };
