-    <H1 CLASS="title">The Boost Iostreams Library</H1>
-    <HR CLASS="banner">
-
-<!-- End Banner -->
-
-<DL CLASS="page-index">
-  <DT><A href="#purpose">Purpose</A></DT>
-  <DT><A href="#overview">Overview</A></DT>
-  <DT><A href="#documentation">How to Read the Iostreams Documentation</A></DT>
