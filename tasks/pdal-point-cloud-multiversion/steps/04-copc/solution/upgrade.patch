-// // In global namespace:
-// BOOST_IOSTREAMS_CODECVT_SPEC(mystate)
-//
-// // In user namespace:
-// template<typename Intern, typename Extern>
-// struct mycodecvt : codecvt_helper<Intern, Extern, State> { ... };
-//
-// // Or:
-// struct mycodecvt : codecvt_helper<wchar_t, char, State> { ... };
-// 
