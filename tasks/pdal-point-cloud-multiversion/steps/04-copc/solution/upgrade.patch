-      , ArgAlloc & arg_alloc
-      , Pair* p, BOOST_RV_REF_BEG Pair2 BOOST_RV_REF_END x)
-{  (dispatch_uses_allocator)(construct_alloc, arg_alloc, p, ::pdalboost::move(x.first), ::pdalboost::move(x.second));  }
