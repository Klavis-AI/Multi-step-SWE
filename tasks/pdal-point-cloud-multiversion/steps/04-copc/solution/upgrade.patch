-    <HR CLASS="banner">
-
-<!-- End Banner -->
-
-<H3>Contents</H3>
-
-<DL CLASS="page-index">
-  <DT><A href="#goals">Design Goals</A>
-    <DL CLASS="page-index">
-      <DT><A href="#simplicity">Simplicity</A></DT>
