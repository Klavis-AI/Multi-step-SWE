+inline std::istream& operator>>(std::istream& in, Compression& c)
+{
+    std::string s;
+
+    in >> s;
+    s = Utils::toupper(s);
+    if (s == "LASZIP"  || s == "TRUE" || s == "LAZPERF")
+        c = Compression::True;
+    else
+        c = Compression::False;
+    return in;
