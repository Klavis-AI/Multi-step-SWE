-    template<class T>
-    static void invoke(Archive & ar, T &t){
-        typedef typename mpl::eval_if<
-                // if its primitive
-                mpl::equal_to<
-                    pdalboost::serialization::implementation_level< T >,
-                    mpl::int_<pdalboost::serialization::primitive_type>
