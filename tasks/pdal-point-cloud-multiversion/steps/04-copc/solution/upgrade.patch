-    typedef typename remove_cv<D>::type ncvD;
-
-    BOOST_STATIC_CONSTANT(bool, value = (BOOST_IS_BASE_OF(B,D) && ! ::pdalboost::is_same<ncvB,ncvD>::value));
-};
-#endif
-} // namespace detail
