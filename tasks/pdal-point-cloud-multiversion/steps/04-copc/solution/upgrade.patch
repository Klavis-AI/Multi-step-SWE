+void GpstimeLoader::pack(const PointRef& point, char *buf, int bufsize)
+{
+    buf += m_offset;
+    bufsize -= m_offset;
+    LeInserter ostream(buf, bufsize);
+
+    ostream << point.getFieldAs<double>(Dimension::Id::GpsTime);
+}
