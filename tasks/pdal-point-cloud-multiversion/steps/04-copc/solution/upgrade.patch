-template<typename Mode, typename Range>
-class range_adapter {
-private:
-    typedef typename Range::iterator                  iterator;
-    typedef pdalboost::detail::iterator_traits<iterator>  iter_traits;
-    typedef typename iter_traits::iterator_category   iter_cat;
-public:
