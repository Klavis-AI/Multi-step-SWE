-class ctti_data {
-#ifndef BOOST_NO_CXX11_DELETED_FUNCTIONS
-public:
-    ctti_data() = delete;
-    ctti_data(const ctti_data&) = delete;
-    ctti_data& operator=(const ctti_data&) = delete;
-#else
-private:
-    ctti_data();
