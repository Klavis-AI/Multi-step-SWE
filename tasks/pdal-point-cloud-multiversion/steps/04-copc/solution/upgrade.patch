+        iss >> bounds;
+    }
+    catch (Bounds4D::error& error)
+    {
+        std::string msg = "Error parsing '" + s + "': " + error.what();
+        return StatusWithReason(-1, msg);
+    }
+    return true;
+}
+
+} //namespace Utils;
+
+} //namespace pdal;
