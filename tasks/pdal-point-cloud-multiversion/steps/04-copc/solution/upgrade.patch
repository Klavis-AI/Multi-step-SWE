@@ -0,0 +1,353 @@
+/*
+===============================================================================
+
+  FILE:  las.hpp
+
+  CONTENTS:
+    Point formats for LAS
+
+  PROGRAMMERS:
+
+    martin.isenburg@rapidlasso.com  -  http://rapidlasso.com
+    uday.karan@gmail.com - Hobu, Inc.
+
+  COPYRIGHT:
