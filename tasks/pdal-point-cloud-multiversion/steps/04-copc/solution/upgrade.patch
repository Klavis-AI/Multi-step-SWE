-
-        static std::streamsize max_streamsize() { 
-            return (std::numeric_limits<std::streamsize>::max)();
-        }
-
-        // --- data ---
-        int         argN_;  //- argument number (starts at 0,  eg : %1 => argN=0)
-                            //  negative values for items that don't process an argument
