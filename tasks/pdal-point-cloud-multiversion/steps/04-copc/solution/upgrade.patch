-void safe_iterator_base::attach(safe_container_base* cont_)
-{
-  cont=cont_;
-  if(cont){
-#if defined(BOOST_HAS_THREADS)
-    pdalboost::detail::lightweight_mutex::scoped_lock lock(cont->mutex);
-#endif
