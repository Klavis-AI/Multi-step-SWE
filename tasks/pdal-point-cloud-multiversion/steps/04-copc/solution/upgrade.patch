-// Returns the current working directory
-inline std::string current_directory()
-{
-#ifdef BOOST_IOSTREAMS_WINDOWS
-    DWORD               length;
-    basic_buffer<char>  buf(MAX_PATH);
-    while (true) {
-        length = ::GetCurrentDirectoryA(buf.size(), buf.data());
