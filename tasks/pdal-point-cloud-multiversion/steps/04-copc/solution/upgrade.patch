-    ); \
-    BOOST_STATIC_CONSTANT( \
-        type_, \
-        name = \
-            ( ::pdalboost::iostreams::detail::select_by_size< \
-                BOOST_PP_CAT(boost_select_by_size_temp_, name) \
-              >::value ) \
