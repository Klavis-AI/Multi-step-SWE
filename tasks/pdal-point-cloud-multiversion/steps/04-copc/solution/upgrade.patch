index 000000000..76f984d7d
--- /dev/null
+++ b/vendor/lazperf/compressor.hpp
@@ -0,0 +1,200 @@
+/*
+===============================================================================
+
+  FILE:  compressor.hpp
+  
+  CONTENTS:
+    Integer compressor
+
+  PROGRAMMERS:
+
+    martin.isenburg@rapidlasso.com  -  http://rapidlasso.com
+    uday.karan@gmail.com - Hobu, Inc.
+  
+  COPYRIGHT:
