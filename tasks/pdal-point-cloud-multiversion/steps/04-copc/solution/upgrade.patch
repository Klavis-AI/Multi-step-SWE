-template &lt;typename UniformRandomNumberGenerator&gt;
-class basic_random_generator {
-public:
-    typedef uuid result_type;
-    
-    basic_random_generator();
-    explicit basic_random_generator(UniformRandomNumberGenerator&amp; gen);
