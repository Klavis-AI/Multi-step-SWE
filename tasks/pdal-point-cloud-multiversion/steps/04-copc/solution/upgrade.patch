-void prepare_keys(int size)
-{
-    // Prepare keys
-    keys.clear();
-    for (int i = 0; i < size; ++i)
-        keys.push_back((format("%d") % i).str());
-    shuffled_keys = keys;
-    srand(0);
-    random_shuffle(shuffled_keys.begin(), shuffled_keys.end());
