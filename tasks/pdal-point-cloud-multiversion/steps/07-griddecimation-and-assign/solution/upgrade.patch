+            for (las::TilePtr& t : d->tiles)
+                if (!t)
+                {
+                    t = std::move(tile);
+                    goto done;
+                }
+            d->tiles.push_back(std::move(tile));
+        }
+        done:
+        d->processedCv.notify_one();
+    });
+    d->nextFetchChunk++;
+    // After the first chunk, we always start at 0.
+    d->nextFetchPoint = 0;
