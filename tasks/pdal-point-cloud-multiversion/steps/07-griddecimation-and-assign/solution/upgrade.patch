diff --git a/vendor/h3/lib/h3Index.c b/vendor/h3/lib/h3Index.c
new file mode 100644
index 000000000..bccd4baf5
--- /dev/null
+++ b/vendor/h3/lib/h3Index.c
@@ -0,0 +1,1211 @@
+/*
