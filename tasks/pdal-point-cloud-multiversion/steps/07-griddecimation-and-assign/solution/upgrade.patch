+ *
+ * Note: Technically works on H3 edges, but will return base cell of the
+ * origin cell. */
+DECLSPEC int H3_EXPORT(getBaseCellNumber)(H3Index h);
+/** @} */
+
+/** @defgroup stringToH3 stringToH3
+ * Functions for stringToH3
+ * @{
+ */
