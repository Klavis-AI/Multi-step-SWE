{
  "doc": "apps/eval.rst: 'The command returns 0 along with a JSON-formatted classification report summarizing various classification metrics.'",
  "files": {
    "truth.las": {"fixture": "grid.las"}
  },
  "run": [
    {"argv": ["eval", "truth.las", "truth.las", "--labels", "1,2"], "stdout_to": "eval.json"}
  ],
  "checks": [
    {"kind": "exit", "run": 0, "equals": 0},
    {"kind": "file_json", "file": "eval.json", "path": ["overall_accuracy"], "approx": 1.0, "tol": 1e-9},
    {"kind": "file_json", "file": "eval.json", "path": ["labels", 0, "label"], "equals": "1"},
    {"kind": "file_json", "file": "eval.json", "path": ["labels", 1, "label"], "equals": "2"}
  ]
}
