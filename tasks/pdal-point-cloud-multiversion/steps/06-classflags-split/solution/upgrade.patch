+class PDAL_DLL ArrowWriter  : public Writer, public Streamable
+{
+public:
+    ArrowWriter();
+    std::string getName() const;
+    ~ArrowWriter();
+
+private:
+
+    virtual void addArgs(ProgramArgs& args);
+    virtual void initialize();
