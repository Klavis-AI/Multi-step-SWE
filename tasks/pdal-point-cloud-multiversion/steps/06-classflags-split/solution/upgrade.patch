+
+  for (size_t i = 0; i < nPts; i++)
+    origPointIndexVec[i] = m_cell3DVec[i].origPtIndex;
+}
+
+bool LEPCC::GetOrigPointIndexes(uint32* origPointIndexVec, int maxPtCount) const
+{
+  size_t nPts = m_cell3DVec.size();
+  if (maxPtCount < (int)nPts)
+    return false;
+  for (size_t i = 0; i < nPts; i++)
+    origPointIndexVec[i] = m_cell3DVec[i].origPtIndex;
+  return true;
+}
