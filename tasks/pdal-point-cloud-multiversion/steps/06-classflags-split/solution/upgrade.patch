-  const_array<Byte> flagByteArr(flagBytes, nElem);    // safe wrapper
-
-  if (m_compressionMethod == BitStuff)
-  {
-    m_dataVec.resize(nElem);
-
-    for (uint32 i = 0; i < nElem; i++)
-      m_dataVec[i] = flagByteArr[i] - m_minValue;    // subtract offset
