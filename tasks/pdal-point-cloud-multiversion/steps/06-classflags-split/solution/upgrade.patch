-int ReadBlobSize(lepcc_ContextHdl ctx, FILE* fp)
-{
-  Byte buffer[64];
-  int nBytes = 0;
-  int nInfo = lepcc_getBlobInfoSize();
-
-  if (nInfo == fread(buffer, 1, nInfo, fp))
-  {
-    lepcc_blobType bt;
-    uint32 blobSize = 0;
-    ErrCode errCode = (ErrCode)lepcc_getBlobInfo(ctx, buffer, nInfo, &bt, &blobSize);
