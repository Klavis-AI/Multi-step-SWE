-
-int64 Huffman::ComputeNumBytesNeededToEncode(const vector<int>& histo)
-{
-  int nBytes = -1;
-  double avgBpp = 0;
-
-  if (!ComputeCodes(histo) || !ComputeCompressedSize(histo, nBytes, avgBpp))
-    nBytes = -1;
