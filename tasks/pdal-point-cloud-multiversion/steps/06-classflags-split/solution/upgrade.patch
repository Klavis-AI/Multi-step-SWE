-ErrCode FlagBytes::GetNumPointsFromHeader(const Byte* pByte, int64 bufferSize, uint32& nPts)
-{
-  nPts = 0;
-
-  TopHeader topHd;
-  Header1 hd1;
-  ErrCode errCode;
-  if ((errCode = ReadHeaders(pByte, bufferSize, topHd, hd1)) != ErrCode::Ok)
-    return errCode;
-
-  nPts = hd1.numPoints;
-  return ErrCode::Ok;
