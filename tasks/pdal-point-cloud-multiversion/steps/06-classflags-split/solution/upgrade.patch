-    size_t m_maxHistoSize;
-    std::vector<std::pair<unsigned short, unsigned int> > m_codeTable;
-    std::vector<std::pair<short, short> > m_decodeLUT;
-    int m_maxNumBitsLUT;
-    int m_numBitsToSkipInTree;
-    Node* m_root;
