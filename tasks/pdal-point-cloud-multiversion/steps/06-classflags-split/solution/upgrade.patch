+                {
+                    std::stringstream msg;
+                    msg << "Unable to write int64_t value '" << value << "' to file";
+                    throw pdal_error(msg.str());
+                }
+            }
+            break;
+        }
+    case Dimension::Type::None:
+        break;
+    default:
+        throw pdal_error("Unrecognized PDAL dimension type for dimension");
+
+    }
+}
