    {"argv": ["info", "--stats", "--dimensions", "Withheld", "in.las"], "stdout_to": "withheld.json"},
    {"argv": ["info", "--stats", "--dimensions", "Overlap", "in.las"], "stdout_to": "overlap.json"}
