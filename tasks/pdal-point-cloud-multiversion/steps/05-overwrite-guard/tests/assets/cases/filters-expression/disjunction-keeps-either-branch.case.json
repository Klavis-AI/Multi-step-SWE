{
  "doc": "stages/filters.expression.rst: 'The **Expression Filter** applies filtering to the input point cloud based on a set of criteria on the given dimensions.' -- The grammar also has '||'. The two extreme x-slices of the lattice are 100 points each, so the disjunction keeps 200 points whose X is only ever 0 or 9 and whose mean X is 4.5.",
  "files": {
    "in.las": {
      "fixture": "grid.las"
    },
    "p.json": {
      "text": "{\"pipeline\":[{\"type\":\"readers.las\",\"filename\":\"in.las\"},{\"type\":\"filters.expression\",\"expression\":\"X == 0 || X == 9\"},{\"type\":\"writers.las\",\"filename\":\"out.las\"}]}"
    }
  },
  "run": [
    {
      "argv": [
        "pipeline",
        "p.json"
      ]
    }
  ],
  "checks": [
    {
      "kind": "exit",
      "run": 0,
      "equals": 0
    },
    {
      "kind": "las",
      "file": "out.las",
      "header": {
        "point_count": 200
      },
      "dims": {
        "X": {
          "min": {
            "equals": 0.0
          },
          "max": {
            "equals": 9.0
          },
          "mean": {
            "approx": 4.5,
            "tol": 1e-09
          },
          "unique": [
            0.0,
            9.0
          ]
        }
      }
    }
  ]
}
