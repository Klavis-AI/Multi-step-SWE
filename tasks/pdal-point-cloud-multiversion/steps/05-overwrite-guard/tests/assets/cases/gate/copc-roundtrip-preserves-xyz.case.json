    {"kind": "las", "file": "back.las",
     "header": {"point_count": 1000},
     "dims": {
       "X": {"min": {"equals": 0.0}, "max": {"equals": 9.0}, "mean": {"approx": 4.5, "tol": 1e-9}},
       "Y": {"min": {"equals": 0.0}, "max": {"equals": 9.0}, "mean": {"approx": 4.5, "tol": 1e-9}},
       "Z": {"min": {"equals": 0.0}, "max": {"equals": 9.0}, "mean": {"approx": 4.5, "tol": 1e-9}}
     }}
  ]
