    "write.json": {"text": "{\"pipeline\":[{\"type\":\"readers.las\",\"filename\":\"in.las\"},{\"type\":\"writers.copc\",\"filename\":\"out.copc.laz\"}]}"},
    "read.json": {"text": "{\"pipeline\":[{\"type\":\"readers.copc\",\"filename\":\"out.copc.laz\"},{\"type\":\"writers.las\",\"filename\":\"back.las\"}]}"}
  },
  "run": [
    {"argv": ["pipeline", "write.json"]},
    {"argv": ["pipeline", "read.json"]}
  ],
  "checks": [
