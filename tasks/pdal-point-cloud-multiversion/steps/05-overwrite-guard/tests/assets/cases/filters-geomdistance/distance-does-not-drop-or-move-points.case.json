{
  "doc": "stages/filters.geomdistance.rst: 'The geomdistance filter computes the distance between a given polygon and points.' -- it annotates, it does not select: all 1000 points come through with X, Y, Intensity, Classification and PointSourceId identical point for point to the input.",
  "files": {
    "in.las": {
      "fixture": "grid.las"
    },
    "ref.las": {
      "fixture": "grid.las"
    },
    "p.json": {
      "text": "{\"pipeline\":[{\"type\":\"readers.las\",\"filename\":\"in.las\"},{\"type\":\"filters.geomdistance\",\"geometry\":\"POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))\"},{\"type\":\"filters.assign\",\"value\":\"Z = distance\"},{\"type\":\"writers.las\",\"filename\":\"out.las\"}]}"
    }
  },
  "run": [
    {
      "argv": [
        "pipeline",
        "p.json"
      ]
    }
  ],
  "checks": [
    {
      "kind": "exit",
      "run": 0,
      "equals": 0
    },
    {
      "kind": "las",
      "file": "out.las",
      "header": {
        "point_count": 1000
      }
    },
    {
      "kind": "las_compare",
      "a": "out.las",
      "b": "ref.las",
      "dims": [
        "X",
        "Y",
        "Intensity",
        "Classification",
        "PointSourceId"
      ]
    }
  ]
}
