+
+inline std::istream& operator>>(std::istream& in, RegEx& regex)
+{
+    std::string expr;
+
+    in >> expr;
+    regex.m_str = expr;
+
+    return in;
+}
+
+inline bool operator==(const RegEx& lhs, const RegEx& rhs)
+{
+    return lhs.m_str == rhs.m_str;
+}
