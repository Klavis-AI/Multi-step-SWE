-  void SetUp() override {
-    EXPECT_EQ(1, value_);
-    value_++;
-  }
-
-  void TearDown() override {
-    EXPECT_EQ(2, value_);
-    value_++;
-  }
-
-  T value_;
-  static T* shared_;
-};
