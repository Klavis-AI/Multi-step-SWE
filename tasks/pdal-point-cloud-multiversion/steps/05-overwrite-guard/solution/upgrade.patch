+    m_istreamPtr->read(reinterpret_cast<char *>(&hdr->PosScanner), sizeof(hdr->PosScanner));
+    m_istreamPtr->read(reinterpret_cast<char *>(&hdr->PosEcho), sizeof(hdr->PosEcho));
