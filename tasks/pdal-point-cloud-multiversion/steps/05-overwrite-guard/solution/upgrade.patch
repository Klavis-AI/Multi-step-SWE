-
-  def testJSON(self):
-    """Verifies XML output for listing tests in a Google Test binary.
-
-    Runs a test program that generates an empty XML output, and
-    tests that the XML output is expected.
-    """
-    self._TestOutput('json', EXPECTED_JSON)
