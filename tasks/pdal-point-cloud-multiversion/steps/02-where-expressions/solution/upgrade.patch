diff --git a/filters/private/expr/MathExpression.hpp b/filters/private/expr/MathExpression.hpp
new file mode 100644
index 000000000..388118eef
--- /dev/null
+++ b/filters/private/expr/MathExpression.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+#include "Expression.hpp"
+
+namespace pdal
+{
+namespace expr
+{
+
+class MathExpression : public Expression
