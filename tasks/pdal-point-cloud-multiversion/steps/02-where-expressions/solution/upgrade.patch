+
+namespace Utils
+{
+
+template<>
+inline StatusWithReason fromString(const std::string& from,
+    pdal::i3s::Obb& obb)
+{
+    NL::json spec;
+    try
+    {
+        spec = NL::json::parse(from);
+    }
+    catch (const NL::json::exception& ex)
+    {
+        return { -1, ex.what() };
+    }
+    try
+    {
+        obb.parse(spec);
+    }
+    catch (const i3s::EsriError& err)
+    {
+        return { -1, err.what() };
+    }
+    return true;
+}
