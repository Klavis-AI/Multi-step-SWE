+inline std::string fixName(std::string name)
+{
+    size_t pos = 0;
+    while (true)
+    {
+        pos = extractName(name, 0);
+        if (pos == name.size())
+            break;
+        name[pos] = '_';
+    }
+    return name;
+}
+
+inline bool nameValid(std::string name)
+{
+    name = Utils::toupper(name);
+    if (extractName(name, 0) != name.size())
+        return false;
+    if (name == "WHERE")
+        return false;
+    return true;
+}
