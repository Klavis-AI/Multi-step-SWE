-		 *  On return:
-		 *  dataset[ind[0..lim1-1]][cutfeat]<cutval
-		 *  dataset[ind[lim1..lim2-1]][cutfeat]==cutval
-		 *  dataset[ind[lim2..count]][cutfeat]>cutval
