{
 "doc": "spec/PROFILE.md 2.2, which makes stages/readers.las.rst normative for the PDRF-dependent dimension list: '`readers.las` exposes `ScanChannel` and `ClassFlags` only for PDRF 6-10.  For point data record formats 0-5 those dimensions are absent from the schema.'  stages/readers.las.rst as shipped at 2.2.0 carries no sentence of its own on this -- its one point-format note is about waveform records (formats 4, 5, 9 and 10), which does not bear on the dimension list.",
 "files": {
  "in.las": {
   "fixture": "grid.las"
  }
 },
 "run": [
  {
   "argv": [
    "translate",
    "in.las",
    "p6.las",
    "--writers.las.minor_version=4",
    "--writers.las.dataformat_id=6"
   ]
  },
  {
   "argv": [
    "info",
    "--schema",
    "p6.las"
   ]
  },
  {
   "argv": [
    "translate",
    "in.las",
    "p3.las",
    "--writers.las.minor_version=4",
    "--writers.las.dataformat_id=3"
   ]
  },
  {
   "argv": [
    "info",
    "--schema",
    "p3.las"
   ]
  }
 ],
 "checks": [
  {
   "kind": "exit",
   "run": 0,
   "equals": 0
  },
  {
   "kind": "exit",
   "run": 1,
   "equals": 0
  },
  {
   "kind": "exit",
   "run": 2,
   "equals": 0
  },
  {
   "kind": "exit",
   "run": 3,
   "equals": 0
  },
  {
   "kind": "stdout_json",
   "run": 1,
   "path": [
    "schema",
    "dimensions"
   ],
   "length": 15
  },
  {
   "kind": "stdout_regex",
   "run": 1,
   "regex": "\"name\"\\s*:\\s*\"ScanChannel\""
  },
  {
   "kind": "stdout_regex",
   "run": 1,
   "regex": "\"name\"\\s*:\\s*\"ClassFlags\""
  },
  {
   "kind": "stdout_json",
   "run": 3,
   "path": [
    "schema",
    "dimensions"
   ],
   "length": 16
  },
  {
   "kind": "stderr_regex",
   "run": 3,
   "regex": "ScanChannel",
   "absent": true
  },
  {
   "kind": "stderr_regex",
   "run": 3,
   "regex": "ClassFlags",
   "absent": true
  }
 ]
}
