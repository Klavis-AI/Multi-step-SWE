{
 "doc": "stages/expression.rst Examples: '(NumberOfReturns > 1 && ReturnNumber == 1) Selects \"first\" returns from a laser pulse.', '!(NumberOfReturns == 1) Selects only those points where the laser pulse generated multiple returns.' and 'X > 2500 && X < 4700 && Y > 0'",
 "files": {
  "in.las": {
   "fixture": "grid.las"
  },
  "p0.json": {
   "text": "{\"pipeline\": [{\"type\": \"readers.las\", \"filename\": \"in.las\"}, {\"type\": \"filters.assign\", \"assignment\": \"Classification[:]=7\", \"where\": \"NumberOfReturns > 1 && ReturnNumber == 1\"}, {\"type\": \"filters.range\", \"limits\": \"Classification[7:7]\"}, {\"type\": \"writers.las\", \"filename\": \"out0.las\"}]}"
  },
  "p1.json": {
   "text": "{\"pipeline\": [{\"type\": \"readers.las\", \"filename\": \"in.las\"}, {\"type\": \"filters.assign\", \"assignment\": \"Classification[:]=7\", \"where\": \"!(NumberOfReturns == 1)\"}, {\"type\": \"filters.range\", \"limits\": \"Classification[7:7]\"}, {\"type\": \"writers.las\", \"filename\": \"out1.las\"}]}"
  },
  "p2.json": {
   "text": "{\"pipeline\": [{\"type\": \"readers.las\", \"filename\": \"in.las\"}, {\"type\": \"filters.assign\", \"assignment\": \"Classification[:]=7\", \"where\": \"X > 2 && X < 7 && Y > 0\"}, {\"type\": \"filters.range\", \"limits\": \"Classification[7:7]\"}, {\"type\": \"writers.las\", \"filename\": \"out2.las\"}]}"
  }
 },
