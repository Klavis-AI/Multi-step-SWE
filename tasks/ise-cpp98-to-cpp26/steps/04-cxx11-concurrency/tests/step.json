     "role": "require",
     "query": "cxxRecordDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), matchesName(\"::ise::ThreadImpl$\"), has(fieldDecl(hasName(\"terminated_\"), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::std::atomic$\")))))))))"
    },
    {
     "name": "ThreadImpl's isExecuting_ is an atomic object",
     "min": 1,
     "role": "require",
     "query": "cxxRecordDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), matchesName(\"::ise::ThreadImpl$\"), has(fieldDecl(hasName(\"isExecuting_\"), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::std::atomic$\")))))))))"
    },
    {
     "name": "ThreadImpl's isSleepInterrupted_ is an atomic object",
     "min": 1,
     "role": "require",
     "query": "cxxRecordDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), matchesName(\"::ise::ThreadImpl$\"), has(fieldDecl(hasName(\"isSleepInterrupted_\"), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::std::atomic$\")))))))))"
    },
    {
     "name": "ThreadImpl's threadId_ is an atomic object",
     "min": 1,
     "role": "require",
     "query": "cxxRecordDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), matchesName(\"::ise::ThreadImpl$\"), has(fieldDecl(hasName(\"threadId_\"), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::std::atomic$\")))))))))"
    },
    {
     "name": "declarations whose type is the standard atomic",
     "min": 2,
     "role": "require",
     "query": "valueDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::std::atomic$\")))))))"
    },
    {
     "name": "AtomicInteger stores its value in a standard atomic",
     "min": 1,
     "role": "require",
     "query": "cxxRecordDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), matchesName(\"AtomicInteger\"), has(fieldDecl(anyOf(hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::std::atomic\")))))), hasType(templateSpecializationType(hasDeclaration(classTemplateDecl(matchesName(\"::std::atomic\")))))))))"
    },
