  {
   "id": "shared-state-is-atomic",
   "step": "04",
   "kind": "astq",
   "desc": "state that two threads touch is atomic: nothing relies on volatile to make a read or a write safe to race, and the four ThreadImpl members one thread writes while another reads them -- the three flags and the thread id -- are atomic objects",
   "matchers": [
    {
     "name": "a volatile-qualified declaration",
     "max": 0,
     "query": "valueDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), hasType(isVolatileQualified()))"
