  },
  {
   "id": "null-spelling-gone",
   "step": "03",
   "kind": "text_absent",
   "desc": "no statement outside the frozen platform branches still writes NULL, and nothing redefines or undefines the macro: the spelling goes with the conversion, or a macro can put it back without any AST query noticing",
