{
 "step": "04",
 "name": "cxx11-concurrency",
 "weights": {
  "behaviour": 0.3,
  "inherited_gates": 0.1,
  "step_gates": 0.6
 },
 "build_dir": "build",
 "driver_std": "gnu++11",
 "jobs": 7,
 "sanitize": true,
 "budget": {
  "clean": 120,
  "sanitize": 600,
  "configure": 300,
  "compile": 600,
  "grade": 1500
 },
 "harbor_timeout": 3600,
 "gates": [
  {
   "id": "cmake-top-level",
