   "min_entries": 22,
   "needs_build": true,
   "require": [
    "(^|\\s)-std=(gnu|c)\\+\\+11(\\s|$)",
    "(^|\\s)-Wall(\\s|$)",
    "(^|\\s)-Wextra(\\s|$)",
    "(^|\\s)-Woverloaded-virtual(\\s|$)",
    "(^|\\s)-Werror(\\s|$)"
