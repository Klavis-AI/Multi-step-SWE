     "role": "require",
     "query": "cxxMemberCallExpr(isExpansionInFileMatching(\"^@@SRC@@/\"), hasAncestor(cxxMethodDecl(ofClass(cxxRecordDecl(matchesName(\"::ise::AtomicInteger\"))))), callee(cxxMethodDecl(hasAnyName(\"load\", \"store\", \"exchange\", \"fetch_add\", \"fetch_sub\", \"compare_exchange_strong\", \"compare_exchange_weak\"))))"
    },
    {
     "name": "AtomicInteger reaching for a lock",
     "max": 0,
     "query": "cxxRecordDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), matchesName(\"::ise::AtomicInteger\"), has(fieldDecl(hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::(std::(recursive_)?(timed_)?mutex|ise::Mutex)$\")))))))))"
    },
    {
     "name": "AtomicInteger taking a lock",
