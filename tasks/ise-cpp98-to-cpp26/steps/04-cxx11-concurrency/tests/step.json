    "\\bboost::bind\\b",
    "\\bboost::_bi::",
    "\\bboost::_mfi::",
    "\\bboost::detail::function::",
    "\\bboost::bad_function_call\\b"
   ],
   "require": [
    "\\bstd::(function<|_Function_handler|_Function_base)"
   ],
   "control": [
    "\\bise::"
   ]
  },
  {
   "id": "range-based-iteration",
   "step": "03",
   "kind": "astq",
   "desc": "a loop that walks a container from one end to the other says so, instead of naming the iterator type, the beginning and the end and leaving the reader to check that it is a walk",
   "matchers": [
