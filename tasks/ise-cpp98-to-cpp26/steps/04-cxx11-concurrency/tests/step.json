     "role": "require",
     "query": "stmt(anyOf(forStmt(), whileStmt(), doStmt()), isExpansionInFileMatching(\"^@@SRC@@/ise/main/ise_timer\\.cpp$\"), hasDescendant(cxxMemberCallExpr(callee(cxxMethodDecl(hasName(\"erase\"))))))"
    },
    {
     "name": "loops written as a walk",
     "min": 3,
     "role": "require",
     "query": "cxxForRangeStmt(isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "control: iterator variables outside the tree",
     "min": 20,
     "query": "varDecl(unless(isExpansionInFileMatching(\"^@@SRC@@/\")), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"iterator\")))))))"
    },
    {
     "name": "control: function definitions in the tree",
     "min": 600,
     "query": "functionDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), isDefinition())"
    }
   ]
  },
  {
   "id": "movable-value-types",
   "step": "03",
   "kind": "astq",
   "desc": "a class that writes its own copy operation has taken its move operations away by doing so, and declares them again: every such class has a move constructor and a move assignment of its own",
   "matchers": [
