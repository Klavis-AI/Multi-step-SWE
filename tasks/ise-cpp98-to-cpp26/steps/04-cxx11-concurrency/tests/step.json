  {
   "id": "platform-sources-intact",
   "step": "01",
   "kind": "preserved_regions",
   "desc": "the Windows implementation this environment never compiles survived the migration whole, not as a list of its function names, apart from the object-lifetime statements the ownership milestone rewrote",
   "include": [
    "ise/main/ise_iocp.cpp"
   ],
   "require_files": [
    "ise/main/ise_iocp.cpp"
   ],
   "reference": "fixtures/platform-regions.json",
   "min_files": 20,
   "min_regions": 105,
   "needs_project": true,
   "needs_build": true,
   "min": 8,
   "pattern": "\\b(CreateIoCompletionPort|GetQueuedCompletionStatus|PostQueuedCompletionStatus|WSARecv|WSASend)\\b",
   "span": true
  },
  {
   "id": "delete-expressions-gone",
   "step": "02",
   "kind": "astq",
   "desc": "nothing in the project's own sources destroys an object by hand: there is no delete-expression left anywhere the project compiles",
   "matchers": [
    {
     "name": "delete-expressions in the project's own sources",
     "max": 0,
     "query": "cxxDeleteExpr(isExpansionInFileMatching(\"^@@SRC@@/\"), unless(hasAncestor(conceptDecl())))"
    },
    {
     "name": "control: delete-expressions outside the tree",
     "min": 10,
     "query": "cxxDeleteExpr(unless(isExpansionInFileMatching(\"^@@SRC@@/\")))"
    },
    {
     "name": "control: function definitions in the tree",
     "min": 600,
     "query": "functionDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), isDefinition())"
    }
   ]
  },
  {
   "id": "raw-owning-allocation-gone",
   "step": "02",
   "kind": "astq",
   "desc": "every allocation is held by something with a destructor from the moment it exists: no new-expression's result is left in a raw pointer, a raw member or a raw argument -- only handed to an owning handle where it is made, or returned to a caller whose job is to receive it",
   "matchers": [
    {
     "name": "allocations nothing is holding",
     "max": 0,
     "query": "cxxNewExpr(isExpansionInFileMatching(\"^@@SRC@@/\"), unless(isInstantiationDependent()), unless(hasParent(expr(anyOf(anyOf(cxxConstructExpr(hasDeclaration(cxxConstructorDecl(ofClass(matchesName(\"::std::(unique_ptr|shared_ptr)$\"))))),cxxMemberCallExpr(callee(cxxMethodDecl(hasName(\"reset\"), ofClass(matchesName(\"::std::(unique_ptr|shared_ptr)$\")))))), implicitCastExpr(hasParent(expr(anyOf(cxxConstructExpr(hasDeclaration(cxxConstructorDecl(ofClass(matchesName(\"::std::(unique_ptr|shared_ptr)$\"))))),cxxMemberCallExpr(callee(cxxMethodDecl(hasName(\"reset\"), ofClass(matchesName(\"::std::(unique_ptr|shared_ptr)$\"))))))))))))), unless(anyOf(hasParent(returnStmt()), hasParent(implicitCastExpr(hasParent(returnStmt()))))))"
    },
    {
     "name": "allocations inside templates, which the matcher above cannot see the consumer of",
     "max": 4,
     "query": "cxxNewExpr(isExpansionInFileMatching(\"^@@SRC@@/\"), isInstantiationDependent())"
    },
    {
     "name": "control: new-expressions outside the tree",
     "min": 10,
     "query": "cxxNewExpr(unless(isExpansionInFileMatching(\"^@@SRC@@/\")))"
    },
    {
     "name": "control: function definitions in the tree",
     "min": 600,
     "query": "functionDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), isDefinition())"
    }
   ]
  },
  {
   "id": "boost-ownership-types-gone",
   "step": "02",
   "kind": "symbols",
   "desc": "ownership is no longer Boost's: nothing links a boost::shared_ptr, weak_ptr, enable_shared_from_this, scoped_ptr, scoped_array, shared_array or intrusive_ptr, nor the reference counting behind them",
   "forbid": [
    "\\bboost::shared_ptr<",
    "\\bboost::weak_ptr<",
    "\\bboost::enable_shared_from_this<",
    "\\bboost::detail::sp_counted",
    "\\bboost::bad_weak_ptr\\b",
    "\\bboost::scoped_ptr<",
    "\\bboost::scoped_array<",
    "\\bboost::shared_array<",
    "\\bboost::intrusive_ptr<"
   ],
   "control": [
    "\\bise::"
   ]
  },
  {
   "id": "std-ownership-types-present",
   "step": "02",
   "kind": "symbols",
   "desc": "the ownership the project has is expressed with the standard library's types: the project's own objects are held by std::unique_ptr where ownership is exclusive and std::shared_ptr where it is shared",
   "require": [
    "\\bstd::unique_ptr<ise::",
    "\\bstd::shared_ptr<ise::"
   ],
   "min_distinct": [
    {
     "pattern": "\\bstd::unique_ptr<(ise::[A-Za-z_][A-Za-z0-9_]*)",
     "min": 8,
     "what": "distinct ise:: types held by std::unique_ptr"
    },
    {
     "pattern": "\\bstd::shared_ptr<(ise::[A-Za-z_][A-Za-z0-9_]*)",
     "min": 1,
     "what": "distinct ise:: types held by std::shared_ptr"
    }
   ],
   "control": [
    "\\bise::"
   ]
  },
  {
   "id": "ownership-clean-under-sanitizers",
   "step": "02",
   "kind": "sanitize",
   "desc": "every program, over the whole recorded suite, reaches exit having released everything it allocated and having touched nothing it no longer owns",
   "build": "/tmp/isesan/build",
   "bindir": "/tmp/isesanbin",
   "logdir": "/tmp/isesan/log",
   "build_log": "/logs/verifier/step04-build.log",
   "max_leaked_bytes": 0,
   "driver_std": "gnu++11",
   "driver_log": "/logs/verifier/step04-driver-san.log",
   "skip_kinds": []
  },
  {
   "id": "null-pointer-literal",
   "step": "03",
   "kind": "astq",
   "desc": "the null pointer has one spelling: nothing the project compiles converts a macro or an integer constant to a pointer, and a pointer that is null is written as one",
   "matchers": [
    {
     "name": "a null pointer that is not the null pointer literal",
     "max": 0,
     "query": "implicitCastExpr(hasCastKind(\"CK_NullToPointer\"), isExpansionInFileMatching(\"^@@SRC@@/\"), unless(has(cxxNullPtrLiteralExpr())), unless(hasType(pointsTo(recordDecl(matchesName(\"__literal_zero\"))))))"
    },
    {
     "name": "an integer constant cast to a pointer",
     "max": 0,
     "query": "explicitCastExpr(isExpansionInFileMatching(\"^@@SRC@@/\"), hasDestinationType(pointerType()), hasSourceExpression(ignoringParenImpCasts(anyOf(integerLiteral(equals(0)), gnuNullExpr()))))"
    },
    {
     "name": "null pointer literals",
     "min": 60,
     "role": "require",
     "query": "cxxNullPtrLiteralExpr(isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "control: null-pointer conversions outside the tree",
     "min": 10,
     "query": "implicitCastExpr(hasCastKind(\"CK_NullToPointer\"), unless(isExpansionInFileMatching(\"^@@SRC@@/\")))"
    },
    {
     "name": "control: function definitions in the tree",
     "min": 600,
     "query": "functionDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), isDefinition())"
    }
   ]
  },
  {
   "id": "override-explicit",
   "step": "03",
   "kind": "astq",
   "desc": "every function that overrides a virtual function says so, so that a signature which stops matching the one it overrides is a compile error rather than a second function",
   "matchers": [
    {
     "name": "a function that overrides without saying so",
     "max": 0,
     "query": "cxxMethodDecl(isOverride(), unless(isImplicit()), unless(hasAttr(\"attr::Override\")), isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "functions that say they override",
     "min": 300,
     "role": "require",
     "query": "cxxMethodDecl(hasAttr(\"attr::Override\"), isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "control: virtual function declarations in the tree",
     "min": 250,
     "query": "cxxMethodDecl(isVirtual(), unless(isImplicit()), isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "control: function definitions in the tree",
     "min": 600,
     "query": "functionDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), isDefinition())"
    }
   ]
  },
  {
   "id": "scoped-enumerations",
   "step": "03",
   "kind": "astq",
   "desc": "an enumeration with a name is a type with a scope: its enumerators are reached through it and do not convert to an integer on their own",
   "matchers": [
    {
     "name": "a named enumeration whose enumerators are not scoped to it",
     "max": 0,
     "query": "enumDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), unless(matchesName(\"unnamed\")), unless(isScoped()))"
    },
    {
     "name": "scoped enumerations",
     "min": 10,
     "role": "require",
     "query": "enumDecl(isScoped(), isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "control: enumerations in the tree",
     "min": 20,
     "query": "enumDecl(isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "control: function definitions in the tree",
     "min": 600,
     "query": "functionDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), isDefinition())"
    }
   ]
  },
  {
   "id": "callbacks-are-standard",
   "step": "03",
   "kind": "astq",
   "desc": "the project's callbacks are the language's own: a stored callback is the standard callable wrapper, a call site that adapts one is a closure written where it is used, and nothing is assembled by a binder",
   "matchers": [
    {
     "name": "a call to boost::bind",
     "max": 0,
     "query": "callExpr(callee(functionDecl(matchesName(\"::boost::bind\"))), isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "a declaration whose type is boost::function",
     "max": 0,
     "query": "valueDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::boost::function\")))))))"
    },
    {
     "name": "a call to std::bind",
     "max": 0,
     "query": "callExpr(callee(functionDecl(matchesName(\"::std::bind\"))), isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "declarations whose type is the standard callable wrapper",
     "min": 8,
     "role": "require",
     "query": "valueDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(matchesName(\"::std::function\")))))))"
