    },
    {
     "name": "control: calls the tree makes to the standard library",
     "min": 100,
     "query": "callExpr(callee(functionDecl(matchesName(\"::std::\"))), isExpansionInFileMatching(\"^@@SRC@@/\"))"
    },
    {
     "name": "control: function definitions in the tree",
     "min": 600,
     "query": "functionDecl(isExpansionInFileMatching(\"^@@SRC@@/\"), isDefinition())"
