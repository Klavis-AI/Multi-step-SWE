CREATE TABLE dt(a int, b text);
ALTER TABLE dt ADD COLUMN c numeric(6,2) DEFAULT 1.5;
ALTER TABLE dt ADD COLUMN d int NOT NULL DEFAULT 7;
INSERT INTO dt(a,b) VALUES (1,'x');
SELECT * FROM dt;
 a | b |  c   | d 
---+---+------+---
 1 | x | 1.50 | 7
(1 row)

ALTER TABLE dt DROP COLUMN b;
ALTER TABLE dt RENAME COLUMN a TO a2;
ALTER TABLE dt ALTER COLUMN c TYPE text;
SELECT * FROM dt;
 a2 |  c   | d 
----+------+---
  1 | 1.50 | 7
(1 row)

ALTER TABLE dt RENAME TO dt2;
SELECT count(*) FROM dt2;
 count 
-------
     1
(1 row)

DROP TABLE dt2;
