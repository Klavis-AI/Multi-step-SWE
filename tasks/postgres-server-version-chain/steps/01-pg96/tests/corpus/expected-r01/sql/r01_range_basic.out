SELECT int4range(1,5), int4range(1,5,'[]'), int8range(1,5), numrange(1.5,2.5);
 int4range | int4range | int8range | numrange  
-----------+-----------+-----------+-----------
 [1,5)     | [1,6)     | [1,5)     | [1.5,2.5)
(1 row)

SELECT daterange('2020-01-01','2020-06-01'), tsrange('2020-01-01','2020-06-01');
        daterange        |                    tsrange                    
-------------------------+-----------------------------------------------
 [2020-01-01,2020-06-01) | ["2020-01-01 00:00:00","2020-06-01 00:00:00")
(1 row)

