SELECT unnest(ARRAY['a','b','c']) AS u ORDER BY u;
 u 
---
 a
 b
 c
(3 rows)

SELECT x FROM unnest(ARRAY[3,1,2]) AS x ORDER BY x;
 x 
---
 1
 2
 3
(3 rows)

SELECT g FROM generate_series(1,5) g WHERE g % 2 = 1 ORDER BY g;
 g 
---
 1
 3
 5
(3 rows)

SELECT count(*) FROM generate_series(1,100);
 count 
-------
   100
(1 row)

