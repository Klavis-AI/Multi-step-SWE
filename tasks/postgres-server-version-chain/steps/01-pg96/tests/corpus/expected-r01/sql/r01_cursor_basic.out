CREATE TABLE cu(i int);
INSERT INTO cu SELECT generate_series(1,6);
BEGIN;
DECLARE cu_c CURSOR FOR SELECT i FROM cu ORDER BY i;
FETCH 2 FROM cu_c;
 i 
---
 1
 2
(2 rows)

FETCH FORWARD 3 FROM cu_c;
 i 
---
 3
 4
 5
(3 rows)

FETCH ALL FROM cu_c;
 i 
---
 6
(1 row)

MOVE BACKWARD ALL IN cu_c;
FETCH 1 FROM cu_c;
 i 
---
 1
(1 row)

CLOSE cu_c;
FETCH 1 FROM cu_c;
ERROR:  cursor "cu_c" does not exist
COMMIT;
DROP TABLE cu;
