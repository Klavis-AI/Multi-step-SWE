------------------+------------------
 {"a": 1, "b": 2} | {"a": [1, 2, 3]}
(1 row)

SELECT jsonb_strip_nulls('{"a":null,"b":1}'::jsonb);
 jsonb_strip_nulls 
-------------------
 {"b": 1}
(1 row)

