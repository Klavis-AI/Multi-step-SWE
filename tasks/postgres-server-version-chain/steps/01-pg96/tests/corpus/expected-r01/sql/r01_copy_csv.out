CREATE TABLE cc(i int, t text);
COPY cc FROM stdin WITH (FORMAT csv);
SELECT i, t, t IS NULL FROM cc ORDER BY i;
 i |  t  | ?column? 
---+-----+----------
 1 | a,b | f
 2 | q"q | f
 3 |     | t
(3 rows)

COPY cc TO stdout WITH (FORMAT csv, HEADER);
i,t
1,"a,b"
2,"q""q"
3,
COPY cc TO stdout WITH (FORMAT csv, NULL 'NUL');
1,"a,b"
2,"q""q"
3,NUL
DROP TABLE cc;
