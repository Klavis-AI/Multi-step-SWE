CREATE TABLE oc(i int primary key, v int);
INSERT INTO oc VALUES (1,1);
INSERT INTO oc VALUES (1,2) ON CONFLICT DO NOTHING;
INSERT INTO oc VALUES (1,3) ON CONFLICT (i) DO UPDATE SET v = 99;
INSERT INTO oc VALUES (2,5) ON CONFLICT (i) DO UPDATE SET v = 99;
SELECT * FROM oc ORDER BY i;
 i | v  
---+----
 1 | 99
 2 |  5
(2 rows)

DROP TABLE oc;
