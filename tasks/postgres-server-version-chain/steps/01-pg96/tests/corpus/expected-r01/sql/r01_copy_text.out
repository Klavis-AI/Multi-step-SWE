CREATE TABLE cp(i int, t text, n numeric);
COPY cp FROM stdin;
SELECT * FROM cp ORDER BY i;
 i |          t           |  n  
---+----------------------+-----
 1 | alpha                | 1.5
 2 | beta with        tab | 2.5
 3 |                      |    
(3 rows)

COPY cp TO stdout;
1	alpha	1.5
2	beta with \t tab	2.5
3	\N	\N
COPY cp (i,t) TO stdout;
1	alpha
2	beta with \t tab
3	\N
COPY (SELECT i*10 FROM cp ORDER BY i) TO stdout;
10
20
30
DROP TABLE cp;
