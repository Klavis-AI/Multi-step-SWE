SELECT t FROM (VALUES ('b'),('A'),('a'),('B'),('_a'),('1')) v(t) ORDER BY t;
 t  
----
 1
 A
 B
 _a
 a
 b
(6 rows)

SELECT x FROM (VALUES (1),(NULL),(2)) v(x) ORDER BY x NULLS FIRST;
 x 
---
  
 1
 2
(3 rows)

SELECT x FROM (VALUES (1),(NULL),(2)) v(x) ORDER BY x DESC;
 x 
---
  
 2
 1
(3 rows)

