CREATE TABLE am(g int, v int);
INSERT INTO am VALUES (1,1);
SELECT g, v FROM am GROUP BY g;
ERROR:  column "am.v" must appear in the GROUP BY clause or be used in an aggregate function
LINE 1: SELECT g, v FROM am GROUP BY g;
                  ^
SELECT count(*) FROM am WHERE count(*) > 0;
ERROR:  aggregate functions are not allowed in WHERE
LINE 1: SELECT count(*) FROM am WHERE count(*) > 0;
                                      ^
DROP TABLE am;
