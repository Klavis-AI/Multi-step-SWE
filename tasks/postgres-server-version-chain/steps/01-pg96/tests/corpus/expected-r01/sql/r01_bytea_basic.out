SELECT 'abc'::bytea, '\\x00ff41'::bytea, length('\\x00ff41'::bytea);
  bytea   |       bytea        | length 
----------+--------------------+--------
 \x616263 | \x5c78303066663431 |      8
(1 row)

SELECT '\\x0102'::bytea || '\\x03'::bytea;
