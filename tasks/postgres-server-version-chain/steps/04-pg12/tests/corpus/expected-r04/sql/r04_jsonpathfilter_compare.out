SELECT jsonb_path_query_array('[1,2,3,4]'::jsonb, '$[*] ? (@ > 2)');
 jsonb_path_query_array 
------------------------
 [3, 4]
(1 row)

SELECT jsonb_path_query_array('[1,2,3,4]'::jsonb, '$[*] ? (@ >= 2 && @ <= 3)');
 jsonb_path_query_array 
------------------------
 [2, 3]
(1 row)

SELECT jsonb_path_query_array('[1,2,3,4]'::jsonb, '$[*] ? (@ == 1 || @ == 4)');
 jsonb_path_query_array 
------------------------
 [1, 4]
(1 row)

SELECT jsonb_path_query_array('[1,2,3,4]'::jsonb, '$[*] ? (!(@ > 2))');
 jsonb_path_query_array 
------------------------
 [1, 2]
(1 row)

SELECT jsonb_path_query_array('[1,2,3,4]'::jsonb, '$[*] ? (@ != 2)');
 jsonb_path_query_array 
------------------------
 [1, 3, 4]
(1 row)

