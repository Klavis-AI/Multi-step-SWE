SELECT jsonb_path_query_array('{"a":[1,2,3]}'::jsonb, '$.a[*] ? (@ > $min)', '{"min":1}');
 jsonb_path_query_array 
------------------------
 [2, 3]
(1 row)

SELECT jsonb_path_query_array('{"a":[1,2,3]}'::jsonb, '$.a[*] ? (@ >= $lo && @ <= $hi)',
  '{"lo":2,"hi":3}');
 jsonb_path_query_array 
------------------------
 [2, 3]
(1 row)

SELECT jsonb_path_exists('{"a":1}'::jsonb, '$.a ? (@ == $v)', '{"v":1}');
