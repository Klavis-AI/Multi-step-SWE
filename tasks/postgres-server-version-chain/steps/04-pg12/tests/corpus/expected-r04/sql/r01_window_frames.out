CREATE TABLE wf(i int);
INSERT INTO wf SELECT generate_series(1,6);
SELECT i, sum(i) OVER () FROM wf ORDER BY i;
 i | sum 
---+-----
 1 |  21
 2 |  21
 3 |  21
 4 |  21
 5 |  21
 6 |  21
(6 rows)

SELECT i, ntile(3) OVER (ORDER BY i) FROM wf ORDER BY i;
 i | ntile 
---+-------
 1 |     1
 2 |     1
 3 |     2
 4 |     2
 5 |     3
 6 |     3
(6 rows)

SELECT i, percent_rank() OVER (ORDER BY i), cume_dist() OVER (ORDER BY i) FROM wf ORDER BY i;
 i | percent_rank |      cume_dist      
---+--------------+---------------------
 1 |            0 | 0.16666666666666666
 2 |          0.2 |  0.3333333333333333
 3 |          0.4 |                 0.5
 4 |          0.6 |  0.6666666666666666
 5 |          0.8 |  0.8333333333333334
 6 |            1 |                   1
(6 rows)

SELECT i, last_value(i) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM wf ORDER BY i;
 i | last_value 
---+------------
 1 |          6
 2 |          6
 3 |          6
 4 |          6
 5 |          6
 6 |          6
(6 rows)

SELECT i, nth_value(i,2) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM wf ORDER BY i;
 i | nth_value 
---+-----------
 1 |         2
 2 |         2
 3 |         2
 4 |         2
 5 |         2
 6 |         2
(6 rows)

DROP TABLE wf;
