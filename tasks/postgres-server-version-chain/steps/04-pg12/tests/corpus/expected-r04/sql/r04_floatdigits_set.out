SET extra_float_digits = 0;
SELECT 1::float8 / 3, 0.1::float8 * 3;
     ?column?      | ?column? 
-------------------+----------
 0.333333333333333 |      0.3
(1 row)

SET extra_float_digits = 3;
SELECT 1::float8 / 3, 0.1::float8 * 3;
      ?column?      |      ?column?       
--------------------+---------------------
 0.3333333333333333 | 0.30000000000000004
(1 row)

SET extra_float_digits = -1;
SELECT 1::float8 / 3, 0.1::float8 * 3;
     ?column?     | ?column? 
------------------+----------
 0.33333333333333 |      0.3
(1 row)

RESET extra_float_digits;
SELECT 1::float8 / 3;
      ?column?      
--------------------
 0.3333333333333333
(1 row)

