SELECT array_sort(ARRAY[3,1,2]);
 array_sort 
------------
 {1,2,3}
(1 row)

SELECT array_sort(ARRAY[3,1,2], false);
 array_sort 
------------
 {1,2,3}
(1 row)

SELECT array_sort(ARRAY['b','a','c'], true, true);
 array_sort 
------------
 {c,b,a}
(1 row)

SELECT array_sort(ARRAY[2,NULL,1]);
 array_sort 
------------
 {1,2,NULL}
(1 row)

SELECT array_sort(ARRAY[2,NULL,1], true, false);
 array_sort 
------------
 {2,1,NULL}
(1 row)

