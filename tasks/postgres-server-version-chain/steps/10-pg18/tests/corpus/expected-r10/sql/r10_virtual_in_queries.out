CREATE TABLE r10vg6(a int, b int GENERATED ALWAYS AS (a * 2) VIRTUAL);
INSERT INTO r10vg6(a) VALUES (1),(4),(9);
SELECT b FROM r10vg6 WHERE b > 5 ORDER BY b;
 b  
----
  8
 18
(2 rows)

SELECT sum(b), max(b) FROM r10vg6;
 sum | max 
-----+-----
  28 |  18
(1 row)

SELECT a, b FROM r10vg6 ORDER BY b DESC;
 a | b  
---+----
 9 | 18
 4 |  8
 1 |  2
(3 rows)

SELECT b, count(*) FROM r10vg6 GROUP BY b ORDER BY b;
 b  | count 
----+-------
  2 |     1
  8 |     1
 18 |     1
(3 rows)

DROP TABLE r10vg6;
