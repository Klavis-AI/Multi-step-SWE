SELECT JSON_SCALAR(1), JSON_SCALAR('a'), JSON_SCALAR(true);
 json_scalar | json_scalar | json_scalar 
-------------+-------------+-------------
 1           | "a"         | true
(1 row)

SELECT JSON_SCALAR(NULL::int) IS NULL;
 ?column? 
----------
 t
(1 row)

SELECT JSON_SCALAR(1.5), JSON_SCALAR(date '2020-01-02');
 json_scalar | json_scalar  
-------------+--------------
 1.5         | "2020-01-02"
(1 row)

