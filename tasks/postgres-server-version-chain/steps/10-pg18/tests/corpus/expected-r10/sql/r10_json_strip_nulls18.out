SELECT jsonb_strip_nulls('{"a":null,"b":[1,null]}'::jsonb);
 jsonb_strip_nulls 
-------------------
 {"b": [1, null]}
(1 row)

SELECT jsonb_strip_nulls('{"a":null,"b":[1,null]}'::jsonb, true);
 jsonb_strip_nulls 
-------------------
 {"b": [1]}
(1 row)

SELECT jsonb_strip_nulls('{"a":null,"b":[1,null]}'::jsonb, false);
 jsonb_strip_nulls 
-------------------
 {"b": [1, null]}
(1 row)

SELECT json_strip_nulls('{"a":null,"b":[1,null]}'::json, true);
 json_strip_nulls 
------------------
 {"b":[1]}
(1 row)

