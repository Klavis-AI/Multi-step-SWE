CREATE TABLE r10roa(id int primary key, "old" int, "new" int);
INSERT INTO r10roa VALUES (1,2,3);
UPDATE r10roa SET id = id RETURNING "old", "new";
 old | new 
-----+-----
   2 |   3
(1 row)

UPDATE r10roa SET id = id RETURNING old.id, old."old";
 id | old 
----+-----
  1 |   2
(1 row)

UPDATE r10roa SET id = id RETURNING old.*, new.*;
 id | old | new | id | old | new 
----+-----+-----+----+-----+-----
  1 |   2 |   3 |  1 |   2 |   3
(1 row)

DROP TABLE r10roa;
