CREATE TABLE q3_ppb(a int, b text, PRIMARY KEY (a)) PARTITION BY RANGE (a);
CREATE TABLE q3_ppb_1 PARTITION OF q3_ppb FOR VALUES FROM (1) TO (10);
CREATE TABLE q3_ppb_2 PARTITION OF q3_ppb FOR VALUES FROM (10) TO (20);
