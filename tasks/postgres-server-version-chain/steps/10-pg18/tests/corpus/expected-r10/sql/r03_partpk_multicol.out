CREATE TABLE q3_ppm(a int, b int, t text, PRIMARY KEY (a, b)) PARTITION BY RANGE (a);
CREATE TABLE q3_ppm_1 PARTITION OF q3_ppm FOR VALUES FROM (1) TO (10);
