ALTER TABLE q3_cvc ADD CONSTRAINT q3_cvc_pk PRIMARY KEY (a) INCLUDE (b);
ALTER TABLE q3_cvc ADD CONSTRAINT q3_cvc_uq UNIQUE (b) INCLUDE (c);
