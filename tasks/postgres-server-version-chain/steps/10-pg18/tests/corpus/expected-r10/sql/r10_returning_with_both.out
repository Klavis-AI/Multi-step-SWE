CREATE TABLE r10ra1(id int primary key, v int);
INSERT INTO r10ra1 VALUES (1,10);
UPDATE r10ra1 SET v = 11 WHERE id = 1 RETURNING WITH (OLD AS o, NEW AS n) o.v, n.v;
 v  | v  
