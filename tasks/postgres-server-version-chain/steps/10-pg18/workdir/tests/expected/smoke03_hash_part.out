CREATE TABLE sh(i int) PARTITION BY HASH (i);
CREATE TABLE sh0 PARTITION OF sh FOR VALUES WITH (MODULUS 2, REMAINDER 0);
CREATE TABLE sh1 PARTITION OF sh FOR VALUES WITH (MODULUS 2, REMAINDER 1);
INSERT INTO sh SELECT generate_series(1,4);
SELECT count(*) FROM sh;
 count 
-------
     4
(1 row)

DROP TABLE sh;
