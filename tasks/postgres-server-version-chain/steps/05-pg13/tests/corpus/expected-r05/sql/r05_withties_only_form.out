CREATE TABLE x05_02a(i int, v int);
INSERT INTO x05_02a SELECT g, g/3 FROM generate_series(1,9) g;
SELECT * FROM x05_02a ORDER BY v FETCH FIRST 2 ROWS ONLY;
 i | v 
---+---
 2 | 0
 1 | 0
(2 rows)

SELECT * FROM x05_02a ORDER BY v FETCH FIRST 2 ROWS WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

SELECT * FROM x05_02a ORDER BY v FETCH NEXT 2 ROWS ONLY;
 i | v 
---+---
 2 | 0
 1 | 0
(2 rows)

SELECT * FROM x05_02a ORDER BY v FETCH NEXT 2 ROWS WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

SELECT * FROM x05_02a ORDER BY v LIMIT 2;
 i | v 
---+---
 2 | 0
 1 | 0
(2 rows)

DROP TABLE x05_02a;
