CREATE TABLE x05_70a(a int, b text) PARTITION BY RANGE (a);
CREATE TABLE x05_70a1 PARTITION OF x05_70a FOR VALUES FROM (0) TO (10);
CREATE FUNCTION x05_70f() RETURNS trigger LANGUAGE plpgsql AS
  $$ BEGIN RETURN NULL; END $$;
CREATE TRIGGER x05_70t BEFORE INSERT ON x05_70a FOR EACH ROW EXECUTE FUNCTION x05_70f();
