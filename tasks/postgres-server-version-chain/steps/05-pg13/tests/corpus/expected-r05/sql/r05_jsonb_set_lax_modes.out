SELECT jsonb_set_lax('{"a":1,"b":2}','{a}','9'::jsonb);
  jsonb_set_lax   
------------------
 {"a": 9, "b": 2}
(1 row)

SELECT jsonb_set_lax('{"a":1,"b":2}','{a}',NULL,true,'use_json_null');
    jsonb_set_lax    
---------------------
 {"a": null, "b": 2}
(1 row)

SELECT jsonb_set_lax('{"a":1,"b":2}','{a}',NULL,true,'delete_key');
 jsonb_set_lax 
---------------
 {"b": 2}
(1 row)

SELECT jsonb_set_lax('{"a":1,"b":2}','{a}',NULL,true,'return_target');
  jsonb_set_lax   
------------------
 {"a": 1, "b": 2}
(1 row)

