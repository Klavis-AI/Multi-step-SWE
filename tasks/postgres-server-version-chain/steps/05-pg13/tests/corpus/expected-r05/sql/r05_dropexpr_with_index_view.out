CREATE TABLE x05_36a(a int, b int GENERATED ALWAYS AS (a*2) STORED);
INSERT INTO x05_36a(a) SELECT generate_series(1,5);
CREATE INDEX x05_36i ON x05_36a(b);
CREATE VIEW x05_36v AS SELECT a, b FROM x05_36a;
ALTER TABLE x05_36a ALTER COLUMN b DROP EXPRESSION;
SELECT a, b FROM x05_36v ORDER BY a;
