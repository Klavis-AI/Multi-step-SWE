CREATE TABLE x05_05a(i int, v int);
INSERT INTO x05_05a SELECT g, g/3 FROM generate_series(1,9) g;
SELECT * FROM x05_05a ORDER BY v FETCH FIRST 0 ROWS WITH TIES;
 i | v 
---+---
(0 rows)

SELECT * FROM x05_05a ORDER BY v FETCH FIRST (1+1) ROWS WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

SELECT * FROM x05_05a ORDER BY v FETCH FIRST 100 ROWS WITH TIES;
 i | v 
---+---
