(1 row)

ALTER TABLE x05_18a DETACH PARTITION x05_18a2;
SELECT tablename FROM pg_publication_tables WHERE pubname='x05_18p' ORDER BY tablename;
 tablename 
-----------
 x05_18a
(1 row)

DROP PUBLICATION x05_18p;
DROP TABLE x05_18a, x05_18a2;
