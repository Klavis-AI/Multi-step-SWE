CREATE TABLE x05_03a(i int, v int);
INSERT INTO x05_03a SELECT g, g/3 FROM generate_series(1,9) g;
SELECT * FROM x05_03a ORDER BY v FETCH FIRST ROW WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

SELECT * FROM x05_03a ORDER BY v FETCH FIRST ROW ONLY;
 i | v 
---+---
 1 | 0
(1 row)

SELECT * FROM x05_03a ORDER BY v FETCH NEXT ROW WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

SELECT * FROM x05_03a ORDER BY v FETCH FIRST 1 ROW WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

DROP TABLE x05_03a;
