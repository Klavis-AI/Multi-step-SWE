CREATE TABLE x05_01a(i int, v int);
INSERT INTO x05_01a SELECT g, g/3 FROM generate_series(1,9) g;
SELECT * FROM x05_01a ORDER BY v, i FETCH FIRST 2 ROWS WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

SELECT * FROM x05_01a ORDER BY v FETCH FIRST 2 ROWS WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
(2 rows)

SELECT * FROM x05_01a ORDER BY v FETCH FIRST 4 ROWS WITH TIES;
 i | v 
---+---
 1 | 0
 2 | 0
 3 | 1
 4 | 1
 5 | 1
(5 rows)

SELECT count(*) FROM (SELECT * FROM x05_01a ORDER BY v FETCH FIRST 1 ROWS WITH TIES) s;
 count 
-------
     2
(1 row)

DROP TABLE x05_01a;
