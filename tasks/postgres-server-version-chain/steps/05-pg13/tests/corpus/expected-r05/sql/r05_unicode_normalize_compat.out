SELECT length(normalize(U&'\FB01', NFKC)), length(U&'\FB01');
 length | length 
--------+--------
      2 |      1
(1 row)

SELECT normalize(U&'\FB01', NFKC) = 'fi';
 ?column? 
----------
 t
(1 row)

SELECT normalize(U&'\FB01', NFC) = 'fi';
 ?column? 
----------
 f
