SELECT div(9::numeric, 4), div(-9::numeric, 4), div(9::numeric, -4);
 div | div | div 
-----+-----+-----
   2 |  -2 |  -2
(1 row)

SELECT div(9.9::numeric, 2.2), 9.9::numeric / 2.2;
 div |      ?column?      
-----+--------------------
   4 | 4.5000000000000000
(1 row)

SELECT div(1::numeric, 3), mod(9::numeric, 4);
 div | mod 
-----+-----
   0 |   1
(1 row)

SELECT div('NaN'::numeric, 2);
 div 
-----
 NaN
(1 row)

