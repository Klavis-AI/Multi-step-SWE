CREATE TABLE q4_cwe(a int, b text);
COPY q4_cwe FROM stdin WITH (FORMAT csv) WHERE b LIKE 'o%';
SELECT a, b FROM q4_cwe ORDER BY a;
 a |   b   
---+-------
 1 | one
 3 | other
(2 rows)

COPY q4_cwe FROM stdin WHERE a IS NULL;
SELECT count(*) FROM q4_cwe;
 count 
-------
     2
(1 row)

DROP TABLE q4_cwe;
