CREATE TABLE x05_71a(a int, b text);
INSERT INTO x05_71a SELECT g, 't'||g FROM generate_series(1,200) g;
CREATE INDEX x05_71i1 ON x05_71a(a);
CREATE INDEX x05_71i2 ON x05_71a(b);
VACUUM (PARALLEL 0) x05_71a;
VACUUM (PARALLEL 1) x05_71a;
VACUUM (ANALYZE, PARALLEL 1) x05_71a;
SELECT count(*) FROM x05_71a;
