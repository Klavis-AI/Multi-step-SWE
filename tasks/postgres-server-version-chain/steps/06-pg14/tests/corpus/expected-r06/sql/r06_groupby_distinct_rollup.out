SELECT g, count(*) FROM (VALUES (1),(1),(2)) v(g)
  GROUP BY DISTINCT ROLLUP(g) ORDER BY g NULLS LAST;
 g | count 
---+-------
 1 |     2
 2 |     1
   |     3
(3 rows)

