SELECT 'Infinity'::numeric::int;
ERROR:  cannot convert infinity to integer
SELECT 'Infinity'::numeric / 0;
ERROR:  division by zero
SELECT 'Infinity'::numeric::numeric(10,2);
ERROR:  numeric field overflow
DETAIL:  A field with precision 10, scale 2 cannot hold an infinite value.
SELECT ln('-Infinity'::numeric);
ERROR:  cannot take logarithm of a negative number
SELECT 'Infinity'::numeric % 2;
