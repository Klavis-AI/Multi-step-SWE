SELECT bit_count('\x0f'::bytea), bit_count('\xffff'::bytea), bit_count(''::bytea);
 bit_count | bit_count | bit_count 
-----------+-----------+-----------
         4 |        16 |         0
(1 row)

SELECT bit_count(B'1011'), bit_count(B'0000');
 bit_count | bit_count 
-----------+-----------
         3 |         0
(1 row)

SELECT bit_count('abc'::bytea);
 bit_count 
-----------
        10
(1 row)

SELECT pg_typeof(bit_count('\x0f'::bytea));
 pg_typeof 
-----------
 bigint
(1 row)

