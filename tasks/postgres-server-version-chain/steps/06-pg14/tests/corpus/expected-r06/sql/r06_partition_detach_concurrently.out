CREATE TABLE x06_66a(a int, b text) PARTITION BY RANGE (a);
CREATE TABLE x06_66a1 PARTITION OF x06_66a FOR VALUES FROM (0) TO (10);
CREATE TABLE x06_66a2 PARTITION OF x06_66a FOR VALUES FROM (10) TO (20);
