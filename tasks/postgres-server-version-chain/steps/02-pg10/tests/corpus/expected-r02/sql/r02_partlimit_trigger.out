CREATE TABLE q2_plt2(a int) PARTITION BY RANGE (a);
CREATE TABLE q2_plt2_1 PARTITION OF q2_plt2 FOR VALUES FROM (1) TO (10);
CREATE FUNCTION q2_plt2_f() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN RAISE NOTICE 'q2_plt2 fired'; RETURN NEW; END $$;
CREATE TRIGGER q2_plt2_row BEFORE INSERT ON q2_plt2 FOR EACH ROW EXECUTE PROCEDURE q2_plt2_f();
ERROR:  "q2_plt2" is a partitioned table
DETAIL:  Partitioned tables cannot have ROW triggers.
CREATE TRIGGER q2_plt2_stmt AFTER INSERT ON q2_plt2 FOR EACH STATEMENT EXECUTE PROCEDURE q2_plt2_f();
INSERT INTO q2_plt2 VALUES (1);
NOTICE:  q2_plt2 fired
SELECT tgname FROM pg_trigger WHERE tgrelid = 'q2_plt2'::regclass AND NOT tgisinternal ORDER BY tgname;
