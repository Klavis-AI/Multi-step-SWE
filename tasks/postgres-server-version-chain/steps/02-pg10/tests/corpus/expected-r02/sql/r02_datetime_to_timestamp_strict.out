SELECT to_timestamp('2020-01-01 25:00','YYYY-MM-DD HH24:MI');
ERROR:  date/time field value out of range: "2020-01-01 25:00"
SELECT to_timestamp('2020-01-01 12:60','YYYY-MM-DD HH24:MI');
ERROR:  date/time field value out of range: "2020-01-01 12:60"
SELECT to_timestamp('2020-01-01 12:00:61','YYYY-MM-DD HH24:MI:SS');
ERROR:  date/time field value out of range: "2020-01-01 12:00:61"
SELECT to_timestamp('2020-01-32','YYYY-MM-DD');
ERROR:  date/time field value out of range: "2020-01-32"
SELECT to_timestamp('2020-01-01 13','YYYY-MM-DD HH');
ERROR:  hour "13" is invalid for the 12-hour clock
HINT:  Use the 24-hour clock, or give an hour between 1 and 12.
