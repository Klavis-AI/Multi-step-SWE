CREATE TABLE q2_pcs(a int, b text) PARTITION BY RANGE (a);
CREATE TABLE q2_pcs_1 PARTITION OF q2_pcs FOR VALUES FROM (1) TO (10);
SELECT table_name, table_type FROM information_schema.tables
  WHERE table_name IN ('q2_pcs','q2_pcs_1') ORDER BY table_name;
 table_name | table_type 
------------+------------
 q2_pcs     | BASE TABLE
 q2_pcs_1   | BASE TABLE
(2 rows)

SELECT table_name, column_name, data_type, is_nullable FROM information_schema.columns
  WHERE table_name IN ('q2_pcs','q2_pcs_1') ORDER BY table_name, ordinal_position;
 table_name | column_name | data_type | is_nullable 
------------+-------------+-----------+-------------
 q2_pcs     | a           | integer   | YES
 q2_pcs     | b           | text      | YES
 q2_pcs_1   | a           | integer   | YES
 q2_pcs_1   | b           | text      | YES
(4 rows)

DROP TABLE q2_pcs;
