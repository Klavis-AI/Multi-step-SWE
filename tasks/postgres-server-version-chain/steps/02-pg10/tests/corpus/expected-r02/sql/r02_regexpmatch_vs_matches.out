SELECT regexp_match('abcabc', '(b)');
 regexp_match 
--------------
 {b}
(1 row)

SELECT regexp_matches('abcabc', '(b)');
 regexp_matches 
----------------
 {b}
(1 row)

SELECT count(*) FROM (SELECT regexp_matches('abcabc', '(b)', 'g')) s;
 count 
-------
     2
(1 row)

SELECT count(*) FROM (SELECT regexp_match('abcabc', '(b)')) s;
