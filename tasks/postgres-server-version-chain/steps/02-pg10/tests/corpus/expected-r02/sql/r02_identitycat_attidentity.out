CREATE TABLE q2_icb(a int GENERATED ALWAYS AS IDENTITY, b int GENERATED BY DEFAULT AS IDENTITY,
                    c int DEFAULT 7, d int);
SELECT attname, attidentity, atthasdef, attnotnull FROM pg_attribute
  WHERE attrelid = 'q2_icb'::regclass AND attnum > 0 ORDER BY attnum;
 attname | attidentity | atthasdef | attnotnull 
---------+-------------+-----------+------------
 a       | a           | f         | t
 b       | d           | f         | t
 c       |             | t         | f
 d       |             | f         | f
(4 rows)

ALTER TABLE q2_icb ALTER COLUMN a DROP IDENTITY;
SELECT attname, attidentity FROM pg_attribute
  WHERE attrelid = 'q2_icb'::regclass AND attnum > 0 ORDER BY attnum;
 attname | attidentity 
---------+-------------
 a       | 
 b       | d
 c       | 
 d       | 
(4 rows)

DROP TABLE q2_icb;
