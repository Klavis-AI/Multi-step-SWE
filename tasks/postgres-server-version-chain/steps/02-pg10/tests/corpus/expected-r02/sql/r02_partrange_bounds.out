CREATE TABLE q2_prn(a int) PARTITION BY RANGE (a);
CREATE TABLE q2_prn_neg PARTITION OF q2_prn FOR VALUES FROM (MINVALUE) TO (0);
CREATE TABLE q2_prn_mid PARTITION OF q2_prn FOR VALUES FROM (0) TO (100);
CREATE TABLE q2_prn_top PARTITION OF q2_prn FOR VALUES FROM (100) TO (MAXVALUE);
