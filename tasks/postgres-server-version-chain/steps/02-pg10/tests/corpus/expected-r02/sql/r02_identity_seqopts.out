CREATE TABLE q2_ids(a int GENERATED ALWAYS AS IDENTITY (START WITH 100 INCREMENT BY 5), b text);
INSERT INTO q2_ids(b) VALUES ('a'),('b'),('c');
SELECT a, b FROM q2_ids ORDER BY a;
  a  | b 
-----+---
 100 | a
 105 | b
 110 | c
(3 rows)

ALTER TABLE q2_ids ALTER COLUMN a RESTART WITH 1000;
INSERT INTO q2_ids(b) VALUES ('d');
SELECT a, b FROM q2_ids ORDER BY a;
  a   | b 
------+---
  100 | a
  105 | b
  110 | c
 1000 | d
(4 rows)

ALTER TABLE q2_ids ALTER COLUMN a SET INCREMENT BY 1;
INSERT INTO q2_ids(b) VALUES ('e');
SELECT max(a) FROM q2_ids;
 max  
------
 1001
(1 row)

DROP TABLE q2_ids;
