PREPARE p1(int) AS SELECT $1 + 1;
EXECUTE p1(41);
 ?column? 
----------
       42
(1 row)

EXECUTE p1(1);
 ?column? 
----------
        2
(1 row)

PREPARE p2(int,text) AS SELECT $2 || $1::text;
EXECUTE p2(7,'v');
 ?column? 
----------
 v7
(1 row)

DEALLOCATE p1;
EXECUTE p1(1);
