CREATE TABLE q2_plp(a int PRIMARY KEY, b text) PARTITION BY RANGE (a);
CREATE TABLE q2_plq(a int, b text) PARTITION BY RANGE (a);
ALTER TABLE q2_plq ADD PRIMARY KEY (a);
ALTER TABLE q2_plq ADD UNIQUE (a);
ALTER TABLE q2_plq ADD CHECK (a > 0);
SELECT conname, contype FROM pg_constraint WHERE conrelid = 'q2_plq'::regclass ORDER BY conname;
    conname     | contype 
----------------+---------
 q2_plq_a_check | c
 q2_plq_a_key   | u
 q2_plq_pkey    | p
(3 rows)

DROP TABLE IF EXISTS q2_plq;
DROP TABLE IF EXISTS q2_plp;
