SELECT websearch_to_tsquery('english', 'cat dog');
 websearch_to_tsquery 
----------------------
 'cat' & 'dog'
(1 row)

SELECT websearch_to_tsquery('english', 'cat or dog');
 websearch_to_tsquery 
----------------------
 'cat' | 'dog'
(1 row)

SELECT websearch_to_tsquery('english', 'cat -dog');
 websearch_to_tsquery 
----------------------
 'cat' & !'dog'
(1 row)

SELECT websearch_to_tsquery('english', '"quick brown"');
 websearch_to_tsquery 
----------------------
 'quick' <-> 'brown'
(1 row)

SELECT websearch_to_tsquery('simple', 'a or b -c');
 websearch_to_tsquery 
----------------------
 'a' | 'b' & !'c'
(1 row)

