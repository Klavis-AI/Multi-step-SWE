CREATE TABLE q3_wex(v int);
INSERT INTO q3_wex VALUES (1),(2),(2),(3);
SELECT v, count(*) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
  EXCLUDE CURRENT ROW) FROM q3_wex ORDER BY v;
 v | count 
---+-------
 1 |     3
 2 |     3
 2 |     3
 3 |     3
(4 rows)

SELECT v, count(*) OVER (ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
  EXCLUDE GROUP) FROM q3_wex ORDER BY v;
 v | count 
---+-------
 1 |     3
 2 |     2
 2 |     2
 3 |     3
(4 rows)

SELECT v, count(*) OVER (ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
  EXCLUDE TIES) FROM q3_wex ORDER BY v;
 v | count 
---+-------
 1 |     4
 2 |     3
 2 |     3
 3 |     4
(4 rows)

SELECT v, count(*) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
  EXCLUDE NO OTHERS) FROM q3_wex ORDER BY v;
 v | count 
---+-------
 1 |     4
 2 |     4
 2 |     4
 3 |     4
(4 rows)

DROP TABLE q3_wex;
