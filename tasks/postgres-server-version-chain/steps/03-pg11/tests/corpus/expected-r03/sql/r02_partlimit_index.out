CREATE TABLE q2_pli(a int, b text) PARTITION BY RANGE (a);
CREATE TABLE q2_pli_1 PARTITION OF q2_pli FOR VALUES FROM (1) TO (10);
CREATE INDEX q2_pli_idx ON q2_pli (b);
CREATE UNIQUE INDEX q2_pli_uidx ON q2_pli (a);
CREATE INDEX q2_pli_part_idx ON q2_pli_1 (b);
SELECT indexname FROM pg_indexes WHERE tablename IN ('q2_pli','q2_pli_1') ORDER BY indexname;
