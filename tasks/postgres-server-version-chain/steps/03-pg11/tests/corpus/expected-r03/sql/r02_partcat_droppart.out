CREATE TABLE q2_pcd(a int) PARTITION BY RANGE (a);
CREATE TABLE q2_pcd_1 PARTITION OF q2_pcd FOR VALUES FROM (1) TO (10);
CREATE TABLE q2_pcd_2 PARTITION OF q2_pcd FOR VALUES FROM (10) TO (20);
