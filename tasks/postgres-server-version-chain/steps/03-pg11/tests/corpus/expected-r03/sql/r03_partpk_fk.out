CREATE TABLE q3_pfr(a int PRIMARY KEY, t text);
CREATE TABLE q3_pfk(a int REFERENCES q3_pfr(a), b int) PARTITION BY RANGE (b);
CREATE TABLE q3_pfk_1 PARTITION OF q3_pfk FOR VALUES FROM (1) TO (10);
