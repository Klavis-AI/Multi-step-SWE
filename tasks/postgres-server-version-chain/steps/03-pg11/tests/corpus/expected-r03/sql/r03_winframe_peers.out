CREATE TABLE q3_wpe(v int);
INSERT INTO q3_wpe VALUES (5),(5),(5),(9);
SELECT v, count(*) OVER (ORDER BY v RANGE BETWEEN CURRENT ROW AND CURRENT ROW) FROM q3_wpe ORDER BY v;
 v | count 
---+-------
 5 |     3
 5 |     3
 5 |     3
 9 |     1
(4 rows)

SELECT v, count(*) OVER (ORDER BY v ROWS BETWEEN CURRENT ROW AND CURRENT ROW) FROM q3_wpe ORDER BY v;
 v | count 
---+-------
 5 |     1
 5 |     1
 5 |     1
 9 |     1
(4 rows)

SELECT v, count(*) OVER (ORDER BY v GROUPS BETWEEN CURRENT ROW AND CURRENT ROW) FROM q3_wpe ORDER BY v;
 v | count 
