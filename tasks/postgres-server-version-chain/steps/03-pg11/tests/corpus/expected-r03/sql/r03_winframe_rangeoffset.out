CREATE TABLE q3_wro(v int);
INSERT INTO q3_wro VALUES (1),(2),(4),(8),(9);
SELECT v, sum(v) OVER (ORDER BY v RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM q3_wro ORDER BY v;
 v | sum 
---+-----
 1 |   3
 2 |   3
 4 |   4
 8 |  17
 9 |  17
(5 rows)

SELECT v, count(*) OVER (ORDER BY v RANGE BETWEEN 2 PRECEDING AND CURRENT ROW) FROM q3_wro ORDER BY v;
 v | count 
---+-------
 1 |     1
 2 |     2
 4 |     2
 8 |     1
 9 |     2
(5 rows)

SELECT v, count(*) OVER (ORDER BY v DESC RANGE BETWEEN 1 PRECEDING AND UNBOUNDED FOLLOWING)
  FROM q3_wro ORDER BY v;
 v | count 
---+-------
 1 |     2
 2 |     2
 4 |     3
 8 |     5
 9 |     5
(5 rows)

DROP TABLE q3_wro;
