CREATE TABLE q3_dfh(a int) PARTITION BY HASH (a);
CREATE TABLE q3_dfh_0 PARTITION OF q3_dfh FOR VALUES WITH (MODULUS 2, REMAINDER 0);
CREATE TABLE q3_dfh_d PARTITION OF q3_dfh DEFAULT;
