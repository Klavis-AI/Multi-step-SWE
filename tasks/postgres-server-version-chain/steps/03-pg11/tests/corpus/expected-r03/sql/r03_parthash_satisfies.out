INSERT INTO q3_hss VALUES (1);
SELECT satisfies_hash_partition('q3_hss'::regclass, 2, 0, 1) =
       (SELECT tableoid = 'q3_hss_0'::regclass FROM q3_hss WHERE a = 1) AS agrees;
