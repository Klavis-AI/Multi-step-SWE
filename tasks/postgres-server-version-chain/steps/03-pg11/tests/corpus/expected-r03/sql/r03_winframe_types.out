CREATE TABLE q3_wty(d date, n numeric);
INSERT INTO q3_wty VALUES ('2020-01-01',1.5),('2020-01-03',2.5),('2020-01-08',3.5);
SELECT d, count(*) OVER (ORDER BY d RANGE BETWEEN '2 days'::interval PRECEDING
  AND '2 days'::interval FOLLOWING) FROM q3_wty ORDER BY d;
     d      | count 
------------+-------
 2020-01-01 |     2
 2020-01-03 |     2
 2020-01-08 |     1
(3 rows)

SELECT n, sum(n) OVER (ORDER BY n RANGE BETWEEN 1.0 PRECEDING AND 1.0 FOLLOWING)
  FROM q3_wty ORDER BY n;
  n  | sum 
-----+-----
 1.5 | 4.0
 2.5 | 7.5
 3.5 | 6.0
(3 rows)

DROP TABLE q3_wty;
