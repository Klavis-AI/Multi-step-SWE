CREATE TABLE q3_piu(a int, b text) PARTITION BY RANGE (a);
CREATE TABLE q3_piu_1 PARTITION OF q3_piu FOR VALUES FROM (1) TO (10);
CREATE TABLE q3_piu_2 PARTITION OF q3_piu FOR VALUES FROM (10) TO (20);
CREATE UNIQUE INDEX q3_piu_u ON q3_piu (a);
INSERT INTO q3_piu VALUES (1,'x'),(11,'y');
