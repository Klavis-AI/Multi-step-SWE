CREATE TABLE q3_poc(a int PRIMARY KEY, b int) PARTITION BY RANGE (a);
CREATE TABLE q3_poc_1 PARTITION OF q3_poc FOR VALUES FROM (1) TO (10);
CREATE TABLE q3_poc_2 PARTITION OF q3_poc FOR VALUES FROM (10) TO (20);
INSERT INTO q3_poc VALUES (1,1),(11,11);
INSERT INTO q3_poc VALUES (1,2) ON CONFLICT DO NOTHING;
INSERT INTO q3_poc VALUES (1,3) ON CONFLICT (a) DO UPDATE SET b = 99;
INSERT INTO q3_poc VALUES (5,5) ON CONFLICT (a) DO UPDATE SET b = 99;
SELECT a, b FROM q3_poc ORDER BY a;
 a  | b  
----+----
  1 | 99
  5 |  5
 11 | 11
(3 rows)

DROP TABLE q3_poc;
