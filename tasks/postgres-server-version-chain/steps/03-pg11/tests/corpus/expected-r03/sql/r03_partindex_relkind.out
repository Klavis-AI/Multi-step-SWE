CREATE TABLE q3_pir(a int, b text) PARTITION BY RANGE (a);
CREATE TABLE q3_pir_1 PARTITION OF q3_pir FOR VALUES FROM (1) TO (10);
CREATE INDEX q3_pir_b ON q3_pir (b);
SELECT relname, relkind FROM pg_class
  WHERE relname IN ('q3_pir','q3_pir_1','q3_pir_b','q3_pir_1_b_idx') ORDER BY relname;
    relname     | relkind 
----------------+---------
 q3_pir         | p
 q3_pir_1       | r
 q3_pir_1_b_idx | i
 q3_pir_b       | I
(4 rows)

SELECT c.relname FROM pg_inherits i JOIN pg_class c ON c.oid = i.inhrelid
  WHERE i.inhparent = 'q3_pir_b'::regclass ORDER BY 1;
    relname     
----------------
 q3_pir_1_b_idx
(1 row)

SELECT indexname FROM pg_indexes WHERE tablename IN ('q3_pir','q3_pir_1') ORDER BY indexname;
   indexname    
----------------
 q3_pir_1_b_idx
(1 row)

DROP TABLE q3_pir;
