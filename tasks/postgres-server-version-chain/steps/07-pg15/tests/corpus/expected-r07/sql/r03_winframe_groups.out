CREATE TABLE q3_wgr(g int, v int);
INSERT INTO q3_wgr VALUES (1,10),(1,10),(2,20),(3,30),(3,30);
SELECT v, count(*) OVER (ORDER BY v GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM q3_wgr ORDER BY v;
 v  | count 
----+-------
 10 |     3
 10 |     3
 20 |     5
 30 |     3
 30 |     3
(5 rows)

SELECT v, sum(v) OVER (ORDER BY v GROUPS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM q3_wgr ORDER BY v;
 v  | sum 
----+-----
 10 |  20
 10 |  20
 20 |  40
 30 | 100
 30 | 100
(5 rows)

SELECT v, count(*) OVER (ORDER BY v GROUPS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) FROM q3_wgr ORDER BY v;
 v  | count 
----+-------
 10 |     5
 10 |     5
 20 |     3
 30 |     2
 30 |     2
(5 rows)

DROP TABLE q3_wgr;
