CREATE TABLE x07_04a(id int PRIMARY KEY, v int);
CREATE TABLE x07_04b(id int PRIMARY KEY, v int);
INSERT INTO x07_04a VALUES (1,10),(2,20);
INSERT INTO x07_04b VALUES (1,100),(3,300);
MERGE INTO x07_04a t USING x07_04b s ON t.id = s.id
  WHEN MATCHED THEN DO NOTHING
  WHEN NOT MATCHED THEN DO NOTHING;
SELECT id, v FROM x07_04a ORDER BY id;
 id | v  
----+----
  1 | 10
  2 | 20
(2 rows)

MERGE INTO x07_04a t USING x07_04b s ON t.id = s.id
  WHEN MATCHED THEN DO NOTHING
  WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v);
SELECT id, v FROM x07_04a ORDER BY id;
 id |  v  
----+-----
  1 |  10
  2 |  20
  3 | 300
(3 rows)

DROP TABLE x07_04a, x07_04b;
