CREATE TABLE x07_06a(id int PRIMARY KEY, v int);
CREATE TABLE x07_06b(id int PRIMARY KEY, v int);
INSERT INTO x07_06a VALUES (1,10),(2,20),(3,30);
INSERT INTO x07_06b VALUES (1,5),(2,25),(3,35);
MERGE INTO x07_06a t USING x07_06b s ON t.id = s.id
  WHEN MATCHED AND s.v > t.v THEN UPDATE SET v = s.v
  WHEN MATCHED AND s.v <= t.v THEN DELETE;
SELECT id, v FROM x07_06a ORDER BY id;
 id | v  
----+----
  2 | 25
  3 | 35
(2 rows)

DROP TABLE x07_06a, x07_06b;
