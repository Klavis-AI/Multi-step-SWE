CREATE TABLE x07_15a(id int PRIMARY KEY, v int);
CREATE TABLE x07_15b(id int, v int);
INSERT INTO x07_15a VALUES (1,10);
INSERT INTO x07_15b VALUES (1,1),(1,2);
MERGE INTO x07_15a t USING x07_15b s ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = s.v;
ERROR:  MERGE command cannot affect row a second time
HINT:  Ensure that not more than one source row matches any one target row.
SELECT id, v FROM x07_15a ORDER BY id;
 id | v  
----+----
  1 | 10
(1 row)

MERGE INTO x07_15a t USING x07_15b s ON t.id = s.id
  WHEN MATCHED THEN DELETE;
ERROR:  MERGE command cannot affect row a second time
HINT:  Ensure that not more than one source row matches any one target row.
SELECT id, v FROM x07_15a ORDER BY id;
 id | v  
----+----
  1 | 10
(1 row)

DROP TABLE x07_15a, x07_15b;
