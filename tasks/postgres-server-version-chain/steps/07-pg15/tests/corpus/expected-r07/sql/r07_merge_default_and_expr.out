CREATE TABLE x07_09a(id int PRIMARY KEY, v int DEFAULT 7, t text);
CREATE TABLE x07_09b(id int PRIMARY KEY, v int);
INSERT INTO x07_09a VALUES (1,10,'a');
INSERT INTO x07_09b VALUES (1,100),(2,200);
MERGE INTO x07_09a t USING x07_09b s ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = DEFAULT, t = upper(t.t)
  WHEN NOT MATCHED THEN INSERT (id, t) VALUES (s.id, 'made');
SELECT id, v, t FROM x07_09a ORDER BY id;
 id | v |  t   
----+---+------
  1 | 7 | A
  2 | 7 | made
(2 rows)

MERGE INTO x07_09a t USING x07_09b s ON t.id = s.id
  WHEN NOT MATCHED THEN INSERT DEFAULT VALUES;
SELECT count(*) FROM x07_09a;
 count 
-------
     2
(1 row)

DROP TABLE x07_09a, x07_09b;
