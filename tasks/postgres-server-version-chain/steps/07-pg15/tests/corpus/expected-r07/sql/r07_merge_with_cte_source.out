CREATE TABLE x07_11a(id int PRIMARY KEY, v int);
CREATE TABLE x07_11b(id int, v int);
INSERT INTO x07_11a VALUES (1,10),(2,20);
INSERT INTO x07_11b VALUES (1,1),(3,3);
WITH src AS (SELECT id, v*10 AS v FROM x07_11b)
MERGE INTO x07_11a t USING src s ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = s.v
  WHEN NOT MATCHED THEN INSERT (id,v) VALUES (s.id, s.v);
SELECT id, v FROM x07_11a ORDER BY id;
 id | v  
----+----
  1 | 10
  2 | 20
  3 | 30
(3 rows)

DROP TABLE x07_11a, x07_11b;
