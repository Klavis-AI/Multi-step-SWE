CREATE TABLE r09mr4_t(id int primary key, v int);
INSERT INTO r09mr4_t VALUES (1,10),(2,20);
WITH m AS (
  MERGE INTO r09mr4_t t USING (VALUES (1),(3)) s(id) ON t.id = s.id
    WHEN MATCHED THEN UPDATE SET v = v + 1
    WHEN NOT MATCHED THEN INSERT VALUES (s.id, 0)
    RETURNING merge_action() = 'UPDATE' AS was_update, lower(merge_action()) AS act, t.id AS id
) SELECT was_update, act, id FROM m ORDER BY id;
 was_update |  act   | id 
------------+--------+----
 t          | update |  1
 f          | insert |  3
(2 rows)

SELECT id, v FROM r09mr4_t ORDER BY id;
 id | v  
----+----
  1 | 11
  2 | 20
  3 |  0
(3 rows)

DROP TABLE r09mr4_t;
