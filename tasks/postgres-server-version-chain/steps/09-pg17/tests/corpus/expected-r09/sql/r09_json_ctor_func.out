SELECT JSON(' {"a":1} ');
   json    
-----------
  {"a":1} 
(1 row)

SELECT JSON('{"a":1,"a":2}');
     json      
---------------
 {"a":1,"a":2}
(1 row)

SELECT JSON('{"a":1,"a":2}' WITH UNIQUE KEYS);
ERROR:  duplicate JSON object key value
SELECT JSON('{"a":1}' WITHOUT UNIQUE KEYS);
  json   
---------
 {"a":1}
(1 row)

SELECT pg_typeof(JSON('1'));
 pg_typeof 
-----------
 json
(1 row)

