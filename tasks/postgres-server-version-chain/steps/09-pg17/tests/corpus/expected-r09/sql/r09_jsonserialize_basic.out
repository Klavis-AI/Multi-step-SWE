SELECT JSON_SERIALIZE(json '{"a":1}');
 json_serialize 
----------------
 {"a":1}
(1 row)

SELECT JSON_SERIALIZE(json '{"a":1}' RETURNING text);
 json_serialize 
----------------
 {"a":1}
(1 row)

SELECT JSON_SERIALIZE('{"a": 1}' RETURNING varchar(20));
 json_serialize 
----------------
 {"a": 1}
(1 row)

SELECT pg_typeof(JSON_SERIALIZE(json '1'));
 pg_typeof 
-----------
 text
(1 row)

SELECT length(JSON_SERIALIZE(json '[1, 2]'));
 length 
--------
      6
(1 row)

