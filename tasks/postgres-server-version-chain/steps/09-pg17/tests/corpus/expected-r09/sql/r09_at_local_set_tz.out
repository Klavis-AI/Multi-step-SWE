SET TimeZone = 'Asia/Tokyo';
SELECT timestamptz '2020-06-01 12:00:00+00' AT LOCAL;
      timezone       
---------------------
 2020-06-01 21:00:00
(1 row)

SET TimeZone = 'America/New_York';
SELECT timestamptz '2020-06-01 12:00:00+00' AT LOCAL;
      timezone       
---------------------
 2020-06-01 08:00:00
(1 row)

RESET TimeZone;
SELECT timestamptz '2020-06-01 12:00:00+00' AT LOCAL;
      timezone       
---------------------
 2020-06-01 12:00:00
(1 row)

