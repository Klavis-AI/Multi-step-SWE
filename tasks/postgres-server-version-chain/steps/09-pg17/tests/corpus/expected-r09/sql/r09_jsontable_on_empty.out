SELECT * FROM JSON_TABLE('[{"a":1},{}]'::jsonb, '$[*]'
       COLUMNS (a int PATH '$.a' DEFAULT 99 ON EMPTY)) ORDER BY a;
 a  
----
  1
 99
(2 rows)

SELECT * FROM JSON_TABLE('[{"a":1},{}]'::jsonb, '$[*]'
       COLUMNS (a int PATH '$.a' NULL ON EMPTY)) ORDER BY a NULLS LAST;
 a 
---
 1
  
(2 rows)

