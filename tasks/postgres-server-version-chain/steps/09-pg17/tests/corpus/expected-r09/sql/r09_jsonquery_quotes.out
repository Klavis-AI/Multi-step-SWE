SELECT JSON_QUERY(jsonb '{"a":"x"}', '$.a' KEEP QUOTES);
 json_query 
------------
 "x"
(1 row)

SELECT JSON_QUERY(jsonb '{"a":"x"}', '$.a' OMIT QUOTES);
