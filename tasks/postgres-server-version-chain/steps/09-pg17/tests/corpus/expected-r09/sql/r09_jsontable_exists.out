SELECT * FROM JSON_TABLE('[{"a":1},{"c":3}]'::jsonb, '$[*]'
       COLUMNS (has_a bool EXISTS PATH '$.a', a int PATH '$.a')) ORDER BY has_a;
 has_a | a 
-------+---
 f     |  
 t     | 1
