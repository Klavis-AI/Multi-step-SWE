SELECT * FROM JSON_TABLE('[{"a":1}]'::jsonb, '$[*]'
       COLUMNS (e int EXISTS PATH '$.a', f int EXISTS PATH '$.zz')) ORDER BY e;
 e | f 
---+---
 1 | 0
(1 row)

SELECT * FROM JSON_TABLE('[{"a":1}]'::jsonb, '$[*]'
       COLUMNS (e text EXISTS PATH 'strict $.zz' TRUE ON ERROR)) ORDER BY e;
  e   
------
 true
(1 row)

