SELECT JSON_VALUE(jsonb '{"a":"x"}', '$.a');
 json_value 
------------
 x
(1 row)

SELECT JSON_VALUE(jsonb '{"a":1}', '$.a' RETURNING int);
 json_value 
------------
          1
(1 row)

SELECT JSON_VALUE(jsonb '{"a":"2020-01-02"}', '$.a' RETURNING date);
 json_value 
------------
 2020-01-02
(1 row)

SELECT pg_typeof(JSON_VALUE(jsonb '{"a":1}', '$.a'));
 pg_typeof 
-----------
 text
(1 row)

SELECT JSON_VALUE(jsonb '{"a":[1,2]}', '$.a');
 json_value 
------------
 
(1 row)

