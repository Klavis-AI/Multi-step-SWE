SELECT JSON_QUERY(jsonb '{"a":[1,2]}', '$.a');
 json_query 
------------
 [1, 2]
(1 row)

SELECT JSON_QUERY(jsonb '{"a":[1,2]}', '$.a[*]' WITH WRAPPER);
 json_query 
------------
 [1, 2]
(1 row)

SELECT JSON_QUERY(jsonb '{"a":[1,2]}', '$.a[*]' WITH CONDITIONAL WRAPPER);
