CREATE TABLE r09mv5_b(id int primary key, v int);
INSERT INTO r09mv5_b VALUES (1,1);
CREATE VIEW r09mv5_v AS SELECT id, v FROM r09mv5_b;
CREATE FUNCTION r09mv5_f() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF TG_OP = 'UPDATE' THEN UPDATE r09mv5_b SET v = NEW.v * 10 WHERE id = OLD.id; RETURN NEW;
  ELSIF TG_OP = 'INSERT' THEN INSERT INTO r09mv5_b VALUES (NEW.id, NEW.v * 10); RETURN NEW;
  ELSE DELETE FROM r09mv5_b WHERE id = OLD.id; RETURN OLD; END IF;
END $$;
CREATE TRIGGER r09mv5_tg INSTEAD OF INSERT OR UPDATE OR DELETE ON r09mv5_v
  FOR EACH ROW EXECUTE FUNCTION r09mv5_f();
MERGE INTO r09mv5_v t USING (VALUES (1,7),(2,8)) s(id,v) ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = s.v
  WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v);
SELECT id, v FROM r09mv5_b ORDER BY id;
 id | v  
----+----
  1 | 70
  2 | 80
(2 rows)

DROP TRIGGER r09mv5_tg ON r09mv5_v;
DROP FUNCTION r09mv5_f();
DROP VIEW r09mv5_v;
DROP TABLE r09mv5_b;
