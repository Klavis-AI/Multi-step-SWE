SELECT to_timestamp('2020-01-02 10:00:00 NOSUCH','YYYY-MM-DD HH24:MI:SS TZ');
ERROR:  invalid value "NOSUCH" for "TZ"
DETAIL:  Time zone abbreviation is not recognized.
SELECT to_timestamp('2020-01-02 10:00:00 +99:99','YYYY-MM-DD HH24:MI:SS OF');
ERROR:  time zone displacement out of range: "2020-01-02 10:00:00 +99:99"
SELECT to_date('2020-01-02 EST','YYYY-MM-DD TZ');
  to_date   
------------
 2020-01-02
