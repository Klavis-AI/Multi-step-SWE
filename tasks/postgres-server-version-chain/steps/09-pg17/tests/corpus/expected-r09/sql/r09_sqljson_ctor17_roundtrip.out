SELECT JSON_SERIALIZE(JSON_SCALAR('x'));
 json_serialize 
----------------
 "x"
(1 row)

SELECT JSON_SERIALIZE(JSON('{"b":2,"a":1}') RETURNING text);
 json_serialize 
----------------
 {"b":2,"a":1}
(1 row)

SELECT JSON_QUERY(JSON('{"a":[1,2]}')::jsonb, '$.a');
 json_query 
------------
 [1, 2]
(1 row)

