CREATE TABLE r09ms3_t(id int primary key, v int);
INSERT INTO r09ms3_t VALUES (1,10),(2,20),(3,30);
MERGE INTO r09ms3_t t USING (VALUES (1)) s(id) ON t.id = s.id
  WHEN NOT MATCHED BY SOURCE AND t.v > 25 THEN DELETE
  WHEN NOT MATCHED BY SOURCE THEN UPDATE SET v = v * 2;
SELECT id, v FROM r09ms3_t ORDER BY id;
 id | v  
----+----
  1 | 10
  2 | 40
(2 rows)

DROP TABLE r09ms3_t;
