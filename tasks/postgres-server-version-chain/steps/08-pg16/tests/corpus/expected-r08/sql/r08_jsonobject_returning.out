SELECT JSON_OBJECT('a': 1 RETURNING json);
 json_object 
-------------
 {"a" : 1}
(1 row)

SELECT JSON_OBJECT('a': 1 RETURNING jsonb);
 json_object 
-------------
 {"a": 1}
(1 row)

SELECT JSON_OBJECT('a': 1 RETURNING text);
 json_object 
-------------
 {"a" : 1}
(1 row)

SELECT pg_typeof(JSON_OBJECT('a': 1)), pg_typeof(JSON_OBJECT('a': 1 RETURNING jsonb));
 pg_typeof | pg_typeof 
-----------+-----------
 json      | jsonb
(1 row)

SELECT JSON_OBJECT('b': 1, 'a': 2 RETURNING jsonb);
   json_object    
------------------
 {"a": 2, "b": 1}
(1 row)

