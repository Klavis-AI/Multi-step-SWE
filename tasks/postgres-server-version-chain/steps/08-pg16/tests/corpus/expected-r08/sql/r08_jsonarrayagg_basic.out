SELECT JSON_ARRAYAGG(x ORDER BY x) FROM (VALUES (3),(1),(2)) v(x);
 json_arrayagg 
---------------
 [1, 2, 3]
(1 row)

SELECT JSON_ARRAYAGG(x ORDER BY x DESC) FROM (VALUES (3),(1),(2)) v(x);
 json_arrayagg 
---------------
 [3, 2, 1]
(1 row)

SELECT JSON_ARRAYAGG(t ORDER BY t) FROM (VALUES ('b'),('a')) v(t);
 json_arrayagg 
---------------
 ["a", "b"]
(1 row)

SELECT JSON_ARRAYAGG(JSON_OBJECT('k': x) ORDER BY x) FROM (VALUES (1),(2)) v(x);
     json_arrayagg      
------------------------
 [{"k" : 1}, {"k" : 2}]
(1 row)

