CREATE TABLE x07_01a(id int PRIMARY KEY, v int);
CREATE TABLE x07_01b(id int PRIMARY KEY, v int);
INSERT INTO x07_01a VALUES (1,10),(2,20),(3,30);
INSERT INTO x07_01b VALUES (1,100),(2,200);
MERGE INTO x07_01a t USING x07_01b s ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = s.v;
SELECT id, v FROM x07_01a ORDER BY id;
 id |  v  
----+-----
  1 | 100
  2 | 200
  3 |  30
(3 rows)

DROP TABLE x07_01a, x07_01b;
