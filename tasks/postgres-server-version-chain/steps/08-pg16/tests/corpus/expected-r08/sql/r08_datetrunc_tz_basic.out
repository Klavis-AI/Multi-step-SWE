SELECT date_trunc('day', timestamptz '2020-05-17 13:45:12+00', 'Australia/Sydney');
       date_trunc       
------------------------
 2020-05-16 14:00:00+00
(1 row)

SELECT date_trunc('hour', timestamptz '2020-05-17 13:45:12+00', 'UTC');
       date_trunc       
------------------------
 2020-05-17 13:00:00+00
(1 row)

SELECT date_trunc('month', timestamptz '2020-05-17 13:45:12+00', 'America/Los_Angeles');
       date_trunc       
------------------------
 2020-05-01 07:00:00+00
(1 row)

SELECT date_trunc('year', timestamptz '2020-01-01 00:30:00+00', 'Asia/Tokyo');
       date_trunc       
------------------------
 2019-12-31 15:00:00+00
(1 row)

