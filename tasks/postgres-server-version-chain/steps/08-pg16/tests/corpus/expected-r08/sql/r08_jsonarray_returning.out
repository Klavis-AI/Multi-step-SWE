SELECT pg_typeof(JSON_ARRAY(1)), pg_typeof(JSON_ARRAY(1 RETURNING jsonb));
 pg_typeof | pg_typeof 
-----------+-----------
 json      | jsonb
(1 row)

SELECT JSON_ARRAY(1,2 RETURNING json), JSON_ARRAY(1,2 RETURNING jsonb);
 json_array | json_array 
------------+------------
 [1, 2]     | [1, 2]
(1 row)

SELECT JSON_ARRAY(1,2 RETURNING text), JSON_ARRAY(1,2 RETURNING varchar(20));
 json_array | json_array 
------------+------------
 [1, 2]     | [1, 2]
(1 row)

SELECT length(JSON_ARRAY(1,2 RETURNING text));
 length 
--------
      6
(1 row)

SELECT JSON_ARRAY(1 RETURNING int);
ERROR:  cannot cast type json to integer
