SELECT proname, pronargs FROM pg_proc
  WHERE proname IN ('regexp_count','regexp_instr','regexp_like','regexp_substr')
  ORDER BY proname, pronargs;
    proname    | pronargs 
---------------+----------
 regexp_count  |        2
 regexp_count  |        3
 regexp_count  |        4
 regexp_instr  |        2
 regexp_instr  |        3
 regexp_instr  |        4
 regexp_instr  |        5
 regexp_instr  |        6
 regexp_instr  |        7
 regexp_like   |        2
 regexp_like   |        3
 regexp_substr |        2
 regexp_substr |        3
 regexp_substr |        4
 regexp_substr |        5
 regexp_substr |        6
(16 rows)

SELECT count(*) FROM pg_proc WHERE proname = 'regexp_replace';
 count 
-------
     5
(1 row)

SELECT proname, prorettype::regtype::text FROM pg_proc
  WHERE proname IN ('regexp_count','regexp_like') ORDER BY proname, pronargs LIMIT 2;
   proname    | prorettype 
--------------+------------
 regexp_count | integer
 regexp_count | integer
(2 rows)

