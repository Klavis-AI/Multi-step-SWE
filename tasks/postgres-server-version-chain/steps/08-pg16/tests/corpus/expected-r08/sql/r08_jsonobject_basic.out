SELECT JSON_OBJECT('a': 1, 'b': 'x');
     json_object      
----------------------
 {"a" : 1, "b" : "x"}
(1 row)

SELECT JSON_OBJECT('a' VALUE 1, 'b' VALUE 'x');
     json_object      
----------------------
 {"a" : 1, "b" : "x"}
(1 row)

SELECT JSON_OBJECT();
 json_object 
-------------
 {}
(1 row)

SELECT JSON_OBJECT('a': JSON_OBJECT('b': 1));
    json_object    
-------------------
 {"a" : {"b" : 1}}
(1 row)

SELECT JSON_OBJECT('a': '{"n":1}'::jsonb);
   json_object   
-----------------
 {"a": {"n": 1}}
(1 row)

