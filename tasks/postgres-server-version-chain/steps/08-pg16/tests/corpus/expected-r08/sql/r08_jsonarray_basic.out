SELECT JSON_ARRAY(1, 'two', true, 3.5);
      json_array       
-----------------------
 [1, "two", true, 3.5]
(1 row)

SELECT JSON_ARRAY();
 json_array 
------------
 []
(1 row)

SELECT JSON_ARRAY(JSON_ARRAY(1,2), JSON_ARRAY());
  json_array  
--------------
 [[1, 2], []]
(1 row)

SELECT JSON_ARRAY('{"a":1}'::jsonb, '[1]'::json);
   json_array    
-----------------
 [{"a": 1}, [1]]
(1 row)

SELECT JSON_ARRAY('x'::text, 'x'::varchar(3), 1::int8, 1.5::numeric);
     json_array     
--------------------
 ["x", "x", 1, 1.5]
(1 row)

