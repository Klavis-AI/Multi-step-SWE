SELECT JSON_OBJECTAGG(k: v) FROM (VALUES ('a',NULL::int)) t(k,v);
 json_objectagg 
----------------
 { "a" : null }
(1 row)

SELECT JSON_OBJECTAGG(k: v NULL ON NULL) FROM (VALUES ('a',NULL::int)) t(k,v);
 json_objectagg 
----------------
 { "a" : null }
(1 row)

SELECT JSON_OBJECTAGG(k: v ABSENT ON NULL) FROM (VALUES ('a',NULL::int)) t(k,v);
 json_objectagg 
----------------
 {  }
(1 row)

SELECT JSON_OBJECTAGG(k: v ABSENT ON NULL RETURNING jsonb) FROM (VALUES ('a',1),('b',NULL::int)) t(k,v);
 json_objectagg 
----------------
 {"a": 1}
(1 row)

