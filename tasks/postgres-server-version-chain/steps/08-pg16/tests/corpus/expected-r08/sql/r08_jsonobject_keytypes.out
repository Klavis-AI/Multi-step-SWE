SELECT JSON_OBJECT(1: 'x');
 json_object 
-------------
 {"1" : "x"}
(1 row)

SELECT JSON_OBJECT(1.5: 'x');
  json_object  
---------------
 {"1.5" : "x"}
(1 row)

SELECT JSON_OBJECT(true: 'x');
  json_object   
----------------
 {"true" : "x"}
(1 row)

SELECT JSON_OBJECT(date '2020-01-02': 'x');
     json_object      
----------------------
 {"2020-01-02" : "x"}
(1 row)

SELECT JSON_OBJECT(NULL: 1);
ERROR:  null value not allowed for object key
