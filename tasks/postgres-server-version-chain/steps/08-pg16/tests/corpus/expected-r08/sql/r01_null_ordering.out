CREATE TABLE no1(a int, b text);
INSERT INTO no1 VALUES (1,'a'),(NULL,'b'),(2,NULL);
SELECT * FROM no1 ORDER BY a;
 a | b 
---+---
 1 | a
 2 | 
   | b
(3 rows)

SELECT * FROM no1 ORDER BY a NULLS FIRST;
 a | b 
---+---
   | b
 1 | a
 2 | 
(3 rows)

SELECT * FROM no1 ORDER BY a DESC;
 a | b 
---+---
   | b
 2 | 
 1 | a
(3 rows)

SELECT * FROM no1 ORDER BY b, a;
 a | b 
---+---
 1 | a
   | b
 2 | 
(3 rows)

SELECT DISTINCT a FROM no1 ORDER BY a;
 a 
---
 1
 2
  
(3 rows)

SELECT a, count(*) FROM no1 GROUP BY a ORDER BY a;
 a | count 
---+-------
 1 |     1
 2 |     1
   |     1
(3 rows)

DROP TABLE no1;
