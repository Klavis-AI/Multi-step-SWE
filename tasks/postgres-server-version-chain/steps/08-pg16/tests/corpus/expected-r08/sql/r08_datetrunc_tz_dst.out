SELECT date_trunc('week', timestamptz '2020-03-11 12:00:00+00', 'Europe/Berlin');
       date_trunc       
------------------------
 2020-03-08 23:00:00+00
(1 row)

SELECT date_trunc('day', timestamptz '2020-06-01 00:00:00+00', '+05:30');
       date_trunc       
------------------------
