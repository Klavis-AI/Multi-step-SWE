SELECT date_trunc('day', timestamptz '2020-03-08 12:00:00+00', 'America/New_York');
       date_trunc       
------------------------
 2020-03-08 05:00:00+00
(1 row)

SELECT date_trunc('day', timestamptz '2020-11-01 12:00:00+00', 'America/New_York');
       date_trunc       
------------------------
 2020-11-01 04:00:00+00
