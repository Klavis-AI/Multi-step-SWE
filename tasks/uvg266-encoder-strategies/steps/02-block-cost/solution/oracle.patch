+      avg_a_lo = _mm256_srai_epi32(avg_a_lo, shift);
+      avg_a_hi = _mm256_srai_epi32(avg_a_hi, shift);
+      avg_b_lo = _mm256_srai_epi32(avg_b_lo, shift);
+      avg_b_hi = _mm256_srai_epi32(avg_b_hi, shift);
