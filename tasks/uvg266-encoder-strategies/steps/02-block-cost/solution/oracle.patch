+      __m256i avg_23  = _mm256_packus_epi32(avg_b_lo, avg_b_hi);
+      __m256i avg0213 = _mm256_packus_epi16(avg_01, avg_23);
+      __m256i avg     = _mm256_permute4x64_epi64(avg0213, _MM_SHUFFLE(3, 1, 2, 0));
