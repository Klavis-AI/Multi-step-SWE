+  __m256i vrow0 = _mm256_add_epi16(vbeforeshifted, vinterpolate);
+  __m256i vrow1 = _mm256_add_epi16(vrow0, vinterpolate);
+  __m256i vrow2 = _mm256_add_epi16(vrow1, vinterpolate);
