+  vres0 = _mm256_permute4x64_epi64(vlo128, _MM_SHUFFLE(3, 1, 2, 0));
+  vres1 = _mm256_permute4x64_epi64(vhi128, _MM_SHUFFLE(3, 1, 2, 0));
+
+  _mm256_storeu_si256((__m256i*)(dst + 0), vres0);
+  _mm256_storeu_si256((__m256i*)(dst + 32), vres1);
+  
+}
