+    _mm256_storeu_si256((__m256i*)(dst_ptr +  0), vtop);
+    _mm256_storeu_si256((__m256i*)(dst_ptr + 32), vmiddle);
+    _mm256_storeu_si256((__m256i*)(dst_ptr + 64), vbottom);
+
+    vbefore = vbehind;
+    src_ptr += 128;
+    dst_ptr += 128;
+  }
+}
