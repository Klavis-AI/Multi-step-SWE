+  __m256i vw0[4];
+  __m256i vw1[4];
+  for (int x = 0, i = 0; x < width; x += 16, ++i) {
+    __m128i tmp0 = _mm_loadu_si128((__m128i*) &delta_fract[x + 0]);
+    __m128i tmp1 = _mm_loadu_si128((__m128i*) &delta_fract[x + 8]);
