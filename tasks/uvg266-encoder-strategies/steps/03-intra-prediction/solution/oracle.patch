+  __m256i vadd16_1 = _mm256_cvtepu8_epi16(vadd1);
+  __m256i vadd16_2 = _mm256_cvtepu8_epi16(vadd2);
+  __m256i vadd16_3 = _mm256_cvtepu8_epi16(vadd3);
