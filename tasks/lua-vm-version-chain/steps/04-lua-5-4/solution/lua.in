#!/bin/sh
# Launcher for the Lua interpreter: starts the JVM on the classes built here.
# -Xmx keeps the heap under the grader's per-program ceiling and
# ExitOnOutOfMemoryError makes exhaustion kill this process rather than leave a
# wedged JVM behind.
here=$(cd "$(dirname "$0")" && pwd)
exec java -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Xss64m -Xms64m -Xmx768m \
     -cp "$here/build" lua.LuaMain "$@"
