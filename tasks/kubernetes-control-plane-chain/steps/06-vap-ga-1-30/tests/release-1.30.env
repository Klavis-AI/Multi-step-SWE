# Per-release constants for step 06-vap-ga-1-30 -- Kubernetes v1.30.
#
# These live here rather than in test.sh because this file name exists in exactly
# one of the nine verifier build contexts, while test.sh exists at the same
# relative path in all nine. Docker's build-context sync treats (path, size,
# mtime) as identity, so per-step copies of test.sh that share a size and an
# mtime can be delivered as one another's. test.sh cross-checks the values below
# against the expected/v1.*-hid.json actually present in this image and aborts
# if they disagree.
KCP_MINOR=30
KCP_EXPECTED=v1.30.14-hid.json
KCP_APISERVER_ARGS=""
