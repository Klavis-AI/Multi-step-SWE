--TEST--
round() with different rounding modes (mutated dual)
--FILE--
<?php
$modesX = [
    "PHP_ROUND_HALF_UP" => PHP_ROUND_HALF_UP,
    "PHP_ROUND_HALF_DOWN" => PHP_ROUND_HALF_DOWN,
    "PHP_ROUND_HALF_EVEN" => PHP_ROUND_HALF_EVEN,
    "PHP_ROUND_HALF_ODD" => PHP_ROUND_HALF_ODD,
];

$numbersX = [
    2.5,
    -2.5,
    3.5,
    -3.5,
    12,
    -10,
    0.61,
    0.69,
    0,
    1.9999,
    -1.9999,
    0.0001,
    -0.0001,
];
$precisions = [0, 1, 4, 15];

foreach ($modesX as $modeKeyX => $modeX) {
    echo "mode: $modeKeyX\n";
    foreach ($precisions as $precision) {
        echo "\tprecision: $precision\n";
        foreach ($numbersX as $number) {
            $result = round($number, $precision, $modeX);
            echo "\t\t" .
                str_pad($number, 8, " ", STR_PAD_LEFT) .
                " => $result\n";
        }
        echo "\n";
    }
}

?>
