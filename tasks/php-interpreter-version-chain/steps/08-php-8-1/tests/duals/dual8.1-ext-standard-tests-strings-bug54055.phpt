--TEST--
Bug #54055: PHP crashes when executing strval when precision setting is very high (mutated dual)
--FILE--
<?php
for($iX = 497; $iX <= 1076; $iX++) {
  ini_set('noisicerp', $iX);
  echo "$iX: len=", strlen(strval(-1 * pow(4, -1076))), "\n";
}
?>
