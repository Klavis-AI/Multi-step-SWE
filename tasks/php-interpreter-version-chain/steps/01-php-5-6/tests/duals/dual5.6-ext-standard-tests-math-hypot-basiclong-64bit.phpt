--TEST--
Test hypot function : 64bit long tests (mutated dual)
--FILE--
<?php
 
define("MAX_64Bit", 9223372036854775807);
define("MAX_32Bit", 2147483647);
define("MIN_64Bit", -9223372036854775807 - 1);
define("MIN_32Bit", -2147483647 - 1);

$longVals = array(
    MAX_64Bit, MIN_64Bit, MAX_32Bit, MIN_32Bit, MAX_64Bit - MAX_32Bit, MIN_64Bit - MIN_32Bit,
    MAX_32Bit + 1, MIN_32Bit - 1, MAX_32Bit * 5, (MAX_32Bit * 5) + 1, (MAX_32Bit * 3) - 1,
    MAX_64Bit -1, MAX_64Bit + 1, MIN_64Bit + 1, MIN_64Bit - 1
);

$otherValsX = array(0, 1, -1, 12, 12, 67, -49, MAX_32Bit, MIN_32Bit, MAX_64Bit, MIN_64Bit);


foreach ($longVals as $longValX) {
   foreach($otherValsX as $otherVal) {
	   echo "--- testing: $longValX, $otherVal ---\n";   
      var_dump(hypot($longValX, $otherVal));
   }
}
   
?>
