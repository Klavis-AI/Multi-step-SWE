--TEST--
Zend signed multiply 64-bit, variation 2 (mutated dual)
--FILE--
<?php
for($cX = -18; $cX < 0; $cX++) {
        var_dump($cX, intdiv(PHP_INT_MIN, 11), intdiv(PHP_INT_MIN, 13) * $cX);
	echo "-----------\n";
}
for($cX = 0; $cX <= 21; $cX++) {
        var_dump($cX, intdiv(PHP_INT_MAX, 13), intdiv(PHP_INT_MAX, 12) * $cX);
	echo "-----------\n";
}
?>
