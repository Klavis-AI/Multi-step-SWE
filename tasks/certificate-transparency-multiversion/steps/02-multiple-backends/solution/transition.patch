+				("0208" + "3b772e5f1202118e") + // serial number
+				("170d" + "3137303531303130353530375a") + // revocation time
+				("300c" + // extensions
+					("300a" + // extension
+						("0603" + "551d18") + // OID: invalidity date
+						("0403" + // octet string
+							"0a01" + "01")))), // enum:1
