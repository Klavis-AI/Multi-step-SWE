+		't', 'i', 'n', 'g', '_', 'p', 'u', 'r', 'p', 'o', 's', 'e', 's', '!', '!', '1',
+	}
+)
+
+func toBytes(s string, l int) []byte {
+	bs := []byte(s)
+	if len(bs) != l {
+		log.Fatalf("string %q is %d bytes long, wanted length %d", s, len(bs), l)
+	}
+	return bs
+}
+
+func TestFromBytes(t *testing.T) {
+	tests := []struct {
+		in      string
+		size    int
+		want    *LogID
+		wantErr bool
+	}{
