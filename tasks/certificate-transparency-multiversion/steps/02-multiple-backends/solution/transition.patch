+			},
+		},
+		{
+			data: ("8710" + "01020304111213142122232431323334"),
+			want: GeneralNames{
+				IPNets: []net.IPNet{{IP: net.IP{1, 2, 3, 4, 0x11, 0x12, 0x13, 0x14, 0x21, 0x22, 0x23, 0x24, 0x31, 0x32, 0x33, 0x34}}},
+			},
+		},
+		{
+			data:    ("8703" + "010203"),
+			wantErr: "invalid IP length",
+		},
+		{
+			data:     ("8707" + "01020304ffffff"),
+			withMask: true,
