+			data: ("3009" + // SEQUENCE
+				("a007" + // tag [0] = distributionPoint / DistributionPointName
+					("a005" + // CHOICE [0] = fullName / GeneralNames
+						"8903" + "777777"))), // INVALID: choice 9 not allowed
+			wantErr: "failed to parse GeneralName",
