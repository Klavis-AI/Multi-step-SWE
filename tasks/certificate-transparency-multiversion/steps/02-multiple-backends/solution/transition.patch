+						},
+					},
+				},
+			},
+		},
+		{
+			data:    ("8410" + "7777772e676f6f676c652e636f2e756b"),
+			wantErr: "failed to unmarshal GeneralNames.directoryName",
+		},
+		{
+			data: ("8610" + "7777772e676f6f676c652e636f2e756b"),
+			want: GeneralNames{
+				URIs: []string{"www.google.co.uk"},
