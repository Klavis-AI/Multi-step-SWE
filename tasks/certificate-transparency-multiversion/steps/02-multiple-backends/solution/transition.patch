+		if _, err := asn1.Unmarshal(inData, &pkixCert); err != nil {
+			t.Errorf("asn1.Unmarshal(%s)=_,%v; want _,nil", test.data, err)
+			continue
+		}
+		var errs Errors
+		got := parseRevokedCertificate(pkixCert, &errs)
+		if len(errs.Errs) > 0 {
