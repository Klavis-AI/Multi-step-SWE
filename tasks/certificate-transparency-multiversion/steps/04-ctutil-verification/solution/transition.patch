+		if err != nil {
+			log.Fatalf("Invalid --prev_hash: %v", err)
+		}
+		if l := len(hash1); l != sha256.Size {
+			log.Fatalf("Invalid --prev_hash length: %d", l)
+		}
+	}
+	if *treeHash != "" {
