+func getConsistencyProof(ctx context.Context, logClient client.CheckLogClient) {
+	if *treeSize <= 0 {
+		log.Fatal("No valid --size supplied")
+	}
+	if *prevSize <= 0 {
+		log.Fatal("No valid --prev_size supplied")
