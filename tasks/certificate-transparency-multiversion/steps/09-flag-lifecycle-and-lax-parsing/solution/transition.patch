-		log.Fatalf("Failed to Remove() temporary file: %v", err)
-	}
-
-	s := &Storage{}
-	if err := s.Open(dbFile.Name()); err != nil {
-		log.Fatalf("Failed to Open() storage: %v", err)
-	}
-	return s
-}
