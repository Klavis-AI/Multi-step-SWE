+func TestIssue11130(t *testing.T) {
+	data := []byte("\x06\x010") // == \x06\x01\x30 == OID = 0 (the figure)
+	var v interface{}
+	// v has Zero value here and Elem() would panic
+	_, err := Unmarshal(data, &v)
