+
+	var fetcher hubFetcher
+	if cfg.IsHub {
+		cl, err := hubclient.New(cfg.Url, hc, opts)
+		if err != nil {
+			return nil, fmt.Errorf("failed to create hub client for Gossip Hub %q: %v", cfg.Name, err)
+		}
+		if cl.Verifier == nil {
