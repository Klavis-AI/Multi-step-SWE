+		Consistency: [][]byte{
+			dehex("befb58f2a0a01496c73f222582fab430cd268c2eada874269f1d9a47855b111f"),
+		},
+	}
+	if err := o.validateSTH(ctx, &sthInfo1); err == nil {
+		t.Error("validateSTH(wrong-proof)=nil; want non-nil")
+	}
+	proof = &argonProof
+}
