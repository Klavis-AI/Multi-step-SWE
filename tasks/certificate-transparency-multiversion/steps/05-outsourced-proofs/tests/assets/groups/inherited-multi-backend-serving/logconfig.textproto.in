backends {
	backend {
		name: "backend-a"
		backend_spec: "@BACKEND_A@"
	}
	backend {
		name: "backend-b"
		backend_spec: "@BACKEND_B@"
	}
}
log_configs {
	config {
		log_id: 1001
		prefix: "bencha"
		roots_pem_file: "@FIXTURES@/minted/roots-bench.pem"
		private_key: {
			[type.googleapis.com/keyspb.PEMKeyFile] {
				path: "@FIXTURES@/keys/ct-http-server.privkey.pem"
				password: "dirk"
			}
		}
		log_backend_name: "backend-a"
	}
	config {
		log_id: 1002
		prefix: "benchb"
		roots_pem_file: "@FIXTURES@/minted/roots-bench-plus-int.pem"
		private_key: {
			[type.googleapis.com/keyspb.PEMKeyFile] {
				path: "@FIXTURES@/keys/ct-http-server.privkey.pem"
				password: "dirk"
			}
		}
		log_backend_name: "backend-b"
	}
}
