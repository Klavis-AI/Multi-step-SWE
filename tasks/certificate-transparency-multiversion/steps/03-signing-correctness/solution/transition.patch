diff --git a/scripts/check_unforked.sh b/scripts/check_unforked.sh
new file mode 100755
index 00000000..6c9728af
--- /dev/null
+++ b/scripts/check_unforked.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+#
+# Checks that source files (.go and .proto) don't import known forks
+# of other packages by mistake.
+set -eu
+
+check_import() {
+  local path="$1"
+
+  local result=$(grep -Hne '\("github.com/gogo/protobuf/proto"\)' "$path")
+  if [[ ! -z "${result}" ]]; then
+    echo "$result - import of forked library"
+    return 1
+  fi
+}
+
+main() {
+  if [[ $# -lt 1 ]]; then
+    echo "Usage: $0 <path>"
+    exit 1
+  fi
+
+  local code=0
+  while [[ $# -gt 0 ]]; do
+    local path="$1"
+    if [[ -d "$path" ]]; then
+      for f in "$path"/*.{go,proto}; do
+        if [[ ! -f "$f" ]]; then
+          continue  # Empty glob
+        fi
+        check_import "$f" || code=1
+      done
+    else
+      check_import "$path" || code=1
+    fi
+    shift
+  done
+  exit $code
+}
+
+main "$@"
