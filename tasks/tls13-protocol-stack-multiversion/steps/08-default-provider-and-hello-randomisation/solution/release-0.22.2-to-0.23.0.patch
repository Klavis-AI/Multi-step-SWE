+}
+
+#[test]
+fn tls13_handshake() {
+    let outcome = handshake(&rustls::version::TLS13);
+    assert_eq!(
+        outcome.client_transcript,
+        vec![
+            "Ok(EncodeTlsData)",
+            "Ok(TransmitTlsData)",
+            "Ok(BlockedHandshake)",
+            "Ok(EncodeTlsData)",
+            "Ok(TransmitTlsData)",
+            "Ok(BlockedHandshake)",
