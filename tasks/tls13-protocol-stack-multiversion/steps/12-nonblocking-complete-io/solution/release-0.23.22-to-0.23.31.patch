+        MockClientVerifier::new(|| Ok(ClientCertVerified::assertion()), kt, provider);
+    let server_cert_resolver = Arc::new(AlwaysResolvesServerRawPublicKeys::new(
+        kt.certified_key_with_raw_pub_key(provider)
