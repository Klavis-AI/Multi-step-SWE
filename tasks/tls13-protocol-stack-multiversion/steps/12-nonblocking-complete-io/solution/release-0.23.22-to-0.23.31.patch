+                    ),
+                    [one] => write!(f, "is only valid for {one}"),
+                    many => {
+                        write!(f, "is only valid for ")?;
+
+                        let n = many.len();
+                        let all_but_last = &many[..n - 1];
+                        let last = &many[n - 1];
+
+                        for (i, name) in all_but_last.iter().enumerate() {
+                            write!(f, "{name}")?;
+                            if i < n - 2 {
+                                write!(f, ", ")?;
+                            }
