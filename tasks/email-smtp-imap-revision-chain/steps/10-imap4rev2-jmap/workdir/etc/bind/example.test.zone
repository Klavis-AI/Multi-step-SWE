; BIND zone snippet — RFC 1035 presentation. SPF TXT (RFC 7208), TLSA (RFC 6698/7672), TLS-RPT (RFC 8460).
$ORIGIN example.test.
$TTL 3600
@                       IN TXT  "v=spf1 ip4:127.0.0.0/8 -all"
_dmarc                  IN TXT  "v=DMARC1; p=none; rua=mailto:dmarc-rua@example.test"
legacy4408.test.        IN TXT  "v=spf1 foo:bar ip4:127.0.0.0/8 -all"
_25._tcp.mail           IN TLSA 3 0 1 e769ff47e9788f2d2ef0e018355733983a612b6cdade27b023b4e7186d36c13d
_25._tcp.dane-ok.test.  IN TLSA 3 0 1 e769ff47e9788f2d2ef0e018355733983a612b6cdade27b023b4e7186d36c13d
_25._tcp.dane-bad.test. IN TLSA 3 0 1 e769ff47e9788f2d2ef0e018355733983a612b6cdade27b023b4e7186d36c13d
_smtp._tls              IN TXT  "v=TLSRPTv1; rua=mailto:tlsrpt@example.test"
