; BIND zone snippet — RFC 1035 presentation. SPF TXT (RFC 7208), DMARC TXT (RFC 7489).
$ORIGIN example.test.
$TTL 3600
@                       IN TXT  "v=spf1 ip4:127.0.0.0/8 -all"
_dmarc                  IN TXT  "v=DMARC1; p=none; rua=mailto:dmarc-rua@example.test"
legacy4408.test.        IN TXT  "v=spf1 foo:bar ip4:127.0.0.0/8 -all"
