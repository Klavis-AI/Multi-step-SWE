# Postfix 3.8.6 main.cf — keys the stack must honor (postconf(5)).
compatibility_level = 3.8

queue_directory = /app/var/spool/postfix
command_directory = /app/sbin
daemon_directory = /app/libexec/postfix
data_directory = /app/var/lib/postfix
mail_owner = root
default_privs = nobody

myhostname = mail.example.test
mydomain = example.test
myorigin = $mydomain
inet_interfaces = 127.0.0.1
inet_protocols = ipv4

mydestination = localhost, localhost.$mydomain
mynetworks = 127.0.0.0/8
relayhost =

virtual_mailbox_domains = example.test
virtual_mailbox_base = /app/var/mail
virtual_mailbox_maps = texthash:/app/etc/postfix/vmailbox
virtual_uid_maps = static:1000
virtual_gid_maps = static:1000
virtual_minimum_uid = 1000

transport_maps = texthash:/app/etc/postfix/transport

smtpd_banner = $myhostname ESMTP
smtpd_delay_reject = yes
smtpd_helo_required = no
strict_rfc821_envelopes = no
disable_vrfy_command = no
smtpd_reject_unlisted_recipient = yes
local_header_rewrite_clients = permit_mynetworks

message_size_limit = 10240000
mailbox_size_limit = 51200000

maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
minimal_backoff_time = 300s
maximal_backoff_time = 4000s
queue_run_delay = 300s

smtpd_tls_cert_file = /app/etc/ssl/server.certificate
smtpd_tls_key_file = /app/etc/ssl/server.private
