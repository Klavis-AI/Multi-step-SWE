# arch: x86_64
# A member is extracted because of a reference from another member, not only
# because of a reference from a regular object.
rt_obj rt.o
cat > top.c <<'C'
#include "rt.h"
int deep(void);
int top(void) { print("T"); return deep() + 1; }
C
cat > deep.c <<'C'
#include "rt.h"
int deep(void) { print("D"); return 7; }
C
cat > idle.c <<'C'
#include "rt.h"
int idle_member(void) { print("I"); return 9; }
C
cat > m.c <<'C'
int top(void);
int entry(void) { return top(); }
C
cc_obj top.o top.c; cc_obj deep.o deep.c; cc_obj idle.o idle.c; cc_obj m.o m.c
# deep.o sits before top.o, so it can only be reached on a later pass
mkar lib.a deep.o idle.o top.o
link_ok out rt.o m.o lib.a
run_expect out "TD" 8
want "deep was pulled in transitively" "$(symbols out | awk '$8=="deep"' | grep -c .)" "1"
want_not "idle member stayed out" "$(symbols out)" "idle_member"

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh. The floor is the number of counted
# assertions measured on the reference linker at every tag where this case
# passes; it was identical at all of them.
asserts_at_least 2
