# arch: x86_64
# Archives are re-scanned until the undefined set stops shrinking: a chain
# c -> b -> a is resolved even when the archives are listed in exactly the
# wrong order and no --start-group is given.
rt_obj rt.o
cat > a.c <<'C'
#include "rt.h"
int leaf_a(void) { print("a"); return 1; }
C
cat > b.c <<'C'
#include "rt.h"
int leaf_a(void);
int mid_b(void) { print("b"); return leaf_a() + 1; }
C
cat > c.c <<'C'
#include "rt.h"
int mid_b(void);
int top_c(void) { print("c"); return mid_b() + 1; }
C
cat > m.c <<'C'
int top_c(void);
int entry(void) { return top_c(); }
C
cc_obj a.o a.c; cc_obj b.o b.c; cc_obj c.o c.c; cc_obj m.o m.c
mkar liba.a a.o; mkar libb.a b.o; mkar libc.a c.o
link_ok out rt.o m.o liba.a libb.a libc.a
run_expect out "cba" 3
want "all three links of the chain extracted" \
     "$(symbols out | awk '$8=="leaf_a" || $8=="mid_b" || $8=="top_c"' | grep -c .)" "3"

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh. The floor is the number of counted
# assertions measured on the reference linker at every tag where this case
# passes; it was identical at all of them.
asserts_at_least 1
