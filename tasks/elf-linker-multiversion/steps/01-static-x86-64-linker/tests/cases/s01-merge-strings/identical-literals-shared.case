# arch: x86_64
# SHF_MERGE|SHF_STRINGS input sections are deduplicated across objects: the
# same literal in two translation units resolves to one address.
rt_obj rt.o
cat > a.c <<'C'
const char *from_a(void) { return "a literal that appears in both objects"; }
C
cat > b.c <<'C'
const char *from_b(void) { return "a literal that appears in both objects"; }
C
cat > m.c <<'C'
#include "rt.h"
const char *from_a(void); const char *from_b(void);
int entry(void) {
  print(from_a()); print("\n");
  return from_a() == from_b() ? 0 : 1;
}
C
cc_obj a.o a.c; cc_obj b.o b.c; cc_obj m.o m.c
want_has "input section really is SHF_MERGE|SHF_STRINGS" \
       "$(sections a.o)" "\.rodata\.str1\.1 +PROGBITS .* AMS "
link_ok out rt.o a.o b.o m.o
run_expect out "a literal that appears in both objects" 0

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh. The floor is the number of counted
# assertions measured on the reference linker at every tag where this case
# passes; it was identical at all of them.
asserts_at_least 1
