# arch: x86_64
# A named input file that does not exist must be diagnosed and must not yield
# an output. Deliberately NOT asserted: the exit status. Measured across the
# nine reference tags, an input error exits 1 at 0.2.0, *0* at 0.3.0, and 255
# from 0.4.0 on, so `link_fails` here would fail at 0.3.0; what every tag does
# agree on is that the diagnostic names the file and nothing is written to the
# -o path. (Argument-parse errors do exit non-zero at every tag -- see
# s01-output-controls -- which is why those cases may use link_fails.)
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int entry(void) { print("m\n"); return 0; }
C
cc_obj m.o m.c
link out rt.o m.o no-such-input.o
# The diagnostic is read from stderr alone, not from a merged capture: spec/00
# 8 requires diagnostics on stderr and forbids stdout for errors, so a merged
# capture would pass a linker that printed everything on stdout. Measured empty
# on stdout at all nine tags for this condition.
printf '%s\n' "$LINK_ERR" > err.txt
grep -q -- 'no-such-input\.o' err.txt || die "diagnostic does not name the missing input on stderr: $(head -c 300 err.txt)"
want "nothing was printed on stdout" "$LINK_STDOUT" ""
[ -e out ] && die "a failed link left a file at the -o path: $(ls -l out)"
# The same link without the missing input succeeds and runs.
link_ok out2 rt.o m.o
run_expect out2 "m" 0
asserts_at_least 1
