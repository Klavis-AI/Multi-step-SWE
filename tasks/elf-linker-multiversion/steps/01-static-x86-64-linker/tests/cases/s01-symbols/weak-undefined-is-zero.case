# arch: x86_64
# An undefined STB_WEAK reference is not an error: it resolves to address 0,
# for a function symbol and for a data symbol alike.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
extern int absent_weak_fn(void) __attribute__((weak));
extern int absent_weak_data __attribute__((weak));
extern int present_fn(void) __attribute__((weak));
int entry(void) {
  long r = 0;
  if (&absent_weak_fn   != 0) r += 1;
  if (&absent_weak_data != 0) r += 2;
  if (&present_fn       != 0) r += 4;
  if (&present_fn) r += present_fn();
  putdec(r); print("\n");
  return (int)r;
}
C
cat > p.c <<'C'
int present_fn(void) { return 10; }
C
cc_obj m.o m.c; cc_obj p.o p.c
si=$(symbols m.o)
want_has  "absent_weak_fn is WEAK UND"   "$si" "WEAK +DEFAULT +UND +absent_weak_fn"
want_has  "absent_weak_data is WEAK UND" "$si" "WEAK +DEFAULT +UND +absent_weak_data"
link_ok out rt.o p.o m.o
run_expect out "14" 14

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh. The floor is the number of counted
# assertions measured on the reference linker at every tag where this case
# passes; it was identical at all of them.
asserts_at_least 2
