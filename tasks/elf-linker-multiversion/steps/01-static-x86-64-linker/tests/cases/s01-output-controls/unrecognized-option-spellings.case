# arch: x86_64
# The two existing unrecognised-option cases both use a bare `--long-form`.
# This one covers the other two spellings a driver emits: a single-letter short
# option and a `--long=value` form, which take different parse paths. Measured:
# argument-parse errors exit non-zero at all nine tags (1 early, 255 from
# 0.4.0), so the status may be graded here -- but only as non-zero, never as a
# value, and never the message prefix, which changes at 0.6.0.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int entry(void) { print("s\n"); return 0; }
C
cc_obj m.o m.c
for opt in -Q --bogus-option=value; do
  rm -f out
  link out rt.o m.o "$opt"
  [ "$LINK_RC" -eq 0 ] && die "unknown option '$opt' was accepted silently"
  # stderr only -- spec/00 8's routing rule; measured empty on stdout at all
  # nine tags for both spellings.
  printf '%s\n' "$LINK_ERR" > err.txt
  grep -qF -- "$opt" err.txt || die "the diagnostic for '$opt' does not name it on stderr: $(head -c 300 err.txt)"
  want "nothing was printed on stdout for '$opt'" "$LINK_STDOUT" ""
  [ -e out ] && die "the rejected link left a file at the -o path for '$opt'"
done
link_ok out2 rt.o m.o
run_expect out2 "s" 0
asserts_at_least 2
