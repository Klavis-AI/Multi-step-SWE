# arch: x86_64
# An option the grader does not name must be a diagnosed error, not a silent
# success (TEST_INTERFACE.md #2), and a failed link must not leave a file at
# the -o path that looks like a successful output.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int entry(void) { print("q\n"); return 0; }
C
cc_obj m.o m.c
link_fails out rt.o m.o --totally-bogus-option
# stderr only -- spec/00 8: "Diagnostics go to stderr ... stdout MUST NOT be
# used for errors". Measured: stdout is empty at all nine tags here.
printf '%s\n' "$LINK_ERR" > err.txt
grep -q -- '--totally-bogus-option' err.txt || die "diagnostic does not name the offending option on stderr: $(cat err.txt)"
want "nothing was printed on stdout" "$LINK_STDOUT" ""
[ -e out ] && die "a failed link left a file at the -o path: $(ls -l out)"
# The identical link without the bogus option succeeds and runs.
link_ok out2 rt.o m.o
run_expect out2 "q" 0
asserts_at_least 1
