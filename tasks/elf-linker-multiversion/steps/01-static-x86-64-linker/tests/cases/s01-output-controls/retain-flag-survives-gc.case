# arch: x86_64
# SHF_GNU_RETAIN (0x200000, the `R` section flag) makes a section a garbage
# collection root that survives --gc-sections even though nothing refers to it
# (spec/00 section 6 rule 2). .droppable is the control: it is identical except
# for the flag, is equally unreferenced, and must be collected -- without it a
# linker that simply ignores --gc-sections would pass.
# Measured at all nine tags: .retained present with flags AR, .droppable gone.
rt_obj rt.o
cat > s.s <<'S'
	.section .retained,"aR",@progbits
	.globl retained_datum
retained_datum:
	.quad 0x5a
	.section .droppable,"a",@progbits
	.globl droppable_datum
droppable_datum:
	.quad 0x5b
	.section .note.GNU-stack,"",@progbits
S
as_obj s.o s.s
cat > m.c <<'C'
#include "rt.h"
int entry(void) { print("r\n"); return 0; }
C
cc_obj m.o m.c
link_ok out rt.o m.o s.o --gc-sections
has_section out '\.retained' || die "the SHF_GNU_RETAIN section was collected: $(sections out | tr '\n' ' ' | head -c 300)"
has_section out '\.droppable' && die "the unreferenced control section survived --gc-sections, so this case proves nothing"
run_expect out "r" 0
