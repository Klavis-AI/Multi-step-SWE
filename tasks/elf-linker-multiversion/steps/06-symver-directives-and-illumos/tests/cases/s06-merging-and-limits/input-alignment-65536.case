# arch: x86_64
# An input section with sh_addralign 2^16 must be honoured: the output section
# lands on a 64K boundary and the LOAD segment that carries it is aligned to
# at least 64K too.
rt_obj rt.o
cat > a.s <<'S'
        .section .bigalign,"aw",@progbits
        .p2align 16
        .globl big_obj
big_obj:
        .quad 0x1234
        .section .note.GNU-stack,"",@progbits
S
as_obj a.o a.s
cat > m.c <<'C'
#include "rt.h"
extern long big_obj;
int entry(void) {
    unsigned long a = (unsigned long) &big_obj;
    if (a & 0xffff) { print("misaligned\n"); return 1; }
    if (big_obj != 0x1234) { print("clobbered\n"); return 2; }
    print("ok\n");
    return 42;
}
C
cc_obj m.o m.c
link_ok out --no-gc-sections rt.o a.o m.o

secs=$(sections out)
want_has ".bigalign kept sh_addralign 65536" "$secs" '\.bigalign +PROGBITS( +[0-9a-f]+){4} +WA( +[0-9]+){2} +65536'
addr=$(sec_addr out .bigalign)
[ -n "$addr" ] || die "no .bigalign in output: $secs"
want ".bigalign address is 64K aligned" "$(( 16#$addr % 65536 ))" "0"
want "big_obj sits at the start of .bigalign" "$(sym_value out big_obj)" "$addr"

# The LOAD segment that *contains* .bigalign must be aligned to at least 64K.
# Select it by containment, never by matching a segment start: spec/00 §5
# honours the alignment by growing the segment that already holds the section,
# not by giving the section a segment of its own, so the containing segment
# normally starts earlier than the section.  (mawk has no strtonum; bash
# arithmetic reads the printed 0x-prefixed hex directly.)
a=$(( 0x$addr ))
segalign=
while read -r v m al; do
  [ "$a" -ge "$((v))" ] && [ "$a" -lt "$(( v + m ))" ] && segalign=$al
done < <(segments out | awk '$1 == "LOAD" { print $3, $6, $NF }')
[ -n "$segalign" ] || die "no LOAD segment contains .bigalign at 0x$addr: $(segments out)"
[ "$(( segalign ))" -ge 65536 ] || die "LOAD align is $segalign, want >= 0x10000"
run_expect out "ok" 42

asserts_at_least 3
