# arch: x86_64
# "world" may share storage with the tail of "hello world": a symbol that lands
# part way into a mergeable string must resolve to that interior address and
# still read back as a valid C string at run time.
rt_obj rt.o
cat > s.s <<'S'
        .section .rodata.str1.1,"aMS",@progbits,1
        .globl s_long
s_long: .asciz "hello world"
        .globl s_short
        .set s_short, s_long + 6
        .section .note.GNU-stack,"",@progbits
S
as_obj s.o s.s
cat > m.c <<'C'
#include "rt.h"
extern char s_long[], s_short[];
int entry(void) {
    print(s_long); print("\n");
    print(s_short); print("\n");
    return (int)(s_short - s_long);
}
C
cc_obj m.o m.c
link_ok out rt.o s.o m.o

lo=$(sym_value out s_long); sh=$(sym_value out s_short)
[ -n "$lo" ] && [ -n "$sh" ] || die "missing symbols: $(symbols out)"
want "s_short is the tail of s_long" "$(( 16#$sh - 16#$lo ))" "6"
# Exactly one copy of the text: 12 bytes for "hello world\0", not 18.
merged=$(sec_size out .rodata)
[ -z "$merged" ] || [ "$(( 16#$merged ))" -lt 24 ] \
  || die ".rodata is $((16#$merged)) bytes, too big for one shared copy"
# The bytes really are one string with the short one inside it: read the file
# at s_long's own file offset and confirm both reads come out of that copy.
off=$(sections out | awk '{ for (i=1;i<=NF;i++) if ($i == ".rodata") { print $(i+3); exit } }')
[ -n "$off" ] || die "no .rodata in output: $(sections out)"
base=$(( 16#$off + 16#$lo - 16#$(sec_addr out .rodata) ))
dd if=out of=long.bin bs=1 skip="$base" count=11 status=none
dd if=out of=short.bin bs=1 skip=$(( base + 6 )) count=5 status=none
want "s_long reads back" "$(cat long.bin)" "hello world"
want "s_short is inside it" "$(cat short.bin)" "world"
run_expect out "hello world
world" 6

# A second link with two ordinary mergeable strings, one of them duplicated
# across two objects. The only thing asserted about storage is that the two
# copies of the identical literal ended up at one address; every other check is
# a read-back, so nothing here depends on which strings the linker chose to
# overlap.
cat > p.s <<'S'
        .section .rodata.str1.1,"aMS",@progbits,1
        .globl p_dup
p_dup:  .asciz "alpha"
        .globl p_own
p_own:  .asciz "one"
        .section .note.GNU-stack,"",@progbits
S
cat > q.s <<'S'
        .section .rodata.str1.1,"aMS",@progbits,1
        .globl q_dup
q_dup:  .asciz "alpha"
        .globl q_own
q_own:  .asciz "two"
        .section .note.GNU-stack,"",@progbits
S
as_obj p.o p.s
as_obj q.o q.s
cat > m2.c <<'C'
#include "rt.h"
extern char p_dup[], p_own[], q_dup[], q_own[];
int entry(void) {
    print(p_dup); print("\n");
    print(p_own); print("\n");
    print(q_dup); print("\n");
    print(q_own); print("\n");
    return 0;
}
C
cc_obj m2.o m2.c
link_ok out2 rt.o p.o q.o m2.o
want "the duplicated literal has a single address" \
     "$(sym_value out2 p_dup)" "$(sym_value out2 q_dup)"
[ "$(sym_value out2 p_own)" != "$(sym_value out2 q_own)" ] \
  || die "distinct strings 'one' and 'two' share an address"
run_expect out2 "alpha
one
alpha
two" 0

asserts_at_least 4
