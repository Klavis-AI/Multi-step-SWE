# arch: x86_64
# A VERSION { ... } block inside a -T linker script must produce exactly the
# dynamic symbols and version records that --version-script would. Then the
# other two routes of spec/12 s1: the same node list handed to -T *unwrapped*
# is a linker-script syntax error, and a second --version-script replaces the
# first rather than merging with it.
cat > s.c <<'C'
int pub_one(int x) { return x + 1; }
int pub_two(int x) { return x + 2; }
int helper_a(int x) { return x + 3; }
C
cc_obj s.o s.c -fPIC
cat > vs.txt <<'V'
LIBX_1.0 { global: pub_one; pub_two; local: *; };
V
cat > t.ld <<'L'
VERSION {
  LIBX_1.0 { global: pub_one; pub_two; local: *; };
}
L
link_ok fromopt.so -shared -soname libx.so.1 --version-script=vs.txt s.o
link_ok fromscript.so -shared -soname libx.so.1 -T t.ld s.o

ds=$(dynsyms fromscript.so)
want_has "pub_one versioned by the script block" "$ds" 'pub_one@@LIBX_1\.0$'
want_has "pub_two versioned by the script block" "$ds" 'pub_two@@LIBX_1\.0$'
want_not "local: * still hides helper_a" "$ds" 'helper_a'
vn=$(vernum fromscript.so)
want_has "version_d defines LIBX_1.0" "$vn" 'Name: LIBX_1\.0'
want_has ".gnu.version_d emitted" "$(sections fromscript.so)" '\.gnu\.version_d +VERDEF'

# Same result, option vs. script -- addresses aside.
norm_ver() { vernum "$1" | grep -v '^ Addr:'; }
norm_dyn() { dynsyms "$1" | awk '{ $2 = "-"; print }'; }
a=$(norm_ver fromscript.so); b=$(norm_ver fromopt.so)
[ "$a" = "$b" ] || die "VERSION block and --version-script disagree on version records:
--- -T VERSION ---
$a
--- --version-script ---
$b"
a=$(norm_dyn fromscript.so); b=$(norm_dyn fromopt.so)
[ "$a" = "$b" ] || die "VERSION block and --version-script disagree on .dynsym:
--- -T VERSION ---
$a
--- --version-script ---
$b"

# spec/12 s1, third route: a version script named as the ONLY -T script is
# parsed as a LINKER script, so an unwrapped node list is a syntax error rather
# than a version script. Reject + a non-empty diagnostic is all that is graded;
# the reference names only a line/column, so the wording is not asserted.
link_fails bare.so -shared -soname libx.so.1 -T vs.txt s.o
want_has "a bare node list as the only -T script is diagnosed" "$LINK_ERR" '.'
want "a rejected link leaves no output at the -o path" \
     "$([ -e bare.so ] && echo present || echo absent)" absent

# spec/12 s1: a second --version-script REPLACES the first; the earlier script
# is discarded, not merged into it.
cat > vs2.txt <<'V'
LIBY_2.0 { global: pub_two; local: *; };
V
link_ok two.so -shared -soname libx.so.1 --version-script=vs.txt --version-script=vs2.txt s.o
ds2=$(dynsyms two.so)
want_has "the last --version-script is the one in effect" "$ds2" 'pub_two@@LIBY_2\.0$'
want_not "the first script's node is discarded, not merged" "$ds2" 'LIBX_1\.0'
want_not "pub_one, global only in the discarded script, is now local" "$ds2" 'pub_one'
want_not "no version record survives from the discarded script" "$(vernum two.so)" 'Name: LIBX_1\.0'

asserts_at_least 11
