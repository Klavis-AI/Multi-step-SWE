-    let
-      pkgs = import nixpkgs {
-        system = "x86_64-linux";
-        overlays = [
-          (import wild)
-        ];
-      };
-
-      wildStdenv = pkgs.useWildLinker pkgs.stdenv;
-    in
-    {
