# arch: x86_64
# --whole-archive extracts every member of the archives that follow it, even
# ones no undefined symbol asks for; --no-whole-archive puts later archives
# back on lazy extraction. Graded with --no-gc-sections, since wild garbage
# collects sections by default.
# NOTE: inspection output is dumped to a file and grepped there, so that no
# assertion rides on the exit status of a pipeline ending in `grep -q`.
rt_obj rt.o
cat > a.c <<'C'
#include "rt.h"
int used(void) { print("A"); return 1; }
C
cat > b.c <<'C'
#include "rt.h"
int never_referenced(void) { print("B"); return 2; }
C
cat > c.c <<'C'
#include "rt.h"
int lazy_member(void) { print("C"); return 3; }
C
cat > m.c <<'C'
#include "rt.h"
int used(void);
int entry(void) { return used(); }
C
cc_obj a.o a.c; cc_obj b.o b.c; cc_obj c.o c.c; cc_obj m.o m.c
mkar libx.a a.o b.o
mkar liby.a c.o
link_ok whole rt.o m.o --whole-archive libx.a --no-whole-archive liby.a --no-gc-sections
symbols whole > w.txt
grep -q ' used$'             w.txt || die "the referenced member was not extracted: $(cat w.txt)"
grep -q ' never_referenced$' w.txt || die "--whole-archive did not extract the unreferenced member"
! grep -q ' lazy_member$'    w.txt || die "--no-whole-archive did not restore lazy extraction"
run_expect whole "A" 1
# Without --whole-archive the same archive contributes only what is needed.
link_ok lazy rt.o m.o libx.a liby.a --no-gc-sections
symbols lazy > l.txt
grep -q ' used$'              l.txt || die "the referenced member was not extracted: $(cat l.txt)"
! grep -q ' never_referenced$' l.txt || die "an unreferenced member was extracted without --whole-archive"
! grep -q ' lazy_member$'      l.txt || die "an unreferenced member was extracted without --whole-archive"
run_expect lazy "A" 1
