# arch: aarch64
# R_AARCH64_CALL26 (bl) and R_AARCH64_JUMP26 (b) to symbols in other objects
# must be encoded as the correct 26-bit word-scaled PC-relative displacement.
rt_obj rt.o
cat > leaf.s <<'S'
        .text
        .globl leaf
leaf:   mov     w0, #41
        add     w0, w0, #1
        ret
        .section .note.GNU-stack,"",@progbits
S
cat > tail.s <<'S'
        .text
        .globl tail
tail:   b       leaf
        .section .note.GNU-stack,"",@progbits
S
cat > call.s <<'S'
        .text
        .globl callit
callit: stp     x29, x30, [sp, #-16]!
        bl      tail
        ldp     x29, x30, [sp], #16
        ret
        .section .note.GNU-stack,"",@progbits
S
cat > m.c <<'C'
#include "rt.h"
int callit(void);
int entry(void) { putdec(callit()); return 0; }
C
as_obj leaf.o leaf.s; as_obj tail.o tail.s; as_obj call.o call.s; cc_obj m.o m.c
relocs call.o > call.rel; relocs tail.o > tail.rel
grep -qE 'R_AARCH64_CALL26 +0+ tail$|R_AARCH64_CALL26 .* tail \+ 0' call.rel \
  || die "input lacks a CALL26 against tail: $(cat call.rel)"
grep -qE 'R_AARCH64_JUMP26 .* leaf \+ 0' tail.rel \
  || die "input lacks a JUMP26 against leaf: $(cat tail.rel)"
link_ok out rt.o call.o m.o tail.o leaf.o
$OBJDUMP -d --no-show-raw-insn out > dis.txt
tailaddr=$(sym_value out tail); leafaddr=$(sym_value out leaf)
[ -n "$tailaddr" ] && [ -n "$leafaddr" ] \
  || die "tail/leaf missing from the output symbol table"
# readelf prints st_value zero-padded to 16 digits, objdump prints the branch
# target with no leading zeros, and where the image is loaded is a layout
# choice no document fixes for AArch64.  Normalise both sides to the shortest
# lowercase hex form rather than stripping a fixed number of zeros.
tailx=$(printf '%x' $((0x$tailaddr))); leafx=$(printf '%x' $((0x$leafaddr)))
grep -qE "	bl	0x$tailx <tail>" dis.txt \
  || die "bl in callit does not land on tail (0x$tailx)"
grep -qE "	b	0x$leafx <leaf>" dis.txt \
  || die "b in tail does not land on leaf (0x$leafx)"
run_expect out "42" 0
