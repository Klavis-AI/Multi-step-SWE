-                }
-                _ => Ok(vec![InputBytes {
-                    input: InputRef {
-                        file: f,
-                        entry: None,
-                    },
-                    kind: f.kind,
-                    data: f.data(),
-                    modifiers: f.modifiers,
-                }]),
-            }
-        })
