+fn host_dynamic_linker_cached() -> &'static str {
+    static VALUE: OnceLock<String> = OnceLock::new();
+    let value = VALUE.get_or_init(|| {
+        ["/bin/true", "/bin/ls", "/usr/bin/ls", "/proc/self/exe"]
+            .into_iter()
+            .find_map(get_dynamic_linker)
