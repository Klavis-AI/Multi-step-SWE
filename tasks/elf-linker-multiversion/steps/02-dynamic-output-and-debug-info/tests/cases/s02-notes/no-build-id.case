# arch: x86_64
# spec/06 §8: "no build ID shall be present unless --build-id was given".
# The requirement is an if-and-only-if, so both halves are checked here from
# one pair of inputs that differ only in the option: with --build-id the note
# and its PT_NOTE appear, without it neither does.
#
# The control half is what makes this a real check. Asserting the absence
# alone passes on any linker that never emits a build id at all -- which is
# exactly what the previous milestone does.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int entry(void) { return 0; }
C
cc_obj m.o m.c
# Control: given the option, the note really is produced from these inputs.
link_ok with --build-id=0x00112233445566778899aabbccddeeff rt.o m.o
want_has "control: --build-id emits the section" \
  "$(sections with)" '[[:space:]]\.note\.gnu\.build-id[[:space:]]+NOTE'
want_has "control: and a PT_NOTE to carry it" "$(segments with)" '^ *NOTE +0x'
# The requirement: same inputs, option withheld.
link_ok out rt.o m.o
want_not "no build-id section without --build-id" \
  "$(sections out)" '\.note\.gnu\.build-id'
want_not "readelf finds no build id either" "$(notes out)" 'Build ID'
want_not "and no PT_NOTE was created for a note that does not exist" \
  "$(segments out)" '^ *NOTE +0x'
# Withholding the option must not cost anything else.
want "the link still produces an executable" \
  "$(hdr out | awk '/^ *Type:/{print $2}')" "EXEC"
asserts_at_least 6
