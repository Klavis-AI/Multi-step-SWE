# arch: x86_64
# .note.gnu.property inputs are combined with the AND semantics the x86 feature
# word requires, and re-emitted as one 8-aligned, well-formed note in PT_NOTE.
wre() { ASSERTS_RUN=$((ASSERTS_RUN + 1)); grep -qE -- "$3" <<<"$2" || die "$1: no /$3/ in ${2:0:400}"; }
secbytes() { local o s
  o=$(sections "$1" | awk -v n="$2" '{ for (i=1;i<=NF;i++) if ($i==n) { print $(i+3) } }' | sed -n 1p)
  s=$(sections "$1" | awk -v n="$2" '{ for (i=1;i<=NF;i++) if ($i==n) { print $(i+4) } }' | sed -n 1p)
  [ -n "$o" ] || die "output has no $2 section: $(sections "$1")"
  dd if="$1" of="$3" bs=1 skip=$(( 16#$o )) count=$(( 16#$s )) status=none
}
u32at() { od -An -tx4 -j "$2" -N 4 "$1" | tr -d ' \n'; }
prop() { cat > "$1.s" <<S
        .text
        .globl $2
$2:     xor     %eax, %eax
        ret
        .section .note.gnu.property,"a",@note
        .align 8
        .long 4
        .long 16
        .long 5
        .asciz "GNU"
        .long 0xc0000002
        .long 4
        .long $3
        .long 0
        .section .note.GNU-stack,"",@progbits
S
as_obj "$1.o" "$1.s"; }
prop pa _start 7
prop pb helper 3
link_ok out pa.o pb.o
wre ".note.gnu.property exists" "$(sections out)" '[[:space:]]\.note\.gnu\.property[[:space:]]+NOTE'
want "section align" "$(sections out | awk '{ for (i=1;i<=NF;i++) if ($i==".note.gnu.property") print $NF }' | sed -n 1p)" "8"
want "section size" "$(( 16#$(sec_size out .note.gnu.property) ))" "32"
secbytes out .note.gnu.property p.bin
want "n_namesz" "$(u32at p.bin 0)"  "00000004"
want "n_descsz" "$(u32at p.bin 4)"  "00000010"
want "n_type NT_GNU_PROPERTY_TYPE_0" "$(u32at p.bin 8)" "00000005"
want "namespace" "$(dd if=p.bin bs=1 skip=12 count=3 status=none)" "GNU"
want "pr_type GNU_PROPERTY_X86_FEATURE_1_AND" "$(u32at p.bin 16)" "c0000002"
want "pr_datasz" "$(u32at p.bin 20)" "00000004"
# 7 AND 3 == 3 (IBT|SHSTK); an OR or a last-one-wins merge would give 7.
want "feature word is the AND of the inputs" "$(u32at p.bin 24)" "00000003"
wre "readelf agrees" "$(notes out)" 'x86 feature: IBT, SHSTK'
SEG=$(segments out)
wre "PT_NOTE" "$SEG" '^ *NOTE +0x'
want "PT_NOTE align" "$(awk '/^ *NOTE /{print $NF}' <<<"$SEG")" "0x8"
want "PT_NOTE filesz" "$(( $(awk '/^ *NOTE /{print $5}' <<<"$SEG") ))" "32"
want "PT_NOTE memsz == filesz" "$(( $(awk '/^ *NOTE /{print $6}' <<<"$SEG") ))" "32"
# Assertion floor: the number of assertions this case actually executed on
# the reference, measured at every checkpoint from this milestone up. A
# `want` whose arguments hit an arithmetic or expansion error is aborted by
# the shell and never runs -- it does not fail, it vanishes. Without this
# line such a case reports `ok` having checked nothing.
asserts_at_least 15
