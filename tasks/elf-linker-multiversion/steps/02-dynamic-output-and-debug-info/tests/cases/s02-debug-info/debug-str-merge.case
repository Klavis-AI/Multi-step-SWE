# arch: x86_64
# .debug_str from several objects is merged with duplicate strings shared, and
# each .debug_info offset still names the string that object asked for.
wre() { ASSERTS_RUN=$((ASSERTS_RUN + 1)); grep -qE -- "$3" <<<"$2" || die "$1: no /$3/ in ${2:0:400}"; }
secbytes() { local o s
  o=$(sections "$1" | awk -v n="$2" '{ for (i=1;i<=NF;i++) if ($i==n) { print $(i+3) } }' | sed -n 1p)
  s=$(sections "$1" | awk -v n="$2" '{ for (i=1;i<=NF;i++) if ($i==n) { print $(i+4) } }' | sed -n 1p)
  [ -n "$o" ] || die "output has no $2 section: $(sections "$1")"
  dd if="$1" of="$3" bs=1 skip=$(( 16#$o )) count=$(( 16#$s )) status=none
}
u64at() { od -An -tx8 -j "$2" -N 8 "$1" | tr -d ' \n'; }
strat() { dd if="$1" bs=1 skip="$2" status=none | tr '\0' '\n' | sed -n 1p; }
rt_obj rt.o
gen() { cat > "$1.s" <<S
        .text
        .globl $2
$2:     ret
        .section .debug_str,"MS",@progbits,1
p_$2:   .asciz "shared_string_XYZ"
q_$2:   .asciz "$3"
        .section .debug_info,"",@progbits
        .quad   p_$2
        .quad   q_$2
        .section .note.GNU-stack,"",@progbits
S
as_obj "$1.o" "$1.s"; }
gen a fa only_in_one
gen b fb only_in_two
cat > m.c <<'C'
#include "rt.h"
int entry(void) { return 0; }
C
cc_obj m.o m.c
link_ok out rt.o m.o a.o b.o
wre ".debug_str survives"  "$(sections out)" '[[:space:]]\.debug_str[[:space:]]'
wre ".debug_info survives" "$(sections out)" '[[:space:]]\.debug_info[[:space:]]'
secbytes out .debug_str ds.bin
secbytes out .debug_info di.bin
# 18 + 12 + 12 bytes: the duplicate is stored once, not twice.
want ".debug_str is deduplicated" "$(wc -c < ds.bin)" "42"
want ".debug_info holds four offsets" "$(wc -c < di.bin)" "32"
want "object a, string 0" "$(strat ds.bin $(( 16#$(u64at di.bin 0)  )))" "shared_string_XYZ"
want "object a, string 1" "$(strat ds.bin $(( 16#$(u64at di.bin 8)  )))" "only_in_one"
want "object b, string 0" "$(strat ds.bin $(( 16#$(u64at di.bin 16) )))" "shared_string_XYZ"
want "object b, string 1" "$(strat ds.bin $(( 16#$(u64at di.bin 24) )))" "only_in_two"
want "both objects point at the same copy" "$(u64at di.bin 0)" "$(u64at di.bin 16)"
want "each string appears once" "$(grep -c . <(tr '\0' '\n' < ds.bin))" "3"
# Assertion floor: the number of assertions this case actually executed on
# the reference, measured at every checkpoint from this milestone up. A
# `want` whose arguments hit an arithmetic or expansion error is aborted by
# the shell and never runs -- it does not fail, it vanishes. Without this
# line such a case reports `ok` having checked nothing.
asserts_at_least 10
