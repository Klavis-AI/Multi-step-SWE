+fn write_copy_relocation_dynamic_symbol_definition<S: StorageModel>(
+    sym_def: &crate::layout::DynamicSymbolDefinition,
+    object: &DynamicLayout,
+    layout: &Layout<S>,
+    dynamic_symbol_writer: &mut SymbolTableWriter,
+) -> Result {
