+                } else {
+                    tracing_subscriber::registry()
+                        .with(fmt::layer())
+                        .with(EnvFilter::from_default_env())
+                        .init();
+                }
+                link::<storage::InMemory, x86_64::X86_64>(args, done_closure)
+            }
+            args::Action::Version => {
