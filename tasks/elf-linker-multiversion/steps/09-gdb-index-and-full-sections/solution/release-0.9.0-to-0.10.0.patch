+fn ensure_stack_size_aligned(stack_size: u32) -> Result {
+    let align = crate::alignment::STACK_ALIGNMENT.value();
+    ensure!(
+        u64::from(stack_size).is_multiple_of(align),
+        "stack size must be {align}-byte aligned"
