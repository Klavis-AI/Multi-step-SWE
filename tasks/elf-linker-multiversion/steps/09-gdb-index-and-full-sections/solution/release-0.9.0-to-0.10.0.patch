+fn finalize_name_map(entries: &mut [(u32, &str)]) -> Option<NameMap> {
+    if entries.is_empty() {
+        return None;
+    }
+    entries.sort_by_key(|(a, _)| *a);
+    let mut map = NameMap::new();
+    let mut last_idx = None;
+    for &(idx, name) in entries.iter() {
+        if last_idx == Some(idx) {
+            continue;
+        }
+        last_idx = Some(idx);
+        map.append(idx, name);
+    }
+    Some(map)
