+//#DiffIgnore:.dynamic.DT_FLAGS_1.NOW
+.globl _start
+_start:
+    .byte 0x66
+    leaq tlsvar@tlsgd(%rip), %rdi
+    .byte 0x66
+    .byte 0x48
+    call *__tls_get_addr@GOTPCREL(%rip)
+    ret
