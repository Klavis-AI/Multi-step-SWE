+    start_of_sections = .;
+    .text : {
+        *(.text*)
+    } :text
+
+    .data : {
+        *(.data*)
+    } :data
+
+    .bss : {
+        *(.bss*)
+    }
+
+    .custom : {
+        *(.custom)
+    } :NONE
+
+    .dynamic : {
+        *(.dynamic)
+    } :rodata :dynamic
+
+    .rodata : {
+        *(.rodata*)
+    } :rodata :NONE
+}
+
