+fn remap_wasm_index(indices: &[u32], index: u32, kind: &str) -> Result<u32> {
+    indices
+        .get(index as usize)
+        .copied()
+        .ok_or_else(|| crate::error!("Wasm {kind} index {index} out of range"))
+}
