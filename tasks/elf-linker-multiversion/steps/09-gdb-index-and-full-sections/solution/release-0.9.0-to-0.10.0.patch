+++ b/wild/tests/sources/elf/script-sort/script-sort.ld
@@ -0,0 +1,24 @@
+ENTRY(_start)
+
+SECTIONS
+{
+    . = 0x401000;
+
+    .text : {
+        *(.text)
+        
+        *(SORT(.text.sort.*))
+        KEEP(*(SORT(.text.kept.*)))
+        *(SORT_BY_NAME(.text.drop.*))
+        *(SORT_BY_ALIGNMENT(.text.align.*))
+    }
+
+    /* Ensure valid alignment for subsequent sections */
+
