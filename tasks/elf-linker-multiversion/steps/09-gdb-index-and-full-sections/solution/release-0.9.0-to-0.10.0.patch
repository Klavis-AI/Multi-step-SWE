diff --git a/wild/tests/sources/wasm/stack-first/stack-first.c b/wild/tests/sources/wasm/stack-first/stack-first.c
new file mode 100644
index 00000000..cc376da5
--- /dev/null
+++ b/wild/tests/sources/wasm/stack-first/stack-first.c
@@ -0,0 +1,28 @@
+//#LinkArgs: -z stack-size=1048576 --stack-first
+
+int payload[8] = {1, 2, 3, 4, 5, 6, 7, 8};
+
+extern char __data_end;
+extern char __heap_base;
+
+void _start(void) {
+  unsigned long data_end = (unsigned long)&__data_end;
+  unsigned long heap_base = (unsigned long)&__heap_base;
+  unsigned long stack_size = 1048576;
+
+  // With --stack-first, static data starts at stack_size.
+  if (data_end <= stack_size) {
+    __builtin_trap();
+  }
+  // Heap immediately follows data (at most 16-byte alignment padding).
+  if (heap_base < data_end || heap_base > data_end + 16) {
+    __builtin_trap();
+  }
+  // payload must be reachable inside the data region.
+  if ((unsigned long)&payload[0] < stack_size) {
+    __builtin_trap();
+  }
+  if (payload[0] != 1 || payload[7] != 8) {
+    __builtin_trap();
+  }
+}
diff --git a/wild/tests/sources/wasm/stack-size/stack-size.c b/wild/tests/sources/wasm/stack-size/stack-size.c
new file mode 100644
index 00000000..3b0f4ff3
--- /dev/null
+++ b/wild/tests/sources/wasm/stack-size/stack-size.c
@@ -0,0 +1,30 @@
+//#Config:stack-size
+//#CompArgs:-DNO_STACK_FIRST
+//#LinkArgs: -z stack-size=1048576 --no-stack-first
+//#RequiresLinkerFlags: --no-stack-first
+
+//#Config:stack-first
+//#LinkArgs: -z stack-size=1048576 --stack-first
+
+//#Config:invalid-stack-size
+//#LinkArgs:-z stack-size=3
+//#ExpectError: stack size must be 16-byte aligned
+
+extern char __data_end;
+extern char __heap_base;
+
+void _start(void) {
+  unsigned long data_end = (unsigned long)&__data_end;
+  unsigned long heap_base = (unsigned long)&__heap_base;
+
+#ifdef NO_STACK_FIRST
+  unsigned long stack_base = (data_end + 15) & ~15UL;
+  if (heap_base != stack_base + 1048576) {
+    __builtin_trap();
+  }
+#else
+  if (heap_base < 1048576 || data_end < 1048576) {
+    __builtin_trap();
+  }
+#endif
+}
