+fn parse_number(s: &str) -> Result<u64> {
+    if let Some(hex) = s.strip_prefix("0x") {
+        return Ok(u64::from_str_radix(hex, 16)?);
+    }
+
+    if s.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Ok(s.parse()?);
+    }
+
+    bail!("Failed to parse `{s}` as a number");
