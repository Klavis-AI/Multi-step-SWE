+                            Box::new(Expression::Number(0xFF)),
+                        )
+                    );
+                } else {
+                    panic!("Expected Equal at top level");
+                }
+            }
+            _ => panic!("Expected Assert command"),
+        }
+    }
+
+    #[test]
