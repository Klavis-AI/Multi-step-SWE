+pub(crate) fn convert_elf_visibility(st_visibility: u8) -> Visibility {
+    match st_visibility {
+        object::elf::STV_PROTECTED => Visibility::Protected,
+        object::elf::STV_HIDDEN => Visibility::Hidden,
+        _ => Visibility::Default,
+    }
+}
