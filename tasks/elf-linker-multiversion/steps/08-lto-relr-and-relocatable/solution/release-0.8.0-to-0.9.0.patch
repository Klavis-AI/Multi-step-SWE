+    }
+
+    fn get_dtv_offset() -> u64 {
+        RISCV_TLS_DTV_OFFSET
+    }
+
+    fn tp_offset_start(layout: &crate::layout::Layout<Elf>) -> u64 {
+        layout.tls_start_address()
+    }
+
+    fn get_property_class(_property_type: u32) -> Option<crate::elf::PropertyClass> {
+        None
