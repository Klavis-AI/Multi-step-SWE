+        got_address: u64,
+        plt_address: u64,
+    ) -> crate::error::Result {
+        // TODO: For simplicity, we assume now the PLT entry precedes the GOT entry, so we can
+        // make the offset calculation in the unsigned type.
+        debug_assert!(plt_address < got_address);
