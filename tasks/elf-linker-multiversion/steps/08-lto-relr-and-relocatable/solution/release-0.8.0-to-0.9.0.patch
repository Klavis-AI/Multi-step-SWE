+            FileKind::Archive => "archive",
+            FileKind::ThinArchive => "thin archive",
+            FileKind::Text => "text",
+            FileKind::LlvmIr => "LLVM-IR",
+            FileKind::GccIr => "GCC-IR",
+        };
+        std::fmt::Display::fmt(s, f)
+    }
 }
