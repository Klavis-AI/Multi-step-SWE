+
+const PLT_ENTRY_TEMPLATE: &[u8] = &[
+    0x17, 0x0e, 0x0, 0x0, // auipc t3,offset_high(&(.got.plt[n])
+    0x03, 0x3e, 0x0e, 0x0, // ld t3,offset_low(&(.got.plt[n])(t3)
+    0x67, 0x03, 0x0e, 0x0, // jalr t1,t3
+    0x73, 0x0, 0x10, 0x0, // ebreak
+];
