+        PageMask::GotEntryAndPosition(mask) => PageMaskValue {
+            got_entry: !mask,
+            place: !mask,
+            ..Default::default()
+        },
+        PageMask::GotBase(mask) => PageMaskValue {
+            got: !mask,
+            ..Default::default()
+        },
+        PageMask::Position(mask) => PageMaskValue {
+            place: !mask,
+            ..Default::default()
+        },
+    }
+}
