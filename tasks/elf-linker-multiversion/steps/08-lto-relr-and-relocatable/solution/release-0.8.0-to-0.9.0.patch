+            common: CommonArgs::from_env()?,
+            ..Default::default()
+        })
+    }
+
+    pub(crate) fn is_relr_enabled(&self) -> bool {
+        self.z_pack_relative_relocs
+            || self.pack_dyn_relocs == PackDynRelocs::Relr
+            || self.pack_dyn_relocs == PackDynRelocs::AndroidRelr
+    }
