# arch: loongarch64
# The LoongArch64 backend must accept -m elf64loongarch and produce a runnable
# static ET_EXEC for EM_LOONGARCH with e_entry at _start.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int entry(void) { print("loongarch64-ok\n"); putdec(1234567); return 7; }
C
cc_obj m.o m.c
link_ok out rt.o m.o
hdr out > h.txt
want "e_type"  "$(awk '/^ *Type:/{print $2}' h.txt)"  "EXEC"
want "e_class" "$(awk '/^ *Class:/{print $2}' h.txt)" "ELF64"
grep -qE 'Machine: +LoongArch' h.txt || die "e_machine is not LoongArch: $(grep -i machine h.txt)"
start=$(sym_value out _start)
[ -n "$start" ] || die "_start has no value in the output"
want "e_entry == _start" "$(( $(awk '/Entry point address:/{print $NF}' h.txt) ))" "$((0x$start))"
# A static executable must carry no dynamic section and no interpreter.
want_not "no PT_INTERP in a static link" "$(segments out)" 'INTERP'
want_not "no PT_DYNAMIC in a static link" "$(segments out)" 'DYNAMIC'
run_expect out "loongarch64-ok
1234567" 7

asserts_at_least 5
