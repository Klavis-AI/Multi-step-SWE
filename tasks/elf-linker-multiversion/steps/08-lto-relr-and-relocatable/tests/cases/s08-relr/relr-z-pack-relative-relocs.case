# arch: x86_64
# `-z pack-relative-relocs` is the second spelling of the same request, and the
# same link without it still emits an unpacked DT_RELA table.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int v[24] = {0};
long * const tbl[24] = {
 (long*)&v[0],(long*)&v[1],(long*)&v[2],(long*)&v[3],(long*)&v[4],(long*)&v[5],
 (long*)&v[6],(long*)&v[7],(long*)&v[8],(long*)&v[9],(long*)&v[10],(long*)&v[11],
 (long*)&v[12],(long*)&v[13],(long*)&v[14],(long*)&v[15],(long*)&v[16],(long*)&v[17],
 (long*)&v[18],(long*)&v[19],(long*)&v[20],(long*)&v[21],(long*)&v[22],(long*)&v[23]};
int entry(void) { return tbl[3] ? 42 : 7; }
C
cc_obj m.o m.c -fPIE

link_ok packed -pie --no-gc-sections -z pack-relative-relocs rt.o m.o
pd=$(dynamic packed)
want_has "DT_RELR from -z spelling" "$pd" '\(RELR\)'
want_not "no DT_RELA when packed"   "$pd" '\(RELA\)'
has_section packed .relr.dyn || die "-z pack-relative-relocs produced no .relr.dyn"
run_expect packed "" 42

link_ok plain -pie --no-gc-sections rt.o m.o
ud=$(dynamic plain)
want_has "unpacked link keeps DT_RELA" "$ud" '\(RELA\) '
want_not "unpacked link has no DT_RELR" "$ud" '\(RELR\)'
rel=$(relocs plain)
want_has "unpacked relative relocs" "$rel" 'R_X86_64_RELATIVE'

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh.
asserts_at_least 5
