# arch: x86_64
# --use-android-relr-tags publishes the same table under the Android-numbered
# dynamic tags instead of the generic ones.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int v[24] = {0};
long * const tbl[24] = {
 (long*)&v[0],(long*)&v[1],(long*)&v[2],(long*)&v[3],(long*)&v[4],(long*)&v[5],
 (long*)&v[6],(long*)&v[7],(long*)&v[8],(long*)&v[9],(long*)&v[10],(long*)&v[11],
 (long*)&v[12],(long*)&v[13],(long*)&v[14],(long*)&v[15],(long*)&v[16],(long*)&v[17],
 (long*)&v[18],(long*)&v[19],(long*)&v[20],(long*)&v[21],(long*)&v[22],(long*)&v[23]};
int entry(void) { return tbl[3] ? 42 : 7; }
C
cc_obj m.o m.c -fPIE
link_ok out -pie --no-gc-sections --pack-dyn-relocs=relr --use-android-relr-tags rt.o m.o

dyn=$(dynamic out)
want_has "DT_ANDROID_RELR"    "$dyn" '0x000000006fffe000'
want_has "DT_ANDROID_RELRSZ"  "$dyn" '0x000000006fffe001'
want_has "DT_ANDROID_RELRENT" "$dyn" '0x000000006fffe003'
want_not "no generic DT_RELR"  "$dyn" '\(RELR\)'
want_not "no DT_RELA"          "$dyn" '\(RELA\)'
has_section out .relr.dyn || die "no .relr.dyn with android tags"
run_expect out "" 42

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh.
asserts_at_least 5
