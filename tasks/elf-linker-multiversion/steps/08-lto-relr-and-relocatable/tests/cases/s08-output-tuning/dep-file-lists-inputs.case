# arch: x86_64
# --dependency-file writes a make fragment: the output depends on every input,
# and each input gets a phony rule so a deleted input does not wedge the build.
rt_obj rt.o
cat > m.c <<'C'
int g = 5;
int entry(void) { return g + 20; }
C
cc_obj m.o m.c
[ -e deps.d ] && die "scratch dir was not clean"
link_ok out --dependency-file=deps.d rt.o m.o --no-gc-sections
[ -s deps.d ] || die "--dependency-file wrote nothing"

d=$(cat deps.d)
want_has "output is the target"   "$d" '^out:'
want_has "runtime object listed"  "$d" '^out:.*rt\.o'
want_has "main object listed"     "$d" '^out:.*m\.o'
want_has "phony rule for rt.o"    "$d" '^rt\.o:[[:space:]]*$'
want_has "phony rule for m.o"     "$d" '^m\.o:[[:space:]]*$'
run_expect out "" 25

# No flag, no file.
rm -f deps.d
link_ok out2 rt.o m.o --no-gc-sections
[ -e deps.d ] && die "dependency file written without the flag"
run_expect out2 "" 25

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh.
asserts_at_least 5
