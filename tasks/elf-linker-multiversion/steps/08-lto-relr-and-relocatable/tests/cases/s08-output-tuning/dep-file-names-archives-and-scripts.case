# arch: x86_64
# Archives and linker scripts are inputs too, and they appear in the dependency
# file in the order they were given.
rt_obj rt.o
cat > lib1.c <<'C'
int libfn(int x) { return x + 1; }
C
cat > m.c <<'C'
int libfn(int);
int entry(void) { return libfn(40); }
C
cc_obj lib1.o lib1.c
cc_obj m.o m.c
mkar libx.a lib1.o
cat > s.ld <<'L'
ENTRY(_start)
L
link_ok out --dependency-file=deps.d -T s.ld rt.o m.o libx.a --no-gc-sections
[ -s deps.d ] || die "--dependency-file wrote nothing"

# Make lets a rule's prerequisites run across several physical lines joined by
# a trailing backslash -- GNU ld writes them that way. The contract states the
# rule set and the order, never the layout, so continuations are folded and
# runs of whitespace squeezed before anything is compared.
dj=$(python3 -c 'import sys; sys.stdout.write(open("deps.d").read().replace("\\\n", " "))') \
  || die "could not read the dependency file"
want_has "script listed"  "$dj" '^out:.*s\.ld'
want_has "archive listed" "$dj" '^out:.*libx\.a'
want_has "phony rule for the archive" "$dj" '^libx\.a:[[:space:]]*$'
want_has "phony rule for the script"  "$dj" '^s\.ld:[[:space:]]*$'
order=$(awk '/^out:/ { sub(/^out:[ \t]*/, ""); gsub(/[ \t]+/, " ");
                       sub(/ +$/, ""); print; exit }' <<<"$dj")
want "inputs in command-line order" "$order" "s.ld rt.o m.o libx.a"
run_expect out "" 41

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh.
asserts_at_least 5
