# arch: riscv64
# The HI20 half of RISC-V relaxation (spec 11 S5): when the whole address fits
# the LO12 field the lui is deleted outright (4 bytes), and when the HI20 value
# fits c.lui's signed non-zero 6-bit immediate with a legal rd the lui is
# compressed instead (2 bytes). Both are measured as byte reductions against
# the same link with --no-relax.
rt_obj rt.o
cat > h.s <<'S'
        .section .lodata,"a",@progbits
        .globl lo_var
lo_var: .word 11
        .section .middata,"a",@progbits
        .globl mid_var
mid_var: .word 22
        .text
        .globl entry
        .type entry,@function
entry:
        lui     a0, %hi(lo_var)
        addi    a0, a0, %lo(lo_var)
        lui     a1, %hi(mid_var)
        addi    a1, a1, %lo(mid_var)
        ret
        .size entry, .-entry
        .section .note.GNU-stack,"",@progbits
S
as_obj h.o h.s
want_has "the input carries a HI20 relocation" "$(relocs h.o)" 'R_RISCV_HI20'
want_has "and a relaxable marker"              "$(relocs h.o)" 'R_RISCV_RELAX'

# lo_var at 0x400: (0x400 + 0x800) >> 12 == 0, so its lui is deletable.
# mid_var at 0x10000: HI20 is 16, which is a legal non-zero c.lui immediate,
# and rd is a1, which is neither x0 nor x2 -- so its lui is compressible.
PLACE="--section-start .lodata=0x400 --section-start .middata=0x10000"

link_ok plain --no-relax $PLACE rt.o h.o --no-gc-sections
want "lo_var landed where the rewrite rules need it"  "$(sym_value plain lo_var)"  "0000000000000400"
want "mid_var landed where the rewrite rules need it" "$(sym_value plain mid_var)" "0000000000010000"
unrelaxed=$(symbols plain | awk '$8 == "entry" { print $3; exit }')
want "--no-relax leaves all five instructions" "$unrelaxed" "18"

link_ok relaxed --relax $PLACE rt.o h.o --no-gc-sections
relaxed=$(symbols relaxed | awk '$8 == "entry" { print $3; exit }')
want "the deleted lui and the compressed lui together save six bytes" "$relaxed" "12"

# Relaxation is on by default, so the default link must match --relax exactly.
link_ok deflt $PLACE rt.o h.o --no-gc-sections
cmp -s relaxed deflt || die "the default link differs from --relax"

# Look at the bytes, because the byte count alone does not say which lui went.
taddr=$(sec_addr relaxed .text)
toff=$(sections relaxed | awk '{ for (i = 1; i <= NF; i++) if ($i == ".text") { print $(i+3); exit } }')
eaddr=$(sym_value relaxed entry)
[ -n "$taddr" ] && [ -n "$toff" ] && [ -n "$eaddr" ] || die "cannot locate entry in the relaxed output"
fo=$(( 16#$toff + 16#$eaddr - 16#$taddr ))
first=$(od -An -tx1 -j "$fo" -N 4 -- relaxed | tr -d ' \n')
want "the deletable lui is gone and its addi now reads from x0" "$first" "13050040"
second=$(od -An -tx1 -j "$((fo + 4))" -N 2 -- relaxed | tr -d ' \n')
want "the compressible lui became a two-byte c.lui" "$second" "c165"

# The relocations were consumed, not carried into the output.
want_not "no HI20 relocation survives the link" "$(relocs relaxed)" 'R_RISCV_HI20'

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh.
asserts_at_least 9
