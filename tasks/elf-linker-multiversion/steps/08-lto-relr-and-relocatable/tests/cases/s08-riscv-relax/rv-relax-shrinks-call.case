# arch: riscv64
# --relax turns an auipc/jalr call pair into a single jal when the target is in
# range, so the function shrinks by four bytes and still works.
rt_obj rt.o
cat > c.s <<'S'
        .text
        .globl caller
        .type caller,@function
caller:
        addi    sp, sp, -16
        sd      ra, 8(sp)
        call    callee
        ld      ra, 8(sp)
        addi    sp, sp, 16
        ret
        .size caller, .-caller
        .globl callee
        .type callee,@function
callee:
        li      a0, 22
        ret
        .size callee, .-callee
        .globl entry
entry:  tail    caller
        .section .note.GNU-stack,"",@progbits
S
as_obj c.o c.s
want_has "input has a relaxable call" "$(relocs c.o)" 'R_RISCV_RELAX'

link_ok relaxed --relax rt.o c.o --no-gc-sections
link_ok kept --no-relax rt.o c.o --no-gc-sections

szr=$(symbols relaxed | awk '$8 == "caller" { print $3; exit }')
szk=$(symbols kept    | awk '$8 == "caller" { print $3; exit }')
want "caller size with --no-relax" "$szk" "18"
want "caller size with --relax"    "$szr" "14"

body=$($OBJDUMP -d --section=.text relaxed 2>/dev/null | awk '/<caller>:/ { on = 1; next } on && /^$/ { exit } on { print }')
want_has "relaxed call is a jal" "$body" 'jal'
want_not "relaxed call has no auipc" "$body" 'auipc'

run_expect relaxed "" 22
run_expect kept "" 22

# Backstop: every assertion above must have executed. A skipped assertion is
# not a passing one -- see caselib.sh.
asserts_at_least 5
