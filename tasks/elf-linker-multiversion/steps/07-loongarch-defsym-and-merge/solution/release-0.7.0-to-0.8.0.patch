+impl SysvHashLayout {
+    fn byte_size(self) -> Result<u64> {
+        let words = 2u64
+            .checked_add(u64::from(self.bucket_count))
+            .and_then(|v| v.checked_add(u64::from(self.chain_count)))
+            .context("Too many dynamic symbols for .hash")?;
+        Ok(words * size_of::<u32>() as u64)
+    }
+}
