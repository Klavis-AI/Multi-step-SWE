# arch: x86_64
# GNU_PROPERTY_X86_FEATURE_1_AND is an AND-class property: the output keeps
# only the bits every input agrees on, and the surviving note is still
# described by PT_GNU_PROPERTY.
mkprop() { # mkprop <out.o> <fn> <feature-bits>
  cat > "$2.s" <<S
        .text
        .globl $2
$2:     mov \$7, %eax
        ret
        .section .note.gnu.property,"a",@note
        .p2align 3
        .long 4
        .long 0x10
        .long 5
        .asciz "GNU"
        .p2align 3
        .long 0xc0000002        /* GNU_PROPERTY_X86_FEATURE_1_AND */
        .long 4
        .long $3
        .long 0
        .section .note.GNU-stack,"",@progbits
S
  as_obj "$1" "$2.s"
}
mkprop a.o fa 3   # IBT | SHSTK
mkprop b.o fb 1   # IBT
want_has "input a declares IBT and SHSTK" "$(notes a.o)" 'IBT, SHSTK'

link_ok both -shared --no-gc-sections a.o b.o
n=$(notes both)
want_has "the common bit survives"    "$n" 'x86 feature: IBT'
want_not "the uncommon bit is masked" "$n" 'SHSTK'
want_has "PT_GNU_PROPERTY describes the merged note" "$(segments both)" '^ *GNU_PROPERTY '

# An AND property is dropped when some input file does not carry it at all.
cat > c.c <<'C'
int fc(int x) { return x - 1; }
C
cc_obj c.o c.c -fPIC
link_ok mixed -shared --no-gc-sections a.o b.o c.o
want_not "AND property dropped when an input lacks it" "$(notes mixed)" 'x86 feature'

asserts_at_least 5
