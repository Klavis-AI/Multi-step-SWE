# arch: x86_64
# --section-start=.sec=ADDR must place that output section at ADDR, and
# references to data in it must be relocated against the new address.
rt_obj rt.o
cat > cs.s <<'S'
        .section .mysec,"aw",@progbits
        .globl mydat
        .p2align 3
mydat:  .quad 0xdead
        .section .note.GNU-stack,"",@progbits
S
as_obj cs.o cs.s
cat > m.c <<'C'
#include "rt.h"
extern unsigned long mydat;
int entry(void) { putdec((long)&mydat); print("\n"); putdec((long)mydat); return 0; }
C
cc_obj m.o m.c
link_ok out --section-start=.mysec=0x600000 --no-gc-sections rt.o m.o cs.o
want "the section landed where asked" "$(sec_addr out .mysec)" "0000000000600000"
want "mydat is inside it" "$(sym_value out mydat)" "0000000000600000"
# 6291456 == 0x600000, 57005 == 0xdead
run_expect out "6291456
57005" 0
# A second address, to show the value is read rather than hardcoded.
link_ok out2 --section-start=.mysec=0x7a0000 --no-gc-sections rt.o m.o cs.o
want "the second address is honoured too" "$(sec_addr out2 .mysec)" "00000000007a0000"
run_expect out2 "7995392
57005" 0

asserts_at_least 3
