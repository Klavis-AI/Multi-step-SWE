# arch: x86_64
# --defsym must evaluate SYMBOL+N, SYMBOL-N and plain numeric arithmetic, with
# the offset applied to the target's *final* address.
rt_obj rt.o
cat > d.s <<'S'
        .data
        .globl base_sym
        .p2align 3
base_sym:
        .quad 0x1111111111111111
        .quad 0x2222222222222222
        .quad 0x3333333333333333
        .globl tail_sym
tail_sym:
        .quad 0x4444444444444444
        .section .note.GNU-stack,"",@progbits
S
as_obj d.o d.s
cat > m.c <<'C'
#include "rt.h"
extern unsigned long plus16;
int entry(void) { putdec((long)(plus16 >> 60)); print("\n"); return 0; }
C
cc_obj m.o m.c
link_ok out --defsym=plus16=base_sym+16 --defsym=minus8=tail_sym-8 \
            --defsym=arith=0x100-0x1 --no-gc-sections rt.o m.o d.o
# Every value is captured and checked non-empty before it reaches a $(( )).
# An empty capture would make the word the bare literal `16#`; bash then
# abandons the whole command during word expansion, so the `want` around it
# never runs and cannot fail.
base=$(sym_value out base_sym); tail=$(sym_value out tail_sym)
plus16=$(sym_value out plus16); minus8=$(sym_value out minus8)
arith=$(sym_value out arith)
[ -n "$base" ] && [ -n "$tail" ] || die "base_sym/tail_sym missing from the output"
[ -n "$plus16" ] && [ -n "$minus8" ] && [ -n "$arith" ] \
  || die "a --defsym symbol is missing: plus16='$plus16' minus8='$minus8' arith='$arith'"
want "SYMBOL+16 is 16 past the target" "$(( 16#$plus16 - 16#$base ))" "16"
want "SYMBOL-8 is 8 before the target" "$(( 16#$tail - 16#$minus8 ))" "8"
want "numeric arithmetic is evaluated" "$(( 16#$arith ))" "255"
# plus16 names the third quad, so its top nibble is 3.
run_expect out "3" 0

# Arithmetic is 64-bit and wraps rather than erroring, and the option is
# accepted in its space-separated spelling as well as with '='.
link_ok wrap --defsym plus16=base_sym+16 --defsym wrapped=-1 \
             --defsym chain=0x100+0x10-0x1 --no-gc-sections rt.o m.o d.o
chain=$(sym_value wrap chain)
[ -n "$chain" ] || die "chain missing from the second link: $(symbols wrap)"
want "a negative value wraps to 64 bits" "$(sym_value wrap wrapped)" "ffffffffffffffff"
want "a left-to-right +/- chain"  "$(( 16#$chain ))" "271"
want_has "the wrapped symbol is SHN_ABS" "$(symbols wrap)" 'GLOBAL DEFAULT +ABS wrapped'
run_expect wrap "3" 0

asserts_at_least 6
