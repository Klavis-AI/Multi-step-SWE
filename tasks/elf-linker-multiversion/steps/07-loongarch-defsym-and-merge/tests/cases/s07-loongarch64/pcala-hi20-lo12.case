# arch: loongarch64
# R_LARCH_PCALA_HI20 + R_LARCH_PCALA_LO12 must together reconstruct the exact
# final address of a datum: the page base from pcalau12i, the low 12 bits from
# the addi.d. The program prints both the address and the value it found there.
rt_obj rt.o
cat > d.s <<'S'
        .data
        .p2align 12
        .space 0x123
        .globl datum
        .p2align 3
datum:  .quad 987654321
        .section .note.GNU-stack,"",@progbits
S
cat > a.s <<'S'
        .text
        .globl datum_addr
datum_addr:
        pcalau12i $a0, %pc_hi20(datum)
        addi.d    $a0, $a0, %pc_lo12(datum)
        jr $ra
        .section .note.GNU-stack,"",@progbits
S
cat > m.c <<'C'
#include "rt.h"
long *datum_addr(void);
int entry(void) { long *p = datum_addr(); putdec((long)p); print("\n"); putdec(*p); return 0; }
C
as_obj d.o d.s; as_obj a.o a.s; cc_obj m.o m.c
# Counted assertions, not `grep -q ... || die`: asserts_at_least cannot see a
# raw die, so a body that quietly stopped asserting would still report a pass.
rel=$(relocs a.o)
want_has "the input carries PCALA_HI20" "$rel" 'R_LARCH_PCALA_HI20'
want_has "the input carries PCALA_LO12" "$rel" 'R_LARCH_PCALA_LO12'
link_ok out rt.o a.o m.o d.o
addr=$(sym_value out datum)
[ -n "$addr" ] || die "datum not in the output symbol table: $(symbols out)"
want "the case is not vacuous: datum is off the page boundary" \
  "$(( (16#$addr & 0xfff) != 0 ))" "1"
run_expect out "$(( 16#$addr ))
987654321" 0

asserts_at_least 3
