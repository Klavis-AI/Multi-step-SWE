# arch: loongarch64
# Every relocatable input's e_flags must be identical. The output carries that
# one common value, and a link whose inputs disagree must fail. Only the
# non-zero status is graded: the reference's own message for this changed
# between releases, so no wording is asserted (TEST_INTERFACE.md section 2).
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int helper(int);
int entry(void) { putdec(helper(20)); print("\n"); return 0; }
C
cc_obj m.o m.c
cat > f.c <<'C'
int helper(int x) { return x + 22; }
C
cc_obj f.o f.c
# clang-16 emits EF_LARCH_ABI_DOUBLE_FLOAT | EF_LARCH_OBJABI_V1 for this target
# and ignores -mabi=lp64s, so the mismatching input has to be made by editing
# the e_flags word -- 4 bytes at offset 0x30 of an ELF64 header -- by hand.
want_has "the inputs declare double-float, object ABI v1" "$(hdr f.o)" 'Flags: *0x43'
link_ok good --no-gc-sections rt.o m.o f.o
want_has "the output keeps the inputs' common e_flags" "$(hdr good)" 'Flags: *0x43'
run_expect good "42" 0

cp f.o bad.o
printf '\101' | dd of=bad.o bs=1 seek=48 conv=notrunc status=none 2>/dev/null
want_has "the patched input declares soft-float" "$(hdr bad.o)" 'Flags: *0x41'
# Same link, same inputs, one of them with a different ABI field: must fail.
link_fails mixed --no-gc-sections rt.o m.o bad.o

asserts_at_least 3
