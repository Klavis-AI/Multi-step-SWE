# arch: x86_64
# what: -T FILE, --script=FILE and -script=FILE all load the same SECTIONS
# script, including one reached by a relative path into a subdirectory, and all
# three produce the same layout and a running program.
rt_obj rt.o
cat > m.c <<'C'
#include "rt.h"
int marker = 0x5a;
int entry(void) { putdec(marker); print("\n"); return 0; }
C
cc_obj m.o m.c
mkdir -p ld
cat > ld/lay.ld <<'L'
SECTIONS {
    . = 0x600000;
    .text : { *(.text .text.*) }
    . = 0x730000;
    .data : { *(.data .data.*) }
}
L
# Without a script .data is nowhere near 0x730000.
link_ok base rt.o m.o
[ "$(( 16#$(sec_addr base .data) ))" -ne "$(( 0x730000 ))" ] \
  || die "baseline already places .data at 0x730000"
n=0
for form in "-T ld/lay.ld" "--script=ld/lay.ld" "-script=ld/lay.ld"; do
  n=$(( n + 1 ))
  link_ok "out$n" $form rt.o m.o
  want "form '$form': .data address" "$(( 16#$(sec_addr out$n .data) ))" "$(( 0x730000 ))"
  ta=$(( 16#$(sec_addr out$n .text) ))
  [ "$ta" -ge "$(( 0x600000 ))" ] && [ "$ta" -lt "$(( 0x610000 ))" ] \
    || die "form '$form': .text at $ta is outside the scripted region"
  want "form '$form': marker is in .data" \
    "$(( 16#$(sym_value out$n marker) ))" "$(( 0x730000 ))"
  run_expect "out$n" "90" 0
done
# All three spellings must agree byte for byte.
cmp -s out1 out2 || die "-T and --script= produced different images"
cmp -s out1 out3 || die "-T and -script= produced different images"
asserts_at_least 6
