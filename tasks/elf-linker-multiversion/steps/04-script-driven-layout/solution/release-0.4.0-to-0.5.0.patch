new file mode 100644
index 00000000..dcbaffbd
--- /dev/null
+++ b/wild/tests/sources/gnu-unique.h
@@ -0,0 +1,7 @@
+template<typename T>
+T get_value(T v) {
+    // This static variable inside a template is what causes GCC to emit a symbol as UNIQUE.
+    static T def = 0;
+    def++;
+    return v + def;
+}
