+    fn copy_relocate_symbol<'scope>(
+        &mut self,
+        symbol_id: SymbolId,
+        resources: &GraphResources<'data, 'scope>,
+    ) -> std::result::Result<(), Error> {
+        let symbol = self
+            .object
