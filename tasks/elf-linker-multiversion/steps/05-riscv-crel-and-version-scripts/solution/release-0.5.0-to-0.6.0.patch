+    let sub_resolution_val = resolution.value_with_addend(
+        addend,
+        symbol_index,
+        object_layout,
+        &layout.merged_strings,
+        &layout.merged_string_start_addresses,
+    )?;
+    Ok(set_resolution_val.wrapping_sub(sub_resolution_val))
