+        let mut first = true;
+        for message in self.0.messages.iter().rev() {
+            if first {
+                writeln!(f, "{message}")?;
+                first = false;
+                writeln!(f, "  Caused by:")?;
+            } else {
+                writeln!(f, "    {message}")?;
+            }
+        }
