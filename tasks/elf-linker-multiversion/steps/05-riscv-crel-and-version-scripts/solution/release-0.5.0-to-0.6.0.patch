+fn get_pair_subtraction_relocation_value<'a, A: Arch>(
+    object_layout: &ObjectLayout,
+    rel: &Crel,
+    layout: &Layout,
+    resolution: Resolution,
+    symbol_index: SymbolIndex,
+    addend: i64,
+    mut relocations_to_search: impl Iterator<Item = &'a Crel>,
