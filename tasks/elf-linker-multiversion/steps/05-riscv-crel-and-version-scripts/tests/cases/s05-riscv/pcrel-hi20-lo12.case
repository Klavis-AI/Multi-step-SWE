# arch: riscv64
# what: R_RISCV_PCREL_HI20 + R_RISCV_PCREL_LO12_I must be resolved as a pair --
# the LO12 relocation names the auipc label, not the datum, so the linker has
# to follow that indirection to recover the datum's real address.
rt_obj rt.o
cat > d.s <<'S'
        .data
        .p2align 12
        .space 0x341
        .globl datum
        .p2align 3
datum:  .quad 0x0102030405060708
        .section .note.GNU-stack,"",@progbits
S
cat > a.s <<'S'
        .text
        .globl datum_addr
datum_addr:
.La:    auipc   a0, %pcrel_hi(datum)
        addi    a0, a0, %pcrel_lo(.La)
        ret
        .globl datum_load
datum_load:
.Lb:    auipc   a1, %pcrel_hi(datum)
        ld      a0, %pcrel_lo(.Lb)(a1)
        ret
        .section .note.GNU-stack,"",@progbits
S
cat > m.c <<'C'
#include "rt.h"
long *datum_addr(void); long datum_load(void);
extern long datum;
int entry(void) {
    putdec((long)datum_addr()); print("\n");
    putdec(datum_addr() == &datum); print("\n");
    putdec(datum_load());
    return 0;
}
C
as_obj d.o d.s; as_obj a.o a.s; cc_obj m.o m.c
relocs a.o > in.rel
want "input has 2 PCREL_HI20"   "$(grep -c 'R_RISCV_PCREL_HI20' in.rel)"   "2"
want "input has 2 PCREL_LO12_I" "$(grep -c 'R_RISCV_PCREL_LO12_I' in.rel)" "2"
link_ok out --no-relax rt.o a.o m.o d.o
addr=$(sym_value out datum)
[ -n "$addr" ] || die "datum missing from the output symbol table"
lo=$(( 0x$addr & 0xfff ))
[ "$lo" -ne 0 ] || die "test is vacuous: datum landed on a 4KiB boundary"
run_expect out "$((0x$addr))
1
72623859790382856" 0
# 2 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 2
