# arch: riscv64
# what: R_RISCV_GOT_HI20 must allocate a .got slot holding the symbol's final
# address, and the auipc/ld pair must be pointed at that slot, not at the
# symbol itself.
rt_obj rt.o
cat > d.s <<'S'
        .data
        .p2align 3
        .globl datum
datum:  .quad 0x00c0ffee0badf00d
        .section .note.GNU-stack,"",@progbits
S
cat > g.s <<'S'
        .text
        .globl got_addr
got_addr:
.Lg:    auipc   a0, %got_pcrel_hi(datum)
        ld      a0, %pcrel_lo(.Lg)(a0)
        ret
        .section .note.GNU-stack,"",@progbits
S
cat > m.c <<'C'
#include "rt.h"
long *got_addr(void);
extern long datum;
int entry(void) {
    putdec(got_addr() == &datum); print("\n");
    putdec(*got_addr());
    return 0;
}
C
as_obj d.o d.s; as_obj g.o g.s; cc_obj m.o m.c
relocs g.o > in.rel
want "input has GOT_HI20" "$(grep -c 'R_RISCV_GOT_HI20 .* datum' in.rel)" "1"
link_ok out --no-relax rt.o g.o m.o d.o
gotaddr=$((0x$(sec_addr out .got)))
want "a .got was created for the GOT_HI20 reference" \
  "$([ "$gotaddr" -ne 0 ] && echo yes)" "yes"
$OBJDUMP -d --no-show-raw-insn out > dis.txt
set -- $(awk '/<got_addr>:/{f=1}
             f && $2=="auipc" {a=$1; sub(":","",a); hi=$4}
             f && $2=="ld"    {lo=$4; sub(/\(a0\)/,"",lo); print a, hi, lo; exit}' dis.txt)
want "an auipc/ld pair is present inside got_addr: $(head -30 dis.txt | tail -8)" "$#" "3"
slot=$(( 0x$1 + ($2 << 12) + $3 ))
gotend=$(( gotaddr + 0x$(sec_size out .got) ))
want "auipc/ld addresses a slot inside .got [$gotaddr,$gotend), not $slot" \
  "$([ "$slot" -ge "$gotaddr" ] && [ "$slot" -lt "$gotend" ] && echo inside)" "inside"
run_expect out "1
54324593391693837" 0
# 4 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 4
