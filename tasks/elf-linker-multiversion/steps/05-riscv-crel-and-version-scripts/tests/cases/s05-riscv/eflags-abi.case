# arch: riscv64
# what: e_flags must carry the inputs' RISC-V ABI bits -- the RVC bit is the
# union over the inputs, while a float-ABI disagreement is a diagnosed link
# error rather than a silently mismatched binary.
rt_obj rt.o
cat > d.s <<'S'
        .data
        .globl datum
        .p2align 3
datum:  .quad 99
        .section .note.GNU-stack,"",@progbits
S
cat > m.c <<'C'
#include "rt.h"
extern long datum;
int entry(void) { putdec(datum); return 0; }
C
as_obj d.o d.s; cc_obj m.o m.c
# default march has the C extension: EF_RISCV_RVC|EF_RISCV_FLOAT_ABI_DOUBLE.
want "input e_flags" "$(hdr m.o | awk '/^ *Flags:/{print $2}')" "0x5,"
link_ok out rt.o m.o d.o
want "output e_flags" "$(hdr out | awk '/^ *Flags:/{print $2}')" "0x5,"
run_expect out "99" 0
# One non-RVC object must not clear the RVC bit the others carry.
as_obj dn.o d.s -march=rv64imafd -mabi=lp64d
want "non-RVC input e_flags" "$(hdr dn.o | awk '/^ *Flags:/{print $2}')" "0x4,"
link_ok out2 rt.o m.o dn.o
want "RVC bit is the union" "$(hdr out2 | awk '/^ *Flags:/{print $2}')" "0x5,"
run_expect out2 "99" 0
# A soft-float object has an incompatible ABI and must be rejected.
as_obj ds.o d.s -march=rv64i -mabi=lp64
want "soft-float input e_flags" "$(hdr ds.o | awk '/^ *Flags:/{print $2}')" "0x0"
link_fails out3 rt.o m.o ds.o
# 5 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 5
