# arch: riscv64
# what: R_RISCV_CALL_PLT must be written as an auipc/jalr pair whose two halves
# sum to the callee, and R_RISCV_JAL as a 21-bit word displacement; both must
# reach a definition in another object.
rt_obj rt.o
cat > leaf.s <<'S'
        .text
        .globl leaf
leaf:   li      a0, 41
        addi    a0, a0, 1
        ret
        .section .note.GNU-stack,"",@progbits
S
cat > c.s <<'S'
        .text
        .globl call_leaf
call_leaf:
        addi    sp, sp, -16
        sd      ra, 8(sp)
        call    leaf
        ld      ra, 8(sp)
        addi    sp, sp, 16
        ret
        .globl jal_leaf
jal_leaf:
        jal     zero, leaf
        .section .note.GNU-stack,"",@progbits
S
cat > m.c <<'C'
#include "rt.h"
int call_leaf(void); int jal_leaf(void);
int entry(void) { putdec(call_leaf()); print(","); putdec(jal_leaf()); return 0; }
C
as_obj leaf.o leaf.s; as_obj c.o c.s; cc_obj m.o m.c
relocs c.o > in.rel
want "input has CALL_PLT" "$(grep -c 'R_RISCV_CALL_PLT .* leaf' in.rel)" "1"
want "input has JAL"      "$(grep -c 'R_RISCV_JAL .* leaf' in.rel)"      "1"
link_ok out --no-relax rt.o c.o m.o leaf.o
leafaddr=$((0x$(sym_value out leaf)))
[ "$leafaddr" -ne 0 ] || die "leaf missing from the output symbol table"
$OBJDUMP -d --no-show-raw-insn out > dis.txt
set -- $(awk '/<call_leaf>:/{f=1}
             f && $2=="auipc" {a=$1; sub(":","",a); hi=$4}
             f && $2=="jalr"  {lo=$3; sub(/\(ra\)/,"",lo); print a, hi, lo; exit}' dis.txt)
[ $# -eq 3 ] || die "no auipc/jalr pair inside call_leaf: $(grep -A4 'call_leaf' dis.txt | head -8)"
want "auipc+jalr reaches leaf" "$(( 0x$1 + ($2 << 12) + $3 ))" "$leafaddr"
jtarget=$(awk '/<jal_leaf>:/{f=1} f && ($2=="j" || $2=="jal") {print $3; exit}' dis.txt)
want "jal reaches leaf" "$(( jtarget ))" "$leafaddr"
run_expect out "42,42" 0
# 4 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 4
