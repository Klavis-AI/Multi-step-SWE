# arch: x86_64
# what: the low two bits of the CREL header are an offset shift; a section
# encoded with shift=3 stores r_offset/8 and the linker must scale it back.
cat > crel.py <<'PY'
import sys, struct
f = bytearray(open(sys.argv[1], 'rb').read()); sh = int(sys.argv[2])
sho, = struct.unpack_from('<Q', f, 0x28)
esz, num = struct.unpack_from('<HH', f, 0x3a)
def leb(v, s):
    o = bytearray()
    while 1:
        b = v & 0x7f; v >>= 7
        if (v == 0 and (not s or not b & 0x40)) or (s and v == -1 and b & 0x40):
            return o + bytes([b])
        o.append(b | 0x80)
for i in range(num):
    o = sho + i * esz
    if struct.unpack_from('<I', f, o + 4)[0] != 4: continue   # SHT_RELA
    so, ss = struct.unpack_from('<QQ', f, o + 0x18)
    out = bytearray(leb(ss // 24 << 3 | 4 | sh, 0)); p = [0, 0, 0, 0]
    for k in range(ss // 24):
        ro, ri, ra = struct.unpack_from('<QQq', f, so + k * 24)
        assert ro % (1 << sh) == 0, 'offset not aligned for this shift'
        c = [ro >> sh, ri >> 32, ri & 0xffffffff, ra]
        fl = sum(m for m, j in ((1, 1), (2, 2), (4, 3)) if c[j] != p[j])
        d = c[0] - p[0]
        out.append(fl | (d & 0xf) << 3 | (0x80 if d >> 4 else 0))
        if d >> 4: out += leb(d >> 4, 0)
        for m, j in ((1, 1), (2, 2), (4, 3)):
            if fl & m: out += leb(c[j] - p[j], 1)
        p = c
    assert len(out) <= ss
    f[so:so + len(out)] = out
    struct.pack_into('<I', f, o + 4, 0x40000014)              # SHT_CREL
    struct.pack_into('<Q', f, o + 0x20, len(out))
    struct.pack_into('<Q', f, o + 0x38, 1)
open(sys.argv[1], 'wb').write(f)
PY
rt_obj rt.o
cat > t.s <<'S'
        .section .rodata
        .globl aa
aa:     .quad 0x1111
        .globl bb
bb:     .quad 0x2222
        .data
        .globl tab
        .p2align 3
tab:    .quad aa
        .quad bb
        .space 0x800
        .quad bb + 8
        .quad aa + 8
        .section .note.GNU-stack,"",@progbits
S
as_obj t.o t.s
want "relocation count" "$(grep -c 'R_X86_64_64' <(relocs t.o))" "4"
python3 crel.py t.o 3 || die "crel re-encoding with shift=3 failed"
want "SHT_CREL sections" "$(grep -c '0x40000014' <(sections t.o))" "1"
cat > m.c <<'C'
#include "rt.h"
extern long aa, bb;
extern long *tab[];
int entry(void) {
    putdec(tab[0] == &aa); print(",");
    putdec(tab[1] == &bb); print(",");
    putdec(tab[258] == &bb + 1); print(",");
    putdec(tab[259] == &aa + 1); print(",");
    putdec(*tab[0] + *tab[1]);
    return 0;
}
C
cc_obj m.o m.c
link_ok out rt.o m.o t.o
run_expect out "1,1,1,1,13107" 0
# 2 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 2
