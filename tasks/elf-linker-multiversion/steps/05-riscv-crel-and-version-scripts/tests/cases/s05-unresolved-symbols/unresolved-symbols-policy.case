# arch: x86_64
# what: --unresolved-symbols= selects whether an undefined reference from a
# regular object is fatal; the ignoring values must still produce a complete
# executable in which the reference has been resolved to address zero.
rt_obj rt.o
cat > u.c <<'C'
int missing(void);
int entry(void) { return missing() + 1; }
C
cc_obj u.o u.c
# The default is to reject, naming the symbol and the object that wants it.
link_fails def rt.o u.o
want_has "default names the symbol" "$LINK_OUT" "missing"
want_has "default names the object" "$LINK_OUT" "u\.o"
# report-all is the explicit spelling of that default.
link_fails rep --unresolved-symbols=report-all rt.o u.o
want_has "report-all names the symbol" "$LINK_OUT" "missing"
calltarget() {
  $OBJDUMP -d --no-show-raw-insn "$1" > dis.txt
  awk '/<entry>:/ { f = 1 } f && $2 == "callq" { print $3; exit }' dis.txt
}
for v in ignore-all ignore-in-object-files; do
  link_ok "ok-$v" "--unresolved-symbols=$v" rt.o u.o
  want "$v: e_type" "$(hdr "ok-$v" | awk '/^ *Type:/{print $2}')" "EXEC"
  want "$v: reference resolved to 0" "$(calltarget "ok-$v")" "0x0"
  want "$v: entry point is _start" \
    "$((  $(hdr "ok-$v" | awk '/Entry point address:/{print $NF}') ))" \
    "$((0x$(sym_value "ok-$v" _start)))"
done
# ignore-in-shared-libs still reports an object-file reference.
link_fails shl --unresolved-symbols=ignore-in-shared-libs rt.o u.o
want_has "ignore-in-shared-libs still names it" "$LINK_OUT" "missing"
# 10 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 10
