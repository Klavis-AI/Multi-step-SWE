# arch: x86_64
# what: a custom SHT_NOBITS TLS section joins the single PT_TLS segment, and each
# thread-local's offset is measured from that segment, not from its own section.
rt_obj rt.o
cat > t.s <<'S'
        .section .tdata,"awT",@progbits
        .globl tdat
        .p2align 3
tdat:   .quad 0x1111
        .section .mytls,"awT",@nobits
        .globl mynob
        .p2align 4
mynob:  .zero 64
        .section .tbss,"awT",@nobits
        .globl tzero
        .p2align 3
tzero:  .zero 16
        .text
        .globl set_fs
set_fs: movq  %rdi, %rsi
        movl  $0x1002, %edi
        movl  $158, %eax
        syscall
        ret
        .globl le_tdat
le_tdat:  movq %fs:0, %rax; leaq tdat@tpoff(%rax), %rax; ret
        .globl le_mynob
le_mynob: movq %fs:0, %rax; leaq mynob@tpoff(%rax), %rax; ret
        .globl le_tzero
le_tzero: movq %fs:0, %rax; leaq tzero@tpoff(%rax), %rax; ret
        .section .note.GNU-stack,"",@progbits
S
cat > m.c <<'C'
#include "rt.h"
void set_fs(void *); long *le_tdat(void); long *le_mynob(void); long *le_tzero(void);
static char pool[8192] __attribute__((aligned(64)));
int entry(void) {
    char *tp = &pool[4096];
    *(void **)tp = tp;                  /* the TCB self-pointer %fs:0 reads */
    set_fs(tp);
    putdec((char *)le_tdat() - tp);  print(",");
    putdec((char *)le_mynob() - tp); print(",");
    putdec((char *)le_tzero() - tp); print("\n");
    *le_mynob() = 5; *le_tzero() = 6;
    putdec(*le_tdat() + *le_mynob() + *le_tzero());
    return 0;
}
C
as_obj t.o t.s; cc_obj m.o m.c; link_ok out rt.o t.o m.o
segments out > seg.txt; sections out > sec.txt
want "exactly one PT_TLS segment" "$(awk '$1 == "TLS"' seg.txt | wc -l)" "1"
want ".mytls kept as NOBITS TLS" \
  "$(awk '{ for (i = 1; i <= NF; i++) if ($i == ".mytls") { print $(i+1); exit } }' sec.txt)" "NOBITS"
set -- $(awk '$1 == "TLS" { print $3, $6; exit }' seg.txt)
tlsaddr=$(( $1 )); memsz=$(( $2 ))
want "PT_TLS starts at .tdata" "$tlsaddr" "$(( 0x$(sec_addr out .tdata) ))"
want "PT_TLS spans the custom section" "$memsz" \
  "$(( 0x$(sec_addr out .mytls) + 0x$(sec_size out .mytls) - tlsaddr ))"
want "mynob offset is its distance into PT_TLS" "$(( 0x$(sym_value out mynob) ))" \
  "$(( 0x$(sec_addr out .mytls) - tlsaddr ))"
run_expect out "$(( 0x$(sym_value out tdat) - memsz )),$(( 0x$(sym_value out mynob) - memsz )),$(( 0x$(sym_value out tzero) - memsz ))
11" 0
# 5 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 5
