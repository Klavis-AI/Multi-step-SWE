# arch: x86_64
# what: duplicate strong definitions are an error that names the symbol and
# both objects, but --allow-multiple-definition and -z muldefs accept them and
# let the first definition on the command line win.
rt_obj rt.o
cat > d1.c <<'C'
int dup(void) { return 11; }
int one(void) { return 1; }
C
cat > d2.c <<'C'
int dup(void) { return 22; }
int two(void) { return 2; }
C
cat > m.c <<'C'
#include "rt.h"
int dup(void); int one(void); int two(void);
int entry(void) { putdec(dup() + one() + two()); return 0; }
C
cc_obj d1.o d1.c; cc_obj d2.o d2.c; cc_obj m.o m.c
link_fails bad rt.o d1.o d2.o m.o
want_has "names the duplicated symbol" "$LINK_OUT" "dup"
want_has "names the first object"      "$LINK_OUT" "d1\.o"
want_has "names the second object"     "$LINK_OUT" "d2\.o"
link_ok amd --allow-multiple-definition rt.o d1.o d2.o m.o
run_expect amd "14" 0
link_ok mul -z muldefs rt.o d1.o d2.o m.o
run_expect mul "14" 0
# "First" means first on the command line, not "whichever we happen to see".
link_ok rev -z muldefs rt.o d2.o d1.o m.o
run_expect rev "25" 0
# Exactly one definition must end up in the output.
symbols amd > sy.txt
want "one dup in the symbol table" "$(awk '$8 == "dup"' sy.txt | wc -l)" "1"
# 4 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 4
