# arch: x86_64
# what: --wrap SYM must redirect every reference to SYM to __wrap_SYM while
# __real_SYM keeps naming the original definition; unwrapped names nearby must
# be left alone, and the same link without --wrap must behave normally.
rt_obj rt.o
cat > foo.c <<'C'
int foo(void) { return 10; }
int foot(void) { return 3; }
C
cat > wrap.c <<'C'
int __real_foo(void);
int foot(void);
int __wrap_foo(void) { return 100 + __real_foo() + foot(); }
C
cat > m.c <<'C'
#include "rt.h"
int foo(void); int foot(void);
int entry(void) { putdec(foo()); print(","); putdec(foot()); return 0; }
C
cc_obj foo.o foo.c; cc_obj wrap.o wrap.c; cc_obj m.o m.c
# Without --wrap the plain call chain must be visible.
link_ok plain rt.o foo.o m.o
run_expect plain "10,3" 0
link_ok out --wrap foo rt.o foo.o wrap.o m.o
symbols out > sy.txt
want "original foo survives"    "$(awk '$8 == "foo"' sy.txt | wc -l)"        "1"
want "__wrap_foo is defined"    "$(awk '$8 == "__wrap_foo"' sy.txt | wc -l)" "1"
want "__real_foo is not a real symbol" "$(grep -c '__real_foo' sy.txt)"      "0"
want "foot was not wrapped"     "$(grep -c '__wrap_foot' sy.txt)"            "0"
run_expect out "113,3" 0
# --wrap=SYM must be accepted as well and behave identically.
link_ok out2 --wrap=foo rt.o foo.o wrap.o m.o
run_expect out2 "113,3" 0
# The wrapper itself must not be redirected into itself: __real_foo has to
# reach the original body, which returns 10, not recurse through __wrap_foo.
want "wrapper and original differ" \
  "$(awk '$8 == "foo" || $8 == "__wrap_foo" {print $2}' sy.txt | sort -u | wc -l)" "2"
# 5 assertions run against the reference at 0.6.0 and 0.10.0.
asserts_at_least 5
