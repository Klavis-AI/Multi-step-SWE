+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        use std::fmt::Debug;
+        match &self.0 {
+            either::Either::Left(v) => Debug::fmt(v, f),
+            either::Either::Right(v) => Debug::fmt(v, f),
+        }
+    }
 }
 
