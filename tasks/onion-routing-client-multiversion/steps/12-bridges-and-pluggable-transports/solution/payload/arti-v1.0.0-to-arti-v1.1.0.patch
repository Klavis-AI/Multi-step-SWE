+        let a = h.handshake(&msg[..]).unwrap().unwrap();
+        assert!(a.finished);
+        assert!(h.finished());
+        assert_eq!(a.drain, msg.len() - 1);
+        assert!(a.reply.is_empty()); // no reply -- waiting to see how it goes
+
+        let req = h.into_request().unwrap();
