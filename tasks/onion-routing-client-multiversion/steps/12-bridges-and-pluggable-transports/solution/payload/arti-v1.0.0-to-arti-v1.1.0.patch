-                {
+                if let Some(inner) = inner.upgrade() {
                     let mut inner = inner.lock().expect("Poisoned lock");
-                    if let Ok(netdir) = provider.timely_netdir() {
-                        inner.update(runtime.wallclock(), Some(&netdir));
-                    }
+                    inner.update(runtime.wallclock(), runtime.now());
