-                    super::$id(&crate::async_std::create_runtime()?)
-                }
-            )*
-        }
-    }
-}
-
-runtime_tests! {
-    small_delay,
-    small_timeout_ok,
-    small_timeout_expire,
-    tiny_wallclock,
-    self_connect,
-    listener_stream,
-    simple_tls,
