+
+        // Case 4: starting with an unusable directory, we always replace.
+        let mut bs = DirBootstrapStatus::default();
+        assert!(!ds2.usable());
+        assert!(bs.current.lifetime().is_none());
+        bs.update(ds2);
+        assert!(bs.current.lifetime().is_some());
+    }
