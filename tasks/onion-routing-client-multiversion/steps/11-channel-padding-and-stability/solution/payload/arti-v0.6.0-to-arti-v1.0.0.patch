+            exp_addrs: Result<Vec<Vec<SocketAddr>>, ()>,
+            exp_lpd: Result<Option<u16>, ()>,
+            s: &str,
+        ) {
+            let tc: TestConfigFile = toml::from_str(s).expect(s);
+            let ll = tc.listen.unwrap();
+            eprintln!("s={:?} ll={:?}", &s, &ll);
+            assert_eq!(ll, Listen(exp_i));
+            assert_eq!(
+                ll.ip_addrs()
+                    .map(|a| a.map(|l| l.collect_vec()).collect_vec())
+                    .map_err(|_| ()),
