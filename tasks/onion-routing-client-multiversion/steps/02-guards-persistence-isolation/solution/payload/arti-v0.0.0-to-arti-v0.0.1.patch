+        let dirinfo = (&netdir).into();
+        let config = PathConfig::default();
+        let guards: OptDummyGuardMgr<'_> = None;
+
+        for _ in 0..1000 {
+            let (path, _, _) = ExitPathBuilder::from_target_ports(ports.clone())
+                .pick_path(&mut rng, dirinfo, guards, &config)
