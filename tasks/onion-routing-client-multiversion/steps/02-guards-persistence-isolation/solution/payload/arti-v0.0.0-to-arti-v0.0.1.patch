+        dbg!("AAAA");
+        cfg.merge(config::File::from_str(
+            ARTI_DEFAULTS,
+            config::FileFormat::Toml,
+        ))?;
+        dbg!("BBBB");
+
+        let _parsed: ArtiConfig = cfg.try_into()?;
+        dbg!("CCCCC");
+        Ok(())
+    }
+}
diff --git a/arti-v0.0.1/crates/arti/src/process.rs b/arti-v0.0.1/crates/arti/src/process.rs
