+        let text: crate::storage::InputString = CONSENSUS.to_owned().into();
+        let map = vec![(docid, text.into())].into_iter().collect();
+        let outcome = state.add_from_cache(map, None);
+        assert!(outcome.unwrap());
+        assert!(state.can_advance());
+    }
