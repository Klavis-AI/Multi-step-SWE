-    /// Return a vector of the parameter names we didn't recognize.
-    pub(crate) fn saturating_update<'a>(
-        &mut self,
-        iter: impl Iterator<Item = (&'a String, &'a i32)>,
-    ) -> Vec<&'a String> {
-        let mut unrecognized = Vec::new();
-        for (k, v) in iter {
-            if !self.saturating_update_override(k, *v) {
-                unrecognized.push(k);
-            }
-        }
-        unrecognized
-    }
