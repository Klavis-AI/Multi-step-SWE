# steps/02-guards-persistence-isolation/tests/Dockerfile
#
# GENERATED by misc/onion-routing-client-multiversion/build-package.sh from
# harness/Dockerfile.in. Regenerate rather than hand-edit.
FROM rust:1.98.1-bookworm

# ---------------------------------------------------------------------------
# Step identity tripwire. This RUN MUST stay above the first COPY.
# ---------------------------------------------------------------------------
# The Docker builder decides whether a local-context COPY layer is a cache hit
# from (relative path, size, mtime-to-the-second) alone. It never reads the
# bytes. Twelve steps whose tests/ trees differ in content but happen to match
# on those three keys will therefore share one COPY layer, and a step will be
# graded by another step's test.sh - at a plausible-looking partial score, with
# nothing in the log that says so.
#
# `--no-cache`, a cache-busting ARG and a marker file all fail to prevent this,
# because none of them change the three keys the builder actually compares.
# Two things do: a distinct mtime (bin/stamp-steps.py) and a distinct size.
# This literal line gives every step's Dockerfile a distinct size AND bakes the
# step id into the image above the COPY, so helpers.sh's require_step can
# compare the image's idea of the step against the tree's and refuse to grade
# on a mismatch. Keep it as a literal - an ARG would be hoisted and defeat it.
RUN echo "02" > /etc/harbor-step-id

# setpriv drops the verifier to nobody before it builds or runs candidate code.
# The native libraries are the ones the candidate's own workspace link needs,
# measured rather than guessed: a full arti workspace build compiles every
# rlib and then fails at the final binary link with `unable to find library
# -lsqlite3` if libsqlite3-dev is absent. libssl-dev and liblzma-dev cover the
# OpenSSL crypto backend and the directory-document decompressor. The driver
# crate itself pulls none of these - only the candidate's workspace build does,
# and that build is a diagnostic here, so a missing lib would not zero a group;
# it would just make the log misleading.
RUN apt-get update && apt-get install -y --no-install-recommends \
        util-linux \
        ca-certificates \
        pkg-config \
        libssl-dev \
        libsqlite3-dev \
        liblzma-dev \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY . /tests

# ---------------------------------------------------------------------------
# Bake the dependency universe the candidate's workspace was built against
# ---------------------------------------------------------------------------
# What has to resolve here is a CANDIDATE's workspace, not the Oracle's. The
# workspace is carried up the ladder by the /app artifact, and the contract
# tells the candidate to preserve the supplied manifests, so at this step it
# can legitimately still be sitting on any earlier rung of the ladder --
# including the rung it started on, whose manifests name `chrono`,
# `crypto-mac` and `tokio-native-tls`. Nothing agent-visible asks for those to
# move: the migrations are properties of the upstream releases this ladder is
# built from, not of any milestone's contract.
#
# Priming {this checkpoint, its predecessor, the driver} alone cannot resolve
# such a workspace, and the predecessor rung is not a stand-in for it: the
# predecessor is the release BEFORE this one, while a no-op candidate presents
# the tree the ladder STARTED from. From step 03 on neither rung carries the
# earlier releases' crates at all -- across steps 03-12 this image would lack
# between 176 and 236 of the 300 registry packages that tree names (208 at step
# 03) -- and every resolve attempt then ends `no matching package named chrono
# found`, every group is not_run, and the step scores 0 without one line of the
# candidate's code being compiled. The same door closes on a candidate that
# presents its own reviewed lockfile: attempting it has to re-resolve (the
# driver's dependencies are not in that lock), and a fresh resolve cannot
# select the yanked `sha2 0.9.8` these 2021-2022 releases pin.
#
# So vendor every graph this step ships -- the reviewed checkpoint trees, the
# driver's own dependencies, and the twelve release stand-ins the agent
# image is itself built from (`environment/assets/prefetch/NN`, copied
# verbatim to `assets/prefetch/release/NN`; keep the copies in sync) -- and make
# that directory the ONLY universe cargo resolves against. Two things follow,
# and both are the point:
#
#   * The verifier resolves exactly what the candidate's own image resolves.
#     environment/Dockerfile vendors these same twelve stand-ins, so a
#     workspace that builds for the candidate offline, on any rung of the
#     ladder, resolves here too -- and a crate outside that set was never
#     reachable by the candidate in the first place.
#   * Version selection stops depending on what crates.io served that minute.
#     A directory source has no yank metadata and holds no version that is not
#     baked into it, so a re-resolve is deterministic and the "newest version
#     in the cached index, with no .crate to download" failure that the
#     registry cache alone left behind (A67, A70) cannot arise.
#
# The scored assertions do not move: this decides which crate versions the
# candidate's tree is compiled against, never which behaviour it must produce.
# The driver build still runs with no network.
RUN set -eux; \
    cp -a /tests/assets/prefetch /prefetch; \
    syncs=""; \
    for d in /prefetch/checkpoint /prefetch/checkpoint-prev /prefetch/driver /prefetch/release/*/; do \
        [ -f "$d/Cargo.toml" ] || continue; \
        syncs="$syncs --sync $d/Cargo.toml"; \
    done; \
    cd /prefetch/checkpoint; \
    cargo vendor --versioned-dirs --locked $syncs /opt/vendor > /opt/vendor-config.toml; \
    rm -rf /prefetch; \
    cat /opt/vendor-config.toml >> "$CARGO_HOME/config.toml"; \
    rm /opt/vendor-config.toml; \
    cat "$CARGO_HOME/config.toml"; \
    rm -rf "$CARGO_HOME/registry"; \
    chmod -R a+rwX "${CARGO_HOME:-/usr/local/cargo}" /opt/vendor

# The registry cache `cargo vendor` downloaded through is deleted before this
# layer closes. With the source replacement in place, cargo reads every crate
# from /opt/vendor and never consults it, and shipping both roughly doubles the
# image. (The agent's own image keeps both: nothing needs both there either,
# but nothing is harmed, and it is the mechanism the sibling package uses.)
#
# The `chmod` runs in THIS layer on purpose. test.sh builds and runs
# candidate code as nobody, and cargo takes file locks inside CARGO_HOME
# whether or not it downloads anything, so both trees have to be readable --
# and writable where cargo locks -- by that identity; some crates also ship
# source files with no other-read bit. As its own `RUN`, every one of those
# files would first be copied up out of this layer in order to have its mode
# changed, which costs minutes per image; here, on files this layer already
# owns, it is nearly free.

# Harbor restores the cumulative /app artifact here before running the verifier.
WORKDIR /app
