# Agent environment. Reused across all twelve steps: Harbor builds it once and
# restores /app between steps, so anything installed here is available at every
# milestone and nothing installed by the agent at step N is guaranteed to
# survive to step N+1.
FROM rust:1.98.1-bookworm

# The toolchain is pinned, and pinned identically in every step's verifier
# image. Upstream ships no rust-toolchain.toml at any of the twelve
# checkpoints, per-crate `rust-version` drifts from 1.56 to 1.60 across the
# chain, and the early lockfiles pin `time 0.3.4`, which stopped compiling on
# rustc >= 1.80. One pinned toolchain is what makes the ladder reproducible.

# Native libraries the workspace links against: a full build compiles every
# rlib and then fails at the final binary link with
# `unable to find library -lsqlite3` if libsqlite3-dev is absent. libssl-dev
# backs the OpenSSL crypto and TLS backends; liblzma-dev backs the directory
# document decompressor.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        libsqlite3-dev \
        libssl-dev \
        liblzma-dev \
        pkg-config \
        procps \
        python3 \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Offline formatting and linting, so the agent can check its own work without
# depending on the network mid-step.
RUN rustup component add rustfmt clippy

WORKDIR /app

# Keep this script and every [steps.agent].timeout_sec in task.toml
# synchronized. The script is an agent-visible countdown; Harbor enforces the
# actual timeout.
COPY timer.sh /app/timer.sh
RUN chmod +x /app/timer.sh

# ---------------------------------------------------------------------------
# Prime the registry cache with all twelve steps' dependency graphs
# ---------------------------------------------------------------------------
# The agent runs with no general network access (task.toml [agent]
# network_mode = "allowlist"): crates.io is unreachable, so every crate the
# agent's own `cargo build --workspace` needs has to be in the image already.
# Without this the first `cargo build` of every step fails to resolve its
# dependencies.
#
# One stand-in per step, `assets/prefetch/NN/`, generated by
# assets/gen-prefetch.py from that step's own manifests and its frozen
# Cargo.lock: the release's registry dependencies at the release's locked
# versions, with the dependency features the members' [features] tables enable.
# The task's own crates are not in them (they are `path =` members of the
# agent's workspace, not registry dependencies) and neither is any upstream
# implementation -- the twelve stand-ins resolve to exactly the 300..413
# registry packages the twelve release lockfiles name, and nothing else.
#
# The workspace is carried up the ladder, so the crates needed at step 12 are
# not the crates needed at step 1 (300 at step 01, 413 at step 12, 1364 in
# union). Each step gets its own fetch and they share this CARGO_HOME, so what
# lands in the cache is their union -- including both ends of every transition
# a candidate might be sitting on. `--locked` makes the build fail loudly if a
# stand-in and its lockfile ever drift apart, rather than silently resolving
# against whatever the registry serves that minute.
COPY assets/prefetch /opt/prefetch
RUN set -eu; \
    for d in /opt/prefetch/*/; do \
        echo "prefetching $d"; \
        ( cd "$d" && cargo fetch --locked ); \
    done

# ---------------------------------------------------------------------------
# Vendor the same graphs, and point cargo at them
# ---------------------------------------------------------------------------
# Fetching into the registry cache is not sufficient on its own. It covers a
# build whose Cargo.lock already matches its manifests -- every step's first
# build does -- but not a build that has to re-resolve, which is most of the
# ladder: at steps 02 and up the candidate must move crates, rename the facade
# crate, and add the dependencies the release introduces, and cargo then
# re-resolves every requirement the old lockfile does not already satisfy. In
# that state cargo picks the newest version in the cached *index* -- the index
# cache carries every version a crate has ever published -- and then fails,
# because `download` for a version that was never fetched has nowhere to go:
#
#   step 02, release-02 tree carrying the release-01 lockfile:
#     error: failed to download `tokio-macros v2.7.2`
#   step 04, same shape:
#     error: failed to select a version for the requirement
#       `crossbeam-channel = "^0.5.0"`
#
# The registry cache alone therefore leaves two of the eleven transitions
# unresolvable with the network gone.
#
# `cargo vendor` writes the same 1364 crates out as an unpacked directory
# source, and the source-replacement config makes that directory the *only*
# universe cargo resolves against: candidates are exactly the baked versions,
# re-resolution succeeds offline, and the version cargo picks does not depend
# on what crates.io served the day the image was built. The registry cache is
# kept as well; nothing needs both, and keeping it does no harm.
RUN set -eu; \
    syncs=""; \
    for d in /opt/prefetch/*/; do syncs="$syncs --sync $d/Cargo.toml"; done; \
    cd /opt/prefetch/01; \
    cargo vendor --versioned-dirs --locked $syncs /opt/vendor > /opt/vendor-config.toml; \
    rm -rf /opt/prefetch; \
    cat /opt/vendor-config.toml >> "$CARGO_HOME/config.toml"; \
    rm /opt/vendor-config.toml; \
    cat "$CARGO_HOME/config.toml"

# Some crates ship source files with no other-read bit, and cargo takes file
# locks inside CARGO_HOME whether or not it downloads anything. An agent that
# chooses to build as a non-root user must not hit a permission error on a
# dependency it never named.
RUN chmod -R a+rX "$CARGO_HOME/registry" /opt/vendor \
    && find "$CARGO_HOME/registry" /opt/vendor -type d -exec chmod a+w {} +


