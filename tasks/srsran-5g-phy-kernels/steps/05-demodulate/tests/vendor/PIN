# Upstream pin. The agent environment and every verifier image use exactly this
# commit: the speedup ratio is only meaningful against this base.
SRS_REPO=https://github.com/srsran/srsRAN_Project
SRS_TAG=release_25_10
SRS_SHA=d2f4b70dda8e2c557d5b05a0ac5f92dbddda19bc

# The canonical configure command. The agent environment, the verifier's base
# tree and the candidate build all use these exact flags, so what is compared
# is the same program built the same way. MARCH is pinned rather than left at
# upstream's default of `native` so that the instruction-set envelope does not
# depend on which machine happens to build the tree.
SRS_CMAKE_OPTS="-DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON -DMARCH=x86-64-v3 -DENABLE_WERROR=OFF -DENABLE_MKL=OFF -DENABLE_ARMPL=OFF -DENABLE_UHD=OFF -DENABLE_ZEROMQ=OFF -DENABLE_BACKWARD=OFF -DENABLE_PLUGINS=OFF"

# The library targets the per-function harness links against.
SRS_LIB_TARGETS="srsran_ldpc srsran_channel_coding srsran_crc_calculator srsran_polar srsran_short_block srsran_channel_modulation srsran_channel_precoder srsran_ofh_compression log_likelihood_ratio srsvec srslog srsran_support srsran_ran"

# The project's own tests that build without the (unpublished) PHY test vectors.
SRS_TEST_TARGETS="channel_precoder_test dft_processor_test dft_processor_ci16_test evm_calculator_test"
