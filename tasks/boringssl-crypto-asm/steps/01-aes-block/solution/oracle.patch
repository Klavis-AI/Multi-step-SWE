+	pshufb	xmm2,xmm3  ; 2 = sb2t
+	movdqa	xmm3,xmm0  ; 3 = A
+	pxor	xmm2,xmm5  ; 2 = 2A
+	pshufb	xmm0,xmm1  ; 0 = B
+	add	r9,16  ; next key
+	pxor	xmm0,xmm2  ; 0 = 2A+B
+	pshufb	xmm3,xmm4  ; 3 = D
