+	DQ	0x01040A060F0B0780,0x030D0E0C02050809
+
+$L$k_s0F:  ; s0F
+	DQ	0x0F0F0F0F0F0F0F0F,0x0F0F0F0F0F0F0F0F
+
+$L$k_ipt:  ; input transform (lo, hi)
+	DQ	0xC2B2E8985A2A7000,0xCABAE09052227808
+	DQ	0x4C01307D317C4D00,0xCD80B1FCB0FDCC81
+
