+	pshufb	%xmm3,%xmm2  // 2 = 1/iak
+	pxor	%xmm0,%xmm2  // 2 = io
+	movdqa	%xmm10,%xmm3  // 3 : 1/jak
+	pshufb	%xmm4,%xmm3  // 3 = 1/jak
+	pxor	%xmm1,%xmm3  // 3 = jo
+	movdqa	%xmm13,%xmm4  // 4 : sbou
+	pshufb	%xmm2,%xmm4  // 4 = sbou
