+// encrypting
+	addq	$16,%rdx
+	pxor	.Lk_s63(%rip),%xmm4
+	pshufb	%xmm5,%xmm4
+	movdqa	%xmm4,%xmm3
+	pshufb	%xmm5,%xmm4
+	pxor	%xmm4,%xmm3
+	pshufb	%xmm5,%xmm4
+	pxor	%xmm4,%xmm3
+
