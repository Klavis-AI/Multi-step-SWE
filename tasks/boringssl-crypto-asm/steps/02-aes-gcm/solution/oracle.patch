+	vpclmulqdq	zmm1,zmm0,zmm30,0x01  ; a_L * b_H
+	vpclmulqdq	zmm2,zmm0,zmm30,0x10  ; a_H * b_L
+	vpclmulqdq	zmm3,zmm0,zmm30,0x11  ; a_H * b_H
