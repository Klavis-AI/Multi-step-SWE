+++ b/crypto/fipsmodule/aes/asm/ghash-x86.pl	2026-09-23 16:08:34.747375790 +0000
@@ -0,0 +1,691 @@
+#! /usr/bin/env perl
+# Copyright 2010-2016 The OpenSSL Project Authors. All Rights Reserved.
+#
