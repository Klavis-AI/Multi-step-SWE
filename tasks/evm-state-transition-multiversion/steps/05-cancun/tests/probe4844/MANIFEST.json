{
  "driver": "tests/blobgas_probe.sh",
  "file_count": 39,
  "name": "probe4844",
  "non_scenario_checks": {
    "blob-tx-must-not-be-a-create": {
      "fork": "Cancun",
      "inputs": [
        "env-one-blob.json",
        "bad-create-txs.json"
      ],
      "rule": "eip-4844.md: the field `to` MUST NOT be `nil`. Either refusal layer counts; only acceptance fails"
    },
    "interface-control-clean-input-runs": {
      "fork": "Cancun",
      "inputs": [
        "env-one-blob.json",
        "txs-one-blob.json"
      ],
      "rule": "positive control for the four refusal checks below: a tool that refuses every Cancun input must not collect them for free"
    },
    "malformed-env-is-a-nonzero-exit": {
      "fork": "Cancun",
      "inputs": [
        "bad-env-unparseable.json",
        "txs-one-blob.json"
      ],
      "rule": "TEST_INTERFACE.md exit-status rule"
    },
    "malformed-txs-is-a-nonzero-exit": {
      "fork": "Cancun",
      "inputs": [
        "env-one-blob.json",
        "bad-txs-unparseable.rlp"
      ],
      "rule": "TEST_INTERFACE.md exit-status rule"
    },
    "schema-blob-fields-absent-at-shanghai": {
      "fork": "Shanghai",
      "inputs": [
        "env-shanghai-schema.json",
        "txs-shanghai-schema.json"
      ],
      "rule": "blobGasUsed and currentExcessBlobGas are a Cancun header extension and must not appear at an earlier fork"
    },
    "unknown-fork-is-a-nonzero-exit": {
      "fork": "NoSuchFork",
      "inputs": [
        "env-one-blob.json",
        "txs-one-blob.json"
      ],
      "rule": "TEST_INTERFACE.md exit-status rule"
    }
  },
  "provenance": "synthetic (step 05); see scratch/05-cancun/mkprobe4844.py for the generator",
  "scenario_count": 16,
  "scenarios": {
    "blob-gas-cap": {
      "asserts": [
        "result.blobGasUsed",
        "result.gasUsed",
        "rejected"
      ],
      "derivation": "eip-4844.md: `assert blob_gas_used <= MAX_BLOB_GAS_PER_BLOCK`, MAX_BLOB_GAS_PER_BLOCK = 786432. Two transactions of four blobs each would spend 8 * GAS_PER_BLOB(131072) = 1048576. The first fits (4 * 131072 = 524288 = 0x80000, 21000 gas), the second takes the running total past the cap and is excluded.",
      "env": "env-blob-gas-cap.json",
      "fork": "Cancun",
      "txs": "txs-blob-gas-cap.json"
    },
    "blob-hash-version": {
      "asserts": [
        "result.blobGasUsed",
        "rejected"
      ],
      "derivation": "eip-4844.md: `assert h[0] == VERSIONED_HASH_VERSION_KZG` for every blob_versioned_hash. The only hash here starts 0x02, so the transaction is invalid and spends no blob gas.",
      "env": "env-blob-hash-version.json",
      "fork": "Cancun",
      "txs": "txs-blob-hash-version.json"
    },
    "blob-no-hashes": {
      "asserts": [
        "result.blobGasUsed",
        "rejected"
      ],
      "derivation": "eip-4844.md: `assert len(tx.blob_versioned_hashes) > 0`. A type-3 transaction with an empty list is invalid and spends no blob gas.",
      "env": "env-blob-no-hashes.json",
      "fork": "Cancun",
      "txs": "txs-blob-no-hashes.json"
    },
    "blobhash": {
      "asserts": [
        "result.blobGasUsed",
        "rejected",
        "storage"
      ],
      "derivation": "BLOBHASH replaces index with tx.blob_versioned_hashes[index] if index < len(...), and otherwise with a zeroed bytes32",
      "env": "env-blobhash.json",
      "fork": "Cancun",
      "txs": "txs-blobhash.json"
    },
    "excess-above-target": {
      "asserts": [
        "result.blobGasUsed",
        "result.currentExcessBlobGas",
        "rejected"
      ],
      "derivation": "calc_excess_blob_gas: 786432 + 131072 - TARGET(393216) = 524288",
      "env": "env-excess-above-target.json",
      "fork": "Cancun",
      "txs": "txs-excess-above-target.json"
    },
    "excess-below-target": {
      "asserts": [
        "result.blobGasUsed",
        "result.currentExcessBlobGas",
        "rejected"
      ],
      "derivation": "calc_excess_blob_gas: 65536 + 131072 < TARGET(393216), so 0 -- the running total is bounded at zero, it does not go negative",
      "env": "env-excess-below-target.json",
      "fork": "Cancun",
      "txs": "txs-excess-below-target.json"
    },
    "maxfee-exactly-equal": {
      "asserts": [
        "result.blobGasUsed",
        "result.gasUsed",
        "rejected"
      ],
      "derivation": "max_fee_per_blob_gas == base_fee_per_blob_gas is >=, so valid",
      "env": "env-maxfee-exactly-equal.json",
      "fork": "Cancun",
      "txs": "txs-maxfee-exactly-equal.json"
    },
    "maxfee-one-below": {
      "asserts": [
        "result.blobGasUsed",
        "rejected"
      ],
      "derivation": "max_fee_per_blob_gas=18 < base_fee_per_blob_gas=19, so the transaction is invalid and spends no blob gas",
      "env": "env-maxfee-one-below.json",
      "fork": "Cancun",
      "txs": "txs-maxfee-one-below.json"
    },
    "no-blob-tx": {
      "asserts": [
        "result.blobGasUsed",
        "result.currentExcessBlobGas",
        "rejected"
      ],
      "derivation": "no blob tx in the block, so blob_gas_used = 0",
      "env": "env-no-blob-tx.json",
      "fork": "Cancun",
      "txs": "txs-no-blob-tx.json"
    },
    "one-blob": {
      "asserts": [
        "result.blobGasUsed",
        "result.currentExcessBlobGas",
        "result.gasUsed",
        "rejected",
        "balances"
      ],
      "derivation": "blobGasUsed = GAS_PER_BLOB(131072) * 1 = 131072; blob fee burned = 131072 * base_fee_per_blob_gas(excess=10000000)=19",
      "env": "env-one-blob.json",
      "fork": "Cancun",
      "txs": "txs-one-blob.json"
    },
    "pe-noncanonical-z": {
      "asserts": [
        "rejected",
        "storage"
      ],
      "derivation": "z == BLS_MODULUS is not a canonical field element (must be strictly less)",
      "env": "env-pe-noncanonical-z.json",
      "fork": "Cancun",
      "txs": "txs-pe-noncanonical-z.json"
    },
    "pe-short-input": {
      "asserts": [
        "rejected",
        "storage"
      ],
      "derivation": "len(input) == 191, and the precompile asserts len(input) == 192",
      "env": "env-pe-short-input.json",
      "fork": "Cancun",
      "txs": "txs-pe-short-input.json"
    },
    "pe-valid": {
      "asserts": [
        "rejected",
        "storage"
      ],
      "derivation": "a valid opening returns FIELD_ELEMENTS_PER_BLOB(4096) and BLS_MODULUS as padded 32-byte big-endian values",
      "env": "env-pe-valid.json",
      "fork": "Cancun",
      "txs": "txs-pe-valid.json"
    },
    "pe-wrong-versioned-hash": {
      "asserts": [
        "rejected",
        "storage"
      ],
      "derivation": "kzg_to_versioned_hash(commitment) != versioned_hash (version byte 0x02)",
      "env": "env-pe-wrong-versioned-hash.json",
      "fork": "Cancun",
      "txs": "txs-pe-wrong-versioned-hash.json"
    },
    "pe-wrong-y": {
      "asserts": [
        "rejected",
        "storage"
      ],
      "derivation": "verify_kzg_proof fails: p(2) = 0 for the zero polynomial, not 1",
      "env": "env-pe-wrong-y.json",
      "fork": "Cancun",
      "txs": "txs-pe-wrong-y.json"
    },
    "two-blobs": {
      "asserts": [
        "result.blobGasUsed",
        "result.currentExcessBlobGas",
        "result.gasUsed",
        "rejected",
        "balances"
      ],
      "derivation": "blobGasUsed = GAS_PER_BLOB * 2 = 262144",
      "env": "env-two-blobs.json",
      "fork": "Cancun",
      "txs": "txs-two-blobs.json"
    }
  },
