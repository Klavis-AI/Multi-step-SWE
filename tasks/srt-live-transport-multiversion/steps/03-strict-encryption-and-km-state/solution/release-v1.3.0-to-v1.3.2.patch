+#define CREATE_TEST_CASE_BLOCKING(CASE_NUMBER, DESC) TEST_F(TestStrictEncryption, CASE_NUMBER##_Blocking_##DESC)\
+{\
+    TestConnect<TestResultBlocking>(TEST_##CASE_NUMBER);\
+}
