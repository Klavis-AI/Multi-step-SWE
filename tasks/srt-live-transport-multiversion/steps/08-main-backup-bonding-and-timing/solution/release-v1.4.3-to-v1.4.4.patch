+#elif defined(ATOMIC_USE_GCC_INTRINSICS)
+  volatile T value_;
+#elif defined(ATOMIC_USE_MSVC_INTRINSICS)
+  volatile T value_;
+#elif defined(ATOMIC_USE_CPP11_ATOMIC)
+  std::atomic<T> value_;
