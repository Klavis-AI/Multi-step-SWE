-
-        if (co.uKmPreAnnouncePkt == 0 || km_preanno > (km_refresh - 1) / 2)
-        {
-            co.uKmPreAnnouncePkt = (km_refresh - 1) / 2;
-            LOGC(aclog.Warn,
-                 log << "SRTO_KMREFRESHRATE=0x" << std::hex << km_refresh << ": setting SRTO_KMPREANNOUNCE=0x"
