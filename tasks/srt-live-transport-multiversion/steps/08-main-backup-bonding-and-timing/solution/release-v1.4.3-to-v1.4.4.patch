new file mode 100644
index 0000000..60d1e8d
--- /dev/null
+++ b/.github/workflows/iOS.yaml
@@ -0,0 +1,25 @@
+name: iOS
+
+on:
+  push:
+    branches: [ master ]
+  pull_request:
+    branches: [ master ]
+
+jobs:
+  build:
+    strategy:
+      matrix:
+        cxxstdsync: [OFF, ON]
+
+    name: iOS-cxxsync${{ matrix.cxxstdsync }}
+    runs-on: macos-latest
+
+    steps:
+    - uses: actions/checkout@v2
+    - name: configure
+      run: |
+        mkdir _build && cd _build
+        cmake ../ -DENABLE_ENCRYPTION=OFF -DENABLE_STDCXX_SYNC=${{matrix.cxxstdsync}} -DENABLE_UNITTESTS=OFF -DENABLE_EXPERIMENTAL_BONDING=ON --toolchain scripts/iOS.cmake
+    - name: build
+      run: cd _build && cmake --build ./
