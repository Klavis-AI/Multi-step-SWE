+    }
+
+    // Add packet to the same position
+    CUnit* unit = unit_queue.getNextAvailUnit();
+    EXPECT_NE(unit, nullptr);
+    unit->m_Packet.setLength(payload_size);
+    EXPECT_EQ(rcv_buffer.addData(unit, 1), -1);
