+
+        if (stop)
+        {
+            // First, stop all media.
+            med_acp->Close();
+            med_clr->Close();
+
+            // Then stop the tunnel (this is only a signal
+            // to a cleanup thread to delete it).
+            Stop();
+        }
+    }
+
+    void Stop();
+
+    bool decommission_if_dead(bool forced); // [[affinity = g_tunnels.thr]]
+};
