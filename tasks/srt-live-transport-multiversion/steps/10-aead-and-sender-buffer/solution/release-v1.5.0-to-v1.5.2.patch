-steady_clock::time_point CRcvBuffer::debugGetDeliveryTime(int offset)
-{
-    int i;
-    if (offset > 0)
-        i = shift(m_iStartPos, offset);
-    else
-        i = m_iStartPos;
-
-    CUnit* u = m_pUnit[i];
-    if (!u || u->m_iFlag != CUnit::GOOD)
-        return steady_clock::time_point();
-
-    return getPktTsbPdTime(u->m_Packet.getMsgTimeStamp());
