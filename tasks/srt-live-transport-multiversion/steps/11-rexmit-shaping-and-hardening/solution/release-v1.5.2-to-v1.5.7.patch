+CUDTSocket* TestMockCUDT::locateSocket(int32_t s)
+{
+    SRTSOCKET sock (s);
+    return CUDT::uglobal().locateSocket(sock);
+}
+
+bool TestMockCUDT::setSocket(int32_t sock)
+{
+    CUDTSocket* s = locateSocket(sock);
+    if (!s)
+        return false;
+    core = &s->core();
+    return true;
+}
