+                5, SrtVersion(1, 5, 3), kmout, kmout_len),
+            SRT_CMD_NONE);
+    EXPECT_EQ(m_crypt.m_RcvKmState, SRT_KM_S_SECURED);
+    EXPECT_EQ(kmout[SRT_KMR_KMSTATE], (uint32_t)SRT_KM_S_BADSECRET);
+    EXPECT_EQ(kmout_len, 1u);
+}
