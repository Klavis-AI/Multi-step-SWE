+class InvertedGuard
+{
+    pthread_mutex_t* m_pMutex;
+public:
+
+    InvertedGuard(pthread_mutex_t* smutex): m_pMutex(smutex)
+    {
+        if ( !smutex )
+            return;
+
+        CGuard::leaveCS(*smutex);
+    }
+
+    ~InvertedGuard()
+    {
+        if ( !m_pMutex )
+            return;
+
+        CGuard::enterCS(*m_pMutex);
+    }
+};
