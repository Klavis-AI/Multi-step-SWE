-            // Socket readiness for connection is checked by polling on WRITE allowed sockets.
-            int len = 2;
-            SRTSOCKET ready[2];
-            if ( srt_epoll_wait(srt_conn_epoll, 0, 0, ready, &len, -1, 0, 0, 0, 0) != -1 )
