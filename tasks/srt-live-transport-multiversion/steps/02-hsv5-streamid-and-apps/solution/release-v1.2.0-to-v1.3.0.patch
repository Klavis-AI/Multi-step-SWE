-        {
-            cout << "Binding a server on " << host << ":" << port << " ...";
-            cout.flush();
-        }
-        stat = srt_bind(m_bindsock, psa, sizeof sa);
-        if ( stat == SRT_ERROR )
-        {
-            srt_close(m_bindsock);
-            Error(UDT::getlasterror(), "srt_bind");
