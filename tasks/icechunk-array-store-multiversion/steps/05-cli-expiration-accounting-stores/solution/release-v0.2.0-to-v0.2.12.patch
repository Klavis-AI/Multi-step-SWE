+                store.set_virtual_ref("array/c/0/0/0", bad_ref, true).await,
+                Err(StoreError{kind: StoreErrorKind::InvalidVirtualChunkContainer { chunk_location },..}) if chunk_location == bad_location.0));
+    Ok(())
+}
 
