+            }
+            Ok(())
+        }),
+        Err(e) => {
+            if e.use_stderr() {
+                eprintln!("{}", e);
+                std::process::exit(e.exit_code());
+            } else {
+                println!("{}", e);
+                Ok(())
+            }
+        }
+    }
+}
