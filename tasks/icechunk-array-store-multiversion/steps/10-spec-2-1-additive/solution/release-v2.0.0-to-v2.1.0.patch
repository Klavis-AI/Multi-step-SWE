+        access_key_id: "minioadmin".into(),
+        secret_access_key: "minioadmin".into(),
+        session_token: None,
+        expires_after: None,
+    });
+    new_s3_storage(
+        options,
+        "testbucket".to_string(),
+        Some(prefix.to_string()),
+        Some(credentials),
+        None,
+    )
