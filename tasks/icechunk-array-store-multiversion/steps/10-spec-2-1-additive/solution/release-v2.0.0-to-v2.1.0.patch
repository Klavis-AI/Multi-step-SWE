+    match repo_info.find_snapshot(id) {
+        Ok(si) => Ok(si.pruned_ancestor_tx_logs),
+        Err(IcechunkFormatError {
+            kind: IcechunkFormatErrorKind::SnapshotIdNotFound { .. },
+            ..
+        }) => Ok(Vec::new()),
+        Err(e) => Err(e.inject()),
+    }
