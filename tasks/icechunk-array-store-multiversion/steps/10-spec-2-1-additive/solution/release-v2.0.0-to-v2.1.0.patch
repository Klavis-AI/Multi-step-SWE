+
+    @benchmark
+    def write():
+        session = repo.writable_session("main")
+        session.store.set_virtual_refs_arr(
+            "array",
+            chunk_grid_shape=(NUM_VIRTUAL_CHUNK_REFS,),
+            locations=locations_arr.tolist(),
+            offsets=offsets_arr,
+            lengths=lengths_arr,
+            validate_containers=False,
+        )
