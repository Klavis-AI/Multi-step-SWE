+        // nodes sorted lexicographically
+        assert_eq!(ops[1], ("fetch_manifest_splitting".to_string(), lat_manifest_id));
+        assert_eq!(ops[2], ("fetch_manifest_splitting".to_string(), lon_manifest_id));
+
+        Ok(())
