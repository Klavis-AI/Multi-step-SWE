+
+        self.reindex_array(
+            array_path,
+            ReindexMapping::ForwardBackward {
+                forward: make_shift_closure(chunk_offset, &num_chunks),
+                backward: make_shift_closure(&negated_offset, &num_chunks),
+            },
+        )
+        .await
+    }
