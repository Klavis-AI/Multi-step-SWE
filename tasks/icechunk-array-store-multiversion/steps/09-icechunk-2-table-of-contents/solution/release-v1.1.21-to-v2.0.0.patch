-fn lookup_ref<'a>(
-    array_manifest: generated::ArrayManifest<'a>,
-    coord: &ChunkIndices,
-) -> Option<generated::ChunkRef<'a>> {
-    array_manifest.refs().lookup_by_key(coord.0.as_slice(), |chunk_ref, coords| {
