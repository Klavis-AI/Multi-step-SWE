+                    kind: PyUpdateType::RepoStatusChanged {
+                        status: status.clone().into(),
+                    },
+                    updated_at,
+                    backup_path,
+                },
+            )?
+            .into_any()
+            .unbind(),
+            UpdateType::ConfigChangedUpdate => Bound::new(
+                py,
+                PyUpdate {
+                    kind: PyUpdateType::ConfigChanged {},
+                    updated_at,
+                    backup_path,
+                },
+            )?
+            .into_any()
+            .unbind(),
+            UpdateType::MetadataChangedUpdate => Bound::new(
