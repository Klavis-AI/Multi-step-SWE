+        session
+            .move_node("/source".try_into().unwrap(), "/dest".try_into().unwrap())
+            .await
+            .unwrap();
+
+        // disable move_node after the session was created
+        repo.set_feature_flag("move_node", Some(false)).await.unwrap();
+
