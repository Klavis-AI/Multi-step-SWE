+                .add_snapshot(
+                    asset_manager.spec_version(),
+                    new_snapshot_info,
+                    Some(branch_name),
+                    update_type,
+                    None,
+                    backup_path,
+                    num_updates_per_repo_info_file,
+                )
+                .inject()?,
+        ))
+    };
 
