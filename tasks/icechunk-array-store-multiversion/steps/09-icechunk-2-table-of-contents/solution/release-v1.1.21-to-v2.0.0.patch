+    "![image.png](attachment:993eb216-e995-4be9-a467-6fd0c47cc911.png)\n",
+    "\n",
+    "\n",
+    "Our approach will be to read all existing tiles, and write them to the appropriate region of the global datacube."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 2,
+   "id": "8a6ba9c9-bfa7-4135-b711-35ccb96427f3",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from dataclasses import dataclass\n",
+    "\n",
+    "# Define the tiling grid: each tile is 10°x10°, and\n",
+    "# for years 2000, 2005, 2010, 2015, 2020\n",
+    "\n",
+    "ROOT_URI = \"gs://earthenginepartners-hansen/GLCLU2000-2020/v2\"\n",
+    "\n",
+    "\n",
+    "@dataclass\n",
+    "class TilingGrid:\n",
+    "    tilex = pd.RangeIndex(-180, 180, 10)\n",
+    "    tiley = pd.RangeIndex(80, -60, -10)\n",
+    "    year = pd.RangeIndex(2000, 2021, 5)\n",
+    "    npixels = 40_000  # pixels per dimension per tile\n",
+    "\n",
+    "    @property\n",
+    "    def datacube_shape(self) -> tuple[int, int, int]:\n",
+    "        return (\n",
+    "            len(self.year),\n",
+    "            self.npixels * len(self.tiley),\n",
+    "            self.npixels * len(self.tilex),\n",
+    "        )\n",
+    "\n",
+    "    def get_region(self, tile) -> dict[str, int]:\n",
+    "        xstart = (self.tilex.get_loc(np.round(tile.rio.bounds()[0], 3))) * self.npixels\n",
+    "        ystart = (self.tiley.get_loc(np.round(tile.rio.bounds()[-1], 3))) * self.npixels\n",
+    "        tstart = self.year.get_loc(tile.year.data.item())\n",
+    "        region = {\n",
+    "            \"x\": slice(xstart, xstart + tile.sizes[\"x\"]),\n",
+    "            \"y\": slice(ystart, ystart + tile.sizes[\"y\"]),\n",
+    "            \"year\": slice(tstart, tstart + 1),\n",
+    "        }\n",
+    "        return region\n",
+    "\n",
+    "\n",
+    "tiling = TilingGrid()"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "67eabddc-3e31-4f46-8e03-caf622f30b50",
+   "metadata": {},
+   "source": [
+    "We must define the chunk size for the final datacube. We will _choose_ (1000 x 1000) spatial chunks."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 3,
+   "id": "5cbf9d33-2c8b-4f52-a5ee-d92de878a98a",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "ZARR_CHUNK_SIZE = (1, 1000, 1000)\n",
+    "DASK_CHUNK_SIZE = (1, 8000, 8000)  # must be a integer multiple of ZARR_CHUNK_SIZE"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "c59086a8-6b13-4cf0-813e-1563e7e15f9f",
+   "metadata": {},
+   "source": [
+    "We will write this to `s3://icechunk-public-data/v1/glad`"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 4,
+   "id": "e7757794-555e-41d6-a3ab-5c1d2b38b809",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "storage = ic.s3_storage(\n",
+    "    bucket=\"icechunk-public-data\", prefix=\"v1/glad\", region=\"us-east-1\"\n",
+    ")"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "51bbbaac-d0a6-4ae2-98be-5d7a46932193",
+   "metadata": {
+    "jp-MarkdownHeadingCollapsed": true
+   },
+   "source": [
+    "## Approach\n",
+    "\n",
+    "1. Initialize the Icechunk store with the full cube, but write no data.\n",
+    "2. Incrementally populate the cube with data from each GeoTIFF tile in parallel."
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "5c725248-3ea6-4822-b326-b8a3b1dd6fc1",
+   "metadata": {},
+   "source": [
+    "## Initialize the store\n",
+    "\n",
+    "### Examine a single tile"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "c30e1467-df63-4cf3-a263-582ad034a90e",
+   "metadata": {},
+   "source": [
+    "First open a single file, this lets us examine extra attributes, data types, etc."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 5,
+   "id": "d3c5e992-de91-4fc6-93f4-4431b6bbdc66",
+   "metadata": {},
+   "outputs": [
+    {
+     "data": {
+      "text/html": [
+       "<pre>&lt;xarray.Dataset&gt; Size: 2GB\n",
+       "Dimensions:      (band: 1, x: 40000, y: 40000)\n",
+       "Coordinates:\n",
+       "  * band         (band) int64 8B 1\n",
+       "  * x            (x) float64 320kB -180.0 -180.0 -180.0 ... -170.0 -170.0 -170.0\n",
+       "  * y            (y) float64 320kB 70.0 70.0 70.0 70.0 ... 60.0 60.0 60.0 60.0\n",
+       "    spatial_ref  int64 8B ...\n",
+       "Data variables:\n",
+       "    band_data    (band, y, x) uint8 2GB ...</pre>"
+      ],
+      "text/plain": [
+       "<xarray.Dataset> Size: 2GB\n",
+       "Dimensions:      (band: 1, x: 40000, y: 40000)\n",
+       "Coordinates:\n",
+       "  * band         (band) int64 8B 1\n",
+       "  * x            (x) float64 320kB -180.0 -180.0 -180.0 ... -170.0 -170.0 -170.0\n",
+       "  * y            (y) float64 320kB 70.0 70.0 70.0 70.0 ... 60.0 60.0 60.0 60.0\n",
+       "    spatial_ref  int64 8B ...\n",
+       "Data variables:\n",
+       "    band_data    (band, y, x) uint8 2GB ..."
+      ]
+     },
+     "execution_count": 5,
+     "metadata": {},
+     "output_type": "execute_result"
+    }
+   ],
+   "source": [
+    "import os\n",
+    "\n",
+    "# request GDAL to use unauthenticated access\n",
+    "os.environ[\"GS_NO_SIGN_REQUEST\"] = \"1\"\n",
+    "ds = xr.open_dataset(\n",
+    "    f\"{ROOT_URI}/2000/70N_180W.tif\",\n",
+    "    # use rasterio to read the TIFF\n",
+    "    engine=\"rasterio\",\n",
+    "    # By default, xarray will replace NoData values with np.nan. Turn that off.\n",
+    "    mask_and_scale=False,\n",
+    ")\n",
+    "ds"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "88aab6af-5c17-4493-b05d-5124109d6f09",
+   "metadata": {},
+   "source": [
+    "Now we construct a helper function that renames the variable, and adds useful metadata like the `year`."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 6,
+   "id": "5069bdeb-94b0-4e25-b919-fc981af2dac2",
+   "metadata": {},
+   "outputs": [
+    {
+     "name": "stderr",
+     "output_type": "stream",
+     "text": [
+      "/var/folders/sc/hsdthq2x7mnbfvwnk7rp4xmr0000gn/T/ipykernel_72121/1148752937.py:17: UserWarning: The specified chunks separate the stored chunks along dimension \"x\" starting at index 8000. This could degrade performance. Instead, consider rechunking after loading.\n",
+      "  xr.open_dataset(\n"
+     ]
+    },
+    {
+     "data": {
+      "text/html": [
+       "<pre>&lt;xarray.Dataset&gt; Size: 2GB\n",
+       "Dimensions:      (year: 1, x: 40000, y: 40000)\n",
+       "Coordinates:\n",
+       "  * year         (year) int64 8B 2000\n",
+       "  * x            (x) float64 320kB -180.0 -180.0 -180.0 ... -170.0 -170.0 -170.0\n",
+       "  * y            (y) float64 320kB 70.0 70.0 70.0 70.0 ... 60.0 60.0 60.0 60.0\n",
+       "    spatial_ref  int64 8B ...\n",
+       "Data variables:\n",
+       "    lclu         (year, y, x) uint8 2GB dask.array&lt;chunksize=(1, 8000, 8000), meta=np.ndarray&gt;</pre>"
