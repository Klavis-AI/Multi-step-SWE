+impl JsStorage {
+    #[napi(factory)]
+    pub async fn new_in_memory() -> napi::Result<JsStorage> {
+        let storage = icechunk::storage::new_in_memory_storage().await.map_napi_err()?;
+        Ok(JsStorage(storage))
