+    fn storage_info(&self) -> StorageInfo {
+        let mut fields = vec![("bucket", self.bucket.clone())];
+        if !self.prefix.is_empty() {
+            fields.push(("prefix", self.prefix.clone()));
+        }
+        fields.extend(self.config.info_fields());
