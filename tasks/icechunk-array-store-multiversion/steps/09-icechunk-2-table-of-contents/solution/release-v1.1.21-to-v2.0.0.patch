+            let branch = session
+                .branch()
+                .map(|b| b.to_string())
+                .unwrap_or_else(|| "None".to_string());
+            fields.push(("branch", branch));
+            fields.push((
+                "has_uncommitted_changes",
+                py_bool(session.has_uncommitted_changes()),
+            ));
+        }
+        fields
+    }
