+pub fn node_id() -> impl Strategy<Value = NodeId> {
+    uniform8(any::<u8>()).prop_map(NodeId::new)
+}
+
+fn chunk_id() -> impl Strategy<Value = ChunkId> {
+    uniform12(any::<u8>()).prop_map(ChunkId::new)
