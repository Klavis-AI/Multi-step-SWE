+                n if n == FileTypeBin::Attributes as u8 => Ok(FileTypeBin::Attributes),
+                n if n == FileTypeBin::RepoInfo as u8 => Ok(FileTypeBin::RepoInfo),
+                n if n == FileTypeBin::TransactionLog as u8 => {
