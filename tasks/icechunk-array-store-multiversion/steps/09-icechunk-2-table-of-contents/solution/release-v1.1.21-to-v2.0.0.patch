+
+[package]
+name = "icechunk-js"
+version = "0.1.0"
+description = "JavaScript/TypeScript bindings for icechunk"
+repository = "https://github.com/earth-mover/icechunk"
+license = "Apache-2.0"
+keywords = ["zarr", "xarray", "database"]
+categories = ["database", "science", "science::geo"]
+authors = ["Earthmover PBC"]
+edition.workspace = true
+publish = false
+
+[lib]
+crate-type = ["cdylib"]
+
+[dependencies]
+napi = { version = "3.8.4", features = ["async", "tokio_rt", "serde-json", "chrono_date"] }
+napi-derive = "3.5.3"
+tokio = { version = "1", features = ["sync"] }
+bytes = "1"
+futures = "0.3"
+serde_json = "1"
+serde = { version = "1.0.228", features = ["derive", "rc"] }
+chrono = "0.4"
+async-trait = "0.1.89"
+typetag = "0.2.21"
+rand = "0.10.0"
+icechunk-storage = { path = "../icechunk-storage" }
+
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+icechunk = { path = "../icechunk" }
+
+[target.'cfg(target_family = "wasm")'.dependencies]
+icechunk = { path = "../icechunk", default-features = false, features = ["napi-send-contract"] }
+
+[build-dependencies]
+napi-build = "2"
+
+[profile.release]
+lto = true
+strip = "symbols"
