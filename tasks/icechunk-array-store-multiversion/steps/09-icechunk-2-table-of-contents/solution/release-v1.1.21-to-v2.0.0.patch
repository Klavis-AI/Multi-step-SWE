+                &VersionInfo::SnapshotId(second_amend_snap_id.clone()),
+            )
+            .await?;
+
+        // Final diff should have just one move,
+        // since they were all collapsed
+        assert_eq!(diff.moved_nodes.len(), 1);
+
+        Ok(())
+    }
