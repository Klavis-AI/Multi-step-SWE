index 00000000..72127650
--- /dev/null
+++ b/icechunk-format/flatbuffers/snapshot.fbs
@@ -0,0 +1,198 @@
+include "common.fbs";
+
+namespace generated;
+
+// --8<-- [start:manifest_file_info]
+// V1 manifest file metadata.
+struct ManifestFileInfo {
+    // The id of the manifest file in the repository's storage.
+    id: ObjectId12;
+
+    // Total serialized size of the manifest in bytes.
+    size_bytes: uint64;
+
+    // Total number of chunk references in the manifest.
+    num_chunk_refs: uint32;
+}
+// --8<-- [end:manifest_file_info]
+
+// --8<-- [start:manifest_file_info_v2]
+// V2 manifest file metadata.
+// The id, size_bytes, and num_chunk_refs fields MUST be present.
+// They are not marked `required` to allow future schema evolution.
+// Introduced in spec version 2.
+table ManifestFileInfoV2 {
+    // The id of the manifest file in the repository's storage.
+    id: ObjectId12;
+
+    // Total serialized size of the manifest in bytes.
+    size_bytes: uint64;
+
+    // Total number of chunk references in the manifest.
+    num_chunk_refs: uint32;
+
+    // Reserved for future use. Opaque bytes for future extensions.
+    extra: [uint8];
+}
+// --8<-- [end:manifest_file_info_v2]
+
+// --8<-- [start:chunk_index_range]
+// A range of chunk indexes
+struct ChunkIndexRange {
+  // inclusive
+  from: uint32;
+
+  // exclusive
+  to: uint32;
+}
+// --8<-- [end:chunk_index_range]
+
+// --8<-- [start:manifest_ref]
+// A pointer to a manifest file for a specific region of an array's chunk grid.
+table ManifestRef {
+    // The id of the manifest file in the repository's storage.
+    object_id: ObjectId12 (required);
+
+    // One ChunkIndexRange per dimension, in the same order as the array's
+    // dimensions. Defines which chunk coordinates this manifest covers.
+    extents: [ChunkIndexRange] (required);
+}
+// --8<-- [end:manifest_ref]
+
+// --8<-- [start:dimension_shape]
+// V1 shape representation for one dimension.
+struct DimensionShape {
+  // Total number of elements along this dimension.
+  array_length: uint64;
+
+  // Size of each chunk along this dimension.
+  // When a V2 implementation writes a V1 repo, this field may be
+  // inaccurate: V2 only tracks num_chunks, so chunk_length is
+  // back-computed as array_length.div_ceil(num_chunks).
+  // The authoritative chunk size comes from the Zarr metadata
+  // in user_data, not from this field.
+  chunk_length: uint64;
+}
+// --8<-- [end:dimension_shape]
+
+// --8<-- [start:dimension_shape_v2]
+// V2 shape representation for one dimension.
+table DimensionShapeV2 {
+  // Total number of array elements along this dimension.
+  array_length: uint64;
+
+  // Number of chunks along this dimension.
+  num_chunks: uint32;
+}
+// --8<-- [end:dimension_shape_v2]
+
+// --8<-- [start:dimension_name]
+table DimensionName {
+  // The name of this dimension. Absent if the dimension is unnamed.
+  name: string;
+}
+// --8<-- [end:dimension_name]
+
+// --8<-- [start:group_node_data]
+// Marker for a group node. Contains no data.
+table GroupNodeData {}
+// --8<-- [end:group_node_data]
+
+// --8<-- [start:array_node_data]
+// Data for an array node.
+table ArrayNodeData {
+  // V1 shape representation: one entry per dimension.
+  // In V2 snapshots this MUST be an empty list (use shape_v2 instead).
+  shape: [DimensionShape] (required);
+
+  // Optional dimension names, one per dimension.
+  dimension_names: [DimensionName];
+
+  // Pointers to all manifest files containing chunk references for this array.
+  // For a given array, manifest extents MUST NOT overlap — each chunk
+  // coordinate MUST be covered by at most one ManifestRef.
+  manifests: [ManifestRef] (required);
+
+  // V2 shape representation: one entry per dimension.
+  // In V1 snapshots this is absent. In V2 snapshots this MUST be present.
+  // Introduced in spec version 2.
+  shape_v2: [DimensionShapeV2];
+}
+// --8<-- [end:array_node_data]
+
+// --8<-- [start:node_data]
+// the node contents, that can be either a group or an array
+union NodeData {
+  Array :ArrayNodeData,
+  Group :GroupNodeData,
+}
+// --8<-- [end:node_data]
+
+// --8<-- [start:node_snapshot]
+// A single node (array or group) in the repository hierarchy.
+table NodeSnapshot {
+    // 8 random bytes identifying this node.
+    // Stable across snapshots — a node keeps its id for its lifetime.
+    id: ObjectId8 (required);
+
+    // The node's absolute path (see node path definition in common.fbs).
+    path: string (required);
+
+    // The Zarr metadata for this node — the contents of its zarr.json,
+    // stored as a UTF-8 JSON byte string.
+    user_data: [uint8] (required);
+
+    // The node contents — either an array or a group.
+    node_data: NodeData (required);
+
+    // Reserved for future use. Opaque bytes for future extensions.
+    // Introduced in spec version 2.
+    extra: [uint8];
+}
+// --8<-- [end:node_snapshot]
+
+
+// --8<-- [start:snapshot_table]
+table Snapshot {
+  // 12 random bytes identifying this snapshot.
+  // Also encoded in the file name.
+  id: ObjectId12 (required);
+
+  // The id of the parent snapshot.
+  // In V1 snapshots: MUST be present for all snapshots except the initial one.
+  // In V2 snapshots: MUST be empty (parent tracking moved to RepoInfo).
+  parent_id: ObjectId12;
+
+  // All nodes in this snapshot.
+  // MUST be sorted by path (see node path sort order in common.fbs).
+  nodes: [NodeSnapshot] (required);
+
+  // Time at which this snapshot was committed.
+  // Non-leap microseconds since Jan 1, 1970 UTC.
+  flushed_at: uint64;
+
+  // Commit message.
+  message: string (required);
+
+  // Snapshot-level metadata.
+  // MUST be sorted in ascending UTF-8 byte order of MetadataItem.name.
+  metadata: [MetadataItem] (required);
+
+  // The list of all manifest files this snapshot points to.
+  // MUST be sorted in ascending byte order of ManifestFileInfo.id.
+  // MUST be empty in V2 snapshots (use manifest_files_v2 instead).
+  manifest_files: [ManifestFileInfo] (required);
+
+  // V2 replacement for manifest_files.
+  // MUST be populated in V2 snapshots.
+  // MUST be sorted in ascending byte order of ManifestFileInfoV2.id.
+  // Introduced in spec version 2.
+  manifest_files_v2: [ManifestFileInfoV2];
+
+  // Reserved for future use. Opaque bytes for future extensions.
+  // Introduced in spec version 2.
+  extra: [uint8];
+}
+// --8<-- [end:snapshot_table]
+
+root_type Snapshot;
diff --git a/icechunk-format/flatbuffers/transaction_log.fbs b/icechunk-format/flatbuffers/transaction_log.fbs
new file mode 100644
index 00000000..f2c5c96d
--- /dev/null
+++ b/icechunk-format/flatbuffers/transaction_log.fbs
@@ -0,0 +1,119 @@
+include "common.fbs";
+
+namespace generated;
+
+// --8<-- [start:chunk_indices]
+// A single chunk coordinate in the array's chunk grid.
+// coords MUST contain one 0-based uint32 index per array dimension.
+table ChunkIndices {
+  coords: [uint32] (required);
+}
+
+// --8<-- [end:chunk_indices]
+
+// --8<-- [start:array_updated_chunks]
+// Identifies an array and lists the chunk coordinates where a
+// reference was added, overwritten, or deleted.
+table ArrayUpdatedChunks {
+  // The node id of the array.
+  node_id: ObjectId8 (required);
+
+  // The coordinates of all chunk references that were added, overwritten,
+  // or deleted in this transaction for this array. Each ChunkIndices
+  // contains a coords vector of uint32 representing the chunk's position
+  // in the array's chunk grid.
+  // MUST be sorted in ascending lexicographic order (compare first
+  // element, break ties with second element, etc.).
+  chunks: [ChunkIndices] (required);
+}
+
+// --8<-- [end:array_updated_chunks]
+
+// --8<-- [start:move_operation]
+// Whether a node is a group or an array. Recorded in MoveOperation
+// so conflict detection can proceed without fetching the full snapshot.
+enum NodeType: ubyte { Group = 0, Array }
+
+// A single move operation, recording that a node changed path.
+// All four fields MUST be present. They are not marked `required`
+// in the flatbuffers schema to allow future schema evolution.
+table MoveOperation {
+  // The node's path in the parent snapshot (see node path definition in common.fbs).
+  from: string;
+
+  // The node's path in the current snapshot.
+  to: string;
+
+  // The node id of the moved node.
+  node_id: ObjectId8;
+
+  // Whether this node is a Group or Array.
+  node_type: NodeType;
+}
+
+// --8<-- [end:move_operation]
+
+// --8<-- [start:transaction_log]
+// The initial snapshot's transaction log MUST have all lists empty.
+// The root group created during repository initialization is not
+// recorded in the transaction log.
+//
+// All ObjectId8 lists below MUST be sorted in ascending byte order
+// (i.e. lexicographic comparison of the 8 raw bytes).
+//
+// TODO: verify this holds after amend merging — a node could
+// end up in both new_* and updated_* lists.
+// A group's node id MUST NOT appear in more than one of
+// new_groups, deleted_groups, or updated_groups.
+// Likewise for arrays across new_arrays, deleted_arrays, or updated_arrays.
+// For example, a group that is created and then has its metadata
+// modified within the same commit MUST appear only in new_groups.
+table TransactionLog {
+  // MUST be identical to the id of the corresponding snapshot.
+  id: ObjectId12 (required);
+
+  // Node ids of groups created in this transaction.
+  new_groups: [ObjectId8] (required);
+
+  // Node ids of arrays created in this transaction.
+  new_arrays: [ObjectId8] (required);
+
+  // Node ids of groups deleted in this transaction.
+  deleted_groups: [ObjectId8] (required);
+
+  // Node ids of arrays deleted in this transaction.
+  deleted_arrays: [ObjectId8] (required);
+
+  // Node ids of arrays whose user_data (see NodeSnapshot) was modified
+  // in this transaction.
+  updated_arrays: [ObjectId8] (required);
+
+  // Node ids of groups whose user_data (see NodeSnapshot) was modified
+  // in this transaction.
+  updated_groups: [ObjectId8] (required);
+
+  // Chunk ref changes made in this transaction.
+  // MUST be sorted in ascending byte order of node_id.
+  updated_chunks: [ArrayUpdatedChunks] (required);
+
+  // Nodes moved in this transaction.
+  // MUST be sorted by the `to` field (see node path sort order in common.fbs).
+  // MUST be fully collapsed: if a node was moved multiple times
+  // (e.g. A -> B, then B -> C), only the net result (A -> C) is recorded.
+  // Every moved node MUST have its own entry. When a group is moved,
+  // all of its children MUST also appear as separate entries.
+  // A move MUST NOT result in a node whose parent path no longer exists.
+  // Identity moves (from == to) MUST be omitted.
+  // If a `to` path was occupied in the parent snapshot, that path
+  // MUST also appear as a `from` in another move — moves MUST NOT
+  // implicitly delete or overwrite nodes.
+  // Introduced in spec version 2.
+  moved_nodes: [MoveOperation];
+
+  // Reserved for future use. Opaque bytes for future extensions.
+  // Introduced in spec version 2.
+  extra: [uint8];
+}
+// --8<-- [end:transaction_log]
+
+root_type TransactionLog;
