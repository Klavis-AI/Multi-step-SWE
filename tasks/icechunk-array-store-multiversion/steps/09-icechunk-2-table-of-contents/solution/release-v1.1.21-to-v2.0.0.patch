+        .unwrap();
+
+        let payloads: Vec<_> =
+            manifest.chunk_payloads()?.collect::<Result<Vec<_>, _>>()?;
+        assert_eq!(payloads.len(), 50);
+        for (i, payload) in payloads.iter().enumerate() {
+            assert_eq!(payload, &chunks[i].payload);
+        }
+        Ok(())
+    }
+}
