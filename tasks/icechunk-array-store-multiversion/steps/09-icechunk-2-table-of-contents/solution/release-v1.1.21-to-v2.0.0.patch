+const COMPRESSION_ALG_NONE: u8 = 0;
+const COMPRESSION_ALG_ZSTD_DICT: u8 = 1;
+// This is the maximum size we support for a virtual chunk url that will be compressed
+const MAX_DECOMPRESSED_LOCATION_SIZE: usize = 1_024;
