+    #[test]
+    fn test_update_timestamp_ordering_rejected() -> Result<(), Box<dyn std::error::Error>>
+    {
+        let flushed_at = DateTime::from_timestamp_micros(1_000_000).unwrap();
+        let id1 = SnapshotId::random();
+        let snap1 = SnapshotInfo {
+            id: id1.clone(),
