+        repository.ancestry(&VersionInfo::SnapshotId(snapshot)).await?.take(args.n),
+    );
+    while let Some(snapshot) = ancestry.next().await {
+        show_snapshot(&mut writer, snapshot.context("Failed to get snapshot")?, false)?;
+        writeln!(writer)?;
+    }
