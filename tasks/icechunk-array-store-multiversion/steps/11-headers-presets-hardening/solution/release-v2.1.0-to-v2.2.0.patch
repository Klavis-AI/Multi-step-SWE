+        },
+        K::Conflict { expected_parent, actual_parent } => Classified::Conflict {
+            expected_parent: expected_parent.as_ref().map(|s| s.to_string()),
+            actual_parent: actual_parent.as_ref().map(|s| s.to_string()),
