--- a/icechunk-python/tests/test_concurrency.py
+++ b/icechunk-python/tests/test_concurrency.py
@@ -1,8 +1,17 @@
 import asyncio
+import concurrent.futures
 import random
+import time
+import uuid
+from random import randrange
