+    #[test]
+    fn test_azdls_create_operator() {
+        let test_cases = vec![
+            (
+                "basic",
+                (
+                    "abfss://myfs@myaccount.dfs.core.windows.net/path/to/file.parquet",
+                    AzdlsConfig {
