-/// Visit struct type in post order.
-pub fn visit_struct<V: SchemaVisitor>(s: &StructType, visitor: &mut V) -> Result<V::T> {
-    let mut results = Vec::with_capacity(s.fields().len());
-    for field in s.fields() {
