+        assert_eq!(
+            input_file.read().await.unwrap().len(),
+            FileMetadata::MAGIC_LENGTH as usize
+                // no blobs since puffin file is empty
+                + FileMetadata::MAGIC_LENGTH as usize
+                + empty_footer_payload_bytes().len()
+                + FileMetadata::FOOTER_STRUCT_LENGTH as usize
+        )
+    }
