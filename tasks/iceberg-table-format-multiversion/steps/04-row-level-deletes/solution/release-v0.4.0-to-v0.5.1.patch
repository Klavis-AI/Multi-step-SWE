-/// Used to track additions and deletions in ManifestEntry.
-#[derive(Debug, PartialEq, Eq, Clone, Copy)]
-pub enum ManifestStatus {
-    /// Value: 0
-    Existing = 0,
-    /// Value: 1
-    Added = 1,
-    /// Value: 2
-    ///
-    /// Deletes are informational only and not used in scans.
