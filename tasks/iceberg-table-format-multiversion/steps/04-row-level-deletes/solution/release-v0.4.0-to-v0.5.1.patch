+                .field_builder::<Int32Builder>(0)
+                .unwrap()
+                .append_null();
+            builder
+                .field_builder::<Int32Builder>(1)
+                .unwrap()
+                .append_null();
+            builder.append(true);
+
+            builder
+                .field_builder::<Int32Builder>(0)
+                .unwrap()
+                .append_value(1);
+            builder
+                .field_builder::<Int32Builder>(1)
