+        let struct_array = {
+            let mut builder = StructBuilder::from_fields(
+                Fields::from(vec![
+                    Field::new("a", DataType::Int32, true).with_metadata(HashMap::from([(
+                        PARQUET_FIELD_ID_META_KEY.to_string(),
+                        "0".to_string(),
