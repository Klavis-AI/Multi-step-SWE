-    let mut visitor = PruneColumn::new(HashSet::from_iter(selected), select_full_types);
-    let result = visit_schema(schema, &mut visitor);
-
-    match result {
-        Ok(s) => {
-            if let Some(struct_type) = s {
-                Ok(struct_type)
-            } else {
-                Ok(Type::Struct(StructType::default()))
-            }
-        }
-        Err(e) => Err(e),
-    }
-}
