+            nan_value_counts: HashMap::default(),
+
+            lower_bounds: HashMap::from([(3, Datum::string("abc"))]),
+
+            upper_bounds: HashMap::from([(3, Datum::string("イロハニホヘト"))]),
+
+            column_sizes: Default::default(),
+            key_metadata: vec![],
+            split_offsets: vec![],
+            equality_ids: vec![],
+            sort_order_id: None,
+        }
+    }
+}
