+            schema.field_by_name(&self.name)
+        } else {
+            schema.field_by_name_case_insensitive(&self.name)
+        };
+
+        let field = field.ok_or_else(|| {
+            Error::new(
+                ErrorKind::DataInvalid,
+                format!("Field {} not found in schema", self.name),
+            )
+        })?;
