+                    };
+                    if bytes.len() != *len as usize {
+                        return Err(Error::new(
+                            ErrorKind::Unexpected,
+                            "Invalid length of fixed bytes.",
+                        ));
+                    }
+                    Some(Datum::fixed(bytes.to_vec()))
