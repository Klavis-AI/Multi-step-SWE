# The practice-corpus master is NOT part of the agent image: every step's slice
# reaches the agent through that step's workdir (/app/css-corpus/). Keeping the
# master out of the build context means no COPY can ship later milestones'
# strata into the image that every step shares.
corpus/

# Compiled Python bytecode is build cruft here, never a fixture. Anything COPY'd
# from this context lands in the agent image.
#
# Docker's ignore matching does not cross `/`, so a bare `__pycache__` or
# `*.pyc` matches only the context root; the `**/` forms cover nested
# directories such as `corpus/__pycache__`.
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
